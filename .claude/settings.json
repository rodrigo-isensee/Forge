{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "tmux capture-pane *",
      "tmux ls",
      "tmux has-session *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/.git-credentials"
      ],
      "allowWrite": [
        "~/.forge-contrib"
      ],
      "denyWrite": [
        ".forge/"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "codeload.github.com",
        "uploads.github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "nodejs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "playwright.azureedge.net",
        "playwright.download.prss.microsoft.com",
        "cdn.playwright.dev"
      ],
      "deniedDomains": [
        "api.anthropic.com",
        "*.anthropic.com",
        "api.openai.com",
        "*.openai.com",
        "generativelanguage.googleapis.com"
      ]
    }
  }
}
