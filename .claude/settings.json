{
  "env": {
    "npm_config_cache": "/tmp/claude-1000/cache/npm",
    "XDG_CACHE_HOME": "/tmp/claude-1000/cache/xdg",
    "PIP_CACHE_DIR": "/tmp/claude-1000/cache/pip",
    "PLAYWRIGHT_BROWSERS_PATH": "/tmp/claude-1000/cache/playwright"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "tmux capture-pane *",
      "tmux ls",
      "tmux has-session *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.forge-contrib"
      ],
      "denyWrite": [
        ".forge/",
        ".githooks/",
        ".claude-plugin/",
        ".github/",
        "tests/config.json",
        "tests/catraca.py",
        "tests/neutralidade.py",
        "hooks/conformidade.json"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "codeload.github.com",
        "uploads.github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "nodejs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "playwright.azureedge.net",
        "playwright.download.prss.microsoft.com",
        "cdn.playwright.dev"
      ],
      "deniedDomains": [
        "api.anthropic.com",
        "*.anthropic.com",
        "api.openai.com",
        "*.openai.com",
        "generativelanguage.googleapis.com"
      ]
    }
  }
}
