#!/usr/bin/env bash
# Forge: develop, homolog e main só mudam por pull request (develop e homolog mesclados pelo tech-lead
# com os testes verdes; main mesclada pelo usuário). Ninguém envia direto para elas.
# Diferente do hook do modelo de projeto (só main): a fábrica tem três degraus protegidos.
# R-TETO: tarefas pesadas uma de cada vez. A suíte do Forge é pesada; duas na mesma máquina e para o mesmo
# usuário esperam a vez por uma trava de arquivo (flock), fora do repositório. O kernel solta a trava quando
# o processo morre, então não existe trava órfã. `--status` diz se há suíte rodando (saída 0) ou não (1); saída 2 = não consegui conferir.
# Pasta da trava: XDG_RUNTIME_DIR (privada do usuário) ou, no recuo para $TMPDIR e /tmp (que podem ser
# compartilhados), a subpasta forge-<uid>, criada com modo 700 e conferida (do próprio usuário, não é link, sem escrita
# de grupo nem de outros).
# Se a subpasta não puder ser criada ou conferida, falha fechado: não há recuo para outra pasta.
# Falha fechada: só aceita quando o find roda e confirma a pasta sem escrita de grupo nem de outros; erro ou saída vazia = recusa.
modo_sem_escrita_alheia() {
  [ "$(find "$1" -maxdepth 0 ! -perm /022 -print 2>/dev/null)" = "$1" ]
}
# $1 = criar: cria a subpasta se faltar; vazio (--status): só confere, sem criar nada.
# TRAVA-SANDBOX: com $HOME/.forge-contrib presente (`-e` ou `-L`; o sandbox do Bash a libera, ADR 0009) a trava e a fila ficam
# só ali, dentro e fora do sandbox, sem recuo; ausente, vale a ordem de sempre. $2 = legado: ignora a pasta comum (provas).
trava_arquivo() {
  local d sub uid comum candidatos
  uid="$(id -u)"
  comum="${HOME:-}/.forge-contrib"
  if [ -z "${2:-}" ] && [ -n "${HOME:-}" ] && { [ -e "$comum" ] || [ -L "$comum" ]; }; then
    candidatos=("$comum")
  else
    candidatos=("${XDG_RUNTIME_DIR:-}" "${TMPDIR:-}" /tmp)
  fi
  for d in "${candidatos[@]}"; do
    if [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ]; then
      d="${d%/}"
      if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ "$d" = "${XDG_RUNTIME_DIR%/}" ]; then
        printf '%s/forge-suite-%s.lock\n' "$d" "$uid"
        return 0
      fi
      sub="$d/forge-$uid"
      if [ ! -e "$sub" ] && [ ! -L "$sub" ] && [ -n "${1:-}" ]; then
        mkdir -m 700 "$sub" 2>/dev/null || true
      fi
      if [ ! -e "$sub" ] && [ ! -L "$sub" ] && [ -z "${1:-}" ]; then
        printf '%s/forge-suite-%s.lock\n' "$sub" "$uid"
        return 0
      fi
      if [ -L "$sub" ] || [ ! -d "$sub" ] || [ ! -O "$sub" ]; then
        echo "pre-push: ${sub} não é uma pasta do próprio usuário (ou é link, ou não pôde ser criada); recusada. Apague-a e tente de novo." >&2
        return 1
      fi
      if ! modo_sem_escrita_alheia "$sub"; then
        echo "pre-push: ${sub} tem escrita de grupo ou de outros (ou o modo não pôde ser lido); recusada. Corrija com chmod 700 ou apague-a e tente de novo." >&2
        return 1
      fi
      printf '%s/forge-suite-%s.lock\n' "$sub" "$uid"
      return 0
    fi
  done
  echo "pre-push: sem pasta gravável para a trava da suíte (${candidatos[*]})." >&2
  return 1
}
# Texto da trava (de outro processo): até 200 bytes, só imprimíveis, para um escape gravado nela não chegar ao terminal (C-14).
texto_da_trava() {
  head -c 200 -- "$trava" 2>/dev/null | LC_ALL=C tr -cd '[:print:]' || true
}
# Confere o arquivo já aberto no descritor 9 (não o caminho): do próprio usuário e não é link no caminho.
trava_confere() {
  if [ -L "$trava" ] || [ ! -O /proc/self/fd/9 ]; then
    echo "pre-push: ${trava} é link simbólico ou não é do próprio usuário; recusado. Apague-o e tente de novo." >&2
    return 1
  fi
}
# SUITE-FILA-JUSTA: a trava do kernel garante uma suíte por vez, mas não a ordem de quem espera. A fila dá a vez
# por ordem de chegada: cada espera cria uma senha <ns>-<pid> na pasta <trava>.fila (modo 700, do próprio usuário,
# não é link), presa por flock no descritor 8, e só disputa a trava quando a sua é a menor senha viva. Senha cujo
# flock se obtém é de processo morto e é descartada. A senha só ordena a espera: a exclusão continua sendo a trava.
# Sem a pasta da fila (ou sem poder criar a senha), espera só pela trava, como antes, com aviso.
senha=""
# Senhas vivas da fila, em ordem de chegada (descarta as de processo morto se $1 = limpar).
fila_vivas() {
  local f LC_COLLATE=C
  for f in "$fila"/[0-9]*; do
    if [ ! -e "$f" ] || [ -L "$f" ]; then continue; fi
    if [ "$f" != "$senha" ] && (exec 7<"$f" && flock -n 7) 2>/dev/null; then
      [ "${1:-}" = limpar ] && rm -f -- "$f"
      continue
    fi
    printf '%s\n' "$f"
  done
}
fila_entrar() {
  local nova alvo
  if [ ! -e "$fila" ] && [ ! -L "$fila" ]; then mkdir -m 700 "$fila" 2>/dev/null || true; fi
  if [ -L "$fila" ] || [ ! -d "$fila" ] || [ ! -O "$fila" ]; then
    echo "pre-push: aviso: ${fila} não é uma pasta do próprio usuário; espera sem a ordem de chegada (só a trava)." >&2
    return 1
  fi
  # A senha nasce com outro nome e já presa; só então ganha o nome que entra na fila (ninguém a vê solta).
  nova="$fila/.nova-$$"; alvo="$fila/$(date +%s%N)-$$"
  if ! { exec 8>"$nova" && flock -n 8 && mv -f -- "$nova" "$alvo"; } 2>/dev/null; then
    rm -f -- "$nova"; exec 8>&-
    echo "pre-push: aviso: não consegui entrar na fila ${fila}; espera sem a ordem de chegada (só a trava)." >&2
    return 1
  fi
  senha="$alvo"
}
fila_sair() {
  if [ -n "$senha" ]; then rm -f -- "$senha"; exec 8>&-; senha=""; fi
}
# Modo --status só quando chamado à mão com exatamente um argumento; o git passa nome e URL do remoto
# (dois argumentos), então um remoto chamado "--status" cai no caminho normal.
if [ "$#" -eq 1 ] && [ "$1" = "--status" ]; then
  # PRE-PUSH-STATUS-RC: erro de conferência sai com 2, para o laço de espera não ler "não consegui conferir" como "livre".
  status_erro() {
    echo "pre-push: --status não conseguiu conferir a trava (saída 2, não é 'livre'); não rode a suíte à mão: use '.githooks/pre-push --suite', que espera a vez ou falha fechado." >&2
    exit 2
  }
  trava="$(trava_arquivo)" || status_erro
  if [ -L "$trava" ]; then echo "pre-push: ${trava} é link simbólico; recusado." >&2; status_erro; fi
  if [ ! -e "$trava" ]; then echo "nenhuma suíte do Forge rodando"; exit 1; fi
  # Só testa: abre para leitura (não cria nem trunca) e solta na hora.
  exec 9<"$trava" || status_erro
  trava_confere || status_erro
  if flock -n 9; then flock -u 9; echo "nenhuma suíte do Forge rodando"; exit 1; fi
  fila="${trava%.lock}.fila"
  na_fila=0
  echo "para rodar esperando a vez (atômico): .githooks/pre-push --suite"
  if [ -d "$fila" ] && [ ! -L "$fila" ] && [ -O "$fila" ]; then na_fila="$(fila_vivas | wc -l)"; fi
  echo "suíte do Forge rodando ($(texto_da_trava)); ${na_fila} na fila"
  exit 0
fi
# Modo --suite (só à mão, com exatamente esse argumento, como o --status): a suíte inteira com a mesma trava e a
# mesma fila do push, sem refs e sem anotar prova. É por onde scripts/suite-paralela.py passa quando chamado à mão.
# F8 (0.43.3): o início do envio, para a linha de duração (linha_de_duracao, abaixo).
inicio_prepush="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# F8: uma linha de duração no log do envio (o stderr do pre-push), lida pelo `forge-check metricas --log-prepush <log>`: início
# e fim em UTC, o plano (baratas, curta, completa, dirigida, nada) e o rc. Sem arquivo novo e sem aviso novo.
linha_de_duracao() {
  echo "pre-push: duracao inicio=${inicio_prepush} fim=$(date -u +%Y-%m-%dT%H:%M:%SZ) plano=$1 rc=$2" >&2
}
modo_suite=0
if [ "$#" -eq 1 ] && [ "$1" = "--suite" ]; then modo_suite=1; exec </dev/null; fi
refs_branches=0; refs_remocoes=0  # PREPUSH-REFS: contadores do laço (nunca herdados do ambiente)
n_refs=0; n_envios=0; unico_local=""; unico_remoto=""; unico_ref=""; envio_sha=(); envio_ref=(); envios=()
while read -r _ local_sha remote_ref remote_sha; do
  n_refs=$((n_refs + 1)); case "$local_sha" in *[!0]*) n_envios=$((n_envios + 1)); envios+=("$local_sha $remote_sha $remote_ref") ;; esac; unico_local="$local_sha"; unico_remoto="$remote_sha"; unico_ref="$remote_ref"
  case "$local_sha" in *[!0]*) envio_sha+=("$local_sha"); envio_ref+=("$remote_ref") ;; esac
  # R-VERIFY: reescrever histórico de ref remota existente (não fast-forward) é decisão do usuário.
  # Recusar quando o objeto remoto não existe localmente é intencional: sem ele não há como provar que
  # é fast-forward; um `git fetch` resolve. Apagar ref (local_sha zerado) não passa por esta checagem.
  case "$local_sha" in *[!0]*)
    case "$remote_sha" in *[!0]*)
      ref_nome="${remote_ref#refs/heads/}"; ref_nome="${ref_nome#refs/tags/}"
      if ! git cat-file -e "$remote_sha" 2>/dev/null; then
        echo "pre-push: o commit atual de ${ref_nome} no remoto não existe aqui, então não dá para saber se o envio é fast-forward; rode 'git pull --rebase' (traz o remoto) e envie de novo." >&2
        exit 1
      fi
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        case "$remote_ref" in
          refs/tags/*) echo "pre-push: R-VERIFY: mover a tag ${ref_nome} para outro commit (histórico reescrito) bloqueado; reescrever histórico é decisão do usuário." >&2 ;;
          *) echo "pre-push: R-VERIFY: envio não fast-forward para ${ref_nome} (histórico reescrito) bloqueado; rode 'git pull --rebase' e envie de novo, reescrever histórico é decisão do usuário." >&2 ;;
        esac
        exit 1
      fi ;;
    esac ;;
  esac
  case "$remote_ref" in
    refs/heads/main|refs/heads/homolog|refs/heads/develop)
      echo "pre-push: envio direto para ${remote_ref#refs/heads/} bloqueado. Abra um pull request (fluxo: branch -> develop -> homolog -> main)." >&2
      exit 1 ;;
  esac
  # PREPUSH-REFS (v0457, D2 de docs/security/ameacas/v0457-hook-shell-pipe.md): a política vale para as refs reais do
  # envio, qualquer que seja a sintaxe (--branches, -c remote.*.mirror, refspec com curinga, --prune, pipe para o shell).
  case "$remote_ref" in
    refs/heads/?*|refs/tags/?*) ;;
    *) echo "pre-push: R-FLUXO: a ref remota '${remote_ref}' não é branch (refs/heads/) nem tag (refs/tags/); envio bloqueado (o envio espelho leva refs/remotes/, refs/notes/ e afins)." >&2
       exit 1 ;;
  esac
  case "$local_sha" in
    *[!0]*) case "$remote_ref" in refs/heads/*) refs_branches=$((refs_branches + 1)) ;; esac ;;
    *) refs_remocoes=$((refs_remocoes + 1)) ;;
  esac
  if [ "$refs_branches" -gt 1 ]; then
    echo "pre-push: R-FLUXO: mais de uma branch com código no mesmo envio bloqueado; envie uma branch por vez (git push origin <branch>)." >&2
    exit 1
  fi
  # PREPUSH-DELETE (decisão do dono, 2026-10-23; item 3 da D2 em 2026-11-10 23:45): a limpeza pós-merge apaga uma ref
  # por envio; mais de uma remoção no mesmo envio (espelho, --prune, curinga) é bloqueada.
  if [ "$refs_remocoes" -gt 1 ]; then
    echo "pre-push: R-FLUXO: mais de uma remoção de branch ou tag no mesmo envio bloqueada; apague uma por envio (git push origin --delete <ref>)." >&2
    exit 1
  fi
done
# PREPUSH-JA-NO-REMOTO: sem nenhuma ref a enviar (a branch já é igual à remota, o git chama o hook com o stdin vazio)
# não há o que testar. Só este caso: o push que apaga ref traz uma linha e segue rodando a suíte; o modo --suite
# também não lê refs e roda sempre.
if [ "$modo_suite" -eq 0 ] && [ "$n_refs" -eq 0 ]; then
  echo "pre-push: nada a enviar (a branch já é igual à remota); suíte não roda." >&2
  exit 0
fi
# PREPUSH-DELETE (decisão do dono, 2026-10-23): o push em que toda ref é remoção (local_sha zerado) não leva código
# novo, então não há o que testar: é a limpeza pós-merge do R-FLUXO, que não espera a suíte nem a fila da trava. Decidido
# aqui, depois de ler todas as refs (a recusa de main, homolog e develop, acima, já valeu para cada uma, inclusive as
# remoções) e antes da trava. Uma ref que envia código, mesmo ao lado de remoções, segue o caminho de sempre.
if [ "$modo_suite" -eq 0 ] && [ "$n_refs" -gt 0 ] && [ "$n_envios" -eq 0 ]; then
  echo "pre-push: o envio só remove branch ou tag (nenhum código novo); suíte não roda." >&2
  exit 0
fi
# Um hook do git recebe GIT_DIR e afins (numa worktree, GIT_DIR aponta para o repositório principal);
# limpa para que nada rodado aqui escreva em outro repositório.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
# Testes estruturais (rápidos, só biblioteca padrão); o CI repete tudo.
cd "$(git rev-parse --show-toplevel)" || exit 1
# I3 (0.37 E8): o delta de cada ref enviada (branch ou tag) passa pelo script de segredo do CI lido da base (a branch não julga a
# si mesma). Base, ponta ou script ilegível: aviso e segue (o CI varre); saída diferente de 0 recusa o envio; nunca o valor.
segredo_no_delta() {
  local dev script envio ponta remoto ref base saida
  if ! { dev="$(git rev-parse --verify -q 'refs/remotes/origin/develop^{commit}' 2>/dev/null)" &&
    script="$(git show "$dev:scripts/verificar-contribuicao.sh" 2>/dev/null)" && [ -n "$script" ]; }; then
    echo "pre-push: aviso: sem refs/remotes/origin/develop ou sem o script de segredo nela; varredura pulada (o CI varre)." >&2
    return 0
  fi
  for envio in "${envios[@]}"; do
    read -r ponta remoto ref <<< "$envio"
    ponta="$(git rev-parse --verify -q "${ponta}^{commit}" 2>/dev/null)" || { echo "pre-push: aviso: ${ref} não é commit; varredura pulada nela." >&2; continue; }
    case "$remoto" in *[!0]*) base="$remoto" ;; *) base="$(git merge-base "$dev" "$ponta" 2>/dev/null)" ;; esac
    [ -n "$base" ] || { echo "pre-push: aviso: ${ref} sem base comum com origin/develop; varredura pulada nela (o CI varre)." >&2; continue; }
    # Transição: o script da base sem a marca forge:ponta varre só o HEAD.
    if ! grep -qx '# forge:ponta.*' <<< "$script" && [ "$ponta" != "$(git rev-parse HEAD 2>/dev/null)" ]; then
      echo "pre-push: aviso: o script de segredo da base não aceita a ponta; ${ref} não foi varrida (o CI varre)." >&2; continue
    fi
    saida="$(env -u BASH_ENV -u ENV -u SHELLOPTS -u BASHOPTS bash --noprofile --norc -c "$script" segredo "$base" "$ponta" 2>&1)" && continue
    printf '%s\n' "$saida" | LC_ALL=C tr -d '\000-\011\013-\037\177' >&2
    echo "pre-push: varredura de segredo falhou ou achou algo em ${ref}; o valor não é impresso. Exemplo de propósito: marque a linha com forge:exemplo; base velha: 'git fetch origin develop' e envie de novo. Nunca --no-verify." >&2
    return 1
  done
}
if [ "$modo_suite" -eq 0 ]; then segredo_no_delta || exit 1; fi
# PUSH-PARECER-JA-NO-REMOTO (decisão do dono, 2026-11-05): o envio cujo commit o remoto já tem (outro envio do mesmo
# commit chegou antes, inclusive durante a espera da fila) não leva nada novo e não roda a suíte; o CI do PR repete tudo.
# Só o destino que o git passou em $2 (a URL do envio, que segue a pushurl; nunca o ambiente), e a ref comparada pelo
# nome inteiro (o ls-remote casa pela cauda). Falha fechada: pula só se todas as refs do push são branch já no remoto no
# mesmo sha ou num descendente; tag, remoção, ref nova, erro ou tempo esgotado rodam a suíte. Não anota prova (.verde,
# .dirigida): só suíte que rodou.
sha_valido() { [[ "$1" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]; }
ja_no_remoto() {
  local i ref sha achado s r saida achados="" destino="${1:-}"
  [ "$modo_suite" -eq 0 ] && [ "$n_envios" -gt 0 ] && [ "$n_envios" -eq "$n_refs" ] || return 1
  [ "${#envio_ref[@]}" -eq "$n_envios" ] || return 1
  case "$destino" in ''|-*) return 1 ;; esac
  for i in "${!envio_ref[@]}"; do
    ref="${envio_ref[$i]}"; sha="${envio_sha[$i]}"; achado=""
    case "$ref" in refs/heads/main|refs/heads/homolog|refs/heads/develop|*[[:cntrl:]]*) return 1 ;; refs/heads/?*) ;; *) return 1 ;; esac
    sha_valido "$sha" || return 1
    saida="$(GIT_TERMINAL_PROMPT=0 timeout 20 git ls-remote -- "$destino" "$ref" 2>/dev/null)" || return 1
    while IFS=$'\t' read -r s r; do [ "$r" = "$ref" ] && achado="$s"; done <<< "$saida"
    sha_valido "$achado" || return 1
    if [ "$achado" != "$sha" ]; then
      git cat-file -e "${achado}^{commit}" 2>/dev/null && git merge-base --is-ancestor "$sha" "$achado" 2>/dev/null || return 1
    fi
    achados="${achados:+$achados, }${ref#refs/heads/} em ${achado:0:7}"
  done
  echo "pre-push: o remoto já tem o que seria enviado (${achados}); suíte não roda." >&2
}
if [ "$modo_suite" -eq 0 ] && ja_no_remoto "${2:-}"; then exit 0; fi
# SUITE-NO-CI (decisão do dono, 2026-11-08, "Faça tudo"): a suíte inteira roda uma vez, no CI do PR; o envio local roda
# as checagens baratas (em segundos, antes da trava) e depois só os testes afetados pelo diff (`bin/forge-testes
# --afetados`), para qualquer branch e para envio de várias refs. A suíte inteira local é opt-in: FORGE_PREPUSH_SUITE=1.
# ENVIO-LEVE (decisão do dono, 2026-11-11, que substitui a SUITE-NO-CI no envio; diretriz 15): o padrão é o envio leve, só as
# checagens baratas e os bloqueios, sem teste nenhum; o CI do PR é o portão. Opt-in à mão: FORGE_PREPUSH_SUITE=afetados (o plano
# do `bin/forge-testes --afetados`) ou =1 (a suíte inteira local).
suite_local="${FORGE_PREPUSH_SUITE:-0}"
case "$suite_local" in 0|1|afetados) ;; *) echo "pre-push: FORGE_PREPUSH_SUITE vale 0 (envio leve, sem testes, o padrão), afetados (os testes afetados) ou 1 (a suíte inteira local); veio '${suite_local}'." >&2; exit 1 ;; esac
# A base é `refs/remotes/origin/develop`, resolvida uma vez só para um sha: plano, checagens e execução leem a mesma base,
# e a ref curta `origin/develop` poderia ser uma branch local de mesmo nome.
base_dev="$(git rev-parse --verify -q 'refs/remotes/origin/develop^{commit}' 2>/dev/null || true)"
# Caminhos do envio: o delta de cada ref enviada e o do HEAD desde a base comum com a develop (a branch inteira, não só o
# que o remoto ainda não tem), mais o que a árvore de trabalho muda (os testes rodam nela). Sem a base: lista vazia e
# `sem_caminhos=1` (o plano cai na suíte inteira, falha fechada).
alterados=()
sem_caminhos=0
caminhos_do_envio() {
  local envio ponta ancora lista
  [ -n "$base_dev" ] || { sem_caminhos=1; return 0; }
  lista="$(mktemp "${TMPDIR:-/tmp}/forge-alterados.XXXXXX")" || { sem_caminhos=1; return 0; }
  {
    for envio in "${envios[@]}" "HEAD 0 HEAD"; do
      read -r ponta _ _ <<< "$envio"
      ancora="$(git merge-base "$base_dev" "$ponta" 2>/dev/null)" || { sem_caminhos=1; continue; }
      git -c core.quotepath=false diff --name-only --no-renames -z "$ancora" "$ponta" -- || sem_caminhos=1
    done
    git -c core.quotepath=false diff --name-only --no-renames -z HEAD -- || sem_caminhos=1
    git -c core.quotepath=false ls-files -z --others --exclude-standard || sem_caminhos=1
  } > "$lista" 2>/dev/null
  mapfile -d '' -t alterados < <(sort -zu "$lista")
  rm -f -- "$lista"
}
if [ "$modo_suite" -eq 0 ]; then caminhos_do_envio; fi
# PREPUSH-BARATAS (P4 do estudo de 2026-11-08): o vermelho de forma sai em segundos, antes da fila e da trava. Sintaxe
# (bash -n e ast do Python) de todo script alterado, shellcheck dos scripts shell que o envio alterou, a neutralidade e o
# scripts/verificar-contribuicao.sh nos arquivos tocados (0.43.3) e `bin/forge-changelog conferir` do HEAD (o fragmento com o
# nome da branch, CHANGELOG-BRANCH). Ferramenta ausente: aviso e segue (o CI repete tudo). Nunca afrouxa: o CI roda as mesmas checagens.
# COBERTURA-P6: o shellcheck escolhe pelo shebang (tipo_de_script), a mesma regra do passo shellcheck do ci.yml, sem lista fixa.
# PARECER-NEUTRALIDADE-CEDO (0.43.3): a regra das classes Neutralidade e NeutralidadeDoNucleo de tests/test_forge.py, só nos
# arquivos tocados (argumentos), com a lista de tests/config.json e o detector de tests/neutralidade.py da árvore. Sem os dois
# (repositório mínimo), nada a conferir: o CI roda as classes inteiras. Termo de projeto sai só com o arquivo, nunca o termo.
NEUTRALIDADE_PY='import json, re, sys
from pathlib import Path
try:
    cfg = json.loads(Path("tests/config.json").read_text(encoding="utf-8"))
    sys.path.insert(0, "tests")
    from neutralidade import termos_achados
except Exception:
    sys.exit(0)
TEXTO = ("agents/", "skills/", "stacks/", "docs/", "templates/", "bin/", "scripts/", "hooks/", "dev/", "tests/transcricoes/")
nucleo = cfg.get("neutralidade_nucleo") or {}
termos = [re.compile(t) for t in nucleo.get("termos", [])]
pastas = tuple(d.rstrip("/") + "/" for d in nucleo.get("pastas", []))
ignorar = tuple(nucleo.get("ignorar", []))
falhas = 0
