#!/usr/bin/env bash
# Forge: develop, homolog e main só mudam por pull request (develop e homolog mesclados pelo tech-lead
# com os testes verdes; main mesclada pelo usuário). Ninguém envia direto para elas.
# Diferente do hook do modelo de projeto (só main): a fábrica tem três degraus protegidos.
# R-TETO: tarefas pesadas uma de cada vez. A suíte do Forge é pesada; duas na mesma máquina e para o mesmo
# usuário esperam a vez por uma trava de arquivo (flock), fora do repositório. O kernel solta a trava quando
# o processo morre, então não existe trava órfã. `--status` diz se há suíte rodando (saída 0) ou não (1).
# Pasta da trava: XDG_RUNTIME_DIR (privada do usuário) ou, no recuo para $TMPDIR e /tmp (que podem ser
# compartilhados), a subpasta forge-<uid>, criada com modo 700 e conferida (do próprio usuário, não é link).
# Se a subpasta não puder ser criada ou conferida, falha fechado: não há recuo para outra pasta.
# $1 = criar: cria a subpasta se faltar; vazio (--status): só confere, sem criar nada.
trava_arquivo() {
  local d sub uid
  uid="$(id -u)"
  for d in "${XDG_RUNTIME_DIR:-}" "${TMPDIR:-}" /tmp; do
    if [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ]; then
      d="${d%/}"
      if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ "$d" = "${XDG_RUNTIME_DIR%/}" ]; then
        printf '%s/forge-suite-%s.lock\n' "$d" "$uid"
        return 0
      fi
      sub="$d/forge-$uid"
      if [ ! -e "$sub" ] && [ ! -L "$sub" ] && [ -n "${1:-}" ]; then
        mkdir -m 700 "$sub" 2>/dev/null || true
      fi
      if [ ! -e "$sub" ] && [ ! -L "$sub" ] && [ -z "${1:-}" ]; then
        printf '%s/forge-suite-%s.lock\n' "$sub" "$uid"
        return 0
      fi
      if [ -L "$sub" ] || [ ! -d "$sub" ] || [ ! -O "$sub" ]; then
        echo "pre-push: ${sub} não é uma pasta do próprio usuário (ou é link, ou não pôde ser criada); recusada. Apague-a e tente de novo." >&2
        return 1
      fi
      printf '%s/forge-suite-%s.lock\n' "$sub" "$uid"
      return 0
    fi
  done
  echo "pre-push: sem pasta gravável para a trava da suíte (XDG_RUNTIME_DIR, TMPDIR, /tmp)." >&2
  return 1
}
# Confere o arquivo já aberto no descritor 9 (não o caminho): do próprio usuário e não é link no caminho.
trava_confere() {
  if [ -L "$trava" ] || [ ! -O /proc/self/fd/9 ]; then
    echo "pre-push: ${trava} é link simbólico ou não é do próprio usuário; recusado. Apague-o e tente de novo." >&2
    return 1
  fi
}
# SUITE-FILA-JUSTA: a trava do kernel garante uma suíte por vez, mas não a ordem de quem espera. A fila dá a vez
# por ordem de chegada: cada espera cria uma senha <ns>-<pid> na pasta <trava>.fila (modo 700, do próprio usuário,
# não é link), presa por flock no descritor 8, e só disputa a trava quando a sua é a menor senha viva. Senha cujo
# flock se obtém é de processo morto e é descartada. A senha só ordena a espera: a exclusão continua sendo a trava.
# Sem a pasta da fila (ou sem poder criar a senha), espera só pela trava, como antes, com aviso.
senha=""
# Senhas vivas da fila, em ordem de chegada (descarta as de processo morto se $1 = limpar).
fila_vivas() {
  local f LC_COLLATE=C
  for f in "$fila"/[0-9]*; do
    [ -e "$f" ] && [ ! -L "$f" ] || continue
    if [ "$f" != "$senha" ] && (exec 7<"$f" && flock -n 7) 2>/dev/null; then
      [ "${1:-}" = limpar ] && rm -f -- "$f"
      continue
    fi
    printf '%s\n' "$f"
  done
}
fila_entrar() {
  local nova alvo
  if [ ! -e "$fila" ] && [ ! -L "$fila" ]; then mkdir -m 700 "$fila" 2>/dev/null || true; fi
  if [ -L "$fila" ] || [ ! -d "$fila" ] || [ ! -O "$fila" ]; then
    echo "pre-push: aviso: ${fila} não é uma pasta do próprio usuário; espera sem a ordem de chegada (só a trava)." >&2
    return 1
  fi
  # A senha nasce com outro nome e já presa; só então ganha o nome que entra na fila (ninguém a vê solta).
  nova="$fila/.nova-$$"; alvo="$fila/$(date +%s%N)-$$"
  if ! { exec 8>"$nova" && flock -n 8 && mv -f -- "$nova" "$alvo"; } 2>/dev/null; then
    rm -f -- "$nova"; exec 8>&-
    echo "pre-push: aviso: não consegui entrar na fila ${fila}; espera sem a ordem de chegada (só a trava)." >&2
    return 1
  fi
  senha="$alvo"
}
fila_sair() {
  if [ -n "$senha" ]; then rm -f -- "$senha"; exec 8>&-; senha=""; fi
}
# Modo --status só quando chamado à mão com exatamente um argumento; o git passa nome e URL do remoto
# (dois argumentos), então um remoto chamado "--status" cai no caminho normal.
if [ "$#" -eq 1 ] && [ "$1" = "--status" ]; then
  trava="$(trava_arquivo)" || exit 1
  if [ -L "$trava" ]; then echo "pre-push: ${trava} é link simbólico; recusado." >&2; exit 1; fi
  if [ ! -e "$trava" ]; then echo "nenhuma suíte do Forge rodando"; exit 1; fi
  # Só testa: abre para leitura (não cria nem trunca) e solta na hora.
  exec 9<"$trava" || exit 1
  trava_confere || exit 1
  if flock -n 9; then flock -u 9; echo "nenhuma suíte do Forge rodando"; exit 1; fi
  fila="${trava%.lock}.fila"
  na_fila=0
  if [ -d "$fila" ] && [ ! -L "$fila" ] && [ -O "$fila" ]; then na_fila="$(fila_vivas | wc -l)"; fi
  echo "suíte do Forge rodando ($(cat "$trava" 2>/dev/null || true)); ${na_fila} na fila"
  exit 0
fi
# Modo --suite (só à mão, com exatamente esse argumento, como o --status): a suíte inteira com a mesma trava e a
# mesma fila do push, sem refs e sem anotar prova. É por onde scripts/suite-paralela.py passa quando chamado à mão.
modo_suite=0
if [ "$#" -eq 1 ] && [ "$1" = "--suite" ]; then modo_suite=1; exec </dev/null; fi
n_refs=0; unico_local=""; unico_remoto=""; unico_ref=""
while read -r _ local_sha remote_ref remote_sha; do
  n_refs=$((n_refs + 1)); unico_local="$local_sha"; unico_remoto="$remote_sha"; unico_ref="$remote_ref"
  # R-VERIFY: reescrever histórico de ref remota existente (não fast-forward) é decisão do usuário.
  # Recusar quando o objeto remoto não existe localmente é intencional: sem ele não há como provar que
  # é fast-forward; um `git fetch` resolve. Apagar ref (local_sha zerado) não passa por esta checagem.
  case "$local_sha" in *[!0]*)
    case "$remote_sha" in *[!0]*)
      ref_nome="${remote_ref#refs/heads/}"; ref_nome="${ref_nome#refs/tags/}"
      if ! git cat-file -e "$remote_sha" 2>/dev/null; then
        echo "pre-push: o commit atual de ${ref_nome} no remoto não existe aqui, então não dá para saber se o envio é fast-forward; rode 'git fetch' e tente de novo." >&2
        exit 1
      fi
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        case "$remote_ref" in
          refs/tags/*) echo "pre-push: R-VERIFY: mover a tag ${ref_nome} para outro commit (histórico reescrito) bloqueado; reescrever histórico é decisão do usuário." >&2 ;;
          *) echo "pre-push: R-VERIFY: envio não fast-forward para ${ref_nome} (histórico reescrito) bloqueado; faça rebase sobre a remota e envie normalmente, reescrever histórico é decisão do usuário." >&2 ;;
        esac
        exit 1
      fi ;;
    esac ;;
  esac
  case "$remote_ref" in
    refs/heads/main|refs/heads/homolog|refs/heads/develop)
      echo "pre-push: envio direto para ${remote_ref#refs/heads/} bloqueado. Abra um pull request (fluxo: branch -> develop -> homolog -> main)." >&2
      exit 1 ;;
  esac
done
# Um hook do git recebe GIT_DIR e afins (numa worktree, GIT_DIR aponta para o repositório principal);
# limpa para que nada rodado aqui escreva em outro repositório.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
# Testes estruturais (rápidos, só biblioteca padrão); o CI repete tudo.
cd "$(git rev-parse --show-toplevel)" || exit 1
espera="${FORGE_TRAVA_ESPERA:-1200}"
case "$espera" in ''|*[!0-9]*) echo "pre-push: FORGE_TRAVA_ESPERA deve ser um número de segundos inteiro (veio '${espera}')." >&2; exit 1 ;; esac
trava="$(trava_arquivo criar)" || exit 1
if [ -L "$trava" ]; then
  echo "pre-push: ${trava} é link simbólico ou não é do próprio usuário; recusado. Apague-o e tente de novo." >&2
  exit 1
fi
# Abre uma vez (sem truncar) e confere o arquivo aberto; o pid vai pelo mesmo descritor.
exec 9>>"$trava" || { echo "pre-push: não consegui abrir a trava ${trava}." >&2; exit 1; }
trava_confere || exit 1
limite_ns=$(( $(date +%s%N) + espera * 1000000000 ))
avisou=0
avisar() {
  [ "$avisou" = 1 ] && return 0
  avisou=1
  echo "pre-push: outra suíte do Forge está rodando ou na fila antes desta ($(cat "$trava" 2>/dev/null || true)); esperando a vez por até ${espera} s (R-TETO)." >&2
}
barrar() {
  fila_sair
  echo "pre-push: a vez não chegou em ${espera} s; a suíte não rodou e o envio foi barrado. Veja '.githooks/pre-push --status' e tente de novo." >&2
  exit 1
}
fila="${trava%.lock}.fila"
if fila_entrar; then
  while [ "$(fila_vivas limpar | head -n 1)" != "$senha" ]; do
    avisar
    [ "$(date +%s%N)" -lt "$limite_ns" ] || barrar
    sleep 0.2
  done
fi
if ! flock -n 9; then
  avisar
  resta_ns=$(( limite_ns - $(date +%s%N) ))
  [ "$resta_ns" -gt 0 ] || resta_ns=0
  flock -w "$((resta_ns / 1000000000)).$(printf '%03d' $(( resta_ns / 1000000 % 1000 )))" 9 || barrar
fi
fila_sair
: > /proc/self/fd/9
printf 'pid %s desde %s\n' "$$" "$(date +%H:%M:%S)" >&9
# No modo --suite a suíte toma o lugar do hook (exec) e herda a trava: morre a suíte, solta a trava.
if [ "$modo_suite" = 1 ]; then
  if [ -f scripts/suite-paralela.py ]; then
    FORGE_SUITE_TRAVA="$trava" exec python3 scripts/suite-paralela.py
  fi
  exec python3 -m unittest discover -s tests -q
fi
# Push que só acrescenta pareceres sobre código que já passou na suíte roda só as classes de teste que leem
# pareceres (as que varrem ou conferem os pareceres; o gate do CI usa um subconjunto próprio); o CI repete tudo. A prova é a árvore verde: depois de cada suíte
# verde com a árvore de trabalho limpa, a árvore testada é anotada ao lado da trava, fora do git. Falha fechada:
# mais de uma ref, ref que não é branch, ref nova, árvore suja ou diferente do commit enviado, prova ausente,
# delta ilegível ou qualquer arquivo fora de docs/{reviews,security,qa,devops}/ rodam a suíte inteira. Também
# rodam a suíte inteira os modelos (arquivo cujo nome começa em "_") e docs/security/{ameacas,aceites}/, que
# a suíte lê com outras regras que não as das classes curtas. A classe NeutralidadeDoNucleo entra no caminho
# curto porque varre docs/security e docs/devops. A árvore anotada é a do início da suíte, não a do fim.
arvore_inicio="$(git rev-parse --verify -q 'HEAD^{tree}' 2>/dev/null || true)"
[ -z "$(git status --porcelain --untracked-files=all 2>/dev/null)" ] && inicio_limpo=1 || inicio_limpo=0
verde="${trava%.lock}.verde"
so_parecer() {
  local arvore_remota delta arquivo
  [ "$n_refs" -eq 1 ] || return 1
  case "$unico_ref" in refs/heads/*) ;; *) return 1 ;; esac
  case "$unico_local" in ''|*[!0-9a-f]*) return 1 ;; esac
  case "$unico_local" in *[!0]*) ;; *) return 1 ;; esac
  case "$unico_remoto" in ''|*[!0-9a-f]*) return 1 ;; esac
  case "$unico_remoto" in *[!0]*) ;; *) return 1 ;; esac
  [ -f "$verde" ] && [ ! -L "$verde" ] && [ -O "$verde" ] || return 1
  [ "$(git rev-parse HEAD 2>/dev/null)" = "$unico_local" ] || return 1
  [ -z "$(git status --porcelain --untracked-files=all 2>/dev/null)" ] || return 1
  arvore_remota="$(git rev-parse --verify -q "${unico_remoto}^{tree}" 2>/dev/null)" || return 1
  [ -n "$arvore_remota" ] || return 1
  grep -qxF -- "$arvore_remota" "$verde" || return 1
  # Apagar ou renomear (o rename aparece como D mais A, por --no-renames) não é "só acrescentar".
  [ -z "$(git -c core.quotepath=false diff --diff-filter=D --name-only --no-renames "$unico_remoto" "$unico_local" 2>/dev/null)" ] || return 1
  delta="$(git -c core.quotepath=false diff --name-only --no-renames "$unico_remoto" "$unico_local" 2>/dev/null)" || return 1
  while IFS= read -r arquivo; do
    case "$arquivo" in
      */_*|docs/security/ameacas/*|docs/security/aceites/*) return 1 ;;
      docs/reviews/*|docs/security/*|docs/qa/*|docs/devops/*) ;;
      *) return 1 ;;
    esac
  done <<< "$delta"
  return 0
}
if so_parecer; then
  echo "pre-push: o envio só acrescenta pareceres sobre código já testado; rodando só as classes que leem pareceres (o CI repete tudo)." >&2
  suite=(python3 -m unittest tests.test_forge.Neutralidade tests.test_forge.Referencias tests.test_forge.AntiDuplicacao tests.test_forge.NeutralidadeDoNucleo -q)
elif [ -f scripts/suite-paralela.py ]; then
  # D4: a suíte inteira dividida em processos, com a guarda de completude contra o discover (R-TETO: uma por vez).
  suite=(env FORGE_SUITE_TRAVA="$trava" python3 scripts/suite-paralela.py)
else
  # Árvore sem o script (repositório mínimo): a mesma suíte em série, mais lenta e nunca mais frouxa.
  suite=(python3 -m unittest discover -s tests -q)
fi
# PREPUSH-PKILL-ALHEIO: parar a suíte é parar só esta execução. A suíte roda como filho deste hook; TERM, INT ou HUP
# no hook encerram só esse filho (que encerra os grupos dos próprios processos) e esperam por ele antes de a trava
# soltar. Parar reprova o envio e não anota prova. Nunca `pkill -f`: o padrão casa com a suíte de outro agente.
suite_pid=""
parar() {
  trap '' TERM INT HUP
  if [ -n "$suite_pid" ]; then kill -TERM "$suite_pid" 2>/dev/null; wait "$suite_pid" 2>/dev/null; fi
  echo "pre-push: suíte interrompida (pid ${$}); só esta execução parou, o envio foi barrado e nenhuma prova foi anotada." >&2
  exit 1
}
trap parar TERM INT HUP
echo "pre-push: suíte do Forge no pid ${$}; para parar só esta execução: kill ${$} (nunca pkill -f, que derruba a suíte de outro agente)." >&2
"${suite[@]}" 9>&- >&2 &
suite_pid=$!
rc=0
wait "$suite_pid" || rc=$?
trap - TERM INT HUP
[ "$rc" -eq 0 ] || { echo "pre-push: testes do Forge falharam." >&2; exit 1; }
# Anota a árvore testada (só se a árvore de trabalho estava limpa no início e no fim e o HEAD^{tree}
# não mudou durante a suíte, para valer a do commit) como prova do próximo push.
arvore_fim="$(git rev-parse --verify -q 'HEAD^{tree}' 2>/dev/null || true)"
if [ "$inicio_limpo" = 1 ] && [ "$arvore_fim" = "$arvore_inicio" ] && [ -z "$(git status --porcelain --untracked-files=all 2>/dev/null)" ] && [ ! -L "$verde" ]; then
  arvore_testada="$arvore_inicio"
  if [ -n "$arvore_testada" ]; then
    { (umask 077; tail -n 199 "$verde" 2>/dev/null || true; printf '%s\n' "$arvore_testada") > "${verde}.novo" \
      && mv -f "${verde}.novo" "$verde"; } 2>/dev/null || true
  fi
fi
exit 0
