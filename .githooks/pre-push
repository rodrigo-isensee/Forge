#!/usr/bin/env bash
# Forge: a main só muda por pull request validado e mesclado pelo usuário.
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: envio para a main bloqueado. Abra um pull request; o usuário valida e faz o merge." >&2
    exit 1
  fi
done
# Testes estruturais (rápidos, só biblioteca padrão); o CI repete tudo.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 -m unittest discover -s tests -q >&2 || { echo "pre-push: testes do Forge falharam." >&2; exit 1; }
exit 0
