 sys.exit(falhas)
 '
+# PORTAO-D2 (portão de entrega do autor, estudo determinístico de 24/11, E173.2): o teto H1 e o texto do PR, com as regras da
+# árvore (bin/forge-check, bin/forge_tamanho.py e o passo pr-texto de tests/catraca.py), sem regra nova. Sem PR aberto da branch, o
+# teto só avisa (o corpo nasce depois); com ele, o corpo sem `teto: excedido` acima do teto e o pr-texto reprovado barram. Sem gh,
+# sem rede ou ferramenta ilegível: aviso e saída 0 (o CI confere). Argumentos: a base comum com a develop e a branch.
+PORTAO_D2_PY='import importlib.machinery, importlib.util, os, subprocess, sys
+ancora, branch = sys.argv[1:3]
+sys.path.insert(0, "bin")
+try:
+    carregador = importlib.machinery.SourceFileLoader("forge_check_d2", "bin/forge-check")
+    fc = importlib.util.module_from_spec(importlib.util.spec_from_loader(carregador.name, carregador))
+    carregador.exec_module(fc)
+    import forge_tamanho
+except Exception as erro:
+    print(f"pre-push: aviso: teto e texto do PR não conferidos ({type(erro).__name__} ao ler bin/forge-check); o CI confere.", file=sys.stderr)
+    sys.exit(0)
+numstat = fc.contagens_do_intervalo(".", ancora, "HEAD", estrito=True)
+if numstat is None:
+    print("pre-push: aviso: o git não leu o diff --numstat; teto e texto do PR não conferidos (o CI confere).", file=sys.stderr)
+    sys.exit(0)
+total = forge_tamanho.linhas_de_codigo(numstat, fc.e_codigo)
+if aviso := forge_tamanho.aviso_de_linhas(total):
+    print(f"pre-push: {aviso}", file=sys.stderr)
+pr, motivo = fc.pr_da_branch(".", branch, corpo=True)
+if pr is None:
+    print(f"pre-push: aviso: PR de {branch} não verificável ({motivo}); teto e texto do PR ficam para o CI.", file=sys.stderr)
+    sys.exit(0)
+if pr.get("state") != "OPEN":
+    sys.exit(0)
+numero, corpo = pr["number"], pr["body"]
+falhas = [f for f in [forge_tamanho.falta_de_motivo(total, corpo, numero)] if f]
+for f in falhas:
+    print(f"pre-push: {f}", file=sys.stderr)
+r = subprocess.run([sys.executable, "-I", "tests/catraca.py", "--modo", "pr-texto", "--base", ancora], capture_output=True,
+                   text=True, env=dict(os.environ, PR_BODY=corpo), stdin=subprocess.DEVNULL)
+if r.returncode == 1:
+    sys.stderr.write(r.stdout)
+    print(f"pre-push: texto do PR #{numero} reprovado pelo pr-texto da catraca (o CI reprova igual); corrija o corpo do PR.", file=sys.stderr)
+    falhas.append("pr-texto")
+elif r.returncode:
+    print(f"pre-push: aviso: o pr-texto da catraca não conferiu o PR (saída {r.returncode}); o CI confere.", file=sys.stderr)
+sys.exit(1 if falhas else 0)
+'
+# PORTAO-D2: o envio só de parecer (todo ref enviado já existe no remoto e o delta só toca docs/{reviews,qa,security,devops}/,
+# a fronteira do so_parecer) não é barrado pelo portão D2, só avisado: o revisor envia o parecer que reprova o corpo ou o
+# tamanho, e o autor corrige na volta (R-REVIEW). Código 0: só avisar; 1: barrar.
+d2_so_avisa() {
+  local envio ponta remoto delta
+  for envio in "${envios[@]}"; do
+    read -r ponta remoto _ <<< "$envio"
+    # Ref nova (remoto zero), sha remoto que o git não tem ou delta vazio: o delta sai vazio, a linha vazia fica fora da fronteira e barra.
+    delta="$(git -c core.quotepath=false diff --name-only --no-renames "$remoto" "$ponta" -- 2>/dev/null)"
+    if printf '%s\n' "$delta" | grep -qvE '^docs/(reviews|qa|security|devops)/'; then return 1; fi
+  done
+  echo "pre-push: aviso: envio só de parecer (docs/reviews, qa, security ou devops): o portão D2 só avisa; o autor corrige na volta (R-REVIEW)." >&2
+}
