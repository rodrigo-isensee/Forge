+      echo "pre-push: docs/indice-forge.md fora de dia (o CI reprova igual); rode python3 scripts/indice-forge.py e commite." >&2
+      d2_so_avisa || falhas=1
+    elif [ "$rc" -ne 0 ]; then
+      echo "pre-push: aviso: scripts/indice-forge.py --conferir não conferiu (saída ${rc}); o CI confere." >&2
+    fi
+  fi
+  # PORTAO-D2: teto H1 e texto do PR da branch do HEAD (PORTAO_D2_PY, acima).
+  if [ -n "$base_dev" ] && [ -f bin/forge-check ] && [ ! -L bin/forge-check ] && [ -f tests/catraca.py ] && [ ! -L tests/catraca.py ]; then
+    for envio in "${envios[@]}"; do
+      read -r ponta _ ref <<< "$envio"
+      case "$ref" in refs/heads/?*) ;; *) continue ;; esac
+      [ "$ponta" = "$(git rev-parse HEAD 2>/dev/null)" ] || continue
+      ancora="$(git merge-base "$base_dev" HEAD 2>/dev/null)" || break
+      python3 -I -c "$PORTAO_D2_PY" "$ancora" "${ref#refs/heads/}" || { echo "pre-push: teto ou texto do PR reprovado (o CI reprova igual)." >&2; d2_so_avisa || falhas=1; }
+      break
+    done
+  fi
   return "$falhas"
 }
