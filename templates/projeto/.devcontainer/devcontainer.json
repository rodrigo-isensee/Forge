// Modelo de projeto (E2.54): o container recriado volta pronto sozinho. Só /workspaces e ~/.claude sobrevivem à recriação;
// a cada início o postStartCommand refaz gh, o link ~/.forge-contrib para /workspaces/.forge-contrib e o core.hooksPath
// (idempotente, nunca apaga dados); o login do gh sobrevive em ~/.claude/gh. Roda como root e fora do sandbox, então NÃO
// executa o script do work tree (o agente o edita) nem lê ref local (gravável pelo agente): faz um clone raso novo da main
// num diretório temporário, com a URL do .git/config (protegido), e roda o script de lá. Antes do primeiro merge do script
// na main, rode uma vez `bash .devcontainer/preparar-ambiente.sh`. Nenhum segredo, e o GH_TOKEN da máquina do dono não entra
// no container (login do dono: gh auth login -s repo,workflow --web). shutdownAction none: fechar o VS Code não para o container,
// então o tmux com o Jarvis segue vivo (em Codespaces a chave é ignorada). Ajuste a imagem à stack do projeto.
{
  "name": "{{PROJETO}}",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "root",
  "shutdownAction": "none",
  "mounts": [
    "source=forge-claude,target=/root/.claude,type=volume"
  ],
  "postStartCommand": "d=$(mktemp -d) && u=$(git -c safe.directory='*' -C \"${containerWorkspaceFolder}\" config --get remote.origin.url) && GH_CONFIG_DIR=/root/.claude/gh git -c 'credential.helper=!gh auth git-credential' clone -q --depth 1 --branch main --single-branch -- \"$u\" \"$d/r\" && [ -s \"$d/r/.devcontainer/preparar-ambiente.sh\" ] && FORGE_PROJETO=\"${containerWorkspaceFolder}\" bash \"$d/r/.devcontainer/preparar-ambiente.sh\" < /dev/null; rm -rf \"$d\"; true"
}
