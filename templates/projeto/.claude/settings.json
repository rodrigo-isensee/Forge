{
  "agent": "forge:jarvis",
  "extraKnownMarketplaces": {
    "forge": {
      "source": { "source": "github", "repo": "rodrigo-isensee/Forge" },
      "autoUpdate": false
    }
  },
  "enabledPlugins": { "forge@forge": true },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git * --no-verify*)",
      "Bash(git config * core.hooksPath*)"
    ],
    "ask": ["Bash(gh pr merge*)", "Bash(gh api * -X PUT*)"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/.claude/gh",
        "~/.git-credentials"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "codeload.github.com",
        "uploads.github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "nodejs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "playwright.azureedge.net",
        "playwright.download.prss.microsoft.com",
        "cdn.playwright.dev"
      ],
      "deniedDomains": [
        "api.anthropic.com",
        "*.anthropic.com",
        "api.openai.com",
        "*.openai.com",
        "generativelanguage.googleapis.com"
      ]
    }
  }
}
