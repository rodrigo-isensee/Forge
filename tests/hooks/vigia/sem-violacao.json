{
  "descricao": "Nada mudou desde o SessionStart: sem saída e sem violacoes.jsonl.",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "passos": [
    {
      "gravar": {
        "{tmp}/t.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        "{tmp}/t.jsonl": [
          "{\"type\": \"assistant\", \"message\": {\"content\": [{\"type\": \"tool_use\", \"id\": \"a\", \"name\": \"Bash\", \"input\": {\"command\": \"ls\"}}]}}",
          "{\"type\": \"user\", \"message\": {\"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"a\", \"is_error\": false, \"content\": \"ok\"}]}}"
        ]
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "sem_arquivo": [
      "violacoes.jsonl"
    ]
  }
}

