{
  "descricao": "AV3 etapa 1: no Stop, a transcrição principal é da sessão que roda com --agent: o papel vem do agent_type dela.",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "passos": [
    {
      "gravar": {
        "{tmp}/t.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        "{tmp}/t.jsonl": "{\"type\": \"assistant\", \"message\": {\"content\": [{\"type\": \"tool_use\", \"id\": \"m1\", \"name\": \"Bash\", \"input\": {\"command\": \"gh pr create --draft\"}}]}}\n"
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "agent_type": "forge:qa-engineer",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "estado": {
      "comandos.jsonl": {
        "contem": [
          "\"agente\": \"forge:qa-engineer\", \"papel\": \"qa\", \"forma\": \"gh pr create\", \"barrado\": null"
        ]
      }
    }
  }
}
