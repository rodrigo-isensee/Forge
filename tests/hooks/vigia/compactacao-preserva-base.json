{
  "descricao": "Compactação (SessionStart `compact`) no meio da tarefa não zera a base: a mudança de antes dela ainda é avisada.",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "passos": [
    {
      "gravar": {
        "{tmp}/t.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        ".githooks/pre-push": "exit 0\n"
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "compact",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "saida": "mudança(s) — em-vigor: .githooks/pre-push alterado"
  }
}
