{
  "descricao": "O Stop seguinte, sem linha nova, não reavisa a lista já conferida (saída vazia; mesmo deslocamento do contorno).",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "passos": [
    {
      "gravar": {
        "{tmp}/t.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        "{tmp}/t.jsonl": [
          "{\"type\": \"user\", \"uuid\": \"m1\", \"message\": {\"role\": \"user\", \"content\": \"Anota isso:\\n- banana azul\\n- laranja\\n3. maca verde\\n\"}}"
        ]
      }
    },
    {
      "entrada": {
        "hook_event_name": "Stop",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "estado": {"violacoes.jsonl": {"contem": ["itens=3"]}}
  }
}
