{
  "descricao": "O mesmo arquivo em vigor alterado em dois turnos: dois avisos (a identidade é o evento, não o texto).",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "passos": [
    {
      "gravar": {
        "{tmp}/t.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        ".githooks/pre-push": "exit 0\n"
      }
    },
    {
      "entrada": {
        "hook_event_name": "Stop",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        ".githooks/pre-push": "exit 1\n"
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "saida": "em-vigor: .githooks/pre-push alterado"
  }
}
