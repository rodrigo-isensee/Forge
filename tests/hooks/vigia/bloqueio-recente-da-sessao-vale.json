{
  "descricao": "Controle: o mesmo bloqueio, da mesma sessão e recente, vale.",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "estado": {
    "vigia.json": {
      "transcricoes": {
        "{tmp}/t.jsonl": 0
      },
      "bloqueios": [
        {
          "alvo": [
            "main"
          ],
          "nome": "Bash",
          "sub": "push",
          "verbos": [],
          "regra": "R-MAIN",
          "sessao": "s1",
          "em": "{agora-10}"
        }
      ]
    }
  },
  "passos": [
    {
      "anexar": {
        "{tmp}/t.jsonl": [
          "{\"type\": \"assistant\", \"message\": {\"content\": [{\"type\": \"tool_use\", \"id\": \"b\", \"name\": \"Bash\", \"input\": {\"command\": \"git -C . push origin HEAD:main\"}}]}}",
          "{\"type\": \"user\", \"message\": {\"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"b\", \"is_error\": false, \"content\": \"ok\"}]}}"
        ]
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "saida": "contorno: Bash em main"
  }
}
