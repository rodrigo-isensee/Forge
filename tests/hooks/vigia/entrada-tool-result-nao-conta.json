{
  "descricao": "Resultado de ferramenta com 3 itens de lista não é texto do dono: silêncio.",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "passos": [
    {
      "gravar": {
        "{tmp}/t.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        "{tmp}/t.jsonl": [
          "{\"type\": \"user\", \"uuid\": \"m1\", \"message\": {\"role\": \"user\", \"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"a\", \"content\": \"- um\\n- dois\\n- tres\\n\"}]}}"
        ]
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "sem_arquivo": [
      "violacoes.jsonl"
    ]
  }
}
