{
  "descricao": "Depois de um `git rm .forge/versao` o vigia não fica mudo: o SessionStart marcou a sessão e o Stop avisa o usuário.",
  "arquivos": {
    ".githooks/pre-push": "#!/bin/sh\n",
    "src/app.js": "v1\n",
    "docs/nota.md": "n\n"
  },
  "env": {
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "passos": [
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1"
      }
    },
    {
      "remover": [
        ".forge/versao"
      ]
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1"
  },
  "esperado": {
    "codigo": 0,
    "saida": "versao-sumiu",
    "estado": {
      "violacoes.jsonl": {
        "contem": [
          "versao-sumiu"
        ]
      }
    }
  }
}
