{
  "descricao": "Lista de 3 itens e Bash que escreve em docs/kanban/: silêncio.",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "passos": [
    {
      "gravar": {
        "{tmp}/t.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        "{tmp}/t.jsonl": [
          "{\"type\": \"user\", \"uuid\": \"m1\", \"message\": {\"role\": \"user\", \"content\": \"Anota isso:\\n- banana azul\\n- laranja\\n3. maca verde\\n\"}}",
          "{\"type\": \"assistant\", \"message\": {\"content\": [{\"type\": \"tool_use\", \"id\": \"a\", \"name\": \"Bash\", \"input\": {\"command\": \"echo item >> docs/kanban/quadro.md\"}}]}}"
        ]
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "sem_arquivo": [
      "violacoes.jsonl"
    ]
  }
}
