{
  "descricao": "Um SubagentStop entre a lista e o Stop não esconde a mensagem do dono: o Stop avisa.",
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "passos": [
    {
      "gravar": {
        "{tmp}/t.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "transcript_path": "{tmp}/t.jsonl"
      }
    },
    {
      "anexar": {
        "{tmp}/t.jsonl": [
          "{\"type\": \"user\", \"uuid\": \"m1\", \"message\": {\"role\": \"user\", \"content\": \"Anota:\\n- a\\n- b\\n- c\\n\"}}"
        ]
      }
    },
    {
      "gravar": {
        "{tmp}/a.jsonl": ""
      }
    },
    {
      "entrada": {
        "hook_event_name": "SubagentStop",
        "session_id": "s1",
        "agent_type": "forge:dev",
        "transcript_path": "{tmp}/t.jsonl",
        "agent_transcript_path": "{tmp}/a.jsonl"
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl"
  },
  "esperado": {
    "codigo": 0,
    "saida": "a lista do turno não foi gravada em docs/pedidos/",
    "estado": {
      "violacoes.jsonl": {
        "contem": [
          "itens=3"
        ]
      }
    }
  }
}
