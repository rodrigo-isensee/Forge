{
  "descricao": "Achado D, cadeia 4: na worktree, o arquivo `.git` com `gitdir:` falso (a marca não se consulta) com o `.forge/versao` fora: falha fechado e o vigia avisa no Stop.",
  "arquivos": {
    ".githooks/pre-push": "#!/bin/sh\n",
    "src/app.js": "v1\n",
    "docs/nota.md": "n\n"
  },
  "env": {
    "CLAUDE_PROJECT_DIR": "{tmp}/wt"
  },
  "passos": [
    {
      "entrada": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1"
      }
    },
    {
      "remover": [
        "../wt/.forge/versao"
      ]
    },
    {
      "gravar": {
        "../wt/.git": "gitdir: /nada\n"
      }
    }
  ],
  "entrada": {
    "hook_event_name": "Stop",
    "session_id": "s1"
  },
  "esperado": {
    "codigo": 0,
    "saida": "versao-sumiu"
  },
  "git": [
    {
      "worktree": "wt",
      "branch": "melhoria/w"
    }
  ]
}
