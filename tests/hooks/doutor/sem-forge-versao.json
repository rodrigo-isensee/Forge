{
  "descricao": "Projeto sem .forge/versao: o doutor não age (nem cria .forge/run).",
  "forge": false,
  "arquivos": {
    ".claude/settings.json": "{}\n",
    ".githooks/pre-push": "#!/bin/sh\n"
  },
  "entrada": {
    "hook_event_name": "SessionStart",
    "session_id": "s1",
    "transcript_path": "{tmp}/t.jsonl",
    "source": "startup"
  },
  "esperado": {
    "codigo": 0,
    "sem_run": true
  }
}