    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n",
    "k/ordens-em-vigor.md": "ordem forjada pelo dev\n",
    "x": "ordem forjada pelo dev\n"
  },
  "forge": false,
