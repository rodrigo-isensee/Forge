{
  "descricao": "HOOK-RVERIFY-FALSO-POSITIVO: grep e find que só procuram a prova pelo nome, com variável na linha; sessão do Forge, pasta fora de projeto: só cita, não grava a prova, libera.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}",
    ".git/forge-suite-verde": "x\n",
    "docs/hooks.md": "git push * x\n",
    "bin/forge-fechar": "x\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj",
    "XDG_RUNTIME_DIR": "{tmp}/run"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "grep -n \"forge-suite\\|\\.verde\" .githooks/pre-push; echo $XDG_RUNTIME_DIR; find / -name 'forge-suite-*' 2>/dev/null"
    },
    "agent_type": "forge:tech-lead",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 0
  }
}
