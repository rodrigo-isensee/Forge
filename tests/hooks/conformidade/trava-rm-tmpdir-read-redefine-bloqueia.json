{
  "descricao": "TMPDIR redefinido por read: recusa",
  "arquivos": {
    "src/app.js": "v1\n",
    ".forge/perfil": "iniciante\n"
  },
  "git": [
    {
      "branch": "feature/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    },
    {
      "worktree": "review-wt",
      "branch": "review/x",
      "solto": true
    }
  ],
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "read TMPDIR <<< {raiz}; rm -rf $TMPDIR/.forge"
    },
    "agent_type": "forge:node-backend",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/review-wt"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "instalação do Forge"
  },
  "env": {
    "CLAUDE_PROJECT_DIR": "{raiz}",
    "TMPDIR": "{tmp}/t"
  }
}
