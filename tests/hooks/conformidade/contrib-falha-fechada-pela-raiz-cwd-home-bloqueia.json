{
  "descricao": "Sessão de projeto com cwd em ~: erro interno diante de push bloqueia.",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "cd ; git push origin HEAD"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONFORMIDADE: erro interno",
    "erros_log": "conformidade"
  },
  "repos": {
    "home/Forge": {
      "arquivos": {
        ".claude-plugin/plugin.json": "{\"name\": \"forge\"}"
      },
      "remotos": {
        "origin": "https://github.com/rodrigo-isensee/Forge.git"
      }
    }
  }
}
