{
  "descricao": "Sessão de projeto com cwd no ~/Forge: tirar rótulo bloqueia.",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "repos": {
    "home/Forge": {
      "arquivos": {
        ".claude-plugin/plugin.json": "{\"name\": \"forge\"}"
      },
      "remotos": {
        "origin": "https://github.com/rodrigo-isensee/Forge.git"
      }
    }
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "gh pr edit 70 --remove-label afrouxa-regra"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home/Forge"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONTRIB: gh pr edit"
  }
}
