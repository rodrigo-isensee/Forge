{
  "descricao": "Sessão do Forge, pasta corrente fora de projeto: AQ barrado em ~/.forge-contrib/docs/pedidos/.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Write",
    "tool_input": {
      "file_path": "{tmp}/home/.forge-contrib/docs/pedidos/x.md",
      "content": "x\n"
    },
    "agent_type": "forge-dev:aq",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "o papel aq escreve só em"
  }
}
