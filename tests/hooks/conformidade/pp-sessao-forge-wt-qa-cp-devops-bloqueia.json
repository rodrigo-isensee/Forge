{
  "descricao": "PARECER-PELO-PAPEL (v0478 E50.7, A3 da segurança; R-CONFORMIDADE): sessão do Forge, worktree em wt/*, qa copia para docs/devops/ pelo Bash `cp`.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "cp a.txt docs/devops/x.md"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home/.forge-contrib/wt/x",
    "agent_type": "forge:qa-engineer"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "parecer de devops é do devops: docs/devops/"
  },
  "repos": {
    "home/.forge-contrib/wt/x": {
      "arquivos": {
        "a.txt": "v\n",
        "docs/devops/x.md": "v\n",
        ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
      },
      "branch": "melhoria/x"
    }
  }
}
