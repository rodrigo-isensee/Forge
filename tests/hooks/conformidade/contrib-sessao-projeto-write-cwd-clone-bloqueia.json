{
  "descricao": "Sessão de projeto com cwd no clone: Write no .claude/ do projeto bloqueia.",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Write",
    "tool_input": {
      "file_path": "{tmp}/proj/.claude/settings.json",
      "content": "x\n"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "agent_type": "forge:dev",
    "cwd": "{tmp}/home/.forge-contrib/proj"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONFORMIDADE"
  }
}
