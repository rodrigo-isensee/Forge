{
  "descricao": "HOOK-NAO-PROTEGE-RAIZ-DO-FORGE (v0481 E37.1, volta 1; R-CONFORMIDADE): o corpo do heredoc do python3 grava .git/hooks/ da raiz.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n",
    ".githooks/pre-push": "#!/bin/sh\n",
    ".githooks/commit-msg": "#!/bin/sh\n",
    ".devcontainer/devcontainer.json": "{}\n",
    "scripts/x.sh": "#!/bin/sh\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "python3 - <<'EOF'\nopen('.git/hooks/pre-commit','w').write('x')\nEOF"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/proj",
    "agent_type": "forge:devops-engineer"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "hooks do git (.git/hooks/)"
  }
