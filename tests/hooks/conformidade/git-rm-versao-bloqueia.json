{
  "descricao": "`git rm .forge/versao` desligaria todos os hooks: barrado como o `rm`.",
  "arquivos": {
    ".githooks/pre-push": "#!/bin/sh\n",
    "src/app.js": "v1\n",
    "docs/nota.md": "n\n"
  },
  "env": {
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "git rm -q .forge/versao"
    },
    "agent_type": "forge:dev",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 2,
    "stderr": ".forge/versao"
  }
}
