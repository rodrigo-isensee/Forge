{
  "descricao": "Sessão de projeto com cwd numa pasta qualquer: gh pr merge -R do Forge bloqueia.",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "gh pr merge 70 -R rodrigo-isensee/Forge"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/outra"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONTRIB: gh pr merge"
  }
}
