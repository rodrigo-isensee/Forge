{
  "descricao": "`git clean -fdX` apaga os arquivos ignorados (`.forge/run/`) e não a marca, que fica no `.git/`; com o `.forge/versao` sumido, a ação crítica falha fechado.",
  "arquivos": {
    ".githooks/pre-push": "#!/bin/sh\n",
    "src/app.js": "v1\n",
    "docs/nota.md": "n\n"
  },
  "env": {
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "passos": [
    {
      "gravar": {
        ".git/forge/projeto": "2026-10-17T00:00:00\n"
      }
    },
    {
      "git": [
        "clean",
        "-fdX"
      ]
    },
    {
      "remover": [
        ".forge/versao"
      ]
    }
  ],
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "git push origin HEAD:melhoria/x"
    },
    "agent_type": "forge:dev",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "sumiu"
  }
}
