{
  "descricao": "B4: worktree sem Forge aberta por link simbólico (`CLAUDE_PROJECT_DIR` e cwd passam pelo link): o `.git` se resolve (caminho real dos dois lados) e `gh pr merge` não falha fechado por engano.",
  "arquivos": {
    ".githooks/pre-push": "#!/bin/sh\n",
    "src/app.js": "v1\n",
    "docs/nota.md": "n\n"
  },
  "forge": false,
  "links": {
    "../lnk": "{tmp}/wt"
  },
  "env": {
    "CLAUDE_PROJECT_DIR": "{tmp}/lnk"
  },
  "git": [
    {
      "worktree": "wt",
      "branch": "melhoria/w"
    }
  ],
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "gh pr merge 1"
    },
    "agent_type": "forge:dev",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/lnk"
  },
  "esperado": {
    "codigo": 0
  }
}
