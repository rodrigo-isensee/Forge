{
  "descricao": "PARECER-PELO-PAPEL (v0478 E50.7, A3 da segurança; R-CONFORMIDADE): sessão do Forge, worktree em wt/*, agente de stack (dev) grava docs/reviews/ pelo NotebookEdit.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "NotebookEdit",
    "tool_input": {
      "notebook_path": "{tmp}/home/.forge-contrib/wt/x/docs/reviews/x.ipynb",
      "new_source": "x"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home/.forge-contrib/wt/x",
    "agent_type": "forge-python:python-backend"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "parecer de review é do tech-lead: docs/reviews/"
  },
  "repos": {
    "home/.forge-contrib/wt/x": {
      "arquivos": {
        "a.txt": "v\n",
        "docs/reviews/x.md": "v\n",
        ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
      },
      "branch": "melhoria/x"
    }
  }
}
