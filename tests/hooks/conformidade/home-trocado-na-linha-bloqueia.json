{
  "descricao": "HOME=/tmp/x e cd / na linha não mudam o home da decisão: ~/.claude.json segue barrado (C-5 d).",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home"
  },
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "tool_name": "Bash",
    "tool_input": {
      "command": "HOME=/tmp/x cd / && echo x > {tmp}/home/.claude.json"
    },
    "agent_type": "forge:tech-lead"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "~/.claude.json"
  }
}
