{
  "descricao": "Rebase de branch já enviada pergunta mesmo em worktree temporária.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".forge/perfil": "iniciante\n"
  },
  "git": [
    {
      "branch": "feature/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    },
    {
      "worktree": "review-wt",
      "branch": "feature/y"
    },
    {
      "ref": "refs/remotes/origin/feature/x"
    }
  ],
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "git rebase origin/develop feature/x"
    },
    "agent_type": "forge:node-backend",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/review-wt"
  },
  "esperado": {
    "codigo": 0,
    "pergunta": "reescreve"
  }
}
