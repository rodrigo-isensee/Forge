{
  "descricao": "PARECER-PELO-PAPEL (v0478 E50.11, A5 da segurança; R-CONFORMIDADE): sessão do Forge, worktree em wt/*, o dono grava docs/security/ pela variável no alvo.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "f=docs/security/x.md; printf x > $f"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home/.forge-contrib/wt/x",
    "agent_type": "forge:security-engineer"
  },
  "esperado": {
    "codigo": 0
  },
  "repos": {
    "home/.forge-contrib/wt/x": {
      "arquivos": {
        "a.txt": "v\n",
        ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
      },
      "branch": "melhoria/x"
    }
  }
}
