{
  "descricao": "CONTROLE-PEDIDOS-E-BRIEFS-SO-JARVIS (v0478 E63.1; R-CONFORMIDADE): sessão do Forge, o jarvis grava docs/pedidos/ da pasta de controle (redireciona).",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n",
    "a.txt": "v\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "echo '- entrega conferida' >> ~/.forge-contrib/docs/pedidos/v1.md"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/proj",
    "agent_type": "forge:jarvis"
  },
  "esperado": {
    "codigo": 0
  },
  "repos": {
    "home/.forge-contrib": {
      "arquivos": {
        "docs/pedidos/v1.md": "# v1\n",
        "docs/briefs/b1.md": "b\n",
        "x/docs/pedidos/v2.md": "# v2\n"
      }
    }
  }
}
