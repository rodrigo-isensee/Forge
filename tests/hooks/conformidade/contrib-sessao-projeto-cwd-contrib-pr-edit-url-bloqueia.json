{
  "descricao": "Sessão de projeto com cwd em ~/.forge-contrib: tirar rótulo por URL bloqueia.",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "gh pr edit https://github.com/rodrigo-isensee/Forge/pull/70 --remove-label afrouxa-regra"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home/.forge-contrib"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONTRIB: gh pr edit"
  }
}
