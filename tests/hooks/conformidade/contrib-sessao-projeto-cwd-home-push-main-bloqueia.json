      "command": "git -C {tmp}/proj push origin main"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-MAIN: push direto para main"
  }
}
