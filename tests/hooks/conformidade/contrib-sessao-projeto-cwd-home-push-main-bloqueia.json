{
  "descricao": "Sessão de projeto com cwd em ~: push do projeto para a main bloqueia (R-MAIN).",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
