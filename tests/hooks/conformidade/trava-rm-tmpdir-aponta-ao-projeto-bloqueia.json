{
  "descricao": "$TMPDIR que aponta para o projeto: a pasta .forge continua protegida",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "git": [
    {
      "branch": "feature/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    }
  ],
  "env": {
    "CLAUDE_PROJECT_DIR": "{raiz}",
    "TMPDIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "rm -rf $TMPDIR/.forge"
    },
    "agent_type": "forge:node-backend",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONFORMIDADE: apagar"
  }
}
