{
  "descricao": "Sessão do Forge (raiz no ~/Forge) em wt/*: push alheio e merge liberam.",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/home/Forge"
  },
  "repos": {
    "home/Forge": {
      "arquivos": {
        ".claude-plugin/plugin.json": "{\"name\": \"forge\"}"
      },
      "remotos": {
        "origin": "https://github.com/rodrigo-isensee/Forge.git"
      }
    },
    "home/.forge-contrib/wt/x": {
      "arquivos": {
        ".claude-plugin/plugin.json": "{\"name\": \"forge\"}"
      },
      "remotos": {
        "origin": "https://github.com/rodrigo-isensee/Forge.git"
      }
    }
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "git push origin melhoria/outra && gh pr merge 70 --squash"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/home/.forge-contrib/wt/x"
  },
  "esperado": {
    "codigo": 0
  }
}
