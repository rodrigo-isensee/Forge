    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "passos": [
    {
      "gravar": {
        "{marca}": "2026-10-17T00:00:00\n"
      }
    },
    {
      "git": [
        "sparse-checkout",
        "set",
        "src"
      ]
    }
  ],
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "echo {tmp}/outro/.git > .git/commondir"
    },
    "agent_type": "forge:dev",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONFORMIDADE"
  }
