{
  "descricao": "ORDENS-SO-JARVIS (v0478 E123.10, A2 da segurança E123.8; R-CONFORMIDADE): projeto, o jarvis grava o arquivo da cópia principal com cwd na worktree.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".forge/ordens/ordens-em-vigor.md": "ordem do dono\n",
    "x": "ordem forjada\n"
  },
  "git": [
    {
      "worktree": "wt",
      "branch": "melhoria/x"
    }
  ],
  "env": {
