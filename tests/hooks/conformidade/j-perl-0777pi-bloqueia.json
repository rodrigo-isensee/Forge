{
  "descricao": "Achado J: `perl -0777pi` (opção numérica junto do `-i`) sobre arquivo em vigor dá bloqueio.",
  "arquivos": {
    ".githooks/pre-push": "#!/bin/sh\n",
    "src/app.js": "v1\n",
    "docs/nota.md": "n\n"
  },
  "env": {
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "perl -0777pi -e 's/^/x/' .githooks/pre-push"
    },
    "agent_type": "forge:dev",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONFORMIDADE"
  }
}
