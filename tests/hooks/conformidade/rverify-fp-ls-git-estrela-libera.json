{
  "descricao": "HOOK-RVERIFY-FALSO-POSITIVO: ls .git/* lista a pasta da prova sem gravar nada; sessão do Forge, pasta fora de projeto: só cita, não grava a prova, libera.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}",
    ".git/forge-suite-verde": "x\n",
    "docs/hooks.md": "git push * x\n",
    "bin/forge-fechar": "x\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj",
    "XDG_RUNTIME_DIR": "{tmp}/run"
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "ls $HOME/.forge-contrib; ls .git/*"
    },
    "agent_type": "forge:tech-lead",
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 0
  }
