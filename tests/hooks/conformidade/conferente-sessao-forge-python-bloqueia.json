{
  "descricao": "Sessão do Forge, pasta corrente fora de projeto: o conferente não roda a suíte (fora da lista do papel só de leitura).",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}"
