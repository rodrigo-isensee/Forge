{
  "descricao": "Sessão de projeto: repositório qualquer cujo remoto aponta para o Forge é o Forge (push alheio bloqueia).",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "repos": {
    "outra": {
      "remotos": {
        "origin": "https://github.com/rodrigo-isensee/Forge.git"
      }
    }
  },
  "entrada": {
    "tool_name": "Bash",
    "tool_input": {
      "command": "git -C {tmp}/outra push origin melhoria/outra"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-CONTRIB: push"
  }
}
