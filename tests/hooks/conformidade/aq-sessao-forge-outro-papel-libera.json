{
  "descricao": "Sessão do Forge, pasta corrente fora de projeto: outro papel segue sem guarda.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}"
