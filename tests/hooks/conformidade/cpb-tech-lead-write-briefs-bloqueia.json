{
  "descricao": "CONTROLE-PEDIDOS-E-BRIEFS-SO-JARVIS (v0478 E63.1; R-CONFORMIDADE): sessão do Forge, o papel tech-lead grava docs/briefs/ da pasta de controle (write).",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n",
    "a.txt": "v\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home",
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "tool_name": "Write",
    "tool_input": {
      "file_path": "{tmp}/home/.forge-contrib/docs/briefs/b1.md",
      "content": "entrega conferida x\n"
    },
    "hook_event_name": "PreToolUse",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/proj",
    "agent_type": "forge:tech-lead"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "o brief aprovado"
  },
  "repos": {
    "home/.forge-contrib": {
      "arquivos": {
        "docs/pedidos/v1.md": "# v1\n",
        "docs/briefs/b1.md": "b\n",
        "x/docs/pedidos/v2.md": "# v2\n"
      }
    }
  }
}
