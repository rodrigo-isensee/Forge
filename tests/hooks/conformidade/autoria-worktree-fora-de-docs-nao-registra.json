{
  "descricao": "Markdown fora de docs/<pasta de parecer>/ numa worktree irmã: nada a registrar.",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "git": [
    {
      "worktree": "wt-qa",
      "branch": "melhoria/x"
    }
  ],
  "passos": [
    {
      "gravar": {
        "{tmp}/wt-qa/notas/p1.md": "texto\n"
      }
    }
  ],
  "entrada": {
    "tool_name": "Write",
    "tool_input": {
      "file_path": "{tmp}/wt-qa/notas/p1.md"
    },
    "agent_type": "forge:qa-engineer",
    "hook_event_name": "PostToolUse",
    "tool_use_id": "toolu_9"
  },
  "esperado": {
    "codigo": 0,
    "sem_arquivo": [
      "autoria.jsonl"
    ]
  }
}
