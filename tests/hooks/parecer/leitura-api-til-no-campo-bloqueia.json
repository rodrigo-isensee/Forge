{
  "descricao": "GH-API-LEITURA-UNICA: em `query=@~/q` o bash não expande o `~` (vem depois de `=@`): o gh lê ./~/q e o hook lia o HOME; o `~` no começo do caminho recusa.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n",
    "casa/q.graphql": "query { viewer { login } }\n",
    "~/q.graphql": "mutation { markPullRequestReadyForReview(input: {pullRequestId: \"PR_1\"}) { clientMutationId } }\n"
  },
  "forge": false,
  "git": [
    {
      "branch": "melhoria/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    },
    {
      "config": {
        "branch.melhoria/x.gh-merge-base": "develop"
      }
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "gh api graphql -F query=@~/q.graphql"
    }
  },
  "esperado": {
    "codigo": 2,
    "stderr": "tirar o rascunho pela API"
  },
  "env": {
    "HOME": "{tmp}/proj/casa"
  }
