{
  "descricao": "HK3-PARECER, PR B, volta 1: o texto do sh -c segue por pipe a um shell que lê o stdin.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
