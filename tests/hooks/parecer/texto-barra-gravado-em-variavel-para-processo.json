{
  "descricao": "HOOK-TEXTO-COM-MERGE: a saída para >(sh) roda o corpo: segue barrado.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
      "worktree": "home/wtx",
      "branch": "melhoria/x"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "cat > \"$TMPDIR/x\" <<'EOF' 2> >(sh)\ngit merge develop\nEOF"
    },
    "cwd": "{raiz}"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-REVIEW"
  }
}
