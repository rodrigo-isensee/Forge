{
  "descricao": "HOOK-TEXTO-COM-MERGE: o corpo do python3 - é programa, não dado: segue na rede D (com o comando de PR lançado; o que só o cita libera por HOOK-CONTRIB-HEREDOC-FP).",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
      "worktree": "home/wtx",
      "branch": "melhoria/x"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "python3 - <<'EOF'\nimport subprocess\nsubprocess.run(['gh', 'pr', 'merge', '3'])\nEOF"
    },
    "cwd": "{raiz}"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-REVIEW: `python3"
  }
}
