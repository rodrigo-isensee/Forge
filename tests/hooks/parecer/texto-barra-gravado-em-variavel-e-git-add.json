{
  "descricao": "HOOK-TEXTO-COM-MERGE: o git depois do arquivo gravado segue barrado (o git roda ganchos e filtros: M3).",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
      "worktree": "home/wtx",
      "branch": "melhoria/x"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "cat > \"$TMPDIR/x.md\" <<'EOF'\ngit merge develop\nEOF\ngit add docs"
    },
    "cwd": "{raiz}"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "heredoc gravado"
  }
}
