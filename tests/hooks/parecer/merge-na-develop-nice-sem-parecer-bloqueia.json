{
  "descricao": "FURO-HOOK-A, A2: nice antes do git merge na develop sem parecer.",
  "arquivos": {
    "src/app.js": "v1\n"
  },
  "git": [
    {
      "branch": "feature/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    },
    {
      "checkout": "develop"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "nice git merge --no-ff -m x feature/x"
    }
  },
  "esperado": {
    "codigo": 2,
    "stderr": "`branch: feature/x`"
  }
}
