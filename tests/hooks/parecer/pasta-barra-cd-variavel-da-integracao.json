{
  "descricao": "HK3-PARECER, PR A (E1 e E3): a pasta do git é a do bash e a do git; a partir de uma worktree de trabalho, barra.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
      "worktree": "home/wtx",
      "branch": "melhoria/x"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "V={raiz}; cd $V && git merge melhoria/x"
    },
    "cwd": "{tmp}/home/wtx"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "nenhum parecer"
  }
}
