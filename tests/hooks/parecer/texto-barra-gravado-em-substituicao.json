{
  "descricao": "HOOK-TEXTO-COM-MERGE: $( ) no alvo do cat não é variável simples: segue na rede D.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
      "worktree": "home/wtx",
      "branch": "melhoria/x"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "cat > \"$(pwd)/x.md\" <<'EOF'\ngit merge develop\nEOF"
    },
    "cwd": "{raiz}"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-REVIEW"
  }
}
