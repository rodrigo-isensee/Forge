{
  "descricao": "Worktree de um clone do Forge (como em ~/.forge-contrib/wt/): gh pr create com review reprovado barra.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "git": [
    {
      "branch": "feature/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    },
    {
      "arquivos": {
        "docs/reviews/p1-1.md": [
          "---",
          "tipo: review",
          "contrato: 1",
          "pedido: p1",
          "branch: feature/y",
          "commit: {HEAD}",
          "parecer: reprovado",
          "revisor: forge:tech-lead",
          "data: 2026-10-15",
          "---",
          "# Review"
        ],
        "docs/qa/p1.md": [
          "---",
          "tipo: qa",
          "contrato: 1",
          "pedido: p1",
          "branch: feature/y",
          "commit: {HEAD}",
          "parecer: aprovado",
          "escopo: completo",
          "bugs_criticos: 0",
          "bugs_altos: 0",
          "bugs_medios: 0",
          "bugs_baixos: 0",
          "data: 2026-10-15",
          "---",
          "# QA"
        ]
      },
      "commit": "docs: pareceres"
    },
    {
      "worktree": "wt/aa",
      "branch": "feature/y"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "gh pr create --base develop --title 'feat: app' --body 'x'"
    },
    "cwd": "{tmp}/wt/aa"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "docs/reviews/p1-1.md"
  }
}
