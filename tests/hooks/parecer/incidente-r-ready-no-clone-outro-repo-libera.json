{
  "descricao": "INCIDENTE-HOOK-PARECER-CONTORNADO: dentro do clone, o -R segue como antes (com os pareceres, libera).",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "git": [
    {
      "branch": "feature/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    },
    {
      "arquivos": {
        "docs/reviews/p1-1.md": [
          "---",
          "tipo: review",
          "contrato: 1",
          "pedido: p1",
          "branch: feature/x",
          "commit: {HEAD}",
          "parecer: aprovado",
          "revisor: forge:tech-lead",
          "data: 2026-10-15",
          "---",
          "# Review"
        ],
        "docs/qa/p1.md": [
          "---",
          "tipo: qa",
          "contrato: 1",
          "pedido: p1",
          "branch: feature/x",
          "commit: {HEAD}",
          "parecer: aprovado",
          "escopo: completo",
          "bugs_criticos: 0",
          "bugs_altos: 0",
          "bugs_medios: 0",
          "bugs_baixos: 0",
          "data: 2026-10-15",
          "---",
          "# QA"
        ]
      },
      "commit": "docs: pareceres"
    },
    {
      "config": {
        "branch.feature/x.gh-merge-base": "develop",
        "remote.origin.url": "git@github.com:dono/forge.git"
      }
    }
  ],
  "env": {
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/proj",
    "tool_input": {
      "command": "gh pr ready -R dono/outro feature/x"
    }
  },
  "esperado": {
    "codigo": 0
  }
