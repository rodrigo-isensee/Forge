{
  "descricao": "PARECER-HOOK-DICA-EDIT: corpo com apóstrofo a programa que pode rodá-lo, com gh pr merge; segue barrado, e o contorno nomeia o Write ou Edit.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "git": [
    {
      "branch": "feature/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    },
    {
      "arquivos": {
        "docs/reviews/p1-1.md": [
          "---",
          "tipo: review",
          "contrato: 1",
          "pedido: p1",
          "branch: feature/x",
          "commit: {HEAD}",
          "parecer: aprovado",
          "revisor: forge:tech-lead",
          "data: 2026-10-15",
          "---",
          "# Review"
        ],
        "docs/qa/p1.md": [
          "---",
          "tipo: qa",
          "contrato: 1",
          "pedido: p1",
          "branch: feature/x",
          "commit: {HEAD}",
          "parecer: aprovado",
          "escopo: completo",
          "bugs_criticos: 0",
          "bugs_altos: 0",
          "bugs_medios: 0",
          "bugs_baixos: 0",
          "data: 2026-10-15",
          "---",
          "# QA"
        ]
      },
      "commit": "docs: pareceres"
    },
    {
      "config": {
        "branch.feature/x.gh-merge-base": "develop"
      }
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "kubectl apply -f - <<'EOF'\nkey: it's\nEOF\ngh pr merge feature/x --repo rodrigo-isensee/Forge --merge"
    }
  },
  "esperado": {
    "codigo": 2,
    "stderr": "Corrigir: grave o texto pelo Write ou Edit e passe-o ao programa noutra chamada do Bash"
  }
}
