{
  "descricao": "HK3-PARECER, PR A, volta 2: a crase entre apóstrofos não cola o merge numa palavra só; a pasta fica incerta e o merge recusa.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
      "worktree": "home/wtx",
      "branch": "melhoria/x"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "git -c 'x.y=`' merge melhoria/x"
    },
    "cwd": "{raiz}"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-REVIEW"
  }
}
