{
  "descricao": "HK3-PARECER, PR A, volta 2: cwd na integração: a expansão depois do subcomando não muda a pasta do git, que é a do cd literal.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
      "worktree": "home/wtx",
      "branch": "melhoria/x"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "cd {tmp}/home/wtx && git merge --ff-only -m \"$(date)\" melhoria/x"
    },
    "cwd": "{raiz}"
  },
  "esperado": {
    "codigo": 0
  }
}
