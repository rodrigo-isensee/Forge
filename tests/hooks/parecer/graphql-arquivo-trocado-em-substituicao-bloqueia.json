{
  "descricao": "GH-API-ARQUIVO-TROCADO (A4 da E3.4): a linha de fora roda outro comando e o gh vem numa substituição: recusa.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n",
    "m.txt": "mutation { markPullRequestReadyForReview(input: {pullRequestId: \"PR_1\"}) { clientMutationId } }\n",
    "l.graphql": "query { viewer { login } }\n"
  },
  "forge": false,
  "git": [
    {
      "branch": "feature/x"
    },
    {
      "arquivos": {
        "src/app.js": "v2\n"
      },
      "commit": "feat: muda o app"
    },
    {
      "config": {
        "branch.feature/x.gh-merge-base": "develop",
        "remote.origin.url": "git@github.com:dono/forge.git"
      }
    }
  ],
  "env": {
    "CLAUDE_PROJECT_DIR": "{tmp}/proj"
  },
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "cwd": "{tmp}/proj",
    "tool_input": {
      "command": "cp m.txt l.graphql; echo \"$(gh api graphql --field=query=@l.graphql)\""
    }
  },
  "esperado": {
    "codigo": 2,
    "stderr": "na mesma chamada de outro comando"
  }
}
