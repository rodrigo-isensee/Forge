{
  "descricao": "HK3-PARECER, PR A, volta 1: a pasta do git é a do bash e a do git; a partir de uma worktree de trabalho, barra.",
  "arquivos": {
    "src/app.js": "v1\n",
    ".claude-plugin/plugin.json": "{\"name\": \"forge\"}\n"
  },
  "forge": false,
  "env": {
    "HOME": "{tmp}/home"
  },
  "git": [
    {
      "worktree": "home/proj",
      "branch": "melhoria/x"
    }
  ],
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "export CDPATH={tmp}; cd proj && git merge melhoria/x"
    },
    "cwd": "{tmp}/home"
  },
  "esperado": {
    "codigo": 2,
    "stderr": "não resolve"
  }
}
