{
  "descricao": "PESADO-VERSOES-FORA-DA-FILA: o forge-testes --versoes roda os afetados em cada versão do Python e espera a vez da fila pesada.",
  "config": {
    "pesados": [
      "bin/forge-testes"
    ]
  },
  "estado": {
    "pesado.json": {
      "pid": "{pid_outro}",
      "comando": "bin/forge-testes --completa",
      "desde": "{agora-120}",
      "tool_use_id": "toolu_1"
    }
  },
  "entrada": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_9",
    "tool_input": {
      "command": "bin/forge-testes --base origin/develop --versoes"
    }
  },
  "esperado": {
    "codigo": 2,
    "stderr": "R-TETO"
  },
  "env": {
    "FORGE_PESADO_ESPERA_S": "0"
  }
}
