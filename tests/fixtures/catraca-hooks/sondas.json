    {"id": "S2", "troca": {"args": ["-s", "-E", "/dev/null", "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py"]}, "removidos": 1},
    {"id": "S3", "troca": {"command": "true"}, "removidos": 1},
    {"id": "S4", "troca": {"command": "echo", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py"]}, "removidos": 1},
    {"id": "A3", "troca": {"type": "prompt"}, "removidos": 1},
    {"id": "S5", "troca": {"args": ["-s", "-E", "-I", "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py"]}, "removidos": 1},
    {"id": "S5-P", "troca": {"args": ["-s", "-E", "-P", "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py"]}, "removidos": 1},
    {"id": "S6", "troca": {"args": ["-s", "-E", "-X", "pycache_prefix=p", "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py"]}, "removidos": 1},
    {"id": "S6-junto", "troca": {"args": ["-s", "-E", "-Xpycache_prefix=p", "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py"]}, "removidos": 1},
    {"id": "S6-W", "troca": {"args": ["-s", "-E", "-W", "error", "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py"]}, "removidos": 1},
