    {"id": "S7-ponto", "troca": {"command": "./python3"}, "removidos": 1},
    {"id": "A7", "troca": {"timeout": 1}, "removidos": 1},
    {"id": "shell-ou", "troca": {"args": ["-s", "-E", "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py", "||", "true"]}, "removidos": 1},
    {"id": "PR565", "troca": {"command": "/usr/bin/env python3", "args": ["-B", "-u", "-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py", "--modo", "x"]}, "removidos": 0}
  ]
}
