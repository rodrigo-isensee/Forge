{
  "fonte": "hooks/hooks.json real; parecer docs/security/v047-catraca-hook-por-script.md (e8499ce: S1 a S4 e A3; 97d58a7: S5 a S7 e A7)",
  "evento": "PreToolUse",
  "script": "${CLAUDE_PLUGIN_ROOT}/hooks/conformidade.py",
  "sondas": [
