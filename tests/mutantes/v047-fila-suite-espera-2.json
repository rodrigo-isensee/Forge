      "para": "{ [ ! -e \"$arq\" ] || [ -O \"$arq\" ]; } || return 0\n    { (umask 077; printf",
      "testes": [
        "tests.test_pre_push_fila.FilaDaSuite.test_registro_que_e_link_nao_e_seguido"
      ]
    },
    {
      "id": "F11",
      "guarda": "a espera pela trava (depois da vez na fila) é laço que confere a trava",
      "arquivo": ".githooks/pre-push",
      "de": "  while ! flock -n 9; do",
      "para": "  while false; do",
      "testes": [
        "tests.test_pre_push_fila.FilaDaSuite.test_dona_morta_avisa_uma_vez_e_nao_libera"
      ]
    },
    {
      "id": "F12",
      "guarda": "a espera pela trava respeita o FORGE_TRAVA_ESPERA",
      "arquivo": ".githooks/pre-push",
      "de": "\n    [ \"$(date +%s%N)\" -lt \"$limite_ns\" ] || barrar",
      "para": "\n    [ \"$(date +%s%N)\" -lt \"$((limite_ns + 30000000000))\" ] || barrar",
      "testes": [
        "tests.test_pre_push_fila.FilaDaSuite.test_barrado_registra_uma_linha_por_envio"
      ]
    },
    {
      "id": "F13",
      "guarda": "dona viva (o kill -0 acha o pid) não é dada como morta",
      "arquivo": ".githooks/pre-push",
      "de": "e=\"$(LC_ALL=C kill -0 \"$1\" 2>&1)\" && return 1",
      "para": "e=\"$(LC_ALL=C kill -0 \"$1\" 2>&1)\" && return 0",
      "testes": [
        "tests.test_pre_push_fila.FilaDaSuite.test_dona_viva_ou_de_outro_namespace_nao_avisa"
      ]
    },
    {
      "id": "F14",
      "guarda": "só o pid que o kill -0 não acha (No such process) é dona morta",
      "arquivo": ".githooks/pre-push",
      "de": "[[ \"$e\" == *\"No such process\"* ]]",
      "para": "[[ \"$e\" != *\"No such process\"* ]]",
      "testes": [
        "tests.test_pre_push_fila.FilaDaSuite.test_dona_morta_avisa_uma_vez_e_nao_libera"
      ]
    }
  ]
