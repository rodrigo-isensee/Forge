      "para": "true || echo",
      "testes": [
        "tests.test_fechar_orfao.Teste.test_c3_prune_negado_com_diretorio_ausente_imprime_prune_e_nao_remove"
      ]
    },
    {
      "id": "D1",
      "guarda": "só a versão maior na develop é atraso",
