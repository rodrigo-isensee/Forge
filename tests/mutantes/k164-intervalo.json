      "para": "split(\"-\")[0]) < int(",
      "testes": [
        "tests.test_forge.VoltaComRecomendacao.test_achado_com_intervalo_de_linhas_e_aceito_e_copiado_inteiro"
      ]
    },
    {
      "id": "M4",
      "guarda": "o intervalo malformado (3-) segue recusado",
      "arquivo": "bin/forge-check",
      "de": "(\\d+(?:-\\d+)?) · (.+?)",
      "para": "(\\d+(?:-\\d*)?) · (.+?)",
      "testes": [
        "tests.test_forge.VoltaComRecomendacao.test_intervalo_malformado_ou_invertido_e_recusado"
