{
  "pedido": "lote-m8-prepush",
  "executor": "unittest",
  "mutantes": [
    {
      "id": "M1",
      "guarda": "dirigido exige árvore de trabalho limpa",
      "arquivo": ".githooks/pre-push",
      "de": "  [ -f bin/forge-testes ] && [ ! -L bin/forge-testes ] || return 1\n  [ \"$(git rev-parse HEAD 2>/dev/null)\" = \"$unico_local\" ] || return 1\n  [ -z \"$(git status --porcelain --untracked-files=all 2>/dev/null)\" ] || return 1\n",
      "para": "  [ -f bin/forge-testes ] && [ ! -L bin/forge-testes ] || return 1\n  [ \"$(git rev-parse HEAD 2>/dev/null)\" = \"$unico_local\" ] || return 1\n",
      "testes": [
        "tests.test_pre_push_afetados.PrePushAfetados.test_arvore_suja_com_arquivo_mapeado_nao_vira_envio_dirigido"
      ]
    },
    {
      "id": "M2",
      "guarda": "a ferramenta do envio dirigido não pode ser link",
      "arquivo": ".githooks/pre-push",
      "de": "[ -f bin/forge-testes ] && [ ! -L bin/forge-testes ] || return 1",
      "para": "[ -f bin/forge-testes ] || return 1",
      "testes": [
        "tests.test_pre_push_afetados.PrePushAfetados.test_ferramenta_que_e_link_roda_a_suite_inteira"
      ]
    },
    {
      "id": "M3",
      "guarda": "dirigido exige HEAD igual ao commit enviado",
      "arquivo": ".githooks/pre-push",
      "de": "  [ -f bin/forge-testes ] && [ ! -L bin/forge-testes ] || return 1\n  [ \"$(git rev-parse HEAD 2>/dev/null)\" = \"$unico_local\" ] || return 1\n",
      "para": "  [ -f bin/forge-testes ] && [ ! -L bin/forge-testes ] || return 1\n",
      "testes": [
        "tests.test_pre_push_afetados.PrePushAfetados.test_commit_enviado_diferente_do_head_roda_a_suite_inteira"
      ]
    },
    {
      "id": "M4",
      "guarda": "diff em filtro, mapa ou hook roda a suíte inteira",
      "arquivo": ".githooks/pre-push",
      "de": "  [ -z \"$(git -c core.quotepath=false diff --name-only --no-renames \"$ancora\" HEAD -- bin/forge-testes tests/config.json .githooks/ 2>/dev/null)\" ] || return 1\n",
      "para": "  true\n",
      "testes": [
        "tests.test_pre_push_afetados.PrePushAfetados.test_diff_que_toca_o_filtro_o_mapa_ou_o_hook_roda_a_suite_inteira"
      ]
    },
    {
      "id": "M5",
      "guarda": "o diff vigiado inclui tests/config.json",
      "arquivo": ".githooks/pre-push",
      "de": "HEAD -- bin/forge-testes tests/config.json .githooks/ 2>/dev/null",
      "para": "HEAD -- bin/forge-testes .githooks/ 2>/dev/null",
      "testes": [
        "tests.test_pre_push_afetados.PrePushAfetados.test_diff_que_toca_o_filtro_o_mapa_ou_o_hook_roda_a_suite_inteira"
      ]
    },
    {
      "id": "M6",
      "guarda": "a base é refs/remotes/origin/develop",
      "arquivo": ".githooks/pre-push",
      "de": "git rev-parse --verify -q 'refs/remotes/origin/develop^{commit}'",
      "para": "git rev-parse --verify -q 'origin/develop^{commit}'",
      "testes": [
        "tests.test_pre_push_afetados.PrePushAfetados.test_base_e_a_ref_remota_mesmo_com_branch_local_de_mesmo_nome"
      ]
    },
    {
      "id": "M7",
      "guarda": "só a suíte completa (completa=1) anota a árvore verde",
      "arquivo": ".githooks/pre-push",
      "de": "if [ \"$completa\" = 1 ] && [ \"$inicio_limpo\" = 1 ]",
      "para": "if [ \"$inicio_limpo\" = 1 ]",
      "testes": [
        "tests.test_pre_push_afetados.PrePushAfetados.test_so_o_modulo_afetado_roda_e_nao_anota_a_arvore_verde"
      ]
    },
    {
      "id": "M8",
      "guarda": "hooks/ roda os testes que executam hooks/agentes.py",
      "arquivo": "bin/forge-testes",
      "de": "\"test_agentes_hash_brief\", \"test_agentes_clone\", \"test_textos_dono_f10\")),",
      "para": "\"test_textos_dono_f10\")),",
      "testes": [
        "tests.test_testes_tocados.MapaCobreOQueOsTestesLeem.test_a_familia_dos_testes_que_executam_hooks_e_bin_roda_no_envio_dirigido"
      ]
    }
  ]
}
