{
  "pedido": "v0479-bp3-s1-atalho",
  "executor": "unittest",
  "mutantes": [
    {
      "id": "M21",
      "guarda": "a saída 128 a 137 reabre",
      "arquivo": "scripts/jarvis-forge",
      "de": "[ \"$rc\" -lt 128 ]",
      "para": "[ \"$rc\" -lt 138 ]",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_saida_anormal_reabre_com_continue"
      ]
    },
    {
      "id": "M22",
      "guarda": "129 (terminal fechado) não reabre",
      "arquivo": "scripts/jarvis-forge",
      "de": "[ \"$rc\" = 129 ]",
      "para": "[ \"$rc\" = 1290 ]",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_interrupcao_da_pessoa_e_terminal_fechado_nao_reabrem"
      ]
    },
    {
      "id": "M23",
      "guarda": "130 (Ctrl+C) não reabre",
      "arquivo": "scripts/jarvis-forge",
      "de": "[ \"$rc\" = 130 ]",
      "para": "[ \"$rc\" = 1300 ]",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_interrupcao_da_pessoa_e_terminal_fechado_nao_reabrem"
      ]
    },
    {
      "id": "M24",
      "guarda": "a 4.ª queda na janela para",
      "arquivo": "scripts/jarvis-forge",
      "de": "-ge \"$quedas_teto\" ]",
      "para": "-gt \"$quedas_teto\" ]",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_teto_tres_reaberturas_a_quarta_queda_para"
      ]
    },
    {
      "id": "M25",
      "guarda": "30 min exatos já saíram da janela",
      "arquivo": "scripts/jarvis-forge",
      "de": "if [ $((agora - t)) -lt \"$janela\" ]",
      "para": "if [ $((agora - t)) -le \"$janela\" ]",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_trinta_minutos_exatos_ja_passaram"
      ]
    },
    {
      "id": "M26",
      "guarda": "a reabertura sempre leva --continue, uma vez só",
      "arquivo": "scripts/jarvis-forge",
      "de": "[ \"${1:-}\" != --continue ]",
      "para": "[ \"${1:-}\" = --continue ]",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_sem_conversa_a_reabertura_poe_o_continue"
      ]
    },
    {
      "id": "M27",
      "guarda": "espera inválida volta a 10 s",
      "arquivo": "scripts/jarvis-forge",
      "de": "*[!0-9]*) espera=10 ;;",
      "para": "*[!0-9]*) espera=99 ;;",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_espera_padrao_dez_segundos_e_configuravel"
      ]
    },
    {
      "id": "M28",
      "guarda": "janela inválida volta a 30 min",
      "arquivo": "scripts/jarvis-forge",
      "de": "*[!0-9]*) janela=1800 ;;",
      "para": "*[!0-9]*) janela=900 ;;",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_janela_configuravel_so_com_numero"
      ]
    },
    {
      "id": "M29",
      "guarda": "o teto é 3 reaberturas",
      "arquivo": "scripts/jarvis-forge",
      "de": "quedas_teto=3",
      "para": "quedas_teto=4",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_teto_tres_reaberturas_a_quarta_queda_para"
      ]
    },
    {
      "id": "M30",
      "guarda": "a espera padrão é 10 s",
      "arquivo": "scripts/jarvis-forge",
      "de": "${FORGE_QUEDA_ESPERA:-10}",
      "para": "${FORGE_QUEDA_ESPERA:-11}",
      "testes": [
        "tests.test_atalho_duravel.ForgeSupervisor.test_espera_padrao_dez_segundos_e_configuravel"
      ]
    }
  ]
}
