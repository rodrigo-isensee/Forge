      "arquivo": "bin/forge-fechar",
      "de": "  subida_extra=\"MERGED",
      "para": "  subida_xx=\"MERGED",
      "testes": [
        "tests.test_fechar_log_check.FecharLogCheck.test_fechamento_grava_uma_linha_subida_por_passo_e_a_do_6_com_merged"
      ]
    },
    {
