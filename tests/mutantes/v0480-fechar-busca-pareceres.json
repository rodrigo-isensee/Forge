{
  "pedido": "v0480-fechar-busca-pareceres",
  "executor": "unittest",
  "mutantes": [
    {
      "id": "M1",
      "guarda": "o --lote recusa --principal",
      "arquivo": "bin/forge-fechar",
      "de": "$medir$copia_principal\" ]",
      "para": "$medir\" ]",
      "testes": [
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_lote_recusa_principal"
      ]
    },
    {
      "id": "M2",
      "guarda": "--principal sem pasta e erro de uso",
      "arquivo": "bin/forge-fechar",
      "de": "copia_principal=\"${2-}\"; shift 2 || die",
      "para": "copia_principal=\"${2-}\"; shift 2 || break",
      "testes": [
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_principal_sem_pasta_e_erro_de_uso"
      ]
    },
    {
      "id": "M3",
      "guarda": "sem sha, buscar_de nao roda o fetch da refspec padrao",
      "arquivo": "bin/forge-fechar",
      "de": "[ \"$#\" -gt 0 ] || return 0  # sem sha",
      "para": "[ \"$#\" -ge 0 ] || return 0  # sem sha",
      "testes": [
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_tudo_legivel_nao_busca_nada"
      ]
    },
    {
      "id": "M4",
      "guarda": "o fetch em lote que falha cai para um fetch por sha",
      "arquivo": "bin/forge-fechar",
      "de": "\"$fonte\" \"$@\" >/dev/null 2>&1 && return 0",
      "para": "\"$fonte\" \"$@\" >/dev/null 2>&1; return 0",
      "testes": [
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_busca_da_origin_e_da_principal_e_diz_o_que_nao_existe"
      ]
    },
    {
      "id": "M5",
      "guarda": "o sha sozinho que a fonte nao tem nao derruba o fechamento",
      "arquivo": "bin/forge-fechar",
      "de": "[ \"$#\" -gt 1 ] || return 0  # o sha sozinho",
      "para": "[ \"$#\" -gt 1 ] || return 1  # o sha sozinho",
      "testes": [
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_busca_da_origin_e_da_principal_e_diz_o_que_nao_existe",
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_sha_ausente_entre_muitos_busca_por_metades"
      ]
    },
    {
      "id": "M6",
      "guarda": "so o commit que a copia nao le entra na busca",
      "arquivo": "bin/forge-fechar",
      "de": "git cat-file -e \"$s^{commit}\" 2>/dev/null || echo \"$s\"",
      "para": "git cat-file -e \"$s^{commit}\" 2>/dev/null && echo \"$s\"",
      "testes": [
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_busca_da_origin_e_da_principal_e_diz_o_que_nao_existe"
      ]
    },
    {
      "id": "M7",
      "guarda": "com --principal, a copia entra nas fontes",
      "arquivo": "bin/forge-fechar",
      "de": "  if [ -n \"$copia_principal\" ]; then",
      "para": "  if [ -z \"$copia_principal\" ]; then",
      "testes": [
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_busca_da_origin_e_da_principal_e_diz_o_que_nao_existe"
      ]
    },
    {
      "id": "M8",
      "guarda": "--principal que nao e copia git para antes do passo 1",
      "arquivo": "bin/forge-fechar",
      "de": "      || die \"parou antes do passo 1: --principal",
      "para": "      || true \"parou antes do passo 1: --principal",
      "testes": [
        "tests.test_fechar_busca_pareceres.FecharBuscaPareceres.test_principal_que_nao_e_repositorio_para_antes_do_passo_1"
      ]
    }
  ]
}
