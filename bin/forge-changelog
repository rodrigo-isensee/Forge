#!/usr/bin/env python3
"""Forge: changelog por fragmentos (ADR 0006), para PRs paralelos não conflitarem no CHANGELOG.md. Só biblioteca padrão.

Uso: forge-changelog novo <Adicionado|Alterado|Corrigido> "<texto>"   grava em changelog.d/<branch-sem-prefixo>.md
     forge-changelog release <versão> <data>                          junta os fragmentos em CHANGELOG.md, os apaga e grava a versão
                                                                      nos plugin.json (raiz e dev/, se existirem); no clone
                                                                      do Forge, imprime a medida da versão (placar e bench)
     forge-changelog conferir-release                                 gate da main: sobrou fragmento em changelog.d/?
     forge-changelog conferir --base REF [--branch=B]                 checagem do CI: o PR deixou entrada de changelog?
                                                                      Em melhoria/*, fragmento novo tem o nome da branch
                                                                      (B, senão GITHUB_HEAD_REF, senão o HEAD; CHANGELOG-BRANCH)
Fragmento: `### <tipo>` seguido de linhas `- texto`. Roda na raiz do repositório (cwd).
Saída: 0 ok; 1 reprovação (fragmento errado ou ausente); 2 erro (git ilegível, exceção).
"""
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

TIPOS = ("Adicionado", "Alterado", "Corrigido")
PASTA = "changelog.d"
PROTEGIDAS = {"main", "homolog", "develop", "HEAD"}
CAMINHOS_DA_FABRICA = ("agents", "skills", "templates", "bin", "scripts", "docs", ".claude-plugin", "hooks")
SECAO_NAO_PUBLICADO = re.compile(r"^## \[Não publicado\][^\n]*\n(.*?)(?=^## |\Z)", re.M | re.S)


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    if r.returncode:  # rc 2 é erro (git ilegível); rc 1 fica só para a reprovação do conferir (CL-1, adendo E1.3)
        print(f"git {' '.join(args)}: {r.stderr.strip()}", file=sys.stderr)
        sys.exit(2)
    return r.stdout


def ler_fragmento(texto, nome):
    """Devolve {tipo: [linhas]}; sai com erro se o formato não for `### tipo` + linhas `- texto`."""
    secoes, atual = {}, None
    for linha in texto.splitlines():
        if not linha.strip():
            continue
        m = re.fullmatch(r"### (\w+)\s*", linha)
        if m:
            if m.group(1) not in TIPOS:
                sys.exit(f"{nome}: tipo '{m.group(1)}' inválido (use {', '.join(TIPOS)}).")
            atual = secoes.setdefault(m.group(1), [])
        elif atual is not None and re.match(r"- \S", linha):
            atual.append(linha)
        elif atual is not None and linha.startswith(" ") and atual:
            atual[-1] += "\n" + linha
        else:
            sys.exit(f"{nome}: formato inválido; esperado '### <tipo>' seguido de linhas '- texto'.")
    if not any(secoes.values()):
        sys.exit(f"{nome}: fragmento sem nenhuma linha.")
    return secoes


def escrever_fragmento(secoes):
    return "\n".join(f"### {t}\n" + "\n".join(secoes[t]) + "\n" for t in secoes)


def fragmentos(pasta=PASTA):
    return sorted(p for p in Path(pasta).glob("*.md") if p.name.lower() != "readme.md")


def slug_da_branch(branch):
    """Nome do fragmento de uma branch: o que vem depois do primeiro `/`, só com letras, dígitos, `.`, `_` e `-`."""
    return re.sub(r"[^A-Za-z0-9._-]+", "-", branch.split("/", 1)[-1]).strip("-.")


def fragmentos_com_outro_nome(branch, novos):
    """Fragmentos novos de changelog.d/ cujo nome não é o da branch (`<branch-sem-prefixo>.md`)."""
    esperado = f"{slug_da_branch(branch)}.md"
    return [n for n in novos if Path(n).name != esperado]


def de_branch_abaixo(nome):
    """CHANGELOG-FRAGMENTO-BASE: o fragmento `changelog.d/<s>.md` trazido por `melhoria/<s>` (local ou de origin) que é
    ancestral do HEAD e o tem; numa branch empilhada ele vem da branch de baixo e não conta como outro nome."""
    def ok(*args):
        return subprocess.run(["git", *args], capture_output=True).returncode == 0
    caminho, stem = f"{PASTA}/{Path(nome).name}", Path(nome).stem
    for ref in (f"refs/heads/melhoria/{stem}", f"refs/remotes/origin/melhoria/{stem}"):
        if ok("merge-base", "--is-ancestor", ref, "HEAD") and ok("cat-file", "-e", f"{ref}:{caminho}"):
            return True
    return False


def branch_do_pr(explicita):
    """A branch da regra do nome: `--branch`, senão `GITHUB_HEAD_REF` (o PR no Actions), senão o HEAD local."""
    return explicita or os.environ.get("GITHUB_HEAD_REF") or git("rev-parse", "--abbrev-ref", "HEAD").strip()


def novo(args):
    texto = args.texto.strip()
    if not texto or "\n" in texto:
        sys.exit("O texto deve ter uma linha e não pode ser vazio.")
    branch = git("rev-parse", "--abbrev-ref", "HEAD").strip()
    if branch in PROTEGIDAS:
        sys.exit(f"Branch '{branch}': rode numa branch de trabalho (melhoria/<tema>).")
    conferir_pasta_de_fragmentos()
    slug = slug_da_branch(branch)
    if not slug:
        sys.exit(f"Não consegui um nome de arquivo a partir da branch '{branch}'.")
    arquivo = Path(PASTA) / f"{slug}.md"
    secoes = ler_fragmento(arquivo.read_text(encoding="utf-8"), str(arquivo)) if arquivo.exists() else {}
    secoes.setdefault(args.tipo, []).append(f"- {texto}")
    arquivo.parent.mkdir(exist_ok=True)
    arquivo.write_text(escrever_fragmento(secoes), encoding="utf-8")
    print(f"gravado em {arquivo}")


MANIFESTOS = (".claude-plugin/plugin.json", "dev/.claude-plugin/plugin.json")


def _recusa_chave_repetida(pares):
    chaves = [k for k, _ in pares]
    if len(chaves) != len(set(chaves)):
        raise ValueError("chave repetida")
    return dict(pares)


def conferir_caminho(caminho, nome, raiz):
    """Recusa link simbólico (inclusive quebrado) e caminho que resolve fora da raiz."""
    if caminho.is_symlink() or not caminho.resolve().is_relative_to(raiz):
        sys.exit(f"{nome}: link simbólico ou fora da raiz do repositório; recusado.")


def conferir_pasta_de_fragmentos():
    """Recusa `changelog.d` que seja link ou resolva fora da raiz, e fragmento que seja link: a release lê e apaga esses arquivos."""
    raiz = Path.cwd().resolve()
    pasta = Path(PASTA)
    if not pasta.exists() and not pasta.is_symlink():
        return
    conferir_caminho(pasta, PASTA, raiz)
    for a in fragmentos():
        conferir_caminho(a, f"{PASTA}/{a.name}", raiz)


def ler_manifestos(versao):
    """Lê e valida os manifestos que existem e calcula o texto novo; devolve [(caminho, novo_texto)]. Recusa link
    simbólico, caminho fora da raiz, JSON inválido, chave repetida, manifesto sem `version` de topo e troca que não
    deixe `version` de topo igual a `versao`. Nada é gravado aqui."""
    raiz = Path.cwd().resolve()
    lidos = []
    for nome in MANIFESTOS:
        caminho = Path(nome)
        if not caminho.exists() and not caminho.is_symlink():
            continue
        conferir_caminho(caminho, nome, raiz)
        texto = caminho.read_text(encoding="utf-8")
        try:
            dados = json.loads(texto, object_pairs_hook=_recusa_chave_repetida)
        except ValueError as erro:
            sys.exit(f"{nome}: não é JSON válido ({erro}).")
        if not isinstance(dados, dict) or not isinstance(dados.get("version"), str):
            sys.exit(f"{nome}: sem a chave 'version' de topo.")
        novo_texto, _ = re.subn(r'("version"\s*:\s*")[^"]*(")', rf"\g<1>{versao}\g<2>", texto, count=1)
        try:
            conferido = json.loads(novo_texto, object_pairs_hook=_recusa_chave_repetida)
        except ValueError as erro:
            sys.exit(f"{nome}: a troca da versão geraria JSON inválido ({erro}); recusado.")
        if conferido != {**dados, "version": versao}:
            sys.exit(f"{nome}: a troca textual não acertou só o 'version' de topo (campo aninhado antes dele?); recusado.")
        lidos.append((caminho, novo_texto))
    return lidos


def gravar_versao(manifestos):
    """Grava o texto já conferido por `ler_manifestos`."""
    for caminho, novo_texto in manifestos:
        caminho.write_text(novo_texto, encoding="utf-8")


def release(args):
    if not re.fullmatch(r"\d+\.\d+\.\d+", args.versao):
        sys.exit("Versão no formato X.Y.Z.")
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", args.data):
        sys.exit("Data no formato AAAA-MM-DD.")
    caminho = Path("CHANGELOG.md")
    conferir_caminho(caminho, "CHANGELOG.md", Path.cwd().resolve())
    texto = caminho.read_text(encoding="utf-8")
    if re.search(rf"^## \[{re.escape(args.versao)}\]", texto, re.M):
        sys.exit(f"CHANGELOG.md já tem a versão {args.versao}.")
    m = SECAO_NAO_PUBLICADO.search(texto)
    if not m:
        sys.exit("CHANGELOG.md sem a seção '## [Não publicado]'.")
    antigas = [l for l in m.group(1).splitlines() if l.strip()]
    conferir_pasta_de_fragmentos()
    arquivos = fragmentos()
    agrupado = {t: [] for t in TIPOS}
    for a in arquivos:
        for tipo, linhas in ler_fragmento(a.read_text(encoding="utf-8"), str(a)).items():
            agrupado[tipo].extend(linhas)
    if not antigas and not arquivos:
        sys.exit("Nada a publicar: sem fragmentos em changelog.d/ nem linhas em '[Não publicado]'.")
    manifestos = ler_manifestos(args.versao)
    corpo = list(antigas)
    for tipo in TIPOS:
        if agrupado[tipo]:
            corpo += [f"### {tipo}", *agrupado[tipo]]
    secao = f"## [Não publicado]\n\n## [{args.versao}] - {args.data}\n" + "\n".join(corpo) + "\n\n"
    caminho.write_text(texto[:m.start()] + secao + texto[m.end():], encoding="utf-8")
    gravar_versao(manifestos)
    for a in arquivos:
        a.unlink()
    print(f"[{args.versao}]: {len(arquivos)} fragmento(s) juntado(s) e apagado(s)")
    avisar_avaliacao(Path.cwd())
    avisar_medidas(Path.cwd(), args.versao)


def avisar_medidas(raiz, versao):
    """v046 E7 (decisão do dono de 12/11): o placar de mutação (M-5) e o bench (BENCH-POR-RELEASE) rodam uma vez por
    versão, aqui na release, nunca no PR. Só no clone do Forge, onde mora o placar; só avisa, nunca muda a saída."""
    if not (raiz / "scripts" / "placar-mutacao.py").is_file():
        return
    tag = subprocess.run(["git", "describe", "--tags", "--abbrev=0", "--match", "v[0-9]*"], cwd=raiz,
                         capture_output=True, text=True)
    anterior = shlex.quote(tag.stdout.strip()) if tag.returncode == 0 and tag.stdout.strip() else "<tag da release anterior>"
    print(f"medida da versão {versao} (uma vez por versão, não é portão; R-TETO):")
    print(f"  placar: scripts/placar-mutacao.py --desde {anterior} --versao {versao} (docs/engineering/placar-mutacao.md)")
    print(f"  bench: a linha da {versao} em bench-versoes.md e metricas-velocidade.md, na área do Jarvis")


def avisar_avaliacao(raiz):
    """0.45.3: no fim da release, imprime `aviso: avaliação de fora pendente ...` (bin/forge_governanca.py). Só avisa: módulo
    ausente ou qualquer falha da leitura não muda a release nem o código de saída."""
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    try:
        import forge_governanca  # noqa: PLC0415
        estado = forge_governanca.avaliacao_pendente(raiz)
        if estado and estado[0]:
            print(f"aviso: {forge_governanca.frase_da_avaliacao(estado)}")
    except Exception:  # noqa: BLE001 - o aviso nunca derruba a release
        pass
    finally:
        sys.path.pop(0)


def linhas_nao_publicado(texto):
    m = SECAO_NAO_PUBLICADO.search(texto)
    return {l.strip() for l in (m.group(1) if m else "").splitlines() if l.strip().startswith("-")}


PASTAS_DE_PARECER = ("docs/reviews/", "docs/qa/", "docs/security/", "docs/devops/")


def e_parecer(caminho):
    """Parecer de verdade: arquivo de docs/{reviews,qa,security,devops}/, fora modelos `_*` e docs/security/{ameacas,aceites}/ (como o gate do ci.yml)."""
    return (caminho.startswith(PASTAS_DE_PARECER) and not Path(caminho).name.startswith("_")
            and not caminho.startswith(("docs/security/ameacas/", "docs/security/aceites/")))


def fragmentos_alterados(filtro, base):
    """Fragmentos de changelog.d/ (só a pasta raiz, sem o README) adicionados ("A") ou apagados ("D") entre base e HEAD."""
    caminhos = git("diff", "--name-only", "--no-renames", f"--diff-filter={filtro}", base, "HEAD", "--", PASTA).split()
    return [p for p in caminhos if p.endswith(".md") and Path(p).name.lower() != "readme.md"
            and Path(p).parent == Path(PASTA)]


def conferir_fechamento(base, apagados):
    """PR que só fecha fragmentos: cada linha de cada fragmento apagado precisa estar no CHANGELOG.md do HEAD."""
    changelog = Path("CHANGELOG.md").read_text(encoding="utf-8")
    for p in apagados:
        for linhas in ler_fragmento(git("show", f"{base}:{p}"), p).values():
            for linha in linhas:
                if linha not in changelog:
                    sys.exit(f"{p}: a linha apagada não está no CHANGELOG.md: {linha}")
    print(f"ok: fechamento de {len(apagados)} fragmento(s), linhas no CHANGELOG")


def conferir(args):
    base = args.base
    mudou = git("diff", "--name-only", "--no-renames", base, "HEAD", "--", *CAMINHOS_DA_FABRICA).split()
    versao = lambda ref: re.search(r'"version"\s*:\s*"([^"]+)"', git("show", f"{ref}:.claude-plugin/plugin.json")).group(1)
    atual, anterior = versao("HEAD"), versao(base)
    print(f"arquivos da fábrica alterados: {len(mudou)} | versão base: {anterior} | versão do PR: {atual}")
    novos = fragmentos_alterados("A", base)
    branch = branch_do_pr(args.branch) if novos else ""
    if branch.startswith("melhoria/") and (
            errados := [n for n in fragmentos_com_outro_nome(branch, novos) if not de_branch_abaixo(n)]):
        sys.exit(f"fragmento(s) sem o nome da branch '{branch}' (esperado {PASTA}/{slug_da_branch(branch)}.md): "
                 f"{', '.join(errados)} (CHANGELOG-BRANCH)")
    if atual != anterior:
        print("PR de release (versão mudou): o changelog fechado é conferido na promoção para a main.")
        return
    apagados = fragmentos_alterados("D", base)
    # Pareceres do próprio pedido (review, QA, segurança, devops) não são outra mudança da fábrica no fechamento.
    outras = [m for m in mudou if not m.startswith(PASTAS_DE_PARECER)]
    if not outras and not novos and apagados:
        conferir_fechamento(base, apagados)
        return
    if not mudou:
        return
    for p in novos:  # fragmento presente é validado antes do atalho de parecer (regressão achada pelo QA)
        ler_fragmento(git("show", f"HEAD:{p}"), p)
    if all(e_parecer(m) for m in mudou):
        print(f"ok: PR só de parecer ({len(mudou)} arquivo(s) em docs/), sem fragmento novo (RELEASE-PR-SO-PARECER)")
        return
    if novos:
        print(f"ok: {len(novos)} fragmento(s) novo(s) em {PASTA}/")
        return
    try:
        anterior_txt = git("show", f"{base}:CHANGELOG.md")
    except SystemExit:
        anterior_txt = ""
    novas = linhas_nao_publicado(Path("CHANGELOG.md").read_text(encoding="utf-8")) - linhas_nao_publicado(anterior_txt)
    if novas:
        print(f"ok: {len(novas)} linha(s) nova(s) em [Não publicado] (forma antiga, aceita na transição)")
        return
    sys.exit(f"Registre a mudança num fragmento novo em {PASTA}/ (rode `bin/forge-changelog novo <tipo> \"<texto>\"`); "
             "não suba a versão no PR.")


def conferir_release(_args):
    pendentes = fragmentos()
    if pendentes:
        sys.exit(f"Há fragmentos em {PASTA}/ ({', '.join(p.name for p in pendentes)}): rode "
                 "`bin/forge-changelog release <versão> <data>` para juntá-los e apagá-los.")
    print(f"ok: {PASTA}/ sem fragmentos pendentes")


def main():
    ap = argparse.ArgumentParser(prog="forge-changelog")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("novo")
    p.add_argument("tipo", choices=TIPOS)
    p.add_argument("texto")
    p.set_defaults(f=novo)
    p = sub.add_parser("release")
    p.add_argument("versao")
    p.add_argument("data")
    p.set_defaults(f=release)
    p = sub.add_parser("conferir")
    p.add_argument("--base", required=True)
    p.add_argument("--branch", default="")
    p.set_defaults(f=conferir)
    p = sub.add_parser("conferir-release")
    p.set_defaults(f=conferir_release)
    args = ap.parse_args()
    try:
        args.f(args)
    except Exception as erro:  # erro inesperado sai com 2, não com o 1 da reprovação; SystemExit passa
        print(f"forge-changelog: erro: {type(erro).__name__}: {erro}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
