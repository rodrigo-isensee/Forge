    br.add_argument("--entrega", action="store_true", help="só em `mensagem`: a mensagem do modo entrega (pede --worktree; Branch, Base, Base-sha e Etapa vêm do brief, Desde da última `conferida` do Histórico do pedido ou, com ela fora do head da worktree, o Base-sha)")
