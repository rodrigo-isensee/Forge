    es = sub.add_parser("esperas", parents=[comum], help="quanto tempo cada cartão esperou o dono ou uma credencial, lido de docs/kanban/historico.md; só leitura (M14b)")
    es.add_argument("--pedido", help="só os cartões deste pedido (cartão igual, da mesma família de nome, com o pedido na coluna Pedido do KANBAN.md ou no motivo do movimento)")
    es.add_argument("--kanban", help="com --pedido: o KANBAN.md a ler (padrão: o da raiz)")
    do = sub.add_parser("dora", parents=[comum], help="frequência de entrega, espera da mudança, taxa de falha, recuperação e vazão por "
                        "semana, lidas das tags do git e do quadro; abaixo de 20 valores, os brutos; só leitura (0.45.7, TM-16)")
    do.add_argument("--desde", type=datetime.date.fromisoformat, help="AAAA-MM-DD (inclusive)")
    do.add_argument("--ate", type=datetime.date.fromisoformat, help="AAAA-MM-DD (inclusive)")
    do.add_argument("--fuso", type=lambda t: datetime.datetime.strptime(t, "%z").tzinfo,
                    help="fuso das horas de escapes.md e da janela, ±HHMM ou ±HH:MM (padrão: o da máquina)")
    do.add_argument("--json", action="store_true", help="saída em JSON")
    co = sub.add_parser("corrigidos", parents=[comum], help="PRs `fix` que corrigem PR já mesclado, lidos do histórico do git; só leitura (M14b)")
    co.add_argument("--ref", help="branch ou commit onde ler a linha de PRs (padrão: origin/develop, develop ou HEAD)")
    co.add_argument("--dias", type=int, default=DIAS_DO_CORRIGIDO, help=f"janela, em dias, do indício por arquivo em comum (padrão {DIAS_DO_CORRIGIDO})")
    pa = sub.add_parser("parecer", help="o parecer preso ao conteúdo do seu domínio (PARECER-CONTEUDO)")
    psub = pa.add_subparsers(dest="acao", required=True)
    pd = psub.add_parser("delta", parents=[comum], help="o diff desde o `commit:` do parecer, só nos arquivos do domínio do tipo dele; só leitura, nunca reprova")
    pd.add_argument("arquivo", help="o parecer (docs/reviews, qa, devops ou security)")
    pd.add_argument("--ate", help="o fim do intervalo (padrão HEAD)")
    pd.add_argument("--base", default="develop", help="develop (padrão) ou homolog: o que veio dela por merge na branch sai do delta (FC-DELTA-APOS-MERGE-BASE)")
    pn = psub.add_parser("novo", parents=[comum], help="imprime o esqueleto válido do parecer com o `commit:` do sha a revisar (Z7, AQ-5); só leitura")
    pn.add_argument("--tipo", required=True, choices=tuple(TIPO_DO_PARECER_NOVO))
    pn.add_argument("--pedido", required=True)
    pn.add_argument("--branch", required=True)
    pn.add_argument("--parecer", required=True, choices=("aprovado", "reprovado"), help="o veredito é de quem revisa; sem padrão")
    ec = sub.add_parser("escape", help="defeito escapado: bug achado depois do parecer final (M14b)")
    esub = ec.add_subparsers(dest="acao", required=True)
    er = esub.add_parser("registrar", parents=[comum], help="acrescenta o defeito escapado em docs/kanban/escapes.md, em formato fixo, com a hora real")
    er.add_argument("--pedido", required=True)
    er.add_argument("--parecer-final", required=True, help="o parecer depois do qual o bug apareceu (caminho em docs/ ou commit)")
    er.add_argument("--achado-por", required=True, help=f"como apareceu: {', '.join(ACHADO_POR)}")
    er.add_argument("--gravidade", required=True, help=", ".join(GRAVIDADES))
    er.add_argument("--controle-que-faltou", required=True, help=f"o controle que deveria tê-lo achado: {', '.join(CONTROLES_QUE_FALTARAM)}")
    er.add_argument("--nota", required=True, help="uma linha: o que escapou")
    er.add_argument("--origem", default=SEM_ORIGEM, help=f"onde o defeito nasceu: {', '.join(ORIGENS)} (padrão {SEM_ORIGEM})")
    eu = esub.add_parser("resumo", parents=[comum], help="escapes por gravidade e controle e a taxa sobre os pedidos prontos; só leitura")
    eu.add_argument("--dias", type=int, default=JANELA_DE_ESCAPES, help=f"janela em dias (padrão {JANELA_DE_ESCAPES})")
    af = sub.add_parser("afrouxamentos", parents=[comum], help="dos PRs com o rótulo afrouxa-regra, quantos afrouxavam regra de verdade (a catraca sobre o diff de cada um); só leitura (M14b)")
    af.add_argument("--prs", help="números dos PRs rotulados, separados por vírgula")
    af.add_argument("--rotulados", help="JSON de `gh pr list --label afrouxa-regra --state all --limit 500 --json number` (a lista é lida do disco; o forge-check não chama o GitHub)")
    af.add_argument("--ref", help="branch ou commit onde estão os PRs mesclados (padrão: origin/develop, develop ou HEAD)")
    so = sub.add_parser("sobreposicao", parents=[comum], help="arquivos em comum entre as branches melhoria/* (informativo, rc 0)")
    so.add_argument("--base", help="branch de integração da comparação (padrão: origin/develop, develop, origin/main, main)")
    so.add_argument("--ref", help="branch prestes a ser mesclada na develop: com release em curso (versão da origin/develop maior que a da origin/homolog), só avisa; sem congelamento, nunca barra (R-FLUXO)")
    sub.add_parser("fila", parents=[comum], help="o que pode começar agora: dependências, teto e sobreposição (só leitura, rc 0)")
    # metricas, regras e avaliacao (0.43.1 H, 0.45.3): a lógica fica em bin/forge_governanca.py, importado só quando um deles roda
    me = sub.add_parser("metricas", parents=[comum], help="tempo do código pronto à develop e à main, voltas, revalidações, suítes, "
                        "espera do dono e reprovações por classe (mérito: declarada), por item e por período; só leitura (0.43.1 H)")
    me.add_argument("--pedido", action="append", help="id em docs/pedidos/ (repita para vários; padrão: todos)")
    me.add_argument("--desde", help="AAAA-MM-DD (inclusive)")
    me.add_argument("--ate", help="AAAA-MM-DD (inclusive)")
    me.add_argument("--por", choices=("dia", "semana"), default="dia", help="período do agrupamento (padrão: dia)")
    me.add_argument("--fuso", help="fuso das horas do Histórico, ±HHMM ou ±HH:MM (padrão: o da máquina)")
    me.add_argument("--agora", help="AAAA-MM-DDTHH:MM para o aberto_h (padrão: agora; serve para reproduzir)")
    me.add_argument("--develop", default="origin/develop", help="ref da develop (padrão: origin/develop)")
    me.add_argument("--main", default="origin/main", help="ref da main (padrão: origin/main)")
    me.add_argument("--gh", action="store_true", help="conta as execuções e falhas do CI das branches citadas (gh run list; usa rede)")
    me.add_argument("--log-prepush", action="append", metavar="LOG", help="log de envio com as linhas `pre-push: duracao ...` do "
                    ".githooks/pre-push (F8; repita para vários): duração por plano, falhas e p50")
    me.add_argument("--transcritos", action="append", metavar="PASTA", help="pasta de transcritos `*.jsonl` dos subagentes (CUSTO; repita "
                    "para várias; padrão: FORGE_TRANSCRITOS ou a pasta do Claude Code da raiz): tokens por item")
    me.add_argument("--json", action="store_true", help="saída em JSON")
    av = sub.add_parser("avaliacao", parents=[comum], help="cadência da avaliação de fora do AQ: 5 versões do CHANGELOG.md desde a última "
                        "docs/avaliacoes/*.md; só avisa, rc 0 (0.45.3)")
    av.add_argument("--pendente", action="store_true", help="diz se a avaliação de fora está pendente (o padrão; nunca barra)")
    rg = sub.add_parser("regras", parents=[comum], help="validade das regras: 'Revisar em:' e 'Medida:' de cada docs/regras/R-*.md; "
                        "aviso rc 0, --estrito rc 1 (0.43.1 H)")
    rg.add_argument("--estrito", action="store_true", help="reprova (rc 1) se alguma regra tem aviso")
    rg.add_argument("--hoje", help="AAAA-MM-DD (padrão: hoje; serve para reproduzir)")
    rg.add_argument("--json", action="store_true", help="saída em JSON")
    mv = sub.add_parser("movimento", parents=[comum], help="anota um movimento do quadro em docs/kanban/historico.md, com a hora real")
    mv.add_argument("cartao")
    mv.add_argument("--de", required=True, help="coluna de origem")
    mv.add_argument("--para", required=True, help="coluna de destino")
    mv.add_argument("--motivo", default="", help="motivo do movimento (padrão: —; até 500 caracteres, sem `atributos:`)")
    for nome, ajuda in (("--titulo", "título do cartão (até 120 caracteres)"), ("--pedido", "id do pedido do cartão"),
                        ("--responsavel", "forge:<agente> ou usuário")):
        mv.add_argument(nome, help=f"{ajuda}; vai à marca `· atributos:` do motivo (EST-M12)")
    na = sub.add_parser("anotar", parents=[comum], help="grava no pedido a decisão, pergunta ou ordem do dono, ou a linha do Histórico, com a hora do relógio (P4)")
    na.add_argument("--pedido", required=True, help="arquivo do pedido ou id em docs/pedidos/<id>.md")
    na.add_argument("--tipo", required=True, choices=TIPOS_DO_ANOTAR)
    na.add_argument("--literal", required=True, help="a fala do dono, literal (vai entre aspas); no historico, o texto da linha")
    na.add_argument("--contexto", help="a paráfrase do Jarvis, fora das aspas (decisao, pergunta, ordem)")
    na.add_argument("--propagar", action="store_true", help="só com --tipo decisao: grava o brief seguinte de cada brief em voo do pedido com a linha nova (B15)")
    na.add_argument("--confere", help="obrigatório com --tipo decisao: rapido, seguro, barato, mede ou nao-passa (E8, critério do Jarvis)")
    cf = sub.add_parser("conferencia", help="registro das conferências do conferente (S-18)")
    csub = cf.add_subparsers(dest="acao", required=True)
    rg = csub.add_parser("registrar", parents=[comum], help="acrescenta uma conferência em docs/kanban/conferencias.md, em formato fixo, com a hora real")
    rg.add_argument("--pedido", required=True)
    rg.add_argument("--brief", required=True, help="nome do brief (docs/briefs/<nome>.md)")
    rg.add_argument("--modo", required=True, help="brief ou entrega")
    rg.add_argument("--rodada", required=True, help="inteiro a partir de 1")
    rg.add_argument("--resultado", required=True, help="texto do veredito, ex.: aprovado, reprovado, não cumpriu (PQ-3)")
    rg.add_argument("--merito", required=True, help="s, n, parcial ou — (o achado procedia?)")
    rg.add_argument("--nota", default="")
    rg.add_argument("--classe", help=f"classe da falha (obrigatória quando reprova ou não cumpre): {', '.join(CLASSES_DE_FALHA)}")
    rg.add_argument("--autor", help=f"quem errou: {', '.join(AUTORES_DE_FALHA)} (padrão: jarvis no modo brief, destino no modo entrega)")
    rg.add_argument("--tardio", help="sim ou nao: o achado podia sair na rodada 1? (obrigatório quando a rodada 2 ou mais não aprova)")
    cl = csub.add_parser("classes", parents=[comum], help="conta as falhas classificadas por classe e autor nos últimos dias e propõe regra com 3 ou mais briefs (só imprime)")
    cl.add_argument("--dias", type=int, default=JANELA_DE_RECORRENCIA, help=f"janela em dias (padrão {JANELA_DE_RECORRENCIA})")
    pv = sub.add_parser("provas", help="provas `cmd` dos briefs e o CI: o arquivo de provas da branch e a medida (M15, R-PROVA)")
    pvsub = pv.add_subparsers(dest="acao", required=True)
    pg = pvsub.add_parser("gerar", parents=[comum], help="imprime o arquivo (não escreve); a PQ fora da lista do scripts/reexecutar-provas.py sai `fora:` no stderr")
    pg.add_argument("--brief", required=True, help="o brief, só em docs/briefs/ (da raiz ou de ~/.forge-contrib)")
    pm = pvsub.add_parser("medida", parents=[comum], help="conferências de entrega que o CI com a M15 pegaria e as só do conferente (EST-M2B-REAVALIAR; só leitura)")
    pm.add_argument("--desde", type=lambda d: datetime.date.fromisoformat(d).isoformat(), help="AAAA-MM-DD: só as conferências desse dia em diante")
    cs = sub.add_parser("classe", parents=[comum], help="classe de risco do diff da branch (T, N ou C), o motivo e os portões e pareceres exigidos; só leitura (P5)")
    cs.add_argument("--base", help="base do diff (padrão: origin/develop, develop, origin/main ou main, a primeira que existe)")
    cs.add_argument("--head", help="ref da entrega (padrão: HEAD)")
    cs.add_argument("--json", action="store_true", dest="como_json", help="uma linha JSON: classe, motivos, arquivos, portoes, pareceres, gatilhos_de_seguranca")
    pr = sub.add_parser("pr", parents=[comum], help="pareceres de review e QA de um pedido; sem --ref, o parecer do disco precisa estar commitado, igual ao do HEAD")
    pr.add_argument("pedido")
    pr.add_argument("--ref", help="lê os pareceres desta ref do git e compara com ela (padrão: disco e HEAD; sem --ref, o parecer do disco precisa estar commitado, igual ao do HEAD)")
    pr.add_argument("--base", help="branch de destino: merge dela depois do parecer não o invalida (diff efetivo)")
    pr.add_argument("--previo", action="store_true", help="só o pré-voo do pre-push (FC-6): parecer ausente vira aviso e não conta para o rc; "
                    "desatualizado, reprovado e o resto seguem violação")
    pr.add_argument("--pr", dest="numero_pr", help="PR já mesclado (squash, branch apagada): os pareceres são conferidos no head dele (headRefOid, "
                    "lido do gh e presente no clone), nunca no commit do merge; não se combina com --ref (E10, CONF-MERGE-APOS-SQUASH)")
    en = sub.add_parser("entrega", parents=[comum], help="escopo da entrega: arquivos do intervalo da delegação (`--desde` só depois de uma conferência); só leitura")
    en.add_argument("pedido", nargs="?", help="arquivo do pedido ou id (docs/pedidos/<id>.md da cópia principal); forma antiga, só leitura")
    en.add_argument("--pedido", dest="pedido_conferir", metavar="PEDIDO", help="forma nova (P2, 0.43.1): confere a entrega contra o brief selado "
                    "da branch e da etapa (escopo declarado, provas, commits; Base, Base-sha e Desde calculados) e, com rc 0, grava "
                    "`entrega conferida <sha40>` no ## Histórico; sem --base, --base-sha, --desde nem --brief")
    en.add_argument("--worktree", help="só com --pedido: a pasta absoluta da worktree da branch (padrão: a do `git worktree list`), onde os PQ cmd rodam")
    en.add_argument("--sem-gravar", action="store_true", help="só com --pedido: confere e não grava (o PQ do autor)")
    en.add_argument("--so-leitura", action="store_true", help="só com --pedido: como --sem-gravar e sem rodar os PQ cmd (lê só git e disco; "
                    "a forma do conferente, que não roda código da branch: os PQ cmd ficam com o autor, o CI e o QA)")
    en.add_argument("--branch", required=True, help="branch entregue")
    en.add_argument("--base", help="forma antiga: branch de integração da entrega (develop, homolog ou main)")
    en.add_argument("--base-sha", help="forma antiga: sha40 da base gravado na delegação (Base-sha)")
    en.add_argument("--etapa", required=True, choices=ETAPAS_DE_CODIGO + ETAPAS_DE_BRANCH_INTEIRA + (ATO_GITHUB,),
                    help="etapa conferida; `--desde` vale em todas as etapas (C1)")
    en.add_argument("--brief", action="append", default=[], help="entregas paralelas conferidas juntas: um brief (em docs/briefs/) por entrega, de mesma Branch, Base, Base-sha e pedido; repita a opção; sem ela, a saída é a de sempre")
    en.add_argument("--desde", help="sha40 da última entrega conferida (linha `conferida <sha40>` do Histórico do pedido); o escopo passa a ser só o que veio depois")
    tr = sub.add_parser("transcricao", help="anonimiza e verifica sessões gravadas (ADR 0007)")
    tsub = tr.add_subparsers(dest="acao", required=True)
    an = tsub.add_parser("anonimizar")
    an.add_argument("entrada")
    an.add_argument("saida")
    ve = tsub.add_parser("verificar")
    ve.add_argument("arquivo")
    cu = tsub.add_parser("custo", parents=[comum], help="tokens por sessão, agente e tipo lidos das transcrições locais (sem rede)")
    cu.add_argument("alvo", nargs="?", help="pasta ou arquivo .jsonl (padrão: as sessões do diretório atual, de ~/.forge-contrib e das worktrees de ~/.forge-contrib/wt em ~/.claude/projects)")
    cu.add_argument("--entregas", action="store_true", help="gera as linhas de docs/kanban/entregas.md")
    cu.add_argument("--entrega", default="<entrega>", help="nome da entrega na linha gerada por --entregas (sem `|`, quebra de linha nem controle)")
    cu.add_argument("--desde", help="só as mensagens a partir desta hora (ISO 8601); a linha sem `timestamp` ou fora da janela vai para `fora_da_janela`")
    cu.add_argument("--ate", help="só as mensagens até esta hora (ISO 8601)")
    cu.add_argument("--pedido", help="a janela do pedido (id de docs/pedidos/<id>.md que existe): do primeiro ao último movimento dos cartões do pedido em docs/kanban/historico.md (cartão igual, da mesma família de nome ou com o pedido na coluna Pedido do KANBAN.md)")
    for nome, ajuda in (("lastro", "afirmações dos relatórios de subagente sem lastro nas saídas de ferramenta (M1)"),
                        ("decisoes", "respostas do Jarvis com mais de uma decisão ou sem recomendação (M3)"),
                        ("vereditos", "vereditos do conferente que contradizem as próprias linhas (P7)"),
                        ("recusas", "recusas de linha dos hooks (não modela, fora da gramática) por papel (P9)"),
                        ("trava", "episódios de espera da trava pesada (R-TETO) por papel, só números (LAC-L1)"),
                        ("avisos", "avisos do doutor e do vigia por hook, evento e dia, únicos e reincidência (L2)")):
        medida = tsub.add_parser(nome, help=ajuda)
        if nome == "avisos":
            medida.add_argument("--amostra", type=int, default=0, metavar="N", help="N avisos só com id s<n>#<i> e tipo doutor|vigia, sem texto (L2)")
        medida.add_argument("alvo", nargs="?", help="pasta ou arquivo .jsonl (padrão: as sessões do diretório atual, de ~/.forge-contrib e das worktrees de ~/.forge-contrib/wt em ~/.claude/projects)")
    ve.add_argument("--teto", type=int, default=TETO_PADRAO, help=f"agentes simultâneos em segundo plano (padrão {TETO_PADRAO}, R-TETO)")
    a = ap.parse_args()
    if a.raiz_pedidos:
        global RAIZES_DE_BRIEF
        escolhida = Path(a.raiz_pedidos).resolve()
        permitidas = (*RAIZES_DE_BRIEF, Path(a.raiz).resolve(), raiz_principal(Path(a.raiz).resolve()).resolve())
        if not any(escolhida == p.resolve() or p.resolve() in escolhida.parents for p in permitidas):
            print(f"forge-check: --raiz-pedidos {nome_seguro(str(escolhida))} fora de ~/.forge-contrib e da raiz do repositório "
                  "(o hook só guarda os pedidos dali)")
            return 2
        RAIZES_DE_BRIEF = (escolhida, *RAIZES_DE_BRIEF)  # a escolhida na frente das demais
    if a.cmd == "brief" and a.alvo == "gerar" and a.etapa is not None and a.etapa not in ETAPAS_DO_GERAR:
        ap.error(f"argument --etapa: invalid choice: {a.etapa!r} (choose from {', '.join(map(repr, ETAPAS_DO_GERAR))})")
    if a.cmd == "brief":
        a.destinos = a.destino or []
        if len(a.destinos) > 1 and not (a.alvo == "gerar" and a.gravar and not a.volta):
            ap.error("argument --destino: vários destinos só em `brief gerar --gravar` sem --volta (o lote, P6)")
        if a.gravar and a.alvo != "gerar":
            ap.error("argument --gravar: só vale em `brief gerar`")
        a.destino = a.destinos[0] if a.destinos else None
    if a.cmd == "entrega" and a.pedido_conferir is not None:
        if a.pedido is not None or a.base is not None or a.base_sha is not None or a.desde is not None or a.brief:
            ap.error("entrega --pedido: Base, Base-sha e Desde são calculados e o brief é o selado; sem pedido posicional, --base, --base-sha, --desde e --brief")
    elif a.cmd == "entrega":
        faltam = [nome for nome, valor in (("pedido", a.pedido), ("--base", a.base), ("--base-sha", a.base_sha)) if valor is None]
        if faltam:
            ap.error(f"the following arguments are required: {', '.join(faltam)} (ou use a forma nova `entrega --pedido`)")
        if a.worktree is not None or a.sem_gravar or a.so_leitura:
            ap.error("--worktree, --sem-gravar e --so-leitura só valem com `entrega --pedido`")
    if a.cmd == "brief" and a.incluir and not (a.alvo == "gerar" and a.volta):
        ap.error("argument --incluir: só vale em `brief gerar --volta`")
    raiz = Path(a.raiz).resolve()
    try:
        return executar(a, raiz)
    except subprocess.TimeoutExpired as e:
        print(f"git: tempo esgotado ({GIT_TIMEOUT_S} s) em `{' '.join(map(str, e.cmd[3:5]))}`; tente de novo")
        return 1
    except PedidoFora as e:  # C-2: entrada ilegível em todo chamador, nunca "sem pedido"
        print(f"forge-check: --pedido fora de docs/pedidos/ das raízes: {nome_seguro(sem_controle(e))}")
        return 2


def executar(a, raiz):
    bloqueio = guarda_de_versao(a, raiz)
    if bloqueio is not None:
        return bloqueio
    if a.cmd in ("metricas", "regras", "avaliacao"):
        modulo = governanca()
        if modulo is None:
            print(f"{a.cmd}: bin/forge_governanca.py ausente ao lado do forge-check; nada medido")
            return 2
        return modulo.executar(a, raiz, Path(a.raiz_pedidos).resolve() if a.raiz_pedidos else raiz)
    if a.cmd in ("pedido", "recado", "pausa") or (a.cmd == "decisoes" and a.resposta is not None):
        modulo = modulo_do_dono()
        if modulo is None:
            print(f"{a.cmd}: bin/forge_dono.py ausente ao lado do forge-check; nada feito")
            return 2
        return modulo.executar(a, raiz, {"pedido": pedido_para_anotar, "versao": versao_da_propria_copia, "seguro": sem_controle})
    if a.cmd == "transcricao" and a.acao == "custo":
        return cmd_transcricao_custo(a.alvo, a.entregas, a.entrega, raiz, a.desde, a.ate, a.pedido)
    if a.cmd == "transcricao" and a.acao in TRANSCRICAO_DO_MODULO:
        return cmd_transcricao_do_modulo(a, raiz)
    if a.cmd == "transcricao" and a.acao == "recusas":
        return cmd_transcricao_recusas(a.alvo, raiz)
    if a.cmd == "transcricao" and a.acao == "trava":
        return cmd_transcricao_trava(a.alvo, raiz)
    if a.cmd == "provas" and a.acao == "gerar":
        return cmd_provas_gerar(raiz, a.brief)
    if a.cmd == "parecer" and a.acao == "novo":
        return cmd_parecer_novo(raiz, a)
    if a.cmd == "parecer" and a.acao == "delta":
        return cmd_parecer_delta(raiz, a.arquivo, a.ate, a.base)
    if a.cmd == "classe":
        return cmd_classe(raiz, a.base, a.head, a.como_json)
    if a.cmd == "delta":
        return cmd_delta(raiz, a.refs, a.parecer, a.classe, a.base)
    if a.cmd == "juncao":
        return cmd_juncao(raiz, a.pedido, a.ref, a.base)
    if a.cmd == "vazio":
        rc, linha = diff_vazio(raiz, a.base, a.ref)
        print(linha)
        return rc
    if a.cmd == "entrega" and a.pedido_conferir is not None:
        return cmd_entrega_conferir(raiz, a.pedido_conferir, a.branch, a.etapa, a.worktree, not (a.sem_gravar or a.so_leitura), a.so_leitura)
    if a.cmd == "entrega":
        return cmd_entrega(raiz, a.pedido, a.branch, a.base, a.base_sha, a.etapa, a.desde, a.brief)
    if a.cmd == "voltas":
        return cmd_voltas(raiz, a.pedido)
    if a.cmd == "dora":
        return modulo_do_bin("forge_dora").executar(a, raiz, Path(a.raiz_pedidos).resolve() if a.raiz_pedidos else raiz)
    if a.cmd == "medida":
        return cmd_medida(raiz, a.pedido, a.merge)
    if a.cmd == "retro":
        return cmd_retro(raiz, a.pedido, a.dias)
    if a.cmd == "anotar":
        linhas, rc = cmd_anotar(raiz, a.pedido, a.tipo, a.literal, a.contexto, a.propagar, a.confere)
        print("\n".join(linhas))
        return rc
    if a.cmd == "escape":
        if a.acao == "resumo":
            return cmd_escape_resumo(raiz, a.dias)
        linhas = cmd_escape_registrar(raiz, a.pedido, a.parecer_final, a.achado_por, a.gravidade, a.controle_que_faltou, a.nota, a.origem)
        for linha in linhas:
            print(linha)
        return 1 if linhas[0].startswith("escape:") else 0
    if a.cmd in ("afrouxamentos", "corrigidos"):  # FILA-31 F6 (0.45.7 E5.3): a lógica fica em bin/forge_corrigidos.py
        ctx = {"git": git, "sha_do_commit": sha_do_commit, "nome_seguro": nome_seguro, "sem_controle": sem_controle,
               "carregar_catraca": carregar_catraca}
        return modulo_do_bin("forge_corrigidos").executar(a, raiz, ctx)
    if a.cmd == "esperas":
        return cmd_esperas(raiz, a.pedido, a.kanban)
    if a.cmd == "kanban" and a.gerar:
        linhas, rc = cmd_kanban_gerar(raiz)
        print("\n".join(linhas))
        return rc
    if a.cmd == "fila":
        for linha in cmd_fila(raiz):
            print(linha)
        return 0
    if a.cmd == "brief":
        if a.alvo == "gerar":
            return cmd_brief_gerar(raiz, a.pedido, a.destinos, a.branch, a.base, a.etapa, a if a.volta else None, a.cobre, a.gravar, a.retomada, a.citar)
        if a.alvo == "mensagem":
            return cmd_brief_mensagem(raiz, a)
        if a.alvo == "selar":
            return cmd_brief_selar(raiz, a)
        return cmd_brief_conferir(raiz, a.alvo, a.pedido, a.destino, a.anterior, a.ref, a.parecer)
    if a.cmd == "proximo":
        linhas, codigo = cmd_proximo(raiz, a.pedido, a.item)
        for linha in linhas:
            print(linha)
        return codigo
    if a.cmd in ("rodar", "meta"):
        return modulo_do_bin({"rodar": "forge_run", "meta": "forge_meta"}[a.cmd]).executar(a, raiz)
    if a.cmd == "decisoes" and a.acao:
        return modulo_do_bin("forge_decisor").executar(a, raiz)
    if a.cmd == "decisoes":
        for linha in cmd_decisoes(raiz, a.pedido, a.sem_cartao, a.desde):
            print(linha)
        return 0
    if a.cmd in ("sobreposicao", "movimento"):
        linhas = (cmd_sobreposicao(raiz, a.base) if a.cmd == "sobreposicao"
                  else cmd_movimento(raiz, a.cartao, a.de, a.para, a.motivo,
                                     {"titulo": a.titulo, "pedido": a.pedido, "responsavel": a.responsavel}))
        extra, rc = release_em_curso(raiz, a.ref) if a.cmd == "sobreposicao" and a.ref else ([], 0)
        for linha in linhas + extra:
            print(linha)
        return rc or (1 if (a.cmd == "movimento" and linhas[0].startswith("movimento:"))
                      or (a.cmd == "sobreposicao" and linhas[0].startswith("sobreposicao: erro:")) else 0)
    if a.cmd == "provas" and a.acao == "medida":
        return cmd_provas_medida(raiz, a.desde)
    if a.cmd == "conferencia" and a.acao == "classes":
        for linha in cmd_conferencia_classes(raiz, a.dias):
            print(linha)
        return 0
    if a.cmd == "conferencia":
        linhas = cmd_conferencia_registrar(raiz, a.pedido, a.brief, a.modo, a.rodada, a.resultado, a.merito, a.nota, a.classe, a.autor, a.tardio)
        for linha in linhas:
            print(linha)
        return 1 if linhas[0].startswith("conferencia:") else 0
    if a.cmd == "fontes":
        linhas, codigo = modulo_do_bin("forge_fontes").cmd_fontes()  # FILA-31 F6: a lógica fica em bin/forge_fontes.py
        for linha in linhas:
            print(linha)
        return codigo
    if a.cmd == "transcricao":
        try:
            violacoes = (cmd_transcricao_anonimizar(a.entrada, a.saida) if a.acao == "anonimizar"
                         else cmd_transcricao_verificar(a.arquivo, a.teto))
        except OSError as e:
            print(f"transcricao: arquivo: {sem_controle(e.strerror)}: {caminho_impresso(e.filename)}")
            return 1
        for v in violacoes:
            print(v)
        return 1 if any(not v.startswith("transcricao: aviso:") for v in violacoes) else 0  # aviso não falha
    pendentes = migracao_pendente(raiz)
    if pendentes:
        print(f"forge-check: aviso: migração do Forge pendente ({', '.join(pendentes)}); rode forge-upgrade",
              file=sys.stderr)
    branch_do_pr = None
    if a.cmd == "pr" and getattr(a, "numero_pr", None) is not None:  # E10: o head mesclado do PR vira a ref
        if a.ref is not None:
            print("pr: --pr e --ref não se combinam: o --pr já escolhe a ref (o headRefOid do PR)")
            return 2
        head, branch_do_pr, motivo = head_do_pr_mesclado(raiz, a.numero_pr)
        if motivo:
            print(f"pr: --pr {nome_seguro(sem_controle(a.numero_pr))}: {motivo}; nada conferido (CONF-MERGE-APOS-SQUASH)")
            return 2
        print(f"pr: PR #{a.numero_pr} mesclado: pareceres conferidos no head {head[:7]} (headRefOid de {nome_seguro(branch_do_pr)}), "
              "não no commit do merge", file=sys.stderr)
        a.ref = head
    if a.cmd == "pr":
        a.pedido = pedido_do_pr(raiz, getattr(a, "pedido", ""), getattr(a, "ref", None))
    if a.cmd == "pr" and (uso := uso_do_pr(raiz, getattr(a, "pedido", ""), getattr(a, "ref", None))):
        print(uso)
        return 2
    violacoes = {"docs": lambda: cmd_docs(raiz), "kanban": lambda: cmd_kanban(raiz),
                 "pr": lambda: pr_da_cli(raiz, getattr(a, "pedido", ""), getattr(a, "ref", None), getattr(a, "base", None), branch_do_pr,
                                          previo=getattr(a, "previo", False))}[a.cmd]()
    for v in violacoes:
        print(v)
    if a.cmd == "pr" and not violacoes and not getattr(a, "previo", False):  # LOTE E1; FC-6: o prévio com parecer ausente não é veredito aprovado
        print(veredito_do_pr(raiz, getattr(a, "pedido", ""), getattr(a, "ref", None), getattr(a, "base", None)))
    return 1 if violacoes else 0


if __name__ == "__main__":
    sys.exit(main())
