    br = sub.add_parser("brief", parents=[comum], help="forma, corte e decisões de um brief (C2, C4); `brief gerar` monta os blocos fixos; `brief mensagem` imprime a mensagem ao conferente")
    br.add_argument("alvo", help="arquivo do brief, `gerar`, `selar` (todas as checagens, os campos calculados corrigidos e o selo no ## Histórico do pedido; P1) ou `mensagem` (a mensagem integral ao conferente, opcional, só se o brief passa)")
    br.add_argument("--arquivo", nargs="+", help="em `selar` e `mensagem`: o brief, resolvido só em docs/briefs/ (da raiz ou de ~/.forge-contrib); um só; vários são recusados (um brief por mensagem)")
    br.add_argument("--pedido", required=True, help="id do pedido: grava só em docs/pedidos/<id>.md (caminho de arquivo é recusado)")
    br.add_argument("--destino", nargs="+", help="agente destino, forge:<nome> (vários só em `gerar --gravar`, o lote: um arquivo por destino). Em `mensagem` só é preciso se o brief não tem `Agente destino:` no cabeçalho (antes da primeira seção); se tem, o --destino precisa ser igual ao do brief. Na conferência (`brief <arquivo>`), o padrão é o `Agente destino:` do brief ou o nome do arquivo")
    br.add_argument("--sem-selar", action="store_true", help="só em `selar`: recalcula e regrava os campos derivados (Base-sha, Revisar-sha, --desde) e para, sem conferir nem gravar selo (a ação automática do O1)")
