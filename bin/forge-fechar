#!/usr/bin/env bash
# Forge: fecha uma entrega na branch de integração com os passos mecânicos do integrador (TA-5, R-FLUXO, R-CONTRIB).
# Uso: forge-fechar <pedido> --ref <branch> [--base origin/develop] [--titulo T] [--origem T] [--muda T]
#                  [--medir RUN|ARQUIVO] [--espera SEGUNDOS] [--esperar-rotulo] [--armar] [--limpar] [--sem-limpar] [--dry-run]
#                  [--cartao ID ...] [--quadro PASTA]
# Roda em ordem e para no primeiro erro: (1) forge-check pr; (1c) a árvore do sha conferido é promovível (scripts/promover-homolog.py
# --conferir-ref, do diretório deste script; rc diferente de 0, prazo de 300 s ou script ausente param); (2) git ls-remote do head; (3) abre o PR (ou reusa o aberto, também o rascunho do autor, um só e com o head conferido);
# (2b) se a base andou desde o ponto de partida: com conflito real (`git merge-tree --write-tree`) ou falha de leitura, para; sem conflito avisa e segue,
# sem trazer a base (E8: a base entra uma vez, pelo autor, antes do pedido de merge; o CI do PR confere o merge com ela);
# (4) espera e lê os checks; (5) recusa rótulo pedido (título que o cita ou item do checklist marcado) e ainda não aplicado; (6) merge preso ao head conferido; (7) limpeza.
# R7 / MERGE-LIBERADO (0.43.3): o passo 6 usa o auto-merge do GitHub (`gh pr merge --auto`, preso ao head): quem mescla é o GitHub, só com os
# checks obrigatórios do ruleset verdes; com eles já verdes, o gh mescla na hora. Depois o script espera o MERGED até o fim de --espera.
# --armar: pula a espera do passo 4, arma o auto-merge logo depois do passo 5 e sai com código 4 se o PR ainda não mesclou (o tech-lead
# não fica esperando o CI; a limpeza vem depois com --limpar, que só age com prova de MERGED).
# Código de saída: 0 fechado e limpo; 1 parou; 3 fechado (o merge ocorreu) com limpeza pendente (o resumo "limpeza: ..." lista o comando de cada parte);
# 4 (só com --armar) auto-merge armado, o PR mescla quando os checks obrigatórios passarem; se a base andar antes, rode de novo (M3).
# --limpar: roda só o passo 7, sem forge-check nem merge, e só com prova de PR MERGED na develop para a branch; cada parte é "se existe" (repete sem
# efeito colateral). Rodado de dentro da worktree da própria branch, sai dela para a principal antes de remover. Só apaga a branch (local e remota) se o sha é o do PR mesclado ou já está na base; nunca usa a opção que força.
# --sem-limpar: faz o merge e pula o passo 7: imprime os comandos da limpeza pendente (o `--limpar` primeiro, que confere o sha; worktree, branch local se existe e branch remota) e sai com
# código 3 (fechado, limpeza pendente). Incompatível com --limpar (erro de uso). Serve a quem prefere limpar depois (ou fora do sandbox).
# --esperar-rotulo: em vez de parar quando o PR pede o rótulo do dono e ele não está aplicado, repete a leitura dos checks e do rótulo
# (a cada FORGE_FECHAR_INTERVALO, até --espera) e segue para o merge preso ao head quando o rótulo está no PR e a Catraca verde. Nessa
# espera o check `catraca` vermelho conta como pendente (é ele que pede o rótulo); qualquer outro check vermelho para. O head do PR
# mudar durante a espera para. Prazo esgotado para como sem a opção. O script nunca aplica rótulo nem marca item do checklist.
# Sem a branch local, --ref vale com a branch só no origin (FECHAR-BRANCH-LOCAL): o sha conferido vem do servidor (ls-remote), o commit
# tem de existir aqui (senão pede git fetch origin <branch>).
# Antes do merge (6a), a base é relida: se andou durante os checks, para só com conflito real; sem ele segue (E8).
# Idempotente: head já mesclado na base ou PR já MERGED com este head não abre PR nem mescla de novo (vai direto à limpeza).
# Erro passageiro do GitHub (502): só as operações que não mudam o PR repetem, até 3 vezes (leituras de estado, de PR e de checks; `push --delete`
# da limpeza). Push de código, criação de PR, `pr ready` e merge nunca se repetem sozinhos.
# Só para a develop: a promoção develop -> homolog segue manual (R-FLUXO). Roda só no repositório do Forge (R-CONTRIB).
# Nunca: mescla na main, aplica rótulo, usa --force ou --no-verify, apaga develop/homolog/main/master ou a branch de integração do CLAUDE.md, dispensa parecer ou check.
# --medir RUN|ARQUIVO (FECHAR-MEDIR-DO-LOG): lê as linhas ORCAMENTO-TEMPO do log do CI (número da execução: `gh run view RUN --log`, só
# leitura; ou o log salvo num arquivo), no formato FORMATO_DO_ORCAMENTO; vão ao "Como medir" do PR criado e à saída. Sem elas, para antes do passo 1.
# --cartao ID (repetível; FECHAR-MOVE-CARTAO): com o merge provado (passo 6, PR já MERGED ou --limpar), move o cartão para Pronto por
# `forge-check movimento ID --de <coluna atual> --para Pronto` no quadro de --quadro (padrão ~/.forge-contrib, o do Forge); a coluna atual é o
# `Para` da última linha do cartão em docs/kanban/historico.md, senão a seção dele no KANBAN.md, senão `—`. Já em Pronto, nada grava;
# o movimento que falha vira pendência (código 3) com o comando. ID fora de [A-Za-z0-9._-] ou quadro sem KANBAN.md param antes do passo 1.
# --dry-run só imprime cada passo (e avisa se o diff toca caminho que a catraca protege); não roda forge-check, git remoto nem gh.
# Para teste, com FORGE_FECHAR_TESTE=1: FORGE_CHECK, FORGE_GH, FORGE_PROMOVER (substituem os comandos) e FORGE_FECHAR_INTERVALO
# (segundos entre leituras dos checks). Sem FORGE_FECHAR_TESTE=1 as três primeiras são ignoradas, com aviso.
# FORGE_FECHAR_TETO_DELETE (segundos, 1 a 75, padrão 75): limite de cada uma das 3 tentativas do `git push --delete` da limpeza (com `timeout`);
# estourado ou negado, a limpeza diz que a remota continua viva e sai com código 3. Rodar da raiz com --ref evita o aviso de sair da worktree.
# FECHAR-ESPERA-CI-DEVELOP: um item por vez. Antes do merge (6b), o CI do push no topo da develop tem de estar verde (pendente espera,
# vermelho ou cancelado para); depois do merge e da limpeza (8), o script acompanha o CI do push no commit de merge até o fim
# (--espera-ci, padrão 3600, 0 a 7200). Não verde sai com código 5 (develop vermelha é prioridade máxima) e, se vermelho, o comando de reversão.
# --lote <pedido>:<branch> ... (INTEGRACAO-EM-LOTE, diretriz 26): 2 ou 3 itens sem arquivo em comum (diff de cada um contra a base), com o
# CI da develop verde antes; cada item roda este script com --item-de-lote (sem as duas esperas do CI), em ordem; depois, um só CI, o do
# último merge, é acompanhado até o fim. Vermelho imprime a reversão do lote inteiro e sai com 5; item que para encerra o lote (os de antes
# ficam, e o CI deles é acompanhado). --item-de-lote é só do --lote.
# --promover <sha> (RELEASE-EM-1H, diretriz 27; o <pedido> é release-<versão>): promove para a homolog exatamente o commit da marca, nunca o
# topo da develop: o sha está na develop do servidor, é promovível (1c), o CI do push nele é verde (a prova da develop, reaproveitada); o ramo
# promocao/<versão> nasce nesse sha e o PR para a homolog mescla com --auto --merge preso a ele. Rodar de novo retoma (ramo, PR e MERGED
# reusados). Item mesclado depois da marca fica para a versão seguinte. Nunca toca a main: imprime o PR homolog -> main para o tech-lead.
# FORGE_FECHAR_PAUSA (segundos, padrão 3) é a espera entre as tentativas de leitura repetida.
# Faixas (recusadas antes do passo 1, com a faixa na mensagem): FORGE_FECHAR_PAUSA 1 a 30; FORGE_FECHAR_INTERVALO 5 a 120 (o piso cai
# para 0 só com FORGE_FECHAR_TESTE=1); --espera 0 a 7200. Só inteiro decimal, no máximo 3 dígitos (5 em --espera).
# Log: depois das checagens iniciais, a primeira linha da saída é "log: <caminho>"; todo o resto (stdout e stderr, igual à tela) vai também
# para esse arquivo (modo 600, criado com mktemp), uma linha por registro, com hora UTC, stderr marcado [err] e segredo mascarado; a última
# linha é "fim: código <n>". A lista do prune do passo 7 vai só ao log (marca [prune]); a tela recebe a contagem. Pasta por usuário (sem link, do próprio dono; modo diferente de 700 é ajustado para 700, com aviso): FORGE_FECHAR_LOG_DIR, senão
# $XDG_RUNTIME_DIR/forge-fechar-logs, senão ${TMPDIR:-/tmp}/forge-fechar-logs-<uid>. Log com mais de 14 dias é apagado. Vale também
# para --dry-run. Serve para quando o comando é cortado pelo teto de tempo.
set -euo pipefail

die() { echo "forge-fechar: $*" >&2; exit 1; }
# passo <n> <texto>: imprime o passo, fecha o relógio do anterior e, fora do --dry-run, abre o seu (FF-2, SP6): a linha `subida: <n> <início> <fim>` vai
# só ao log, pela gravar_linha (mascarada); a do 6 leva `MERGED <merge7> <head7>`; o `fim` fecha o último com `rc <código>`.
passo() {
  subida_fecha
  echo "[$1] $2"
  [ "$seco" = 1 ] || { subida_n="$1"; subida_ini="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; }
}
# subida_fecha [sufixo]: grava a linha do passo aberto (nenhum aberto, nada) com o sufixo do merge e o recebido, e o fecha.
subida_fecha() {
  [ -n "$subida_n" ] || return 0
  gravar_linha "" "subida: $subida_n $subida_ini $(date -u +%Y-%m-%dT%H:%M:%SZ)${subida_extra:+ $subida_extra}${1:+ $1}"
  subida_n="" subida_extra=""
}
# I4: checks que o merge exige em `pass` (`skipping`, ausente ou outro estado param), cada um pelo par `workflow/nome`: o `name:` do workflow e o
# dos jobs do CI e da Catraca, como na proteção da develop (decisão 36 do dono); o mesmo nome vindo de outro workflow não conta (C-6).
# Constante: nada no ambiente, argumento ou arquivo a muda; vazia por erro de edição, para.
readonly CHECKS_EXIGIDOS=("CI/bateria" "CI/bateria (python 3.14)" "Catraca/catraca")
[ "${#CHECKS_EXIGIDOS[@]}" -gt 0 ] || die "CHECKS_EXIGIDOS vazia: o merge sem check exigido é recusado (I4)"

pedido="" ref="" base="origin/develop" titulo="" origem="" muda="" medir="" espera=1800 seco=0 esperar=0 limpar=0 sem_limpar=0 so_remota=0 base_2b="" dorme_pid="" promover_teste="" subida_n="" subida_ini="" subida_extra=""  # nascem vazios: o fim nunca age em valor herdado do ambiente (R2 do parecer de segurança do lote a)
armar=0 estado_lido=0  # --armar (R7): arma o auto-merge sem esperar os checks
lote=0 item_de_lote=0 promover_sha="" espera_ci=3600 ci_falhou=0 ci_st="" ci_ruins="" ja_mesclado=1 posicionais=()  # lote, promoção pela marca e espera do CI da develop
cartoes=() quadro="${HOME:-}/.forge-contrib" motivo_cartao="" cartao_pend=0  # FECHAR-MOVE-CARTAO
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) ref="${2-}"; shift 2 || die "--ref pede a branch" ;;
    --base) base="${2-}"; shift 2 || die "--base pede a base" ;;
    --titulo) titulo="${2-}"; shift 2 || die "--titulo pede o texto" ;;
    --origem) origem="${2-}"; shift 2 || die "--origem pede o texto" ;;
    --muda) muda="${2-}"; shift 2 || die "--muda pede o texto" ;;
    --medir) medir="${2-}"; shift 2 || die "--medir pede o número da execução do CI ou o arquivo do log" ;;
    --espera) espera="${2-}"; shift 2 || die "--espera pede os segundos" ;;
    --esperar-rotulo) esperar=1; shift ;;
    --armar) armar=1; shift ;;
    --cartao) cartoes+=("${2-}"); shift 2 || die "--cartao pede o ID do cartão" ;;
    --quadro) quadro="${2-}"; shift 2 || die "--quadro pede a pasta do KANBAN.md" ;;
    --limpar) limpar=1; shift ;;
    --sem-limpar) sem_limpar=1; shift ;;
    --dry-run) seco=1; shift ;;
    --lote) lote=1; shift ;;
    --item-de-lote) item_de_lote=1; shift ;;
    --promover) promover_sha="${2-}"; shift 2 || die "--promover pede o sha do commit da marca" ;;
    --espera-ci) espera_ci="${2-}"; shift 2 || die "--espera-ci pede os segundos" ;;
    -*) die "opção desconhecida: $1" ;;
    *) posicionais+=("$1"); shift ;;
  esac
done

if [ "$lote" = 1 ]; then
  # Só os itens, --base, --espera, --espera-ci e --dry-run: o resto é de cada item, que o lote não repassa.
  if [ -n "$ref$promover_sha$titulo$origem$muda$medir" ] || [ "$limpar$sem_limpar$armar$esperar$item_de_lote" != 00000 ] || [ "${#cartoes[@]}" != 0 ]; then
    die "--lote recebe só os itens <pedido>:<branch> e --base, --espera, --espera-ci ou --dry-run"
  fi
  { [ "${#posicionais[@]}" -ge 2 ] && [ "${#posicionais[@]}" -le 3 ]; } || die "--lote pede 2 ou 3 itens <pedido>:<branch> (diretriz 26); um item só vai sem --lote"
  vistas=" "
  for item in "${posicionais[@]}"; do
    ped_it="${item%%:*}" br_it="${item#*:}"
    if [ "$ped_it" = "$item" ] || ! [[ "$ped_it" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]]; then die "--lote: item fora da forma <pedido>:<branch>: $item"; fi
    git check-ref-format --branch "$br_it" >/dev/null 2>&1 || die "--lote: branch inválida no item $item"
    case "$br_it" in main|master|develop|homolog) die "--lote: a branch do item não pode ser $br_it (R-FLUXO)" ;; esac
    case "$vistas" in *" $br_it "*) die "--lote: a branch $br_it aparece duas vezes" ;; esac
    vistas="$vistas$br_it "
  done
  pedido=lote
else
  [ "${#posicionais[@]}" -le 1 ] || die "pedido repetido: ${posicionais[1]}"
  pedido="${posicionais[0]-}"
fi
[ -n "$pedido" ] || die "informe o pedido (forge-fechar <pedido> --ref <branch>)"
if [ -n "$promover_sha" ]; then
  if [ -n "$ref$titulo$origem$muda$medir" ] || [ "$limpar$sem_limpar$armar$esperar$item_de_lote" != 00000 ] || [ "${#cartoes[@]}" != 0 ]; then
    die "--promover recebe só o pedido da release, o sha da marca e --espera, --espera-ci ou --dry-run"
  fi
  [[ "$promover_sha" =~ ^[0-9a-f]{40}$ ]] || die "--promover pede o sha de 40 hex do commit da marca (recebi: $promover_sha)"
  ref="promocao"  # só para as checagens de nome abaixo; o ramo de verdade é promocao/<versão>, lido do commit
fi
[ "$lote" = 1 ] || [ -n "$ref" ] || die "informe --ref <branch>"
if [ "$lote" = 1 ]; then ref="lote"; fi  # só para as checagens de nome abaixo
[ "$limpar" = 0 ] || [ "$sem_limpar" = 0 ] || die "--limpar e --sem-limpar não combinam: um só roda a limpeza, o outro a pula"
[ "$armar" = 0 ] || [ "$limpar" = 0 ] || die "--armar e --limpar não combinam: o --armar arma o merge, o --limpar só limpa depois dele"
[ "$armar" = 0 ] || [ "$esperar" = 0 ] || die "--armar e --esperar-rotulo não combinam: com o auto-merge armado, o GitHub espera o rótulo e a catraca"
case "$ref" in main|master|develop|homolog) die "a branch da entrega não pode ser $ref (R-FLUXO, R-VERIFY)" ;; esac
# Branch de integração do projeto: a primeira palavra entre crases na linha do CLAUDE.md da raiz que cita "integração"; sem a linha, só a lista fixa.
raiz_proj=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$raiz_proj" ] && [ -f "$raiz_proj/CLAUDE.md" ]; then
  # shellcheck disable=SC2016  # as crases são o padrão a procurar, não uma expansão
  integracao=$(grep -i 'integra[cç][aã]o' "$raiz_proj/CLAUDE.md" 2>/dev/null | grep -o '`[^`]*`' | head -1 | tr -d '`' || true)
  [ -z "$integracao" ] || [ "$ref" != "$integracao" ] || die "a branch da entrega não pode ser $ref: é a branch de integração do CLAUDE.md (R-FLUXO, R-VERIFY)"
fi
git check-ref-format --branch "$ref" >/dev/null 2>&1 || die "--ref não é um nome de branch válido: $ref"
case "$base" in
  origin/develop) alvo=develop; metodo=--squash ;;
  origin/main|main) die "base main recusada: a main é só do dono (R-MAIN)" ;;
  *) die "base fora do fluxo: $base (use origin/develop; a promoção à homolog é manual)" ;;
esac
# faixa <nome> <valor> <mínimo> <máximo> <dígitos>: só inteiro decimal, no máximo <dígitos> dígitos (o tamanho vem antes do valor, para
# número enorme não passar na comparação) e dentro da faixa; compara em base 10 (`08` vale 8). Devolve o valor normalizado em `faixa_valor`.
faixa() {
  local nome="$1" v="$2" min="$3" max="$4" dig="$5"
  if ! { [[ "$v" =~ ^[0-9]+$ ]] && [ "${#v}" -le "$dig" ]; }; then die "$nome pede um número inteiro de $min a $max segundos (recebi: $v)"; fi
  v=$((10#$v))
  { [ "$v" -ge "$min" ] && [ "$v" -le "$max" ]; } || die "$nome fora da faixa: pede de $min a $max segundos (recebi: $v)"
  faixa_valor="$v"
}
for c in "${cartoes[@]}"; do
  [[ "$c" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] || die "--cartao fora da forma (letras, números, ponto, _ e -; até 80): $c"
done
if [ "${#cartoes[@]}" -gt 0 ] && [ ! -f "$quadro/KANBAN.md" ]; then die "--cartao pede o quadro: não há KANBAN.md em $quadro (use --quadro)"; fi
faixa --espera "$espera" 0 7200 5
espera="$faixa_valor"
faixa --espera-ci "$espera_ci" 0 7200 5
espera_ci="$faixa_valor"
# O lote roda cada item por este mesmo script; FORGE_FECHAR_ITEM o troca só com FORGE_FECHAR_TESTE=1, como os outros falsos.
eu="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"

if [ "${FORGE_FECHAR_TESTE:-}" = 1 ]; then
  check="${FORGE_CHECK:-forge-check}"
  gh="${FORGE_GH:-gh}"
  promover_teste="${FORGE_PROMOVER:-}"
  item_cmd="${FORGE_FECHAR_ITEM:-$eu}"
else
  item_cmd="$eu"
  if [ -n "${FORGE_CHECK:-}${FORGE_GH:-}${FORGE_PROMOVER:-}${FORGE_FECHAR_ITEM:-}" ]; then
    echo "aviso: FORGE_CHECK/FORGE_GH/FORGE_FECHAR_ITEM/FORGE_PROMOVER só valem com FORGE_FECHAR_TESTE=1; usando forge-check, gh, promover-homolog e este script reais." >&2
  fi
  check=forge-check
  gh=gh
fi
# As esperas por variável têm teto e piso, antes de qualquer passo: valor alto prende o script, valor que não é número o mata depois do PR
# aberto e intervalo 0 vira leitura do `gh` sem pausa. O piso (pausa 1, intervalo 5) cai para 0 só com FORGE_FECHAR_TESTE=1; o teto vale sempre.
piso_pausa=1 piso_intervalo=5
[ "${FORGE_FECHAR_TESTE:-}" != 1 ] || { piso_pausa=0; piso_intervalo=0; }
faixa FORGE_FECHAR_INTERVALO "${FORGE_FECHAR_INTERVALO:-30}" "$piso_intervalo" 120 3
intervalo="$faixa_valor"
faixa FORGE_FECHAR_PAUSA "${FORGE_FECHAR_PAUSA:-3}" "$piso_pausa" 30 3
pausa="$faixa_valor"
# FECHAR-DA-RAIZ: teto de cada tentativa do `git push --delete` da limpeza (o pre-push roda nele); o pior caso (3 tentativas no teto, 2 pausas de 30 s no máximo e a conferência da remota, 10 s) fica em até 300 s com o teto de 75 s.
faixa FORGE_FECHAR_TETO_DELETE "${FORGE_FECHAR_TETO_DELETE:-75}" 1 75 3
teto_delete="$faixa_valor"
# ler <comando...>: leitura idempotente; imprime a saída da primeira tentativa que passa (até 3, com pausa); falha se as 3 falham.
ler() {
  local n=0 saida_ler
  while :; do
    if saida_ler="$("$@" 2>/dev/null)"; then printf '%s' "$saida_ler"; return 0; fi
    n=$((n + 1))
    [ "$n" -lt 3 ] || return 1
    dormir "$pausa"
  done
}
# com_teto <segundos> <comando...>: roda o comando com limite de tempo quando há `timeout` (sem ele, roda sem limite); o `exec` do teste fica no processo.
com_teto() {
  local t="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$t" "$@"; else "$@"; fi
}
# repetir <comando...>: operação idempotente que só devolve status (push --delete); até 3 tentativas, com pausa.
repetir() {
  local n=0
  while :; do
    "$@" && return 0
    n=$((n + 1))
    [ "$n" -lt 3 ] || return 1
    dormir "$pausa"
  done
}
# remoto_exato <branch> [prefixo...]: sha de refs/heads/<branch> no origin (vazio se não existe); falha se a leitura falha. O padrão do
# `git ls-remote` casa pelo fim do nome (refs/heads/a/refs/heads/<branch> também sai): só vale a linha com a coluna 2 igual ao nome inteiro.
# O prefixo (com_teto 10) roda na frente do git. A coluna 1 tem de ser um sha hexadecimal (40 ou 64 caracteres); linha que casa o nome com outra
# coisa na coluna 1 é leitura que falhou (rc 1), nunca um valor que segue para os passos seguintes.
remoto_exato() {
  local nome="refs/heads/$1" saida_remota; shift
  saida_remota="$("$@" git ls-remote origin "$nome")" || return 1
  printf '%s\n' "$saida_remota" | awk -v r="$nome" '$2 == r { if ((length($1) == 40 || length($1) == 64) && $1 ~ /^[0-9a-f]+$/) print $1; else ruim = 1; exit } END { exit ruim }'
}
# A linha que o teste do orçamento de heredocs imprime (tests/test_hooks.py, FORMATO_DO_ORCAMENTO); a mesma regex, em ERE.
readonly FORMATO_DO_ORCAMENTO='^ORCAMENTO-TEMPO teste=([^[:space:]]+) medido=([0-9]+\.[0-9]{2})s limite=([0-9]+(\.[0-9]+)?)s medida=(cpu|parede) forma=(.+)$'
# medir_do_log <fonte>: define `medida` com as linhas ORCAMENTO-TEMPO do log (o prefixo do `gh run view --log`, job, passo e hora, e o texto
# do unittest -v antes da marca ficam de fora); fonte que não é execução nem arquivo, marca ausente ou linha fora do formato param.
medir_do_log() {
  local fonte="$1" texto linha destravar="rode o CI do PR (o teste do orçamento imprime a linha) e passe o número da execução (gh run list --branch $ref) ou o log salvo"
  if [[ "$fonte" =~ ^[0-9]{1,20}$ ]]; then
    if [ "$seco" = 1 ]; then medida="(lida no passo real: $gh run view $fonte --log)"; return 0; fi
    texto="$(ler "$gh" run view "$fonte" --log)" || die "--medir: não consegui ler o log da execução $fonte do CI ($gh run view $fonte --log), e sem ele não há medida; confira o número e a credencial do gh"
  elif [ -f "$fonte" ] && [ -r "$fonte" ]; then
    texto="$(cat -- "$fonte")"
  else
    die "--medir: '$fonte' não é número de execução do CI nem arquivo legível; o --medir lê a medida do log do CI, não texto livre; $destravar"
  fi
  medida=""
  while IFS= read -r linha; do
    case "$linha" in *"ORCAMENTO-TEMPO "*) ;; *) continue ;; esac
    linha="ORCAMENTO-TEMPO ${linha#*ORCAMENTO-TEMPO }"
    linha="${linha%$'\r'}"
    [[ "$linha" =~ $FORMATO_DO_ORCAMENTO ]] || die "--medir: linha ORCAMENTO-TEMPO fora do formato (FORMATO_DO_ORCAMENTO de tests/test_hooks.py): $linha; o PR sairia com medida que ninguém confere; corrija quem a imprime ou $destravar"
    medida="${medida:+$medida
}$linha"
  done <<<"$texto"
  [ -n "$medida" ] || die "--medir: o log ($fonte) não tem linha ORCAMENTO-TEMPO, e sem ela não há medida do orçamento; $destravar"
}
medida=""
[ -z "$medir" ] || medir_do_log "$medir"
[ -n "$titulo" ] || titulo="$ref"
corpo="## Projeto de origem
${origem:-Forge (melhoria da fábrica, pedido $pedido)}

## Situação observada
Pedido $pedido, branch $ref.

## O que muda
${muda:-Ver o diff e o pedido $pedido.}

## Como medir
${medida:-Ver a seção de medição do pedido $pedido.}

## Checklist
- [ ] Rótulo \`afrouxa-regra\` pedido ao dono (marque só se a mudança afrouxa regra protegida; o dono aplica o rótulo)"

catraca="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/tests/catraca.py"
# FF-1/C-2: o promover-homolog do diretório deste script, nunca o scripts/ da worktree da branch (o cwd vira o dela logo abaixo).
promover="${promover_teste:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/scripts/promover-homolog.py}"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "rode dentro do repositório do Forge"
cd "$(git rev-parse --show-toplevel)"
if ! grep -qE '"name"[[:space:]]*:[[:space:]]*"forge"' .claude-plugin/plugin.json 2>/dev/null; then
  die "este não é o repositório do Forge (sem .claude-plugin/plugin.json com name forge); o fechamento é do tech-lead no Forge (R-CONTRIB)"
fi

# Log em arquivo: stdout e stderr continuam na tela; cada linha também vai ao arquivo, com hora e sem segredo (ver `mascarar`).
# A pasta é por usuário e só é aceita se for diretório de verdade (sem link simbólico) e do próprio usuário; o modo é ajustado para 700 (com aviso), setgid incluído.
if [ -n "${FORGE_FECHAR_LOG_DIR:-}" ]; then
  logdir="$FORGE_FECHAR_LOG_DIR"
elif [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
  logdir="$XDG_RUNTIME_DIR/forge-fechar-logs"
else
  logdir="${TMPDIR:-/tmp}/forge-fechar-logs-$(id -u)"
fi
[ ! -L "$logdir" ] || die "a pasta do log é um link simbólico: $logdir; recusada"
(umask 077; mkdir -p "$logdir") || die "não consegui criar a pasta do log: $logdir"
if ! { [ -d "$logdir" ] && [ ! -L "$logdir" ]; }; then die "a pasta do log não é um diretório (ou virou link simbólico): $logdir"; fi
[ -O "$logdir" ] || die "a pasta do log é de outro dono: $logdir; recusada"
# Caminho absoluto e normalizado (sem `..` nem link no meio): a limpeza do passo 7 troca de diretório e o registrador precisa achar o arquivo depois disso.
logdir="$(cd "$logdir" && pwd -P)" || die "não consegui resolver a pasta do log: $logdir"
# Só o modo se corrige: link, outro dono e não diretório já foram recusados acima; pasta do próprio usuário com modo diferente de 700 vira 700, com aviso.
# O chmod é simbólico porque `chmod 700` mantém o setgid de um diretório (2755 viraria 2700 e o modo seguiria diferente de 700), e `u-s` tira o setuid.
# Sem janela de corrida (FECHAR-TOCTOU): entra na pasta com `cd -P`, confere o dono do diretório já aberto (`.`) e o chmod age sobre `.`, não sobre o
# caminho, que podia virar link entre a checagem e o chmod. `$logdir` já é o caminho resolvido (`pwd -P`).
modo_de() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }
if [ "$(modo_de "$logdir")" != 700 ]; then
  (cd -P "$logdir" && [ -O . ] && chmod u=rwx,go=,g-s,u-s .) 2>/dev/null || die "a pasta do log precisa ter modo 700 e não consegui ajustar: $logdir (chmod 700 ou escolha outra em FORGE_FECHAR_LOG_DIR)"
  [ "$(modo_de "$logdir")" = 700 ] || die "a pasta do log precisa ter modo 700: $logdir (chmod 700 ou escolha outra em FORGE_FECHAR_LOG_DIR)"
  echo "aviso: a pasta do log não tinha modo 700; ajustei para 700: $logdir" >&2
fi
# Retenção: log do próprio usuário com mais de 14 dias, só nesta pasta, sem seguir link.
find "$logdir" -maxdepth 1 -type f -user "$(id -u)" -name 'forge-fechar-*.log' -mtime +14 -delete 2>/dev/null || true
log="$(umask 077; mktemp "$logdir/forge-fechar-$(printf '%s' "$pedido" | tr -c 'A-Za-z0-9._-' '_')-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX.log")" \
  || die "não consegui criar o log em $logdir"
echo "log: $log"
# mascarar: lê uma linha e imprime a versão sem segredo (sem diferença de maiúsculas; `token` em prosa fica intacto, só com = ou : ou JSON).
mascarar() {
  sed -E '
    s/"([A-Za-z_]*(token|secret|password|passwd|key)[A-Za-z_]*)"[[:space:]]*:[[:space:]]*"[^"]*"/"\1": "***"/Ig
    s/(authorization[[:space:]]*:[[:space:]]*).*/\1***/I
    s/(bearer[[:space:]]+)[^[:space:]&"]+/\1***/Ig
    s/(basic[[:space:]]+)[A-Za-z0-9+\/]{8,}=*/\1***/Ig
    s#(://[^/:@[:space:]]+):[^@/[:space:]]+@#\1:***@#g
    s/([A-Za-z_]*(token|secret|password|passwd|key)[A-Za-z_]*[=:])[[:space:]]*[^[:space:]&"]+/\1***/Ig
    s/(gh[pousr]_|github_pat_)[A-Za-z0-9_]+/\1***/g
  '
}
# registrar <fd>: repassa cada linha à tela (fd 1 ou 2) e grava a versão mascarada no log (stderr com prefixo [err]); uma escrita por linha,
# sob flock quando existe, para duas fileiras não partirem a linha uma da outra. A ordem entre stdout e stderr no mesmo segundo não é garantida.
registrar() {
  local linha marca=""
  trap '' TERM INT HUP
  [ "$1" = 2 ] && marca="[err] "
  while IFS= read -r linha || [ -n "$linha" ]; do
    printf '%s\n' "$linha" >&"$1"
    gravar_linha "$marca" "$linha"
  done
}
# gravar_linha <marca> <linha>: grava a linha mascarada, com data e marca, só no log (sem tela).
gravar_linha() {
  local saida
  saida="$(date -u +%Y-%m-%dT%H:%M:%SZ) $1$(printf '%s' "$2" | mascarar)"
  if command -v flock >/dev/null 2>&1; then
    { flock 9; printf '%s\n' "$saida" >&9; } 9>>"$log"
  else
    printf '%s\n' "$saida" >> "$log"
  fi
}
exec > >(registrar 1)
pid_out=$!
exec 2> >(registrar 2)
pid_err=$!
# Ao sair (inclusive em `die`): grava `fim: código <n>`, fecha as duas saídas e espera os registradores terminarem de gravar.
fim() {
  local rc=$?
  trap - EXIT
  trap '' TERM INT HUP
  [ -z "${dorme_pid:-}" ] || kill "$dorme_pid" 2>/dev/null || true
  exec 2>&-
  wait "$pid_err" 2>/dev/null || true
  subida_fecha "rc $rc"
  echo "fim: código $rc"
  exec >&-
  wait "$pid_out" 2>/dev/null || true
  exit "$rc"
}
trap fim EXIT
# Sinal de corte (o teto do Bash do agente manda TERM): sai com 128+n, e o `fim:` grava esse código em vez de um sucesso que não houve.
# Só "fim: código 0" depois da linha "Entrega ... fechada" é sucesso; log sem "fim:" é processo morto sem trap (KILL).
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
[ -z "$medida" ] || printf 'medida: %s\n' "${medida//$'\n'/$'\n'medida: }"
# dormir <segundos>: o sleep roda em segundo plano e o script espera nele (`wait` volta na hora com um sinal tratado); com o sleep em primeiro
# plano o trap de TERM/INT/HUP só correria quando ele acabasse (até o intervalo, 120 s no teto). O `fim` mata o sleep que sobrar.
dormir() {
  sleep "$1" &
  dorme_pid=$!
  wait "$dorme_pid"
  dorme_pid=""
}

# run_do_link <link>: define run_n e job_n com os números da execução e do job lidos do link de um check (`/runs/<n>/job/<j>`, só dígitos, até 20);
# "?" quando o link está fora do padrão. É a extração do resumo verde e da parada do passo 4.
run_do_link() {
  run_n="?" job_n="?"
  if [[ "$1" =~ /runs/([0-9]{1,20})/job/([0-9]{1,20}) ]]; then run_n="${BASH_REMATCH[1]}"; job_n="${BASH_REMATCH[2]}"; fi
}
# dicas_de_log: na parada do passo 4, uma linha `para ler: ...` por execução com check vermelho ou desconhecido (só impressa, nunca executada).
# Só o número da execução, lido do link, entra no comando; o nome do check e o resto do link não. Com TMPDIR, o cache do `gh` vai para lá (no sandbox
# o cache padrão não é gravável), entre aspas simples; sem TMPDIR o comando sai puro (nunca um /tmp previsível). Lê `saida` (a última leitura).
dicas_de_log() {
  local nome_ck estado_ck link_ck vistos=" " cache="" aspa="'"
  [ -z "${TMPDIR:-}" ] || cache="XDG_CACHE_HOME='${TMPDIR//"$aspa"/"$aspa\\$aspa$aspa"}' "
  while IFS=$'\037' read -r nome_ck estado_ck link_ck; do
    run_do_link "$link_ck"
    [ "$run_n" != "?" ] || continue
    case "$vistos" in *" $run_n "*) continue ;; esac
    vistos="$vistos$run_n "
    echo "para ler: ${cache}gh run view $run_n --log-failed" >&2
  done < <(printf '%s\n' "$saida" | awk -F'\t' 'NF>=2 && $2 !~ /^(pass|skipping|pending|queued|in_progress)$/ {print $1 "\037" $2 "\037" $4}')
}

# sha_confere <sha>: o sha é um dos heads mesclados (merged_heads) ou já está na base; só então a branch ou a remota podem ser apagadas.
sha_confere() {
  local h
  for h in $merged_heads; do
    if [ "$h" = "$1" ]; then return 0; fi
  done
  git merge-base --is-ancestor "$1" "$base" 2>/dev/null
}
# tira_c1 <texto>: imprime o texto sem os controles C1 em UTF-8 (U+0080 a U+009F, os bytes C2 80 a C2 9F), que o `tr` por byte não pega.
tira_c1() {
  local LC_ALL=C s="$1"
  printf '%s' "${s//$'\xc2'[$'\x80'-$'\x9f']/}"
}
# aviso_do_rotulo: na parada do passo 4, diz se pedir o rótulo afrouxa-regra ao dono ajuda (só texto em stderr; a decisão da parada não muda).
# O rótulo vale depois do último push: com outro check vermelho, pedi-lo agora não ajuda. Só a catraca vermelha pode ser o pedido do rótulo, e a falha
# fechada dela não se resolve com ele, então manda ler o motivo antes. Os nomes que o script monta na frase passam sem caractere de controle
# (C0, DEL e C1 em UTF-8).
aviso_do_rotulo() {
  local ruins outros
  ruins="$(printf '%s\n' "$saida" | awk -F'\t' 'NF>=2 && $2 !~ /^(pass|skipping|pending|queued|in_progress)$/ {print $1}' | tr -d '\000-\010\013-\037\177')"
  ruins="$(tira_c1 "$ruins")"
  [ -n "$ruins" ] || return 0
  outros="$(printf '%s\n' "$ruins" | grep -vxF catraca || true)"
  if [ -n "$outros" ]; then
    echo "aviso: não peça o rótulo agora: $(printf '%s\n' "$ruins" | paste -sd, - | sed 's/,/, /g') vermelho(s); corrija, faça o push e só depois peça o rótulo (ele vale depois do último push)." >&2
  elif [ "$esperar" = 1 ]; then
    echo "aviso: só a catraca está vermelha mesmo com a espera do rótulo; leia o motivo antes (o log da execução dela); o rótulo vale depois do último push." >&2
  else
    echo "aviso: só a catraca está vermelha: ela pode estar pedindo o rótulo afrouxa-regra, mas a falha fechada dela não se resolve com o rótulo; leia o motivo antes (o log da execução dela). Se for o rótulo, peça ao dono e rode com --esperar-rotulo." >&2
  fi
}
# secao_da_branch: define secao_st (ausente, presente ou ilegivel) para a seção branch.<ref> do .git/config. Compara o NOME exato da seção por texto
# fixo (o ref pode ter `.`; prefixo sozinho casaria a seção da branch `a.b` com a branch `a`) e só dá "ausente" com o código 1 do git (nenhuma seção);
# qualquer outro código (config ilegível) é "ilegivel", nunca "ausente".
secao_da_branch() {
  local nomes rc=0 n
  secao_st=ausente
  nomes="$(git config --local --name-only --get-regexp '^branch\.' 2>/dev/null)" || rc=$?
  case "$rc" in 0) ;; 1) return 0 ;; *) secao_st=ilegivel; return 0 ;; esac
  while IFS= read -r n; do
    if [[ "$n" == "branch.$ref."* ]] && [[ "${n#"branch.$ref."}" != *.* ]]; then secao_st=presente; return 0; fi
  done <<<"$nomes"
}
# estados_da_espera: só com --esperar-rotulo; troca `estados` (lido de `saida`) pelo que a espera do rótulo considera, linha a linha da `catraca`.
# Antes do rótulo, a catraca `fail` é o pedido dele: pendente, e o número da execução entra em `run_cand` (candidatas); o laço do passo 4 as passa para
# `run_antes` (as execuções vistas antes do rótulo, as velhas) só se uma leitura do rótulo posterior aos checks ainda o vê ausente, e as descarta se presente.
# Depois do rótulo: só a linha cuja execução está em `run_antes`, e só em `fail` ou `cancel`, conta como pendente (é a velha, cancelada pela
# concorrência do workflow quando a execução do evento do rótulo começa). A velha só deixa de contar quando a execução nova está na leitura em
# `pass` ou ainda pendente; a nova decide. Execução nova que não é `pass` nem pendente PARA na hora: `fail` (a Catraca reprovou), `cancel` e
# qualquer outra conclusão, `skipping` inclusive (só `pass` libera o merge). `cancel` fora de `run_antes`, ou com link fora do padrão, também para.
# Link fora do padrão (ou rótulo já aplicado na primeira leitura, sem `run_antes`) mantém a rede de 10 leituras, só para `fail`. O `break` do laço
# continua exigindo tudo `pass` ou `skipping` na última leitura, e a velha mapeada nunca chega a ele. Nunca reexecuta nada.
estados_da_espera() {
  local -a nomes=() sts=() runs=()
  local nome_ck estado_ck link_ck run_ck i n=0 nova=0 st
  velha_pendente=""
  while IFS=$'\037' read -r nome_ck estado_ck link_ck; do
    run_ck="?"
    if [[ "$link_ck" =~ /runs/([0-9]{1,20})/job/[0-9]{1,20} ]]; then run_ck="${BASH_REMATCH[1]}"; fi
    nomes[n]="$nome_ck"; sts[n]="$estado_ck"; runs[n]="$run_ck"; n=$((n + 1))
    if ! { [ "$nome_ck" = catraca ] && [ "$run_ck" != "?" ]; }; then continue; fi
    if [ "$rotulo_ok" = 0 ]; then
      case "$run_cand" in *" $run_ck "*) ;; *) run_cand="$run_cand$run_ck " ;; esac
    elif [ "$run_antes" != " " ]; then
      case "$run_antes" in
        *" $run_ck "*) ;;
        *) case "$estado_ck" in pass | pending | queued | in_progress) nova=1 ;; esac ;;
      esac
    fi
  done < <(printf '%s\n' "$saida" | awk -F'\t' 'NF>=2 {print $1 "\037" $2 "\037" $4}')
  estados=""
  for ((i = 0; i < n; i++)); do
    st="${sts[i]}"
    if [ "${nomes[i]}" = catraca ]; then
      if [ "$rotulo_ok" = 0 ]; then
        [ "$st" != fail ] || st=pending
      elif [ "${runs[i]}" != "?" ] && case "$run_antes" in *" ${runs[i]} "*) true ;; *) false ;; esac; then
        if [ "$st" = fail ] || [ "$st" = cancel ]; then
          if [ "$nova" = 1 ]; then st=skipping; else st=pending; velha_pendente="${runs[i]}"; fi
        fi
      elif [ "$st" = fail ]; then
        if [ "${runs[i]}" = "?" ] || [ "$run_antes" = " " ]; then
          [ "$apos_rotulo" -gt 10 ] || st=pending
        else
          echo "aviso: a Catraca do rótulo reprovou (run ${runs[i]}); leia o motivo no log da execução e corrija; o script nunca reexecuta a catraca." >&2
        fi
      elif [ "${runs[i]}" != "?" ] && [ "$run_antes" != " " ]; then
        case "$st" in
          pass | pending | queued | in_progress | cancel) ;;
          *) echo "aviso: a execução nova da Catraca (run ${runs[i]}) não terminou em pass; só pass libera o merge." >&2; st=sem-pass ;;
        esac
      fi
    fi
    estados="${estados:+$estados$'\n'}$st"
  done
}

# exigidos_ok: cada exigido tem linha de workflow e nome iguais (inteiros) em `saida` e TODAS em `pass`, pelo estado original do `gh` (não o `estados` mapeado);
# só com --esperar-rotulo, a `catraca` velha (execução em `run_antes`) não conta. Falha com `exigido_nome` e `exigido_estado` (o lido ou "ausente").
exigidos_ok() {
  local par wf_ex nome_ex nome_ck estado_ck wf_ck link_ck achou
  for par in "${CHECKS_EXIGIDOS[@]}"; do
    wf_ex="${par%%/*}" nome_ex="${par#*/}" achou=0
    while IFS=$'\037' read -r nome_ck estado_ck wf_ck link_ck; do
      if [ "$nome_ck" != "$nome_ex" ] || [ "$wf_ck" != "$wf_ex" ]; then continue; fi
      if [ "$esperar" = 1 ] && [ "$nome_ex" = catraca ] && [[ "$link_ck" =~ /runs/([0-9]{1,20})/job/ ]] && [[ "$run_antes" == *" ${BASH_REMATCH[1]} "* ]]; then continue; fi
      achou=1
      if [ "$estado_ck" != pass ]; then exigido_nome="$nome_ex"; exigido_estado="$estado_ck"; return 1; fi
    done < <(printf '%s\n' "$saida" | awk -F'\t' 'NF>=2 {print $1 "\037" $2 "\037" $3 "\037" $4}')
    if [ "$achou" = 0 ]; then exigido_nome="$nome_ex"; exigido_estado=ausente; return 1; fi
  done
}
msg_exigido() { echo "parou no passo 4: o check exigido $exigido_nome não passou (estado: $exigido_estado${1-}); os exigidos (${CHECKS_EXIGIDOS[*]}) só passam em pass"; }

# leitura_sem_merge <rev>: as linhas que a pendência por commit sem merge imprime no lugar de `worktree remove`, `branch -D` e `push --delete`: um
# comentário e uma leitura (`git log`), cada argumento escapado com `printf '%q'`. Só lê; a ref entra por nome completo (uma tag de mesmo nome não responde
# no lugar da branch) e a remota, pelo sha lido do servidor (a referência de rastreio pode estar velha).
leitura_sem_merge() {
  printf '# confira; só apague depois de decidir\ngit log --oneline %q..%q' "$base" "$1"
}

# podar_orfaos: `git worktree prune -v` do repositório todo (só tira registro de diretório ausente); a lista vai só ao log e a tela recebe a
# contagem, para centenas de registros órfãos não enterrarem a linha `limpeza:` (WORKTREE-ORFAS). LC_ALL=C: a contagem lê o "Removing" sem
# tradução. No sandbox o prune pode ser negado: avisa com o código e o log, e quem decide a pendência é o registro relido depois.
podar_orfaos() {
  local prune_saida prune_rc=0 prune_linha
  prune_saida="$(LC_ALL=C git worktree prune -v 2>&1)" || prune_rc=$?
  while IFS= read -r prune_linha; do gravar_linha "[prune] " "$prune_linha"; done <<< "$prune_saida"
  echo "registro: prune tirou $(grep -c '^Removing ' <<< "$prune_saida") registro(s) de worktree órfã"
  [ "$prune_rc" = 0 ] || echo "aviso: o prune saiu com código $prune_rc; a saída dele está no log: $log" >&2
}
# limpar_entrega: a limpeza do passo 7 e do --limpar, só depois da prova de merge (merged_heads). Cada parte é "se existe", então repete sem efeito
# colateral. Ordem: worktree, branch local, e por último a remota (o pre-push reconhece o push só de remoção, não roda suíte nem espera a fila da trava; PREPUSH-DELETE). Nunca força: worktree suja e branch com commit
# novo ficam pendentes. Resumo sempre gravado; define `pendencia` (0 ou 1) e deixa a decisão do código de saída a quem chama.
limpar_entrega() {
  local arv_st=ok br_st=ok rem_st=ok arvore atual sha_local sha_remoto pend_cmds="" sem_merge=0 leitura_dada=0 rem_leitura=""
  pendencia=0
  # O sha da branch local é conferido ANTES de mexer na worktree: `git worktree remove` apaga os arquivos ignorados (ambiente local) de uma worktree
  # limpa, e uma branch com commit novo (nome reaproveitado depois de um PR antigo mesclado) não pode perdê-los.
  sha_local="$(git rev-parse --verify -q "refs/heads/$ref" || true)"
  # sem_merge: a branch local tem commit que não foi mesclado. Então a pendência dela imprime leitura (leitura_sem_merge), nunca comando que apaga.
  if [ -n "$sha_local" ] && ! sha_confere "$sha_local"; then sem_merge=1; fi
  atual="$(pwd -P)"
  # O caminho é a linha inteira depois de "worktree " (pode ter espaço); o nome da branch não tem.
  arvore="$(git worktree list --porcelain | awk -v b="refs/heads/$ref" '$1=="worktree"{w=substr($0,10)} $1=="branch" && $2==b {print w}')"
  local orfao=0 principal meta=""
  if [ -n "$arvore" ]; then
    if [ -d "$arvore" ] && [ "$(cd "$arvore" && pwd -P)" = "$atual" ]; then
      # Rodado de dentro da worktree da própria branch: sai dela para a worktree principal (a primeira de `worktree list`) antes de remover.
      principal="$(git worktree list --porcelain | awk '$1=="worktree" && !f {print substr($0,10); f=1}')"
      if [ -n "$principal" ] && [ -d "$principal" ] && [ "$(cd "$principal" && pwd -P)" != "$atual" ] && cd "$principal"; then
        echo "registro: saí da worktree de $ref para a principal: $principal"
      else
        if [ "$sem_merge" = 1 ]; then
          echo "aviso: você está na worktree de $ref e não achei outra para sair; a branch local $ref ($sha_local) tem commit que não foi mesclado: saia dela e confira (git log) antes de apagar qualquer coisa." >&2
        else
          echo "aviso: você está na worktree de $ref e não achei outra para sair; saia dela e rode: git worktree remove $(printf '%q' "$arvore") && git branch -D $(printf '%q' "$ref")" >&2
        fi
        arv_st=pendente
      fi
    fi
    if [ "$arv_st" != ok ]; then
      :
    elif [ -n "$sha_local" ] && ! sha_confere "$sha_local"; then
      echo "aviso: a branch local $ref ($sha_local) tem commit que não foi mesclado; não removi a worktree $(printf '%q' "$arvore") (arquivos ignorados dela se perderiam)." >&2
      arv_st=pendente
    elif meta="$(git -C "$arvore" rev-parse --absolute-git-dir 2>/dev/null || true)"; ! git worktree remove "$arvore"; then
      # "Device or resource busy": o diretório pode já ter sumido com o registro administrativo para trás; prune só tira entrada de diretório ausente.
      if [ ! -d "$arvore" ]; then podar_orfaos; fi
      if git worktree list --porcelain | awk -v w="$arvore" '$1=="worktree" && substr($0,10)==w {f=1} END {exit !f}'; then
        if [ -d "$arvore" ]; then
          echo "aviso: não removi a worktree $arvore (suja ou ocupada); se o diretório persistir com a worktree limpa, rode o comando fora do sandbox." >&2
        else
          echo "aviso: registro órfão da worktree $arvore: o diretório já não existe e o prune foi negado (sandbox?). O prune é do repositório todo (tira todo registro de worktree com diretório ausente). A branch local fica pendente enquanto o registro existir." >&2
          orfao=1
        fi
        arv_st=pendente
      fi
    else
      podar_orfaos  # WORKTREE-PRUNE-SANDBOX: os registros que outra sessão do sandbox deixou presos saem aqui, sem esperar o dono
    fi
    # O sandbox prende os metadados (.git/worktrees/<id>) da worktree que já existia quando a sessão abriu: o git não lista mais o registro
    # sem o gitdir, e o prune de um fechamento de outra sessão os tira. Só registro: nada fica para o dono rodar.
    if [ "$arv_st" = ok ] && [ -n "${meta:-}" ] && [ -d "$meta" ]; then
      echo "registro: os metadados da worktree ficaram em $meta (o sandbox os prende nesta sessão); o prune do próximo fechamento os tira"
    fi
    if [ "$arv_st" != ok ]; then
      if [ "$orfao" = 1 ]; then pend_cmds="$pend_cmds
git worktree prune"
      elif [ "$sem_merge" = 1 ]; then
        pend_cmds="$pend_cmds
$(leitura_sem_merge "refs/heads/$ref")"
        leitura_dada=1
      else pend_cmds="$pend_cmds
git worktree remove $(printf '%q' "$arvore")"
      fi
    fi
  fi
  if [ -n "$sha_local" ]; then
    if [ "$arv_st" != ok ]; then
      br_st=pendente
    elif ! sha_confere "$sha_local"; then
      echo "aviso: a branch local $ref ($sha_local) tem commit que não foi mesclado; não a apaguei." >&2
      br_st=pendente
    else
      # O stderr do `branch -D` é guardado e continua impresso: no sandbox o .git/config é protegido e o git avisa "could not lock config file"
      # com código 0, deixando a seção branch.<ref> para trás. A decisão vem do estado do config, não do texto do aviso.
      local br_rc=0 br_err cfg_campo=""
      { br_err="$(git branch -D "$ref" 2>&1 1>&3)"; } 3>&1 || br_rc=$?
      [ -z "$br_err" ] || printf '%s\n' "$br_err" >&2
      if [ "$br_rc" != 0 ]; then
        echo "aviso: não apaguei a branch local $ref." >&2
        br_st=pendente
      else
        secao_da_branch
        case "$secao_st" in
          ausente) [ -z "$br_err" ] || cfg_campo=" config=ok (aviso do git sem efeito)" ;;
          presente)
            cfg_campo=" config=pendente"
            echo "aviso: a branch local $ref foi apagada, mas a seção branch.$ref continua no .git/config (o git não conseguiu gravar o config)." >&2
            pend_cmds="$pend_cmds
git config --local --remove-section $(printf '%q' "branch.$ref")" ;;
          *)
            cfg_campo=" config=pendente"
            echo "aviso: não consegui ler o .git/config para conferir a seção branch.$ref depois de apagar a branch." >&2
            pend_cmds="$pend_cmds
git config --local --list" ;;
        esac
      fi
    fi
    if [ "$br_st" = ok ]; then
      :
    elif [ "$sem_merge" = 1 ]; then
      if [ "$leitura_dada" = 0 ]; then pend_cmds="$pend_cmds
$(leitura_sem_merge "refs/heads/$ref")"; fi
    else pend_cmds="$pend_cmds
git branch -D $(printf '%q' "$ref")"
    fi
  fi
  # O campo do config vai no fim do estado da branch, a última coisa da linha `limpeza:` (só existe quando o passo acima o definiu).
  [ -z "${cfg_campo:-}" ] || br_st="$br_st$cfg_campo"
  if ! sha_remoto="$(remoto_exato "$ref")"; then
    echo "aviso: não consegui ler a branch remota $ref." >&2
    rem_st=pendente
  else
    if [ -z "$sha_remoto" ]; then
      :
    elif ! sha_confere "$sha_remoto"; then
      echo "aviso: a branch remota $ref ($sha_remoto) tem commit que não foi mesclado; não a apaguei." >&2
      rem_st=pendente
      rem_leitura="$(leitura_sem_merge "$sha_remoto")"  # a remota decide pelo sha dela, não pelo da local (C1-1)
    else
      echo "registro: apagando a branch remota $ref (até ${teto_delete}s por tentativa, 3 tentativas)"
      if ! repetir com_teto "$teto_delete" git push origin --delete "refs/heads/$ref"; then
        # O corte (ou uma resposta perdida) pode vir depois de o servidor já ter apagado a ref: confere antes de dizer que ela continua viva.
        if sha_depois="$(remoto_exato "$ref" com_teto 10)"; then
          if [ -z "$sha_depois" ]; then
            echo "registro: a branch remota $ref já não existe no servidor (o comando falhou ou foi cortado depois de apagá-la)"
          else
            echo "aviso: não apaguei a branch remota $ref (a exclusão foi negada, falhou ou passou de ${teto_delete}s); a branch remota continua viva; apague-a (git push origin --delete $(printf '%q' "$ref"))." >&2
            rem_st=pendente
          fi
        else
          echo "aviso: não consegui conferir a branch remota $ref depois de a exclusão falhar ou passar de ${teto_delete}s; ela pode ou não ter sido apagada; confira (git ls-remote origin $(printf '%q' "refs/heads/$ref"))." >&2
          rem_st=pendente
        fi
      fi
    fi
  fi
  if [ "$rem_st" = ok ]; then
    :
  elif [ -n "$rem_leitura" ]; then pend_cmds="$pend_cmds
$rem_leitura"
  else pend_cmds="$pend_cmds
git push origin --delete $(printf '%q' "refs/heads/$ref")"
  fi
  echo "limpeza: remota=$rem_st worktree=$arv_st branch=$br_st"
  if [ -n "$pend_cmds" ]; then
    pendencia=1
    printf 'pendente, rode:%s\n' "$pend_cmds"
  fi
}

# coluna_do_cartao <id>: a coluna atual do cartão no quadro: o `Para` da última linha dele no histórico, senão a seção do KANBAN.md
# (o título `## ` cortado no primeiro ` (`), senão `—` (cartão sem registro). Só leitura.
coluna_do_cartao() {
  local col
  col="$(awk -F'|' -v id="$1" '{ for (i = 2; i <= 5; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i) } $3 == id && $2 ~ /^[0-9][0-9][0-9][0-9]-/ { p = $5 } END { print p }' \
    "$quadro/docs/kanban/historico.md" 2>/dev/null || true)"
  [ -n "$col" ] || col="$(awk -v id="$1" '/^## / { s = substr($0, 4); sub(/ +\(.*/, "", s) } /^\|/ { split($0, c, "|"); gsub(/^[ \t]+|[ \t]+$/, "", c[2]); if (c[2] == id) { print s; exit } }' \
    "$quadro/KANBAN.md" 2>/dev/null || true)"
  printf '%s' "${col:-—}"
}
# mover_cartoes: só depois do merge provado; cada --cartao vai a Pronto pelo `forge-check movimento` (a hora real, o custo e a forma do
# histórico ficam com ele). Já em Pronto não grava de novo (repetir não duplica). Falha não desfaz nada: vira `cartao_pend=1` e o comando.
mover_cartoes() {
  local id de
  for id in "${cartoes[@]}"; do
    de="$(coluna_do_cartao "$id")"
    if [ "$de" = Pronto ]; then echo "cartão $id: já em Pronto; nada gravado"; continue; fi
    if "$check" movimento "$id" --de "$de" --para Pronto --motivo "$motivo_cartao" --raiz "$quadro" >/dev/null; then
      echo "cartão $id: $de -> Pronto ($motivo_cartao)"
    else
      echo "aviso: não movi o cartão $id para Pronto; rode: forge-check movimento $(printf '%q' "$id") --de $(printf '%q' "$de") --para Pronto --motivo $(printf '%q' "$motivo_cartao") --raiz $(printf '%q' "$quadro")" >&2
      cartao_pend=1
    fi
  done
}

# mesclar_auto <método> <head>: o único `gh pr merge` do script (passo 6 e P6), por nome de branch ($ref, que o hook `parecer` exige),
# com --auto e preso ao head.
mesclar_auto() { "$gh" pr merge "$ref" --auto "$1" --match-head-commit "$2"; }

# estado_do_pr: lê o PR de número pr_n (leitura, com repetição) e define pr_estado, pr_head, pr_base e pr_merge ("-" sem commit de merge); vazios se a leitura falhar.
estado_do_pr() {
  local linha
  pr_estado="" pr_head="" pr_base="" pr_merge=""
  linha="$(ler "$gh" pr view "$pr_n" --json state,headRefOid,baseRefName,mergeCommit \
    --jq '"\(.state) \(.headRefOid) \(.baseRefName) \(.mergeCommit.oid // "-")"')" || return 1
  read -r pr_estado pr_head pr_base pr_merge <<<"$linha"
}

# esperar_o_merged (passo 6, R7): depois do `gh pr merge --auto`, relê o estado até MERGED; o GitHub mescla quando os checks obrigatórios
# passam. Com --armar, o PR ainda aberto sai com código 4 (auto-merge armado); sem ele, espera até o fim de --espera e para. A leitura
# que falha deixa o estado vazio e sai da espera: a conferência do MERGED, logo depois, usa esta leitura (não relê) e para.
esperar_o_merged() {
  estado_lido=1
  estado_do_pr || return 0
  while [ "$pr_estado" = OPEN ]; do
    if [ "$armar" = 1 ]; then
      subida_extra="ARMADO ${remoto_sha:0:7}"
      echo "auto-merge armado no PR #$pr_n (head ${remoto_sha:0:7}): o GitHub mescla em $alvo quando os checks obrigatórios passarem."
      echo "a base foi conferida agora, antes dos checks: se a $alvo andar antes do merge (outro PR mesclado), este PR não mescla sozinho; rode o forge-fechar com --armar de novo."
      printf 'depois do merge, rode: forge-fechar %q --ref %q --limpar' "$pedido" "$ref"
      for c in "${cartoes[@]}"; do printf ' --cartao %q' "$c"; done
      [ "${#cartoes[@]}" = 0 ] || printf ' --quadro %q' "$quadro"
      printf '\n'
      exit 4
    fi
    [ $((SECONDS - inicio)) -lt "$espera" ] || die "parou no passo 6: o auto-merge está armado, mas o PR #$pr_n não mesclou após ${espera}s; confira os checks obrigatórios e rode de novo (ou --limpar depois do merge)"
    dormir "$intervalo"
    estado_do_pr || return 0
  done
}

# conflito_com <passo> <sha da base> <o que não foi feito>: rc 0 quando o merge da base no head conferido tem conflito real (`git merge-tree
# --write-tree`, git 2.38 ou mais), com os arquivos em conflito no stderr; rc 1 quando sai limpo. Falha do merge-tree para: nunca vira "limpo".
# E8 (0.45.6): o fechamento não traz a base; só o conflito real para, e quem atualiza a branch é o autor, uma vez, antes do pedido de merge.
conflito_com() {
  local saida st=0
  saida="$(git merge-tree --write-tree --name-only --no-messages "$remoto_sha" "$2")" || st=$?
  case "$st" in
    0) return 1 ;;
    1) echo "arquivos em conflito entre $base e $ref:" >&2
       printf '%s\n' "$saida" | sed '1d' | awk 'NF && !visto[$0]++ {print "  " $0}' >&2
       return 0 ;;
    *) die "parou no passo $1: não consegui calcular o merge de $base em $ref (git merge-tree --write-tree, git 2.38 ou mais); nada foi $3" ;;
  esac
}

# conferir_base (passo 2b, só leitura): a base andou depois do ponto de partida da branch? Falha de leitura PARA (nada de `|| true` aqui):
# só o caso "tudo certo" segue. Com conflito real (merge-tree) para e lista os arquivos; sem conflito avisa e segue, sem trazer a base (E8):
# o CI do PR confere o merge com ela. Não faz fetch nem escreve em refs/: só pede `git fetch origin <base>` quando a base local está velha.
conferir_base() {
  local srv base_sha n
  srv="$(remoto_exato "$alvo")" || die "parou no passo 2b: não consegui ler a $alvo no servidor (nada foi aberto)"
  [ -n "$srv" ] || die "parou no passo 2b: não consegui ler a $alvo no servidor (resposta vazia; nada foi aberto)"
  base_sha="$(git rev-parse --verify --quiet "$base^{commit}")" || die "parou no passo 2b: a base $base não existe aqui; rode: git fetch origin $alvo"
  [ "$srv" = "$base_sha" ] || die "parou no passo 2b: $base ($base_sha) está atrás da $alvo no servidor ($srv); rode: git fetch origin $alvo, e rode de novo"
  base_2b="$base_sha"  # a base que o passo 6a compara antes do merge (CONFLITO-SEMANTICO-ANTES-DO-PR)
  if git merge-base --is-ancestor "$base_sha" "$remoto_sha"; then return 0; else
    [ $? = 1 ] || die "parou no passo 2b: não consegui comparar $base com o head; rode: git fetch origin $alvo"
  fi
  if conflito_com 2b "$base_sha" aberto; then
    die "parou no passo 2b: o merge de $base em $ref tem conflito (nenhum PR foi aberto); atualize a branch (git merge $base), rode a suíte no push e rode de novo"
  fi
  n="$(git rev-list --count "$base_sha" --not "$remoto_sha")" || die "parou no passo 2b: não consegui contar os commits da base"
  echo "a base andou $n commit$([ "$n" = 1 ] || echo s) sem conflito com $ref; não trago a base (E8): o CI do PR confere o merge com ela."
}

# conferir_base_no_merge (passo 6a, CONFLITO-SEMANTICO-ANTES-DO-PR): com o ruleset sem "exigir branch atualizada" (strict=false), outro PR
# pode entrar na base enquanto os checks deste rodam. Antes do merge, relê a base no servidor; se andou desde o passo 2b, para só com conflito
# real (o GitHub não mesclaria); sem conflito segue sem trazer a base (E8): o CI da base, no push do merge, confere o resultado.
# Falha de leitura para (nada é mesclado sem a base conferida).
conferir_base_no_merge() {
  local srv local_base
  [ -n "$base_2b" ] || return 0  # o 2b não rodou (head já na base ou PR já MERGED)
  srv="$(remoto_exato "$alvo")" || die "parou no passo 6a: não consegui ler a $alvo no servidor; nada foi mesclado"
  [ -n "$srv" ] || die "parou no passo 6a: não consegui ler a $alvo no servidor (resposta vazia); nada foi mesclado"
  [ "$srv" != "$base_2b" ] || return 0
  local_base="$(git rev-parse --verify --quiet "$base^{commit}")" || local_base=""
  if [ "$local_base" != "$srv" ] || ! git merge-base --is-ancestor "$base_2b" "$srv" 2>/dev/null; then
    die "parou no passo 6a: a $alvo andou durante os checks ($base_2b -> $srv) e $base não a tem; nada foi mesclado; rode: git fetch origin $alvo, e rode de novo"
  fi
  if conflito_com 6a "$srv" mesclado; then
    die "parou no passo 6a: a $alvo andou durante os checks ($base_2b -> $srv) e o merge dela em $ref tem conflito; nada foi mesclado; atualize a branch (git merge $base), rode a suíte no push e rode de novo"
  fi
  echo "a $alvo andou durante os checks sem conflito com $ref; não trago a base (E8); sigo para o merge."
}

# promovivel <sha> (passo 1c, FF-1, SP4): a árvore do sha conferido passa no promover-homolog --conferir-ref (só leitura). Script ausente,
# rc diferente de 0 e o 124 do prazo param (C-1); o recomeço do 2b roda o script de novo, e o 1c com ele, sobre o head novo (C-3).
promovivel() {
  local saida_1c rc_1c=0
  [ -f "$promover" ] || die "parou no passo 1c: não achei $promover (nada foi aberto nem mesclado)"
  saida_1c="$(timeout 300 python3 -I "$promover" --conferir-ref "$1" 2>&1)" || rc_1c=$?
  [ "$rc_1c" = 0 ] || die "parou no passo 1c: a árvore que entra na $alvo não é promovível (rc $rc_1c; nada foi aberto nem mesclado): $saida_1c
com release na develop ainda não promovida, promova-a (scripts/promover-homolog.py) antes de mesclar outra branch (R-FLUXO)"
}

# esperar_ci <branch> <sha> <segundos> (FECHAR-ESPERA-CI-DEVELOP): relê as execuções do evento push na <branch> para o commit até todas
# concluírem ou o prazo acabar, a cada FORGE_FECHAR_INTERVALO. Define ci_st: verde (todas em success, skipped ou neutral), vermelho (alguma
# com outra conclusão), cancelado (só canceladas: a branch andou e a execução não prova nada), pendente (prazo esgotado, inclusive sem
# execução registrada) ou ilegivel (a leitura falhou 3 vezes). As que não passaram vão para ci_ruins, uma por linha (`run <id> <conclusão>`).
esperar_ci() {
  local t0=$SECONDS linhas
  while :; do
    if ! linhas="$(ler "$gh" run list --branch "$1" --event push --commit "$2" --json databaseId,status,conclusion \
      --jq '.[] | [.databaseId, .status, .conclusion] | @tsv')"; then ci_st=ilegivel; return 0; fi
    ci_ruins="$(printf '%s\n' "$linhas" | awk -F'\t' 'NF >= 2 && $2 == "completed" && $3 !~ /^(success|skipped|neutral)$/ {
      gsub(/[^0-9]/, "", $1); gsub(/[^a-z_]/, "", $3); print "run " $1 " " ($3 == "" ? "?" : $3) }')"
    if [ -n "$ci_ruins" ]; then
      if printf '%s\n' "$ci_ruins" | grep -qv ' cancelled$'; then ci_st=vermelho; else ci_st=cancelado; fi
      return 0
    fi
    # Sem execução registrada, a linha vazia não está "completed": não é verde.
    if printf '%s\n' "$linhas" | awk -F'\t' '$2 != "completed" {f = 1} END {exit f}'; then ci_st=verde; return 0; fi
    if [ $((SECONDS - t0)) -ge "$3" ]; then ci_st=pendente; return 0; fi
    dormir "$intervalo"
  done
}
# msg_ci <branch> <sha>: o motivo da parada pelo ci_st da última esperar_ci.
msg_ci() {
  local ruins
  ruins="$(printf '%s\n' "$ci_ruins" | paste -sd, - | sed 's/,/, /g')"
  case "$ci_st" in
    vermelho) echo "a $1 está vermelha no ${2:0:7} ($ruins): prioridade máxima, corrija ou reverta antes do próximo merge" ;;
    cancelado) echo "o CI do push na $1 no ${2:0:7} foi cancelado ($ruins; a $1 andou depois dele): acompanhe o CI do topo até o fim" ;;
    pendente) echo "o CI do push na $1 no ${2:0:7} não terminou no prazo; acompanhe até o fim (gh run list --branch $1 --commit $2)" ;;
    *) echo "não consegui ler o CI do push na $1 no ${2:0:7} (gh run list)" ;;
  esac
}
# reversao <sha...>: o comando (só impresso) que reverte os merges dados, do último para o primeiro, numa branch nova a partir da base.
reversao() {
  local s lista="" ultimo="${*: -1}"  # a branch da reversão leva o nome do último merge, o do CI vermelho
  for s in "$@"; do lista="$s $lista"; done
  printf 'git fetch origin %s && git switch --no-track -c melhoria/reverte-%s origin/%s && git revert --no-edit %s&& git push origin melhoria/reverte-%s' \
    "$alvo" "${ultimo:0:7}" "$alvo" "$lista" "${ultimo:0:7}"
}
# ci_antes_do_merge <passo>: um item por vez; o topo da base no servidor tem o CI do push verde antes de mais um merge (pendente espera).
ci_antes_do_merge() {
  local topo
  topo="$(remoto_exato "$alvo")" || die "parou no passo $1: não consegui ler a $alvo no servidor; nada foi mesclado"
  [ -n "$topo" ] || die "parou no passo $1: não consegui ler a $alvo no servidor (resposta vazia); nada foi mesclado"
  esperar_ci "$alvo" "$topo" "$espera_ci"
  [ "$ci_st" = verde ] || die "parou no passo $1: $(msg_ci "$alvo" "$topo"); nada foi mesclado (FECHAR-ESPERA-CI-DEVELOP)"
  echo "CI do push na $alvo verde no ${topo:0:7}."
}
# ci_no_merge <sha esperado> <merges do item ou do lote...>: acompanha o CI do push até o fim; não verde avisa (vermelho, com a reversão) e liga ci_falhou.
ci_no_merge() {
  passo 8 "CI do push na $alvo no ${1:0:7} (até ${espera_ci}s)"
  esperar_ci "$alvo" "$1" "$espera_ci"
  if [ "$ci_st" = verde ]; then echo "CI do push na $alvo verde no ${1:0:7}."; return 0; fi
  echo "aviso: $(msg_ci "$alvo" "$1")" >&2
  shift
  [ "$ci_st" != vermelho ] || echo "para reverter: $(reversao "$@")" >&2
  ci_falhou=1
}

# fechar_lote (INTEGRACAO-EM-LOTE, diretriz 26): recusa arquivo em comum, exige o CI da base verde, fecha cada item com --item-de-lote e
# acompanha um só CI, o do último merge. Não volta: sai com 0 (3 com limpeza pendente), 5 (CI não verde) ou 1 (parou).
fechar_lote() {
  local item br sha arqs tabela="" comuns saida_it rc_it m parou="" rc_lote=0
  local -a mesclados=()
  passo L1 "arquivos em comum (diff de cada item contra $base)"
  for item in "${posicionais[@]}"; do
    br="${item#*:}"
    sha="$(git rev-parse --verify -q "refs/heads/$br^{commit}" 2>/dev/null)" || sha="$(remoto_exato "$br")" || sha=""
    if ! { [ -n "$sha" ] && git cat-file -e "$sha^{commit}" 2>/dev/null; }; then die "parou no passo L1: sem a branch $br aqui nem o commit dela do origin; rode git fetch origin $br (nada foi mesclado)"; fi
    arqs="$(git diff --name-only --no-renames "$base...$sha")" || die "parou no passo L1: não consegui ler o diff de $br contra $base (nada foi mesclado)"
    tabela="$tabela$(printf '%s\n' "$arqs" | awk -v b="$br" 'NF {print b "\t" $0}')"$'\n'
  done
  comuns="$(printf '%s' "$tabela" | awk -F'\t' 'NF >= 2 {k = substr($0, length($1) + 2); if ((k in d) && d[k] != $1) print "  " k " (" d[k] " e " $1 ")"; else d[k] = $1}')"
  [ -z "$comuns" ] || die "parou no passo L1: arquivo em comum; esses itens entram um por vez, em ordem de chegada (R-FLUXO); nada foi mesclado:
$comuns"
  echo "sem arquivo em comum entre os ${#posicionais[@]} itens."
  passo L2 "CI do push na $alvo verde antes do lote"
  ci_antes_do_merge L2
  passo L3 "itens em seguida, cada um com --item-de-lote"
  for item in "${posicionais[@]}"; do
    br="${item#*:}" rc_it=0
    echo "item ${item%%:*} ($br):"
    saida_it="$("$item_cmd" "${item%%:*}" --ref "$br" --base "$base" --espera "$espera" --item-de-lote 2>&1)" || rc_it=$?
    printf '%s\n' "$saida_it"
    m="$(printf '%s\n' "$saida_it" | awk '$1 == "merge:" && $2 ~ /^[0-9a-f]+$/ && (length($2) == 40 || length($2) == 64) {s = $2} END {print s}')"
    [ -z "$m" ] || mesclados+=("$m")
    if [ "$rc_it" != 0 ] && [ "$rc_it" != 3 ]; then parou="${item%%:*} ($br) parou com código $rc_it"; break; fi
    [ "$rc_it" = 0 ] || rc_lote=3
  done
  [ "${#mesclados[@]}" = 0 ] || ci_no_merge "${mesclados[${#mesclados[@]}-1]}" "${mesclados[@]}"
  if [ "$ci_falhou" = 1 ]; then
    [ "$ci_st" != vermelho ] || echo "lote vermelho: reverta o lote inteiro (acima), ache o culpado e volte ao um por vez até a $alvo ficar verde (diretriz 26)." >&2
    echo "Lote: ${#mesclados[@]} merge(s) na $alvo; o CI do push não ficou verde (código 5)."
    exit 5
  fi
  [ -z "$parou" ] || die "parou no lote: o item $parou; os ${#mesclados[@]} merge(s) antes dele ficam na $alvo, com o CI do push verde"
  echo "Lote fechado em $alvo: ${#mesclados[@]} merge(s), CI do push verde no último."
  exit "$rc_lote"
}

# promover_marca (RELEASE-EM-1H, diretriz 27): a homolog recebe exatamente o commit da marca, nunca o topo da develop, pelo ramo
# promocao/<versão> preso a ele. Cada passo é "se já feito, retoma" (ramo no mesmo sha, PR aberto ou MERGED), para a espera rodar em segundo
# plano e voltar depois de uma queda com o mesmo comando. Não volta: sai com 0, 3 (ramo de promoção não apagado) ou 1.
promover_marca() {
  local sha="$promover_sha" dev versao ramo r lista ab_base="" ab_head="" url corpo_p
  alvo=homolog
  passo P1 "commit da marca na develop do servidor"
  dev="$(remoto_exato develop)" || die "parou no passo P1: não consegui ler a develop no servidor (nada foi promovido)"
  if ! { [ -n "$dev" ] && git cat-file -e "$dev^{commit}" 2>/dev/null && git cat-file -e "$sha^{commit}" 2>/dev/null; }; then
    die "parou no passo P1: sem o commit da marca ou o topo da develop aqui; rode git fetch origin develop homolog (nada foi promovido)"
  fi
  git merge-base --is-ancestor "$sha" "$dev" 2>/dev/null || die "parou no passo P1: o commit $sha não está na develop do servidor; a promoção leva um commit da develop (R-FLUXO)"
  versao="$(git show "$sha:.claude-plugin/plugin.json" 2>/dev/null | sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([0-9]\{1,4\}\.[0-9]\{1,4\}\.[0-9]\{1,4\}\)".*/\1/p' | head -n 1)" || versao=""
  [ -n "$versao" ] || die "parou no passo P1: não li a versão X.Y.Z do .claude-plugin/plugin.json no commit $sha (nada foi promovido)"
  echo "marca $sha, versão $versao; a develop tem $(git rev-list --count "$sha..$dev") commit(s) depois dela, que ficam para a versão seguinte."
  passo P2 "a marca é promovível: $promover --conferir-ref $sha"
  promovivel "$sha"
  passo P3 "CI do push na develop no commit da marca (a prova da develop, reaproveitada)"
  esperar_ci develop "$sha" "$espera_ci"
  case "$ci_st" in
    verde) echo "CI do push na develop verde no ${sha:0:7}." ;;
    cancelado) echo "aviso: $(msg_ci develop "$sha"); sem a prova da develop, decide o CI do PR de promoção." >&2 ;;
    *) die "parou no passo P3: $(msg_ci develop "$sha"); nada foi promovido" ;;
  esac
  ramo="promocao/$versao"
  passo P4 "ramo $ramo no commit da marca"
  r="$(remoto_exato "$ramo")" || die "parou no passo P4: não consegui ler $ramo no origin (nada foi promovido)"
  if [ -z "$r" ]; then
    git push origin "$sha:refs/heads/$ramo" || die "parou no passo P4: não consegui enviar $ramo (nada foi promovido)"
  elif [ "$r" != "$sha" ]; then
    die "parou no passo P4: $ramo já existe no origin com outro commit ($r), não o da marca; confira e apague-o antes (nada foi promovido)"
  else
    echo "$ramo já está no origin com o commit da marca; retomo."
  fi
  passo P5 "PR $ramo -> homolog"
  lista="$(ler "$gh" pr list --head "$ramo" --state all --limit 30 --json number,state,baseRefName,headRefOid \
    --jq '.[] | "\(.number) \(.state) \(.baseRefName) \(.headRefOid)"')" || die "parou no passo P5: não consegui ler os PRs de $ramo"
  pr_n="$(printf '%s\n' "$lista" | awk -v s="$sha" '$2 == "MERGED" && $3 == "homolog" && $4 == s {print $1; exit}')"
  if [ -n "$pr_n" ]; then
    echo "PR #$pr_n já MERGED na homolog com o commit da marca; retomo."
  else
    [ "$(printf '%s\n' "$lista" | awk '$2 == "OPEN" {n++} END {print n + 0}')" -le 1 ] || die "parou no passo P5: há mais de um PR aberto de $ramo; feche os outros e rode de novo"
    read -r pr_n ab_base ab_head <<<"$(printf '%s\n' "$lista" | awk '$2 == "OPEN" {print $1, $3, $4; exit}')"
    if [ -n "$pr_n" ]; then
      if ! { [ "$ab_base" = homolog ] && [ "$ab_head" = "$sha" ]; }; then die "parou no passo P5: o PR aberto #$pr_n de $ramo tem base $ab_base e head $ab_head, não a homolog e a marca"; fi
      echo "PR #$pr_n já aberto; retomo."
    else
      corpo_p="## Projeto de origem
Forge (promoção da versão $versao pelo commit da marca $sha, pedido $pedido).

## Situação observada
A homolog recebe exatamente o commit da marca; o que a develop recebeu depois dela fica para a versão seguinte (RELEASE-EM-1H).

## O que muda
O conjunto de origin/homolog..$sha; ver o diff.

## Como medir
Tempo do commit da marca até o PR para a main pronto, por versão (diretriz 27, meta de 1 hora).

## Checklist
- [ ] Rótulo \`afrouxa-regra\` pedido ao dono (marque só se a leva afrouxa regra protegida; o dono aplica o rótulo)"
      url="$("$gh" pr create --base homolog --head "$ramo" --title "chore(promoção): $versao para a homolog" --body "$corpo_p")" || die "parou no passo P5: não consegui abrir o PR"
      pr_n=""
      if [ "$(printf '%s\n' "$url" | grep -c .)" = 1 ] && [[ "$url" =~ ^https://[^[:space:]]+/pull/([0-9]{1,9})$ ]]; then pr_n="${BASH_REMATCH[1]}"; fi
      [ -n "$pr_n" ] || die "parou no passo P5: o PR foi criado, mas o número não foi lido; rode de novo (retoma o PR aberto)"
      echo "PR #$pr_n aberto: $url"
    fi
    passo P6 "merge automático preso ao commit da marca (até ${espera}s)"
    ref="$ramo"
    if ! mesclar_auto --merge "$sha"; then echo "aviso: o gh pr merge devolveu erro; confiro o estado do PR." >&2; fi
    inicio=$SECONDS
    estado_do_pr || true
    while [ "$pr_estado" = OPEN ]; do
      [ $((SECONDS - inicio)) -lt "$espera" ] || break
      dormir "$intervalo"
      estado_do_pr || true
    done
  fi
  estado_do_pr || true
  if ! { [ "$pr_estado" = MERGED ] && [ "$pr_head" = "$sha" ] && [ "$pr_base" = homolog ]; }; then
    die "parou no passo P6: o PR #$pr_n não consta MERGED na homolog com o commit da marca (estado: ${pr_estado:-desconhecido}); rode o mesmo comando para retomar"
  fi
  echo "promovida: a homolog recebeu o commit da marca $sha (versão $versao), merge ${pr_merge:0:7}."
  echo "próximo, do tech-lead (só o dono mescla, R-MAIN): gh pr create --base main --head homolog --title 'release $versao'"
  if repetir com_teto "$teto_delete" git push origin --delete "refs/heads/$ramo"; then exit 0; fi
  echo "aviso: não apaguei o ramo $ramo; rode: git push origin --delete refs/heads/$ramo" >&2
  exit 3
}

# ci_do_item: o passo 8 do item que este script mesclou; o item de lote deixa o CI para o lote, e o head já na base não trouxe merge novo.
ci_do_item() { if [ "$ja_mesclado" = 0 ] && [ "$item_de_lote" = 0 ]; then ci_no_merge "$pr_merge" "$pr_merge"; fi; }

if [ "$seco" = 0 ] && [ "$lote" = 1 ]; then fechar_lote; fi
if [ "$seco" = 0 ] && [ -n "$promover_sha" ]; then promover_marca; fi

if [ "$seco" = 1 ] && [ "$lote" = 1 ]; then
  echo "forge-fechar --lote --dry-run: nada será executado."
  passo L1 "git diff --name-only $base...<branch> de cada item (${posicionais[*]}); arquivo em comum para, sem merge"
  passo L2 "$gh run list --branch $alvo --event push --commit <topo da $alvo>: verde antes do lote (pendente espera até ${espera_ci}s)"
  passo L3 "forge-fechar <pedido> --ref <branch> --item-de-lote, um item depois do outro; item que para encerra o lote"
  passo 8 "CI do push na $alvo no último merge, até o fim (até ${espera_ci}s); vermelho imprime a reversão do lote e sai com 5"
  exit 0
fi
if [ "$seco" = 1 ] && [ -n "$promover_sha" ]; then
  echo "forge-fechar --promover --dry-run: nada será executado."
  passo P1 "o commit $promover_sha está na develop do servidor; a versão vem do .claude-plugin/plugin.json dele"
  passo P2 "python3 -I $promover --conferir-ref $promover_sha"
  passo P3 "$gh run list --branch develop --event push --commit $promover_sha: verde (cancelado avisa e segue; o CI do PR decide)"
  passo P4 "git push origin $promover_sha:refs/heads/promocao/<versão> (se já existe no mesmo sha, retoma)"
  passo P5 "$gh pr create --base homolog --head promocao/<versão> (reusa o aberto ou o MERGED)"
  passo P6 "$gh pr merge promocao/<versão> --auto --merge --match-head-commit $promover_sha; espera o MERGED até ${espera}s; apaga o ramo"
  exit 0
fi
if [ "$seco" = 1 ]; then
  echo "forge-fechar --dry-run: nada será executado."
  # Só leitura local: o passo 1 real passa o nome da branch local (FECHAR-REF-POR-NOME), o número do PR só existe depois do passo 3 (o --dry-run não chama gh nem o servidor).
  ref_dry="refs/heads/$ref"
  sha_dry="$(git rev-parse --verify -q "refs/heads/$ref^{commit}" 2>/dev/null)" || { sha_dry="<sha não lido: a branch local não existe>"; ref_dry="$sha_dry"; }
  passo 1 "$check pr $pedido --ref $ref_dry --base $base"
  passo "1c" "python3 -I $promover --conferir-ref $sha_dry (a árvore que entra na $alvo é promovível; rc diferente de 0, prazo de 300 s ou script ausente param)"
  passo 2 "git ls-remote origin refs/heads/$ref (igual ao head local de $ref)"
  passo "2b" "git ls-remote origin refs/heads/$alvo (igual a $base; senão, git fetch origin $alvo); se a base andou, git merge-tree --write-tree do head com ela: com conflito para e lista os arquivos; sem conflito avisa e segue, sem trazer a base (E8) (só leitura; não roda quando o head já está em $base ou o PR já está MERGED)"
  passo 3 "$gh pr create --base $alvo --head $ref --title '$titulo' (se não houver PR aberto; não abre se o head já está em $base ou já tem PR MERGED)"
  passo 4 "$gh pr checks <número do PR, lido no passo 3> (espera até ${espera}s; por JSON; os exigidos, pelo par workflow/nome (${CHECKS_EXIGIDOS[*]}), só passam em pass, os demais em pass ou skipping)"
  passo 5 "$gh pr view <número do PR, lido no passo 3> --json labels (recusa se o título cita afrouxa-regra ou o item do rótulo está marcado no corpo, e o rótulo não está aplicado; com --esperar-rotulo, espera o rótulo do dono e a catraca verde até o fim de --espera)"
  passo "6a" "git ls-remote origin refs/heads/$alvo (a base que o passo 2b leu? se andou durante os checks: com conflito no git merge-tree --write-tree para sem mesclar; sem conflito segue, sem trazer a base (E8); base local velha pede git fetch)"
  [ "$item_de_lote" = 1 ] || passo "6b" "$gh run list --branch $alvo --event push --commit <topo da $alvo>: verde antes do merge (pendente espera até ${espera_ci}s; vermelho para)"
  passo 6 "$gh pr merge $ref --auto $metodo --match-head-commit <head conferido> (auto-merge do GitHub com os checks obrigatórios; base $alvo; recusa base main; PR em rascunho vira pronto; PR já MERGED não repete o merge; espera o MERGED até --espera; com --armar sai com código 4 se ainda não mesclou)"
  for c in "${cartoes[@]}"; do echo "cartão $c: depois do merge, forge-check movimento $c --de $(coluna_do_cartao "$c") --para Pronto --raiz $quadro"; done
  [ "$sem_limpar" = 0 ] || echo "--sem-limpar: o passo 7 é pulado; imprime os comandos da limpeza e sai com código 3 depois do merge."
  passo 7 "git worktree remove <worktree de $ref> (prune se o diretório já sumiu); git branch -D $ref (só com o sha mesclado); git push origin --delete $ref (até 3 tentativas, por último); sai com código 3 se algo ficar pendente"
  [ "$item_de_lote" = 1 ] || passo 8 "CI do push na $alvo no commit de merge, até o fim (até ${espera_ci}s); não verde sai com 5 (vermelho imprime a reversão)"
  [ "$limpar" = 0 ] || echo "--limpar: só o passo 7, com prova de PR MERGED em $alvo ($gh pr list --head $ref); sem prova, recusa."
  # Aviso: os caminhos de controle vêm da lista PROTEGIDOS da própria catraca (tests/catraca.py), sem cópia aqui.
  if ! controles="$(python3 -I - "$(dirname "$catraca")" "$PWD" "$base" "refs/heads/$ref" 2>/dev/null <<'PY'
import importlib.util, sys
pasta, raiz, base, ref = sys.argv[1:5]
sys.path.insert(0, pasta)
spec = importlib.util.spec_from_file_location("catraca", pasta + "/catraca.py")
c = importlib.util.module_from_spec(spec)
spec.loader.exec_module(c)
cod, saida = c.git(raiz, "diff", "--no-renames", "--name-only", "-z", c.base_efetiva(raiz, base, ref), ref)
if cod:  # alterados() devolve lista vazia em erro; aqui o erro tem de aparecer
    sys.exit(1)
for a in (x for x in saida.split("\0") if x):
    if a.startswith(c.PROTEGIDOS):
        print(a)
PY
)"; then
    echo "aviso: não consegui conferir se o diff toca caminho de controle da catraca (tests/catraca.py)."
  elif [ -n "$controles" ]; then
    echo "aviso: o diff de $ref toca caminho de controle que a catraca protege; o rótulo afrouxa-regra do dono vai ser pedido (R-CONFORMIDADE): $(printf '%s' "$controles" | tr '\n' ' ')"
  fi
  exit 0
fi

if [ "$limpar" = 1 ]; then
  passo 7 "limpeza por --limpar (R-FLUXO, Depois do merge): só com prova de PR MERGED em $alvo"
  lista="$(ler "$gh" pr list --head "$ref" --state all --limit 30 --json number,state,baseRefName,headRefOid \
    --jq '.[] | "\(.number) \(.state) \(.baseRefName) \(.headRefOid)"')" || die "parou no --limpar: não consegui ler os PRs de $ref (nada foi apagado)"
  merged_heads="$(printf '%s\n' "$lista" | awk -v b="$alvo" '$2=="MERGED" && $3==b {print $4}')"
  [ -n "$merged_heads" ] || die "parou no --limpar: sem prova de merge: nenhum PR MERGED em $alvo para $ref; nada foi apagado"
  motivo_cartao="mesclado em $alvo (forge-fechar --limpar)"
  mover_cartoes
  limpar_entrega
  if [ "$pendencia" = 0 ] && [ "$cartao_pend" = 0 ]; then echo "Limpeza de $ref concluída."; else exit 3; fi
  exit 0
fi

# Cadeia única (B5): o parecer vale para sha_conferido, o remoto tem de ser esse mesmo sha e o merge sai preso a ele (--match-head-commit). O sha é
# lido antes do passo 1; o sha local é relido depois do passo 1 e de novo no passo 2.
# FECHAR-BRANCH-LOCAL: sem a branch local (worktree já removida, branch de outra instância), o modo só remota lê o sha do servidor
# (ls-remote, nunca a refs/remotes/origin, que pode estar velha), exige o commit aqui e relê o servidor onde leria a branch local.
# FECHAR-REF-POR-NOME: com a branch local, o forge-check recebe refs/heads/<branch>, sem ambiguidade com tag de mesmo nome (lê os pareceres da branch, não do primeiro nome que casa com o sha:
# uma worktree de portão no mesmo head reprovava a conferência); sem a local, o sha do servidor, que não tem nome para ler.
ref_check=""
if sha_conferido="$(git rev-parse --verify -q "refs/heads/$ref^{commit}" 2>/dev/null)"; then ref_check="refs/heads/$ref"; else
  so_remota=1
  sha_conferido="$(remoto_exato "$ref")" || die "parou no passo 1: sem a branch local $ref e sem leitura dela no origin (nada foi aberto)"
  [ -n "$sha_conferido" ] || die "parou no passo 1: a branch $ref não existe aqui nem no origin"
  git cat-file -e "$sha_conferido^{commit}" 2>/dev/null || die "parou no passo 1: sem a branch local e sem o commit $sha_conferido; rode git fetch origin $ref, e rode de novo"
  echo "aviso: sem a branch local $ref; confiro o head do servidor ($sha_conferido)." >&2
  ref_check="$sha_conferido"
fi
# head_atual: o head de $ref onde ele vale (a branch local; no modo só remota, o servidor). Falha de leitura sai com rc 1.
head_atual() {
  if [ "$so_remota" = 1 ]; then remoto_exato "$ref"; else git rev-parse --verify -q "refs/heads/$ref^{commit}" 2>/dev/null; fi
}

# Lock órfão (LOTE-0307-A): um `index.lock` na pasta git da worktree da branch (resto de envio que morreu com a tarefa) trava o avanço da branch
# sem aviso. Só lê e avisa: nunca apaga o lock (quem apaga é o dono ou o Jarvis, depois de conferir que nenhum git está rodando).
arvore_lock="$(git worktree list --porcelain | awk -v b="refs/heads/$ref" '$1=="worktree"{w=substr($0,10)} $1=="branch" && $2==b {print w}')"
if [ -n "$arvore_lock" ] && [ -d "$arvore_lock" ]; then  # pasta já apagada (registro órfão): o passo 7 trata com prune
  pasta_git="$(git -C "$arvore_lock" rev-parse --git-dir 2>/dev/null)" || die "parou antes do passo 1: não consegui ler a pasta git da worktree $arvore_lock"
  case "$pasta_git" in /*) ;; *) pasta_git="$arvore_lock/$pasta_git" ;; esac
  if [ -e "$pasta_git/index.lock" ]; then
    mtime_lock="$(stat -c %Y "$pasta_git/index.lock" 2>/dev/null || stat -f %m "$pasta_git/index.lock" 2>/dev/null || echo "")"
    idade_lock="desconhecida"
    [[ "$mtime_lock" =~ ^[0-9]+$ ]] && idade_lock="$(( ($(date +%s) - mtime_lock) / 60 )) min"
    die "parou antes do passo 1: há um lock do git na worktree de $ref: $pasta_git/index.lock (idade: $idade_lock). Nada foi apagado. Confira que nenhum git está rodando nela e, só então, rode: rm $(printf '%q' "$pasta_git/index.lock")"
  fi
fi

passo 1 "pareceres: $check pr $pedido --ref $ref_check --base $base"
"$check" pr "$pedido" --ref "$ref_check" --base "$base" || die "parou no passo 1: forge-check pr acusou violação (nada foi aberto nem mesclado)"
local_sha="$(head_atual || true)"
[ "$local_sha" = "$sha_conferido" ] || die "parou no passo 1: o head de $ref mudou durante a conferência dos pareceres (conferido $sha_conferido, agora ${local_sha:-ausente}); os pareceres valem para o sha conferido; confira e rode de novo"
passo "1c" "promovível: $promover --conferir-ref $sha_conferido"
promovivel "$sha_conferido"

passo 2 "head no servidor"
local_sha="$(head_atual)" || die "parou no passo 2: a branch $ref não existe ou não foi lida (local ou, no modo só remota, no origin)"
[ "$local_sha" = "$sha_conferido" ] || die "parou no passo 2: o head de $ref mudou depois da conferência dos pareceres (conferido $sha_conferido, agora $local_sha); confira e rode de novo"
remoto_sha="$(remoto_exato "$ref")" || die "parou no passo 2: não consegui ler a branch $ref no origin"
[ -n "$remoto_sha" ] || die "parou no passo 2: $ref não está no origin (git push origin $ref, sem -u)"
[ "$remoto_sha" = "$sha_conferido" ] || die "parou no passo 2: o head local ($sha_conferido) difere do remoto ($remoto_sha); envie a branch"

passo 3 "PR para $alvo"
ja_mesclado=0
if git merge-base --is-ancestor "$remoto_sha" "$base" 2>/dev/null; then
  ja_mesclado=1
  echo "o head de $ref já está em $base; nada a abrir nem a mesclar."
else
  lista="$(ler "$gh" pr list --head "$ref" --state all --limit 30 --json number,state,baseRefName,headRefOid,isCrossRepository \
    --jq '.[] | "\(.number) \(.state) \(.baseRefName) \(.headRefOid) \(.isCrossRepository)"')" || die "parou no passo 3: não consegui ler os PRs de $ref"
  if printf '%s\n' "$lista" | awk -v s="$remoto_sha" -v b="$alvo" '$2=="MERGED" && $3==b && $4==s {f=1} END {exit !f}'; then
    ja_mesclado=1
    echo "já existe PR MERGED em $alvo com o head de $ref; nada a abrir nem a mesclar."
  else
    passo "2b" "base de $alvo"
    conferir_base
    n_abertos="$(printf '%s\n' "$lista" | awk '$2=="OPEN" {n++} END {print n+0}')"
    [ "$n_abertos" -le 1 ] || die "parou no passo 3: há $n_abertos PRs abertos para $ref; feche os outros e rode de novo (o fechamento só reusa um)"
    aberto="$(printf '%s\n' "$lista" | awk '$2=="OPEN" {print $1 " " $3 " " $5 " " $4; exit}')"
    if [ -n "$aberto" ]; then
      read -r pr_n aberto_base aberto_fork aberto_head <<<"$aberto"
      [[ "$pr_n" =~ ^[0-9]{1,9}$ ]] || die "parou no passo 3: o número do PR aberto não é numérico"
      [ "$aberto_fork" != true ] || die "parou no passo 3: o PR aberto #$pr_n vem de um fork (isCrossRepository) com o mesmo nome de branch; o fechamento só vale para PR do próprio repositório"
      [ "$aberto_base" = "$alvo" ] || die "parou no passo 3: o PR aberto #$pr_n tem base $aberto_base, não $alvo; feche-o ou corrija a base (R-MAIN)"
      # O rascunho que o autor abriu na entrega (D-1) só se reusa com o head conferido; o `pr ready` fica no passo 6, depois dos pareceres e do rótulo.
      [ "$aberto_head" = "$remoto_sha" ] || die "parou no passo 3: o PR aberto #$pr_n tem o head ${aberto_head:-desconhecido}, não o conferido no passo 2 ($remoto_sha); envie a branch de novo ou feche o PR"
      echo "PR #$pr_n já aberto; reusado."
    else
      url_pr="$("$gh" pr create --base "$alvo" --head "$ref" --title "$titulo" --body "$corpo")" || die "parou no passo 3: não consegui abrir o PR"
      # O número vem da URL que o create imprime (uma só, terminando em /pull/<n>, só dígitos); sem ele o script para (o PR criado é reusado na rodada seguinte).
      pr_n=""
      if [ "$(printf '%s\n' "$url_pr" | grep -c .)" = 1 ] && [[ "$url_pr" =~ ^https://[^[:space:]]+/pull/([0-9]{1,9})$ ]]; then pr_n="${BASH_REMATCH[1]}"; fi
      [ -n "$pr_n" ] || die "parou no passo 3: o PR foi criado, mas o número não foi lido; rode de novo (reusa o PR aberto)"
      echo "PR #$pr_n aberto: $url_pr"
    fi
  fi
fi

if [ "$ja_mesclado" = 0 ]; then
  inicio=$SECONDS
  apos_rotulo=0
  run_antes=" " run_cand=" " velha_pendente=""
  ultimo_resumo=""
  msg_rotulo="parou no passo 5: o PR pede o rótulo afrouxa-regra (no título ou em item marcado) e o dono ainda não o aplicou; o script nunca aplica rótulo"
  while :; do  # com --esperar-rotulo o laço repete os passos 4 e 5; sem a opção roda uma vez só
  passo 4 "checks (até ${espera}s)"
  falhas=0
  rotulo_ok=0
  if [ "$esperar" = 1 ]; then
    # A espera continua presa ao head conferido no passo 2; push novo durante ela para (o merge também recusaria).
    head_pr="$(ler "$gh" pr view "$pr_n" --json headRefOid --jq .headRefOid || true)"
    [ -z "$head_pr" ] || [ "$head_pr" = "$remoto_sha" ] || die "parou na espera do rótulo: o head do PR ($head_pr) mudou desde o passo 2 ($remoto_sha); confira e rode de novo"
    if ler "$gh" pr view "$pr_n" --json labels --jq '.labels[].name' | grep -qx 'afrouxa-regra'; then
      rotulo_ok=1
      apos_rotulo=$((apos_rotulo + 1))
    fi
  fi
  while :; do
    # --armar (R7): quem espera os checks obrigatórios é o auto-merge do GitHub; o script não lê nem espera os checks aqui.
    [ "$armar" = 0 ] || { echo "--armar: os checks não são esperados aqui; o auto-merge do GitHub mescla só com os obrigatórios verdes."; break; }
    # Por JSON (C-6): nome, estado (bucket), workflow e link por tab; o `@tsv` escapa o tab de um nome, que não desalinha as colunas.
    saida="$("$gh" pr checks "$pr_n" --json name,bucket,link,workflow --jq '.[] | [.name, .bucket, .workflow, .link] | @tsv' 2>&1 || true)"
    estados="$(printf '%s\n' "$saida" | awk -F'\t' 'NF>=2 {print $2}')"
    # Só com --esperar-rotulo: a catraca vermelha é o pedido do rótulo, ou a execução velha logo depois dele (ver estados_da_espera).
    [ "$esperar" = 0 ] || estados_da_espera
    # Uma leitura do rótulo logo depois da leitura dos checks (só enquanto ele está ausente e há candidatas): rótulo ainda ausente promove as
    # candidatas a "velhas" (`run_antes`); rótulo presente as descarta (a execução veio do evento do rótulo, não é velha). Leitura que falha conta
    # como ausente (o lado de antes: no máximo atrasa); falha de leitura nunca descarta. A lista é zerada a cada decisão e só esta leitura a consulta.
    if [ "$esperar" = 1 ] && [ "$rotulo_ok" = 0 ] && [ "$run_cand" != " " ]; then
      if ! ler "$gh" pr view "$pr_n" --json labels --jq '.labels[].name' | grep -qx 'afrouxa-regra'; then
        for c_cand in $run_cand; do
          case "$run_antes" in *" $c_cand "*) ;; *) run_antes="$run_antes$c_cand " ;; esac
        done
      fi
      run_cand=" "
    fi
    if [ -z "$estados" ]; then
      # PR recém-aberto: o GitHub ainda não registrou os checks ("no checks reported"); espera, como um check pendente.
      if [ -z "$saida" ] || printf '%s' "$saida" | grep -qi 'no checks reported'; then
        [ $((SECONDS - inicio)) -lt "$espera" ] || die "parou no passo 4: nenhum check apareceu após ${espera}s"
        dormir "$intervalo"
        continue
      fi
      # erro passageiro do GitHub (502): leitura, repete até 3 vezes seguidas.
      falhas=$((falhas + 1))
      [ "$falhas" -lt 3 ] || die "parou no passo 4: não consegui ler os checks: $saida"
      dormir "$pausa"
      continue
    fi
    falhas=0
    if printf '%s\n' "$estados" | grep -qvE '^(pass|skipping|pending|queued|in_progress)$'; then
      aviso_do_rotulo
      printf '%s\n' "$saida" >&2
      dicas_de_log
      die "parou no passo 4: há check vermelho ou desconhecido; corrija e rode de novo"
    fi
    # Uma linha no log por mudança de contagem (não enche o log na espera longa).
    resumo="checks: pass=$(printf '%s\n' "$estados" | grep -cE '^(pass|skipping)$' || true) pendentes=$(printf '%s\n' "$estados" | grep -cE '^(pending|queued|in_progress)$' || true)"
    [ "$resumo" = "$ultimo_resumo" ] || { echo "$resumo"; ultimo_resumo="$resumo"; }
    pendente=0; printf '%s\n' "$estados" | grep -qE '^(pending|queued|in_progress)$' && pendente=1
    if [ "$pendente" = 0 ]; then  # com pendente, os exigidos ainda não decidem
      exigidos_ok && break
      [ "$exigido_estado" = ausente ] || die "$(msg_exigido)"  # ausente espera até --espera, como o pendente
    fi
    if [ $((SECONDS - inicio)) -ge "$espera" ]; then
      [ "$esperar" = 0 ] || [ "$rotulo_ok" = 1 ] || die "$msg_rotulo"
      [ -z "$velha_pendente" ] || die "parou no passo 4: o rótulo foi aplicado, mas só a execução velha da Catraca (run $velha_pendente) aparece após ${espera}s; confira se o evento do rótulo gerou a execução nova; o script nunca reexecuta a catraca"
      [ "$pendente" = 1 ] || die "$(msg_exigido " após ${espera}s")"  # o exigido ausente, já lido acima
      die "parou no passo 4: checks ainda pendentes após ${espera}s"
    fi
    dormir "$intervalo"
    # com a espera do rótulo, o laço de fora relê o rótulo e o head a cada volta
    [ "$esperar" = 0 ] || continue 2
  done
  [ "$armar" = 1 ] || echo "checks verdes (exigidos em pass: ${CHECKS_EXIGIDOS[*]})."
  # Só apresentação (não muda nenhuma decisão do passo 4): run e job de cada check, lidos do link da última leitura, sem chamada nova.
  [ "$armar" = 1 ] || while IFS=$'\037' read -r nome_ck estado_ck link_ck; do
    run_do_link "$link_ck"
    echo "check $nome_ck $estado_ck run=$run_n job=$job_n"
  done < <(printf '%s\n' "$saida" | awk -F'\t' 'NF>=2 {print $1 "\037" $2 "\037" $4}')
  echo "head: $remoto_sha"

  passo 5 "rótulo"
  rotulos="$(ler "$gh" pr view "$pr_n" --json labels --jq '.labels[].name')" || die "parou no passo 5: não consegui ler os rótulos do PR"
  texto="$(ler "$gh" pr view "$pr_n" --json title,body --jq '.title, .body')" || die "parou no passo 5: não consegui ler o título e o corpo do PR"
  # O título é o lugar oficial do sinal de afrouxamento (primeira linha do texto): citar o rótulo nele já para.
  # No corpo, só a linha de item marcado (`- [x]`, `* [X]`, `+ [x]`, `1. [x]`, `1) [x]`) que cita o rótulo; texto que apenas o menciona não para.
  if ! printf '%s\n' "$rotulos" | grep -qx 'afrouxa-regra'; then
    gatilho=""
    if printf '%s\n' "$texto" | head -n 1 | grep -qi 'afrouxa-regra'; then
      gatilho="pelo título"
    elif printf '%s\n' "$texto" | tail -n +2 | grep -qiE '^[[:space:]]*([-*+]|[0-9]+[.)])[[:space:]]+\[x\].*afrouxa-regra'; then
      gatilho="por um item marcado do corpo"
    fi
    if [ -n "$gatilho" ]; then
      if [ "$esperar" = 1 ] && [ $((SECONDS - inicio)) -lt "$espera" ]; then
        echo "aguardando o rótulo afrouxa-regra do dono, pedido $gatilho (o script nunca o aplica)..."
        dormir "$intervalo"
        continue
      fi
      dica="; depois que o dono aplicar o rótulo, rode de novo com --esperar-rotulo"
      [ "$esperar" = 0 ] || dica=""
      die "parou no passo 5: o rótulo afrouxa-regra foi pedido $gatilho e o dono ainda não o aplicou; o script nunca aplica rótulo$dica"
    fi
  fi
  break
  done

  passo "6a" "base de $alvo antes do merge"
  conferir_base_no_merge
  if [ "$item_de_lote" = 0 ]; then
    passo "6b" "CI do push na $alvo verde antes do merge (um item por vez, até ${espera_ci}s)"
    ci_antes_do_merge 6b
  fi
  passo 6 "merge ($metodo) em $alvo"
  # As leituras do passo 6 vão pelo número do PR (lido no passo 3); o merge continua por nome de branch (o hook `parecer` o exige) e preso ao head.
  pre="$(ler "$gh" pr view "$pr_n" --json baseRefName,isDraft,state,headRefOid,isCrossRepository --jq '"\(.baseRefName) \(.isDraft) \(.state) \(.headRefOid) \(.isCrossRepository)"')" || die "parou no passo 6: não consegui ler a base do PR"
  read -r pre_base pre_rascunho pre_estado pre_head pre_fork <<<"$pre"
  [ "$pre_base" != main ] || die "parou no passo 6: o PR tem base main; a main é só do dono (R-MAIN)"
  [ "$pre_base" = "$alvo" ] || die "parou no passo 6: o PR tem base $pre_base, não $alvo"
  [ "$pre_fork" != true ] || die "parou no passo 6: o PR #$pr_n vem de um fork (isCrossRepository); o fechamento só vale para PR do próprio repositório"
  [ "$pre_head" = "$remoto_sha" ] || die "parou no passo 6: o head do PR #$pr_n (${pre_head:-desconhecido}) difere do conferido no passo 2 ($remoto_sha); confira e rode de novo"
  if [ "${pre_estado:-OPEN}" = MERGED ]; then
    echo "o PR já consta como MERGED; o merge não se repete."
  else
    # O ready e o merge agem no PR que o gh resolve pelo nome da branch (o hook `parecer` o exige): releio por esse nome e paro se não for o pr_n guardado.
    # Sobra só a janela entre esta leitura e o merge (um PR novo do mesmo head aberto nesse intervalo); o --match-head-commit prende o head, não o PR.
    por_nome="$(ler "$gh" pr view "$ref" --json number --jq '.number')" || die "parou no passo 6: não consegui reler o PR pelo nome da branch"
    [ "$por_nome" = "$pr_n" ] || die "parou no passo 6: o nome da branch $ref resolve para o PR #${por_nome:-desconhecido}, não para o #$pr_n guardado; há mais de um PR aberto desse head; feche o outro e rode de novo"
    if [ "$pre_rascunho" = true ]; then
      "$gh" pr ready "$ref" || die "parou no passo 6: não consegui marcar o PR como pronto"
    fi
    # O merge muda o PR: não se repete sozinho. Se falhou, só se lê o estado: um 502 após o merge feito já deixou o PR MERGED.
    # R7: `--auto` entrega o merge ao GitHub, que só mescla com os checks obrigatórios verdes (nunca --admin; o hook o recusa).
    if ! mesclar_auto "$metodo" "$remoto_sha"; then
      estado_do_pr || true
      [ "$pr_estado" = MERGED ] || die "parou no passo 6: o merge falhou (ou o head do PR mudou desde o passo 2)"
      echo "o merge devolveu erro, mas o PR consta como MERGED; confiro o head, a base e o commit de merge abaixo."
    fi
    esperar_o_merged
  fi
  # MERGED só vale para este PR, com o head conferido no passo 2, na base alvo e com commit de merge (um MERGED de outro head não é sucesso).
  [ "$estado_lido" = 1 ] || estado_do_pr || true
  [ "$pr_estado" = MERGED ] || die "parou no passo 6: o PR não consta como MERGED (estado: ${pr_estado:-desconhecido})"
  [ "$pr_head" = "$remoto_sha" ] || die "parou no passo 6: o PR #$pr_n consta MERGED com o head ${pr_head:-desconhecido}, não o conferido ($remoto_sha); não conto como sucesso"
  [ "$pr_base" = "$alvo" ] || die "parou no passo 6: o PR #$pr_n consta MERGED na base ${pr_base:-desconhecida}, não em $alvo"
  if ! { [ -n "$pr_merge" ] && [ "$pr_merge" != "-" ]; }; then die "parou no passo 6: o PR #$pr_n consta MERGED sem commit de merge; confira no GitHub"; fi
  echo "merge: $pr_merge"
  subida_extra="MERGED ${pr_merge:0:7} ${remoto_sha:0:7}"
fi

if [ "$ja_mesclado" = 0 ]; then motivo_cartao="mesclado em $alvo: PR #$pr_n, merge ${pr_merge:0:7}"; else motivo_cartao="mesclado em $alvo: head ${remoto_sha:0:7}"; fi
mover_cartoes
passo 7 "limpeza (R-FLUXO, Depois do merge)"
merged_heads="$remoto_sha"
if [ "$sem_limpar" = 1 ]; then
  arvore_sl="$(git worktree list --porcelain | awk -v b="refs/heads/$ref" '$1=="worktree"{w=substr($0,10)} $1=="branch" && $2==b {print w}')"
  echo "limpeza: pulada (--sem-limpar)"
  printf 'pendente, rode:\n'
  # O --limpar vem primeiro porque confere o sha antes de apagar (R-VERIFY); os comandos soltos abaixo não conferem nada. O `branch -D` só entra se a branch local existe.
  printf 'forge-fechar %q --ref %q --limpar\n' "$pedido" "$ref"
  # O sha local é relido aqui (ele pode andar durante a espera): com commit que não foi mesclado, a linha é de leitura, não a que apaga (C1-2).
  sha_sl="$(git rev-parse --verify -q "refs/heads/$ref" || true)"
  if [ -n "$sha_sl" ] && ! sha_confere "$sha_sl"; then
    printf '%s\n' "$(leitura_sem_merge "refs/heads/$ref")"
  else
    [ -z "$arvore_sl" ] || printf 'git worktree remove %q\n' "$arvore_sl"
    ! git rev-parse --verify -q "refs/heads/$ref" >/dev/null || printf 'git branch -D %q\n' "$ref"
  fi
  # A remota também é relida (C1-2): só o sha mesclado (ou a remota já sem a ref) imprime o comando que apaga; commit não mesclado vira leitura e leitura que falha, só um aviso (sem comando).
  sha_rsl=""
  if sha_rsl="$(remoto_exato "$ref")" && { [ -z "$sha_rsl" ] || sha_confere "$sha_rsl"; }; then
    printf 'git push origin --delete %q\n' "refs/heads/$ref"
  elif [ -n "$sha_rsl" ]; then printf '%s\n' "$(leitura_sem_merge "$sha_rsl")"
  else printf '# não consegui ler a branch remota; confira o servidor antes de apagar\n'
  fi
  ci_do_item
  echo "Entrega $pedido fechada em $alvo; limpeza pulada por --sem-limpar (código 3): rode o --limpar acima (confere o sha antes de apagar) ou os comandos soltos."
  [ "$ci_falhou" = 0 ] || { echo "O CI do push na $alvo não ficou verde (código 5): veja o aviso do passo 8."; exit 5; }
  exit 3
fi
limpar_entrega
ci_do_item
if [ "$ci_falhou" = 1 ]; then
  echo "Entrega $pedido fechada em $alvo; o CI do push na $alvo não ficou verde (código 5): veja o aviso do passo 8$([ "$pendencia$cartao_pend" = 00 ] || echo " e a limpeza pendente acima")."
  exit 5
elif [ "$pendencia" = 0 ] && [ "$cartao_pend" = 0 ]; then
  echo "Entrega $pedido fechada em $alvo."
else
  echo "Entrega $pedido fechada em $alvo; com pendência (código 3): rode os comandos acima ou forge-fechar $(printf '%q' "$pedido") --ref $(printf '%q' "$ref") --limpar."
  exit 3
fi
