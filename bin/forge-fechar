#!/usr/bin/env bash
# Forge: fecha uma entrega na branch de integração com os passos mecânicos do integrador (TA-5, R-FLUXO, R-CONTRIB).
# Uso: forge-fechar <pedido> --ref <branch> [--base origin/develop] [--titulo T] [--origem T] [--muda T]
#                  [--medir T] [--espera SEGUNDOS] [--esperar-rotulo] [--dry-run]
# Roda em ordem e para no primeiro erro: (1) forge-check pr; (2) git ls-remote do head; (3) abre o PR (ou reusa o aberto);
# (4) espera e lê os checks; (5) recusa rótulo pedido (título que o cita ou item do checklist marcado) e ainda não aplicado; (6) merge preso ao head conferido; (7) limpeza.
# --esperar-rotulo: em vez de parar quando o PR pede o rótulo do dono e ele não está aplicado, repete a leitura dos checks e do rótulo
# (a cada FORGE_FECHAR_INTERVALO, até --espera) e segue para o merge preso ao head quando o rótulo está no PR e a Catraca verde. Nessa
# espera o check `catraca` vermelho conta como pendente (é ele que pede o rótulo); qualquer outro check vermelho para. O head do PR
# mudar durante a espera para. Prazo esgotado para como sem a opção. O script nunca aplica rótulo nem marca item do checklist.
# Idempotente: head já mesclado na base ou PR já MERGED com este head não abre PR nem mescla de novo (vai direto à limpeza).
# Erro passageiro do GitHub (502): só as operações que não mudam o PR repetem, até 3 vezes (leituras de estado, de PR e de checks; `push --delete`
# da limpeza). Push de código, criação de PR, `pr ready` e merge nunca se repetem sozinhos.
# Só para a develop: a promoção develop -> homolog segue manual (R-FLUXO). Roda só no repositório do Forge (R-CONTRIB).
# Nunca: mescla na main, aplica rótulo, usa --force ou --no-verify, apaga develop/homolog/main, dispensa parecer ou check.
# --dry-run só imprime cada passo (e avisa se o diff toca caminho que a catraca protege); não roda forge-check, git remoto nem gh.
# Para teste, com FORGE_FECHAR_TESTE=1: FORGE_CHECK, FORGE_GH (substituem os comandos) e FORGE_FECHAR_INTERVALO (segundos entre
# leituras dos checks). Sem FORGE_FECHAR_TESTE=1 as duas primeiras são ignoradas, com aviso.
# FORGE_FECHAR_PAUSA (segundos, padrão 3) é a espera entre as tentativas de leitura repetida.
# Log: depois das checagens iniciais, a primeira linha da saída é "log: <caminho>"; todo o resto (stdout e stderr, igual à tela) vai também
# para esse arquivo (modo 600), uma linha por registro, com hora UTC e segredo mascarado. Pasta: FORGE_FECHAR_LOG_DIR
# (padrão ${TMPDIR:-/tmp}/forge-fechar-logs). Vale também para --dry-run. Serve para quando o comando é cortado pelo teto de tempo.
set -euo pipefail

die() { echo "forge-fechar: $*" >&2; exit 1; }
passo() { echo "[$1] $2"; }

pedido="" ref="" base="origin/develop" titulo="" origem="" muda="" medir="" espera=1800 seco=0 esperar=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) ref="${2-}"; shift 2 || die "--ref pede a branch" ;;
    --base) base="${2-}"; shift 2 || die "--base pede a base" ;;
    --titulo) titulo="${2-}"; shift 2 || die "--titulo pede o texto" ;;
    --origem) origem="${2-}"; shift 2 || die "--origem pede o texto" ;;
    --muda) muda="${2-}"; shift 2 || die "--muda pede o texto" ;;
    --medir) medir="${2-}"; shift 2 || die "--medir pede o texto" ;;
    --espera) espera="${2-}"; shift 2 || die "--espera pede os segundos" ;;
    --esperar-rotulo) esperar=1; shift ;;
    --dry-run) seco=1; shift ;;
    -*) die "opção desconhecida: $1" ;;
    *) [ -z "$pedido" ] || die "pedido repetido: $1"; pedido="$1"; shift ;;
  esac
done

[ -n "$pedido" ] || die "informe o pedido (forge-fechar <pedido> --ref <branch>)"
[ -n "$ref" ] || die "informe --ref <branch>"
case "$ref" in main|develop|homolog) die "a branch da entrega não pode ser $ref (R-FLUXO)" ;; esac
git check-ref-format --branch "$ref" >/dev/null 2>&1 || die "--ref não é um nome de branch válido: $ref"
case "$base" in
  origin/develop) alvo=develop; metodo=--squash ;;
  origin/main|main) die "base main recusada: a main é só do dono (R-MAIN)" ;;
  *) die "base fora do fluxo: $base (use origin/develop; a promoção à homolog é manual)" ;;
esac
[[ "$espera" =~ ^[0-9]+$ ]] || die "--espera pede um número de segundos"

if [ "${FORGE_FECHAR_TESTE:-}" = 1 ]; then
  check="${FORGE_CHECK:-forge-check}"
  gh="${FORGE_GH:-gh}"
else
  if [ -n "${FORGE_CHECK:-}${FORGE_GH:-}" ]; then
    echo "aviso: FORGE_CHECK/FORGE_GH só valem com FORGE_FECHAR_TESTE=1; usando forge-check e gh reais." >&2
  fi
  check=forge-check
  gh=gh
fi
intervalo="${FORGE_FECHAR_INTERVALO:-30}"
pausa="${FORGE_FECHAR_PAUSA:-3}"
[[ "$pausa" =~ ^[0-9]+$ ]] || die "FORGE_FECHAR_PAUSA pede um número de segundos"
# ler <comando...>: leitura idempotente; imprime a saída da primeira tentativa que passa (até 3, com pausa); falha se as 3 falham.
ler() {
  local n=0 saida_ler
  while :; do
    if saida_ler="$("$@" 2>/dev/null)"; then printf '%s' "$saida_ler"; return 0; fi
    n=$((n + 1))
    [ "$n" -lt 3 ] || return 1
    sleep "$pausa"
  done
}
# repetir <comando...>: operação idempotente que só devolve status (push --delete); até 3 tentativas, com pausa.
repetir() {
  local n=0
  while :; do
    "$@" && return 0
    n=$((n + 1))
    [ "$n" -lt 3 ] || return 1
    sleep "$pausa"
  done
}
[ -n "$titulo" ] || titulo="$ref"
corpo="## Projeto de origem
${origem:-Forge (melhoria da fábrica, pedido $pedido)}

## Situação observada
Pedido $pedido, branch $ref.

## O que muda
${muda:-Ver o diff e o pedido $pedido.}

## Como medir
${medir:-Ver a seção de medição do pedido $pedido.}

## Checklist
- [ ] Rótulo \`afrouxa-regra\` pedido ao dono (marque só se a mudança afrouxa regra protegida; o dono aplica o rótulo)"

catraca="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/tests/catraca.py"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "rode dentro do repositório do Forge"
cd "$(git rev-parse --show-toplevel)"
if ! grep -qE '"name"[[:space:]]*:[[:space:]]*"forge"' .claude-plugin/plugin.json 2>/dev/null; then
  die "este não é o repositório do Forge (sem .claude-plugin/plugin.json com name forge); o fechamento é do tech-lead no Forge (R-CONTRIB)"
fi

# Log em arquivo: stdout e stderr continuam na tela; cada linha também vai ao arquivo, com hora e sem segredo (token, Bearer).
logdir="${FORGE_FECHAR_LOG_DIR:-${TMPDIR:-/tmp}/forge-fechar-logs}"
(umask 077; mkdir -p "$logdir") || die "não consegui criar a pasta do log: $logdir"
log="$logdir/forge-fechar-$(printf '%s' "$pedido" | tr -c 'A-Za-z0-9._-' '_')-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
(umask 077; : > "$log") || die "não consegui criar o log: $log"
echo "log: $log"
# registrar <fd>: repassa cada linha à tela (fd 1 ou 2) e grava a versão mascarada no log; só fecha a tela depois de gravar tudo.
registrar() {
  local linha
  while IFS= read -r linha || [ -n "$linha" ]; do
    printf '%s\n' "$linha" >&"$1"
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(printf '%s' "$linha" \
      | sed -E 's/(gh[pousr]_|github_pat_)[A-Za-z0-9_]+/\1***/g; s/([Bb]earer|[Tt]oken)([=:]|[[:space:]]+)[^[:space:]&]+/\1\2***/g')" >> "$log"
  done
}
exec > >(registrar 1) 2> >(registrar 2)

if [ "$seco" = 1 ]; then
  echo "forge-fechar --dry-run: nada será executado."
  passo 1 "$check pr $pedido --ref $ref --base $base"
  passo 2 "git ls-remote origin refs/heads/$ref (igual ao head local de $ref)"
  passo 3 "$gh pr create --base $alvo --head $ref --title '$titulo' (se não houver PR aberto; não abre se o head já está em $base ou já tem PR MERGED)"
  passo 4 "$gh pr checks $ref (espera até ${espera}s; só pass/skipping passam)"
  passo 5 "$gh pr view $ref --json labels (recusa se o título cita afrouxa-regra ou o item do rótulo está marcado no corpo, e o rótulo não está aplicado; com --esperar-rotulo, espera o rótulo do dono e a catraca verde até o fim de --espera)"
  passo 6 "$gh pr merge $ref $metodo --match-head-commit <head conferido> (base $alvo; recusa base main; PR em rascunho vira pronto; PR já MERGED não repete o merge)"
  passo 7 "git push origin --delete $ref (até 3 tentativas); git worktree remove <worktree de $ref>; git branch -D $ref"
  # Aviso: os caminhos de controle vêm da lista PROTEGIDOS da própria catraca (tests/catraca.py), sem cópia aqui.
  if ! controles="$(python3 -I - "$(dirname "$catraca")" "$PWD" "$base" "refs/heads/$ref" 2>/dev/null <<'PY'
import importlib.util, sys
pasta, raiz, base, ref = sys.argv[1:5]
sys.path.insert(0, pasta)
spec = importlib.util.spec_from_file_location("catraca", pasta + "/catraca.py")
c = importlib.util.module_from_spec(spec)
spec.loader.exec_module(c)
cod, saida = c.git(raiz, "diff", "--no-renames", "--name-only", "-z", c.base_efetiva(raiz, base, ref), ref)
if cod:  # alterados() devolve lista vazia em erro; aqui o erro tem de aparecer
    sys.exit(1)
for a in (x for x in saida.split("\0") if x):
    if a.startswith(c.PROTEGIDOS):
        print(a)
PY
)"; then
    echo "aviso: não consegui conferir se o diff toca caminho de controle da catraca (tests/catraca.py)."
  elif [ -n "$controles" ]; then
    echo "aviso: o diff de $ref toca caminho de controle que a catraca protege; o rótulo afrouxa-regra do dono vai ser pedido (R-CONFORMIDADE): $(printf '%s' "$controles" | tr '\n' ' ')"
  fi
  exit 0
fi

passo 1 "pareceres: $check pr $pedido --ref $ref --base $base"
"$check" pr "$pedido" --ref "$ref" --base "$base" || die "parou no passo 1: forge-check pr acusou violação (nada foi aberto nem mesclado)"

passo 2 "head no servidor"
local_sha="$(git rev-parse "refs/heads/$ref" 2>/dev/null)" || die "parou no passo 2: a branch local $ref não existe"
remoto_sha="$(git ls-remote origin "refs/heads/$ref" | awk '{print $1}')"
[ -n "$remoto_sha" ] || die "parou no passo 2: $ref não está no origin (git push origin $ref, sem -u)"
[ "$remoto_sha" = "$local_sha" ] || die "parou no passo 2: o head local ($local_sha) difere do remoto ($remoto_sha); envie a branch"

passo 3 "PR para $alvo"
ja_mesclado=0
if git merge-base --is-ancestor "$remoto_sha" "$base" 2>/dev/null; then
  ja_mesclado=1
  echo "o head de $ref já está em $base; nada a abrir nem a mesclar."
else
  lista="$(ler "$gh" pr list --head "$ref" --state all --limit 30 --json number,state,baseRefName,headRefOid \
    --jq '.[] | "\(.number) \(.state) \(.baseRefName) \(.headRefOid)"')" || die "parou no passo 3: não consegui ler os PRs de $ref"
  if printf '%s\n' "$lista" | awk -v s="$remoto_sha" -v b="$alvo" '$2=="MERGED" && $3==b && $4==s {f=1} END {exit !f}'; then
    ja_mesclado=1
    echo "já existe PR MERGED em $alvo com o head de $ref; nada a abrir nem a mesclar."
  else
    aberto="$(printf '%s\n' "$lista" | awk '$2=="OPEN" {print $1 " " $3; exit}')"
    if [ -n "$aberto" ]; then
      [ "${aberto#* }" = "$alvo" ] || die "parou no passo 3: o PR aberto #${aberto%% *} tem base ${aberto#* }, não $alvo; feche-o ou corrija a base (R-MAIN)"
      echo "PR #${aberto%% *} já aberto; reusado."
    else
      "$gh" pr create --base "$alvo" --head "$ref" --title "$titulo" --body "$corpo" || die "parou no passo 3: não consegui abrir o PR"
    fi
  fi
fi

if [ "$ja_mesclado" = 0 ]; then
  inicio=$SECONDS
  apos_rotulo=0
  msg_rotulo="parou no passo 5: o PR pede o rótulo afrouxa-regra (no título ou em item marcado) e o dono ainda não o aplicou; o script nunca aplica rótulo"
  while :; do  # com --esperar-rotulo o laço repete os passos 4 e 5; sem a opção roda uma vez só
  passo 4 "checks (até ${espera}s)"
  falhas=0
  rotulo_ok=0
  if [ "$esperar" = 1 ]; then
    # A espera continua presa ao head conferido no passo 2; push novo durante ela para (o merge também recusaria).
    head_pr="$(ler "$gh" pr view "$ref" --json headRefOid --jq .headRefOid || true)"
    [ -z "$head_pr" ] || [ "$head_pr" = "$remoto_sha" ] || die "parou na espera do rótulo: o head do PR ($head_pr) mudou desde o passo 2 ($remoto_sha); confira e rode de novo"
    if ler "$gh" pr view "$ref" --json labels --jq '.labels[].name' | grep -qx 'afrouxa-regra'; then
      rotulo_ok=1
      apos_rotulo=$((apos_rotulo + 1))
    fi
  fi
  while :; do
    saida="$("$gh" pr checks "$ref" 2>&1 || true)"
    estados="$(printf '%s\n' "$saida" | awk -F'\t' 'NF>=2 {print $2}')"
    if [ "$esperar" = 1 ]; then
      # Só com --esperar-rotulo: a catraca vermelha é o pedido do rótulo (ou o resto da leitura velha logo depois dele): espera como pendente.
      if [ "$rotulo_ok" = 0 ] || [ "$apos_rotulo" -le 10 ]; then
        estados="$(printf '%s\n' "$saida" | awk -F'\t' 'NF>=2 {if ($1=="catraca" && $2=="fail") print "pending"; else print $2}')"
      fi
    fi
    if [ -z "$estados" ]; then
      # PR recém-aberto: o GitHub ainda não registrou os checks ("no checks reported"); espera, como um check pendente.
      if [ -z "$saida" ] || printf '%s' "$saida" | grep -qi 'no checks reported'; then
        [ $((SECONDS - inicio)) -lt "$espera" ] || die "parou no passo 4: nenhum check apareceu após ${espera}s"
        sleep "$intervalo"
        continue
      fi
      # erro passageiro do GitHub (502): leitura, repete até 3 vezes seguidas.
      falhas=$((falhas + 1))
      [ "$falhas" -lt 3 ] || die "parou no passo 4: não consegui ler os checks: $saida"
      sleep "$pausa"
      continue
    fi
    falhas=0
    if printf '%s\n' "$estados" | grep -qvE '^(pass|skipping|pending|queued|in_progress)$'; then
      printf '%s\n' "$saida" >&2
      die "parou no passo 4: há check vermelho ou desconhecido; corrija e rode de novo"
    fi
    printf '%s\n' "$estados" | grep -qE '^(pending|queued|in_progress)$' || break
    if [ $((SECONDS - inicio)) -ge "$espera" ]; then
      [ "$esperar" = 0 ] || [ "$rotulo_ok" = 1 ] || die "$msg_rotulo"
      die "parou no passo 4: checks ainda pendentes após ${espera}s"
    fi
    sleep "$intervalo"
    # com a espera do rótulo, o laço de fora relê o rótulo e o head a cada volta
    [ "$esperar" = 0 ] || continue 2
  done
  echo "checks verdes."

  passo 5 "rótulo"
  rotulos="$(ler "$gh" pr view "$ref" --json labels --jq '.labels[].name')" || die "parou no passo 5: não consegui ler os rótulos do PR"
  texto="$(ler "$gh" pr view "$ref" --json title,body --jq '.title, .body')" || die "parou no passo 5: não consegui ler o título e o corpo do PR"
  # O título é o lugar oficial do sinal de afrouxamento (primeira linha do texto): citar o rótulo nele já para.
  # No corpo, só a linha de item marcado (`- [x]`, `* [X]`, `+ [x]`, `1. [x]`, `1) [x]`) que cita o rótulo; texto que apenas o menciona não para.
  if ! printf '%s\n' "$rotulos" | grep -qx 'afrouxa-regra'; then
    if printf '%s\n' "$texto" | head -n 1 | grep -qi 'afrouxa-regra' \
      || printf '%s\n' "$texto" | tail -n +2 | grep -qiE '^[[:space:]]*([-*+]|[0-9]+[.)])[[:space:]]+\[x\].*afrouxa-regra'; then
      if [ "$esperar" = 1 ] && [ $((SECONDS - inicio)) -lt "$espera" ]; then
        echo "aguardando o rótulo afrouxa-regra do dono (o script nunca o aplica)..."
        sleep "$intervalo"
        continue
      fi
      die "$msg_rotulo"
    fi
  fi
  break
  done

  passo 6 "merge ($metodo) em $alvo"
  pre="$(ler "$gh" pr view "$ref" --json baseRefName,isDraft,state --jq '"\(.baseRefName) \(.isDraft) \(.state)"')" || die "parou no passo 6: não consegui ler a base do PR"
  read -r pre_base pre_rascunho pre_estado <<<"$pre"
  [ "$pre_base" != main ] || die "parou no passo 6: o PR tem base main; a main é só do dono (R-MAIN)"
  [ "$pre_base" = "$alvo" ] || die "parou no passo 6: o PR tem base $pre_base, não $alvo"
  if [ "${pre_estado:-OPEN}" = MERGED ]; then
    echo "o PR já consta como MERGED; o merge não se repete."
  else
    if [ "$pre_rascunho" = true ]; then
      "$gh" pr ready "$ref" || die "parou no passo 6: não consegui marcar o PR como pronto"
    fi
    # O merge muda o PR: não se repete sozinho. Se falhou, só se lê o estado: um 502 após o merge feito já deixou o PR MERGED.
    if ! "$gh" pr merge "$ref" "$metodo" --match-head-commit "$remoto_sha"; then
      estado="$(ler "$gh" pr view "$ref" --json state --jq .state || true)"
      [ "$estado" = MERGED ] || die "parou no passo 6: o merge falhou (ou o head do PR mudou desde o passo 2)"
      echo "o merge devolveu erro, mas o PR consta como MERGED."
    fi
  fi
  estado="$(ler "$gh" pr view "$ref" --json state --jq .state || true)"
  [ "$estado" = MERGED ] || die "parou no passo 6: o PR não consta como MERGED (estado: ${estado:-desconhecido})"
fi

passo 7 "limpeza (R-FLUXO, Depois do merge)"
repetir git push origin --delete "refs/heads/$ref" || echo "aviso: não apaguei a branch remota $ref; apague-a (git push origin --delete $ref)." >&2
atual="$(pwd -P)"
arvore="$(git worktree list --porcelain | awk -v b="refs/heads/$ref" '$1=="worktree"{w=$2} $1=="branch" && $2==b {print w}')"
if [ -n "$arvore" ] && [ "$(cd "$arvore" && pwd -P)" = "$atual" ]; then
  echo "aviso: você está na worktree de $ref; saia dela e rode: git worktree remove $arvore && git branch -D $ref" >&2
else
  if [ -n "$arvore" ]; then
    git worktree remove "$arvore" || echo "aviso: não removi a worktree $arvore; rode git worktree prune no terminal." >&2
  fi
  git branch -D "$ref" || echo "aviso: não apaguei a branch local $ref." >&2
fi
echo "Entrega $pedido fechada em $alvo."
