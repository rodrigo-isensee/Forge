def git(*args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout


def caminhos_alterados(base):
    """Alterados desde o ancestral comum com `base` (commitados ou não) e os novos ainda não versionados."""
    ancora = git("merge-base", base, "HEAD").strip()
    # --no-renames: um arquivo movido lista os dois caminhos, e o antigo (se protegido ou sem mapa) cai na completa.
    nomes = set(git("diff", "--name-only", "--no-renames", ancora).splitlines())
    nomes |= set(git("ls-files", "--others", "--exclude-standard").splitlines())
    return sorted(n for n in nomes if n)


def caminhos_pedidos(pedidos, origem, raiz):
    """Caminhos dados na linha de comando, relativos à raiz do repositório e normalizados (`..` resolvido sem seguir
    link). Levanta ValueError para o que cai fora do repositório."""
    saida = []
    for pedido in pedidos:
        relativo = os.path.relpath(os.path.join(origem, pedido), raiz)
        if relativo == ".." or relativo.startswith(".." + os.sep):
            raise ValueError(f"{pedido}: fora do repositório")
        saida.append(Path(relativo).as_posix())
    return sorted(set(saida))


def planejar(caminhos, raiz=Path(".")):
    """Devolve ("dirigido", [módulos]) ou ("completo", [motivo])."""
    modulos = set()
    for caminho in caminhos:
        if caminho in ALTERA_O_MAPA:
            return "completo", [f"{caminho} altera o mapa ou a configuração"]
        casou = None
        for padrao, destino in MAPA:
            if re.fullmatch(padrao, caminho):
                casou = destino
                break
        casou = casou or modulos_da_convencao(caminho, raiz) or modulos_do_novo(caminho, raiz)
        if casou is None:
            return "completo", [f"{caminho} sem mapa"]
        modulos.update(casou)
    ausentes = sorted(m for m in modulos if not arquivo_do_modulo(m, raiz).is_file())
    if ausentes:
        return "completo", [f"módulo sem arquivo: {', '.join(ausentes)}"]
    if modulos:
        modulos.update(oraculos(raiz))
    return "dirigido", sorted(modulos)


def modulos_da_convencao(caminho, raiz=Path(".")):
    """O2: os módulos do caminho pela convenção de nome, ou None (fora de bin/, hooks/ e scripts/, em SEM_CONVENCAO ou sem o
    arquivo tests/test_<nome>.py)."""
    achado = CONVENCAO.fullmatch(caminho)
    if not achado or caminho in SEM_CONVENCAO:
        return None
    modulo = "test_" + achado.group(2).replace("-", "_")
    if not arquivo_do_modulo(modulo, raiz).is_file():
        return None
    return (modulo,) + VARREM_A_PASTA[achado.group(1)]


def modulos_do_novo(caminho, raiz=Path(".")):
    """E14.1: os módulos de um subcomando, módulo do bin/ ou spec de mutantes sem regra no MAPA, ou None (suíte completa).
    O subcomando sem tests/test_<sub>.py e a spec ilegível, sem teste ou com teste fora de tests.test_* seguem na completa."""
    sub = SUBCOMANDO.fullmatch(caminho)
    if sub:
        modulo = "test_" + sub.group(1).replace("-", "_")
        if not arquivo_do_modulo(modulo, raiz).is_file():
            return None
        return tuple(sorted({modulo, "test_forge"} | leitores(f"forge-{sub.group(1)}", raiz)))
    do_bin = MODULO_DO_BIN.fullmatch(caminho)
    if do_bin:
        return tuple(sorted({"test_forge"} | leitores(do_bin.group(1), raiz)))
    if SPEC_DE_MUTANTES.fullmatch(caminho):
        return modulos_da_spec(raiz / caminho)
    return None


def leitores(nome, raiz=Path(".")):
    """Módulos de teste que citam `nome` como palavra inteira (forge-x não casa com forge-xy nem com o_forge-x)."""
    palavra = re.compile(rf"(?<![\w-]){re.escape(nome)}(?![\w-])")
    return {m for m, texto in textos_dos_testes(raiz).items() if palavra.search(texto)}


def modulos_da_spec(arquivo):
    """Os módulos citados no campo `testes` de cada mutante da spec, ou None (falha fechada)."""
    try:
        ids = [t for m in json.loads(arquivo.read_text(encoding="utf-8"))["mutantes"] for t in m["testes"]]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    achados = [TESTE_DA_SPEC.fullmatch(t) if isinstance(t, str) else None for t in ids]
    if not achados or None in achados:
        return None
    return tuple(sorted({a.group(1) for a in achados}))


def arquivo_do_modulo(modulo, raiz=Path(".")):
    """tests/test_x.py de `test_x`; tests/evals/test_x.py de `evals.test_x`."""
    return raiz / "tests" / (modulo.replace(".", "/") + ".py")


def nome_do_modulo(relativo):
    """`evals.test_x` de tests/evals/test_x.py, se toda pasta do caminho é pacote (o discover só desce em pacote)."""
    achado = SUBMODULO_DE_TESTE.fullmatch(relativo)
    if not achado:
        return None
    partes = achado.group(1).split("/")
    return ".".join(partes)


def textos_dos_testes(raiz=Path(".")):
    """{módulo: texto} de todo tests/test_*.py e dos tests/<pacote>/test_*.py (link ou ilegível fica de fora: o CI o
    roda)."""
    textos = {}
    for p in sorted((raiz / "tests").rglob("test_*.py")):
        nome = nome_do_modulo(p.relative_to(raiz).as_posix())
        pastas = p.parent.relative_to(raiz / "tests").parts
        pacote = all((raiz / "tests" / Path(*pastas[:i + 1]) / "__init__.py").is_file() for i in range(len(pastas)))
        if nome and pacote and p.is_file() and not p.is_symlink():
            try:
                textos[nome] = p.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
    return textos


def citam(textos, agulhas):
    """Módulos cujo texto contém alguma das agulhas."""
    return {m for m, texto in textos.items() if any(a in texto for a in agulhas)}


def agulhas_do_caminho(caminho):
    """O caminho inteiro, o nome do arquivo e, para .py, o nome do módulo; os curtos demais ficam de fora."""
    nome = caminho.rsplit("/", 1)[-1]
    agulhas = {caminho, nome}
    if nome.endswith(".py"):
        agulhas.add(nome[:-3])
    return {a for a in agulhas if len(a) >= MINIMO_DA_AGULHA}


def planejar_afetados(caminhos, raiz=Path(".")):
    """(módulos, notas) dos testes afetados por `caminhos`, para o pre-push. Conservador: na dúvida, o módulo entra.
    Nunca devolve a suíte completa; o que não tem leitor conhecido vira nota (o CI do PR roda a suíte inteira)."""
    textos = textos_dos_testes(raiz)
    modulos, notas = set(), []
    for caminho in caminhos:
        achados = set(citam(textos, {caminho}))
        regra = (next((destino for padrao, destino in MAPA if re.fullmatch(padrao, caminho)), None)
                 or modulos_da_convencao(caminho, raiz) or modulos_do_novo(caminho, raiz))
        achados.update(regra or ())
        for padrao, agulhas in EXERCITAM:
            if re.fullmatch(padrao, caminho):
                achados |= citam(textos, agulhas)
        nome = nome_do_modulo(caminho)
        if nome:
            achados |= {nome} if nome in textos else set()
            achados |= citam(textos, {nome, nome.rsplit(".", 1)[-1]})
            achados |= {m for m, texto in textos.items() if VARRE_OS_TESTES.search(texto)}
        elif regra is None:
            achados |= citam(textos, agulhas_do_caminho(caminho))
            if caminho.startswith(PASTAS_VARRIDAS):
                achados.add("test_forge")
        if not achados:
            notas.append(f"{caminho}: nenhum teste o lê; fica para o CI")
        modulos |= achados
    ausentes = sorted(m for m in modulos if m not in textos)
    if ausentes:
        notas.append(f"módulo do mapa sem arquivo (fica para o CI): {', '.join(ausentes)}")
    modulos -= set(ausentes)
    if modulos:
        modulos.update(oraculos(raiz))
    return sorted(modulos), notas


def comando_dirigido(modulos, filtros, raiz=Path(".")):
    """Os módulos em paralelo (`scripts/suite-partes.py`, o mecanismo do suite-paralela) quando os dois scripts
    existem e não há `-k`; senão, em série no `unittest`, como antes."""
    partes, paralela = raiz / "scripts" / "suite-partes.py", raiz / "scripts" / "suite-paralela.py"
    if not filtros and all(p.is_file() and not p.is_symlink() for p in (partes, paralela)):
        return [sys.executable, "-I", str(partes), "--modulos", ",".join(modulos)]
    comando = [sys.executable, "-m", "unittest", "-q", *[f"tests.{m}" for m in modulos]]
    for filtro in filtros:
        comando += ["-k", filtro]
    return comando


def oraculos(raiz=Path(".")):
    """Os testes-oráculo do portão (`tests/test_oraculo_<pedido>.py`, EXT-1): entram em todo plano dirigido, porque o
    oráculo pode ler qualquer arquivo de controle. Nome fora do padrão, link ou pasta levanta ValueError: nunca some
    do plano em silêncio."""
    achados = []
    for p in sorted((raiz / "tests").glob("test_oraculo_*.py")):
        if p.is_symlink() or not p.is_file() or not ORACULO.fullmatch(p.stem):
            raise ValueError(f"oráculo fora do padrão (tests/test_oraculo_[a-z0-9_]+.py, arquivo comum): {ascii(p.name)}")
        achados.append(p.stem)
    return achados


def modulos_sem_mapa(pedidos, raiz=Path(".")):
    """Módulos de teste dados como CAMINHO (tests/test_x.py existente), ou None se algum pedido é outra coisa.
    Pedir o módulo é dizer qual rodar: não há o que mapear (FORGE-TESTES-SEM-MAPA)."""
    achados = [MODULO_DE_TESTE.fullmatch(c) for c in pedidos]
    if not pedidos or not all(achados) or not all((raiz / c).is_file() for c in pedidos):
        return None
    return sorted(a.group(1) for a in achados)


def bin_lidos(texto):
    """Arquivos de bin/ que o texto de um módulo de teste lê: só as formas que montam um caminho (`RAIZ / "bin/x"`,
    `RAIZ / "bin" / "x"`, `joinpath("bin", "x")`, `ler("bin/x")`). Citar o caminho como argumento ou dado não conta."""
    try:
        arvore = ast.parse(texto)
    except SyntaxError:
        return set()
    def texto_de(no):
        return no.value if isinstance(no, ast.Constant) and isinstance(no.value, str) else None
    achados = set()
    for no in ast.walk(arvore):
        partes = []
        if isinstance(no, ast.BinOp) and isinstance(no.op, ast.Div):
            raiz = no
            while isinstance(raiz, ast.BinOp):
                raiz = raiz.left
            if ast.unparse(raiz).startswith("self."):
                continue  # `self.dir / "bin" / "x"` monta o caminho num repositório de brinquedo, não no Forge
            partes = [texto_de(no.right)]
            if isinstance(no.left, ast.BinOp) and isinstance(no.left.op, ast.Div):
                partes = [texto_de(no.left.right)] + partes
        elif isinstance(no, ast.Call) and isinstance(no.func, ast.Attribute) and no.func.attr == "joinpath":
            partes = [texto_de(a) for a in no.args]
        elif isinstance(no, ast.Call) and isinstance(no.func, ast.Name) and no.func.id == "ler" and no.args:
            partes = [texto_de(no.args[0])]
        for n, parte in enumerate(partes):
            if parte and parte.startswith("bin/"):
                achados.add(parte[4:])
            elif parte == "bin" and n + 1 < len(partes) and partes[n + 1]:
                achados.add(partes[n + 1])
    return {a for a in achados if a and "/" not in a}


def avisos_de_mapa(caminhos, raiz=Path(".")):
    """Um teste que cita um arquivo de bin/ que o MAPA não leva a ele: o pre-push o pularia, e a suíte completa
    reprova (MapaCobreOQueOsTestesLeem). Avisa cedo (MAPA-TESTES-AVISO-CEDO)."""
    avisos = []
    for caminho in caminhos:
        achado = MODULO_DE_TESTE.fullmatch(caminho)
        if not achado or not (raiz / caminho).is_file():
            continue
        texto = (raiz / caminho).read_text(encoding="utf-8", errors="replace")
        for alvo in sorted(bin_lidos(texto)):
            if not (raiz / "bin" / alvo).is_file():
                continue
            modo, modulos = planejar([f"bin/{alvo}"], raiz)
            if modo == "dirigido" and achado.group(1) not in modulos:
                avisos.append(f"forge-testes: {caminho} lê bin/{alvo}, mas o MAPA não leva a {achado.group(1)}; "
                              f"acrescente em bin/forge-testes e em tests/test_testes_tocados.py")
    return avisos


def anotar(modo, modulos, segundos, codigo):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    agora = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with LOG.open("a", encoding="utf-8") as f:
        f.write(f"{agora} modo={modo} modulos={','.join(modulos) or '-'} duracao={segundos:.1f}s saida={codigo}{contexto()}\n")


# --- `--vermelho`: a prova de que o teste derruba o defeito -------------------------------------------------------
# Cada cópia é um clone local em $TMPDIR com `.git` próprio (os testes do Forge rodam `git ls-files` na raiz), feito do
# commit e nunca da árvore de trabalho. O executor por teste é `executar`, chamado pelo caminho absoluto deste script.
PROVA = ("prova (asserção)", "prova (API ausente)")
ENTREGA = "falha da entrega (regressão ou sem veredito)"
HERDADA = "não prova (herdada da base)"  # teste que já existia: a falha de carga ou de setup da base não é dele
ERROS_DE_API = {"ImportError", "AttributeError", "NameError"}


def ambiente_da_copia():
    """Sem `GIT_*` (um hook exporta `GIT_DIR`, que venceria o repositório da cópia), `FORGE_*` nem a sessão real."""
    env = {k: v for k, v in os.environ.items() if not k.startswith(("GIT_", "FORGE_")) and k != "CLAUDE_PROJECT_DIR"}
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return env


# FILA-31 F2: o git da cópia vem do módulo comum, com o ambiente deste script.
git_da_copia = functools.partial(apoio.git_da_copia, ambiente_da_copia)
montar_copia = functools.partial(apoio.montar_copia, ambiente_da_copia)
resolver = apoio.resolver


def mudancas(ancora, cabeca):
    """[(status, caminho)] do diff commitado, sem detectar renomeação (o arquivo movido lista os dois caminhos)."""
    partes = git("diff", "--name-status", "--no-renames", "-z", ancora, cabeca).split("\0")
    return [(partes[i][0], partes[i + 1]) for i in range(0, len(partes) - 1, 2)]


def devolver_producao(copia, ancora, producao):
    """Põe de volta o conteúdo da base nos arquivos de produção do diff; o que a base não tinha sai da cópia."""
    for status, caminho in producao:
        if status == "A":
            (copia / caminho).unlink(missing_ok=True)
        else:
            git_da_copia("checkout", "--quiet", ancora, "--", caminho, cwd=copia)


class Registro(unittest.TestResult):
    """Um resultado por teste (`ok`, `falha` por asserção, `erro`, `pulado`), em vez do código de saída do processo."""

    def __init__(self):
        super().__init__()
        self.por_id = {}

    def anotar(self, teste, res, err=None):
        ident = teste.id().removeprefix("unittest.loader._FailedTest.")  # falha de carga: o módulo inteiro
        if res == "ok" and ident in self.por_id:
            return
        self.por_id[ident] = {"id": ident, "res": res, "tipo": err[0].__name__ if err else None,
                              "nome": (getattr(err[1], "name", None) or getattr(err[1], "filename", None)) if err else None}

    def addSuccess(self, teste):
        self.anotar(teste, "ok")

    def addFailure(self, teste, err):
        self.anotar(teste, "falha", err)

    def addError(self, teste, err):
        self.anotar(teste, "erro", err)

    def addSkip(self, teste, motivo):
        self.anotar(teste, "pulado")

    def addUnexpectedSuccess(self, teste):
        self.anotar(teste, "falha", (AssertionError, AssertionError("sucesso inesperado"), None))

    def addSubTest(self, teste, subteste, err):
        if err is not None:
            self.anotar(teste, "falha" if issubclass(err[0], teste.failureException) else "erro", err)


def executar(modulo, registro):
    """Roda `tests.<modulo>` no diretório atual e grava um registro por teste em `registro` (JSON, uma linha por teste)."""
    sys.path.insert(0, os.getcwd())
    resultado = Registro()
    unittest.defaultTestLoader.loadTestsFromName(f"tests.{modulo}").run(resultado)
    Path(registro).write_text("".join(json.dumps(e) + "\n" for e in resultado.por_id.values()), encoding="utf-8")
    return 0


def rodar_modulo(copia, modulo, registro, prazo):
    """Roda um módulo na cópia. False se estourou o prazo, morreu por sinal ou não deixou registro."""
    processo = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--executar", modulo,
                                 "--registro", str(registro)], cwd=copia, env=ambiente_da_copia(),
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                start_new_session=True)
    try:
        processo.wait(timeout=prazo)
    except BaseException as erro:  # prazo, sinal ou Ctrl-C: nada fica rodando
        try:
            os.killpg(processo.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        processo.wait()
        if isinstance(erro, subprocess.TimeoutExpired):
            return False
        raise
    return processo.returncode == 0 and Path(registro).is_file()


def ler_registro(caminho):
    return {e["id"]: e for e in map(json.loads, Path(caminho).read_text(encoding="utf-8").splitlines())}


def classificar(h, b, mudou, removidos):
    """Classe de um teste. `h` e `b`: entrada do registro no HEAD e na base (None se não rodou). `mudou`: o módulo
    de teste está no diff. `removidos`: nomes dos arquivos de produção que a base não tem (para a API ausente)."""
    if h is None:
        return "sem veredito"
    if "pulado" in (h["res"], (b or {}).get("res")):
        return "pulado"
    if h["res"] == "ok":
        if b is None:
            return "sem veredito"
        if b.get("herdada"):
            return HERDADA
        if b["res"] == "ok":
            return "não prova (passa na base)"
        if b["res"] == "falha":
            return PROVA[0]
        api = b["tipo"] in ERROS_DE_API or (b["tipo"] == "ModuleNotFoundError"
                                            and (b["nome"] or "").split(".")[-1] in removidos)
        # arquivo que o próprio diff cria e o `setUpClass` ou o `setUpModule` abriu na base: o mesmo caso, só o alvo muda
        api = api or (b["tipo"] == "FileNotFoundError" and Path(str(b["nome"])).stem in removidos)
        return PROVA[1] if api else "sem veredito"  # erro do próprio módulo de teste não é vermelho
    if b is not None and b["res"] == "ok":
        return "regressão"
    if b is not None and b["res"] == "falha" and not mudou:
        return "dívida pré-existente"  # só informação: continua bloqueando
    return ENTREGA


class TodosExistiam:
    """Base do módulo ilegível: nenhum teste conta como novo (falha fechada, ninguém ganha prova herdada)."""

    def __contains__(self, _):
        return True


def testes_da_base(ancora, modulo):
    """`Classe.teste` do módulo de teste na versão da base, lido sem executar (`git show` e `ast`). Módulo que a base
    não tem: conjunto vazio (todos os testes são novos). Ilegível: `TodosExistiam`."""
    caminho = f"tests/{modulo}.py"
    try:
        if not git("ls-tree", ancora, "--", caminho).strip():
            return set()
        arvore = ast.parse(git("show", f"{ancora}:{caminho}"))
    except (RuntimeError, SyntaxError, ValueError):
        return TodosExistiam()
    classes = {n.name: n for n in arvore.body if isinstance(n, ast.ClassDef)}

    def metodos(classe, vistas=()):
        nomes = {n.name for n in classe.body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}
        for pai in classe.bases:  # herança dentro do próprio módulo
            if isinstance(pai, ast.Name) and pai.id in classes and pai.id not in vistas:
                nomes |= metodos(classes[pai.id], (*vistas, classe.name))
        return nomes

    return {f"{nome}.{metodo}" for nome, classe in classes.items() for metodo in metodos(classe)}


def da_base(registro_b, ident, existiam=()):
    """Entrada da base para o teste `ident` (`tests.<módulo>.<Classe>.<teste>`): a dele ou, na falta, a falha de carga
    do módulo (o executor a grava só com o nome do módulo, `test_<nome>`), o erro do `setUpClass` da classe ou o do
    `setUpModule` do módulo. Essa entrada herdada só serve de prova a teste que a base não tinha: para quem está em
    `existiam` (`Classe.teste` da versão da base do módulo) ela volta marcada `herdada`, e não prova nada."""
    if ident in registro_b:
        return registro_b[ident]
    partes = ident.split(".")
    for chave in (".".join(partes[:2]), partes[1] if len(partes) > 1 else "", f"setUpClass ({'.'.join(partes[:-1])})", f"setUpModule ({'.'.join(partes[:2])})"):
        if chave in registro_b:
            entrada = registro_b[chave]
            return {**entrada, "herdada": True} if ".".join(partes[2:]) in existiam else entrada
    return None


def estado_da_arvore():
    return git("status", "--porcelain")


def vermelho(base_pedida, modulos_pedidos, prazo):
    raiz = Path.cwd()
    base = resolver(base_pedida)
    cabeca = resolver("HEAD")
    if base is None or cabeca is None:
        print(f"forge-testes --vermelho: base ilegível ({base_pedida!r}); não recuo para outro modo.", file=sys.stderr)
        return 2
    try:
        antes = estado_da_arvore()
        if antes:
            print("forge-testes --vermelho: árvore com mudança não commitada; commite antes (a prova fica presa a um sha).",
                  file=sys.stderr)
            return 2
        ancora = git("merge-base", base, cabeca).strip()
        itens = mudancas(ancora, cabeca)
    except RuntimeError as erro:
        print(f"forge-testes --vermelho: {erro}", file=sys.stderr)
        return 2
    if not itens:
        print(f"vermelho: base={ancora[:12]} head={cabeca[:12]} nada alterado; sem prova.")
        return 1
    caminhos = [c for _, c in itens]
    producao = [(s, c) for s, c in itens if not TESTE_DO_DIFF.fullmatch(c)]
    mantidos = [c for c in caminhos if TESTE_DO_DIFF.fullmatch(c)]
    modificados = {MODULO_DE_TESTE.fullmatch(c).group(1) for c in caminhos if MODULO_DE_TESTE.fullmatch(c)}
    removidos = {Path(c).stem for s, c in producao if s == "A"}
    todos = sorted(p.stem for p in (raiz / "tests").glob("test_*.py") if NOME_DE_MODULO.fullmatch(p.stem))
    if modulos_pedidos is not None:
        modulos, restrito = modulos_pedidos, " (restrito por --modulos)"
        ausentes = [m for m in modulos if m not in todos]
        if ausentes:
            print(f"forge-testes --vermelho: módulo sem arquivo em tests/: {', '.join(ausentes)}", file=sys.stderr)
            return 2
    else:
        # `--vermelho` é evidência, não portão: os módulos de teste do diff mais o plano dos outros caminhos (se esse
        # plano é completo, todos). Mandar o módulo de teste ao `planejar` rodaria a suíte inteira duas vezes, em série.
        # Os dados de teste (a spec tests/mutantes/<pedido>.json de todo item, corpus, fixtures) ficam no HEAD nas duas
        # cópias, não provam nada e, sem mapa, levariam à suíte completa; `tests/config.json` segue ao `planejar`.
        modo, plano = planejar([c for c in caminhos if not TESTE_DO_DIFF.fullmatch(c) or c in ALTERA_O_MAPA], raiz)
        if modo == "completo":
            print(f"vermelho: o mapa não sabe ({'; '.join(plano)}); suíte completa.")
        modulos = todos if modo == "completo" else sorted({m for m in modificados if m in todos} | set(plano))
        restrito = ""
    print(f"vermelho: base={ancora[:12]} head={cabeca[:12]} módulos={','.join(modulos)}{restrito}")
    print(f"revertidos à base: {', '.join(c for _, c in producao) or '-'}")
    print(f"mantidos no HEAD: {', '.join(mantidos) or '-'}")

    anterior = signal.signal(signal.SIGTERM, lambda numero, quadro: sys.exit(143))  # o `finally` apaga as cópias
    trabalho = Path(tempfile.mkdtemp(prefix="forge-vermelho-"))
    inicio = time.monotonic()
    try:
        cabeca_dir, base_dir = trabalho / "H", trabalho / "B"
        montar_copia(raiz, cabeca_dir, cabeca)
        montar_copia(raiz, base_dir, cabeca)
        devolver_producao(base_dir, ancora, producao)
        linhas, contagem, sem_veredito, falhou = [], {}, False, False
        for modulo in modulos:
            lados = {}
            for lado, copia in (("H", cabeca_dir), ("B", base_dir)):
                registro = trabalho / f"{lado}-{modulo}.jsonl"
                lados[lado] = ler_registro(registro) if rodar_modulo(copia, modulo, registro, prazo) else None
            if lados["H"] is None or lados["B"] is None:
                quem = ",".join(l for l in lados if lados[l] is None)
                linhas.append(f"{modulo} · sem veredito (prazo, sinal ou executor sem registro em {quem})")
                contagem["sem veredito"] = contagem.get("sem veredito", 0) + 1
                sem_veredito = True
                continue
            existiam = testes_da_base(ancora, modulo)
            for ident in sorted(lados["H"]):
                h, b = lados["H"][ident], da_base(lados["B"], ident, existiam)
                classe = classificar(h, b, modulo in modificados, removidos)
                contagem[classe] = contagem.get(classe, 0) + 1
                sem_veredito |= classe == "sem veredito"
                falhou |= h["res"] in ("falha", "erro")
                if classe != "não prova (passa na base)" or modulo in modificados:
                    linhas.append(f"{ident} · H={h['res']} · B={(b or {}).get('res', '-')} · {classe}")
        depois = estado_da_arvore()
    except (RuntimeError, OSError) as erro:
        print(f"forge-testes --vermelho: {erro}", file=sys.stderr)
        return 2
    finally:
        signal.signal(signal.SIGTERM, anterior)
        shutil.rmtree(trabalho, ignore_errors=True)
    print("\n".join(linhas))
    print("contagem: " + ("; ".join(f"{c}={n}" for c, n in sorted(contagem.items())) or "nenhum teste"))
    if depois != antes:
        print("forge-testes --vermelho: a árvore de trabalho mudou durante a prova; resultado descartado.", file=sys.stderr)
        return 2
    prova = sum(contagem.get(c, 0) for c in PROVA)
    if sem_veredito:
        codigo = 2
        print("sem veredito: volta ao autor; não vale como vermelho nem como já falhava.")
    elif falhou or not prova:
        codigo = 1
        if falhou:
            print("há teste que falha no HEAD (a etiqueta não libera nada).")
        if not prova:
            print("nenhum teste prova a mudança.")
    else:
        codigo = 0
    anotar("vermelho", modulos, time.monotonic() - inicio, codigo)
    return codigo


def main(argv=None):
    p = argparse.ArgumentParser(prog="forge-testes", description="Teste dirigido: iteração do autor e filtro do pre-push do envio de código (nunca portão de CI).")
    p.add_argument("caminhos", nargs="*", metavar="CAMINHO")
    p.add_argument("--base", default=BASE_PADRAO)
    p.add_argument("--listar", action="store_true")
    p.add_argument("--completa", action="store_true")
    p.add_argument("--afetados", action="store_true",
                   help="plano do pre-push: os testes afetados, nunca a suíte completa (o CI a roda)")
    p.add_argument("-k", dest="filtros", action="append", default=[], metavar="PADRAO",
                   help="só os testes cujo nome contém PADRAO (como `unittest -k`; repita para somar)")
    p.add_argument("--vermelho", nargs="?", const=True, default=None, metavar="BASE")
    p.add_argument("--modulos", metavar="M[,M...]")
    p.add_argument("--prazo", type=int, metavar="SEGUNDOS", help=f"por módulo, em segundos (padrão {PRAZO_PADRAO})")
    p.add_argument("--executar", help=argparse.SUPPRESS)  # interno: o executor por teste do `--vermelho`
    p.add_argument("--registro", help=argparse.SUPPRESS)
    args = p.parse_args(argv)
    if args.executar:
        return executar(args.executar, args.registro)
    if args.vermelho is None and args.modulos is not None:
        p.error("--modulos só vale com --vermelho")
    if args.vermelho is not None and (args.completa or args.listar or args.afetados):
        p.error("--vermelho não combina com --completa, --listar nem --afetados")
    if args.afetados and args.completa:
        p.error("--afetados não combina com --completa")
    if args.vermelho is not None and args.filtros:
        p.error("-k não combina com --vermelho")
    if args.vermelho is None and args.prazo is not None:
        p.error("--prazo só vale com --vermelho")
    prazo = PRAZO_PADRAO if args.prazo is None else args.prazo
    if not 0 < prazo <= PRAZO_MAXIMO:
        p.error(f"--prazo vai de 1 a {PRAZO_MAXIMO} segundos")
    modulos_pedidos = None
    if args.modulos is not None:
        # FORGE-TESTES-MODULOS-NOME: o nome com o pacote (`tests.test_x`, a forma do `unittest`) vale como `test_x`; um
        # corte só, no começo, e a validação depois dele (`tests.tests.test_x` e `tests/test_x.py` seguem recusados).
        modulos_pedidos = [m.removeprefix("tests.") for m in args.modulos.split(",")]
        if not all(NOME_DE_MODULO.fullmatch(m) for m in modulos_pedidos):
            p.error("--modulos: nomes de módulo de teste (test_<nome> ou tests.test_<nome>) separados por vírgula")

    if args.caminhos and (args.completa or args.vermelho is not None):
        p.error("caminhos não combinam com --completa nem com --vermelho")
    origem = os.getcwd()
    try:
        raiz = git("rev-parse", "--show-toplevel").strip()
        os.chdir(raiz)
    except RuntimeError as erro:
        sys.exit(f"forge-testes: fora de um repositório git ({erro})")
    try:
        oraculos()
        pedidos = caminhos_pedidos(args.caminhos, origem, raiz) if args.caminhos else []
    except ValueError as erro:
        print(f"forge-testes: {erro}", file=sys.stderr)
        return 2

    if args.vermelho is not None:
        return vermelho(args.base if args.vermelho is True else args.vermelho, modulos_pedidos, prazo)

    try:
        for aviso in avisos_de_mapa(pedidos or caminhos_alterados(args.base)):
            print(aviso, file=sys.stderr)
    except RuntimeError:
        pass  # o plano abaixo trata o erro do git
    if args.completa:
        modo, detalhe = "completo", ["pedido --completa"]
    elif args.afetados:
        try:
            alterados = pedidos or caminhos_alterados(args.base)
        except RuntimeError as erro:
            print(f"forge-testes: não consegui ler o git ({erro})", file=sys.stderr)
            return 2
        detalhe, notas = planejar_afetados(alterados)
        for nota in notas:
            print(f"forge-testes: {nota}", file=sys.stderr)
        if not detalhe:
            print("forge-testes: nada a rodar (nenhum teste afetado). O CI do PR roda a suíte inteira.")
            return 0
        modo = "dirigido"
    elif pedidos and (so_modulos := modulos_sem_mapa(pedidos)):
        modo, detalhe = "dirigido", so_modulos
        print(f"forge-testes: sem mapa para {', '.join(pedidos)}; roda só {', '.join(detalhe)}.", file=sys.stderr)
    elif pedidos:
        modo, detalhe = planejar(pedidos)
    else:
        try:
            modo, detalhe = planejar(caminhos_alterados(args.base))
        except RuntimeError as erro:
            modo, detalhe = "completo", [f"não consegui ler o git ({erro})"]
        else:
            if modo == "dirigido" and not detalhe:
                print("forge-testes: nada alterado; nada a rodar.")
                return 0

    if modo == "completo":
        print(f"forge-testes: suíte completa ({'; '.join(detalhe)})")
        comando, modulos = list(SUITE_COMPLETA), []
    else:
        print(f"forge-testes: dirigido ({', '.join(detalhe)}). O CI do PR roda a suíte inteira.")
        comando, modulos = comando_dirigido(detalhe, args.filtros), detalhe
    if modo == "completo":
        for filtro in args.filtros:
            comando += ["-k", filtro]
    if args.listar:
        return 0
    inicio = time.monotonic()
    codigo = subprocess.run(comando).returncode
    anotar(modo, modulos, time.monotonic() - inicio, codigo)
    return codigo


if __name__ == "__main__":
    sys.exit(main())
