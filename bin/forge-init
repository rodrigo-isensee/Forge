#!/usr/bin/env bash
# Forge: prepara um projeto para ser desenvolvido pela fábrica.
# Uso: forge-init [--nome NOME] [--descricao TEXTO] [--pronto COMANDO] [--forcar] [DIRETORIO]
# Copia templates/projeto para o diretório sem sobrescrever o que já existe (salvo --forcar),
# substitui os marcadores {{PROJETO}}, {{DESCRICAO}} e {{COMANDO_PRONTO}} e ativa o hook de git.
set -euo pipefail

raiz_forge="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
modelo="$raiz_forge/templates/projeto"

nome=""; descricao="Descreva aqui o objetivo do sistema."; pronto="npm run pronto"; forcar=0; destino="."
while [ $# -gt 0 ]; do
  case "$1" in
    --nome) nome="$2"; shift 2 ;;
    --descricao) descricao="$2"; shift 2 ;;
    --pronto) pronto="$2"; shift 2 ;;
    --forcar) forcar=1; shift ;;
    -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "forge-init: opção desconhecida: $1" >&2; exit 2 ;;
    *) destino="$1"; shift ;;
  esac
done

[ -d "$destino" ] || { echo "forge-init: diretório não existe: $destino" >&2; exit 2; }
destino="$(cd "$destino" && pwd)"
[ -n "$nome" ] || nome="$(basename "$destino")"

escapar() { printf '%s' "$1" | sed -e 's/[\/&|]/\\&/g'; }
n_esc="$(escapar "$nome")"; d_esc="$(escapar "$descricao")"; p_esc="$(escapar "$pronto")"

criados=0; mantidos=0
while IFS= read -r -d '' arq; do
  rel="${arq#"$modelo"/}"
  alvo="$destino/$rel"
  if [ -e "$alvo" ] && [ "$forcar" -eq 0 ]; then
    echo "  mantido  $rel"; mantidos=$((mantidos + 1)); continue
  fi
  mkdir -p "$(dirname "$alvo")"
  sed -e "s|{{PROJETO}}|$n_esc|g" -e "s|{{DESCRICAO}}|$d_esc|g" -e "s|{{COMANDO_PRONTO}}|$p_esc|g" "$arq" > "$alvo"
  [ -x "$arq" ] && chmod +x "$alvo"
  echo "  criado   $rel"; criados=$((criados + 1))
done < <(find "$modelo" -type f -print0 | sort -z)

if git -C "$destino" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$destino" config core.hooksPath .githooks
  echo "  hook     core.hooksPath=.githooks"
else
  echo "  aviso    $destino não é um repositório git; rode 'git init' e 'git config core.hooksPath .githooks'"
fi
echo "forge-init: $criados criado(s), $mantidos mantido(s) em $destino"
