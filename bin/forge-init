#!/usr/bin/env bash
# Forge: prepara um projeto para ser desenvolvido pela fábrica.
# Uso: forge-init [--nome NOME] [--descricao TEXTO] [--stack NOME] [--pronto COMANDO] [--forcar] [--sem-versionar] [--sem-sandbox] [DIRETORIO]
# Copia templates/projeto para o diretório sem sobrescrever o que já existe (salvo --forcar),
# substitui os marcadores {{PROJETO}}, {{DESCRICAO}}, {{STACK}}, {{COMANDO_PRONTO}}, {{PRONTO_RAPIDO}} e {{DETECCAO}} e ativa o hook de git
# (nunca troca um core.hooksPath de outra ferramenta nem desliga hooks ativos em .git/hooks).
# --sem-versionar (FILA-24, D1 = B): no git ficam só .forge/versao, .forge/config.json e as chaves enabledPlugins e
# extraKnownMarketplaces do .claude/settings.json; o resto vai para .claude/settings.local.json e .git/info/exclude.
# --sem-sandbox (0.45.0): o sandbox não liga nem é oferecido aqui; quem chama (o forge adotar) oferece.
set -euo pipefail

raiz_forge="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
modelo="$raiz_forge/templates/projeto"

nome=""; descricao="Descreva aqui o objetivo do sistema."; pronto=""; stack="node-react"; forcar=0; sem_versionar=0; sem_sandbox=0; destino="."
while [ $# -gt 0 ]; do
  case "$1" in
    --nome) nome="$2"; shift 2 ;;
    --descricao) descricao="$2"; shift 2 ;;
    --stack) stack="$2"; shift 2 ;;
    --pronto) pronto="$2"; shift 2 ;;
    --forcar) forcar=1; shift ;;
    --sem-versionar) sem_versionar=1; shift ;;
    --sem-sandbox) sem_sandbox=1; shift ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "forge-init: opção desconhecida: $1" >&2; exit 2 ;;
    *) destino="$1"; shift ;;
  esac
done

# E21: o Forge precisa do Python 3.12 ou mais novo (o menor que o CI prova; o mesmo PYTHON_MINIMO do forge-doutor).
# Confere antes de mexer em qualquer arquivo, com a frase para quem não é técnico.
python_minimo="3.12"
conferir_python() {
  local versao
  if ! versao="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)" || [ -z "$versao" ]; then
    echo "forge-init: não achei o Python 3 neste computador, e o Forge precisa do Python $python_minimo ou mais novo. Instale-o (no Ubuntu 24.04 ele já vem; nos outros sistemas, em python.org) e rode de novo. Nada foi mudado." >&2
    exit 2
  fi
  if [ "$(printf '%s\n%s\n' "$python_minimo" "$versao" | sort -V | head -n1)" != "$python_minimo" ]; then
    echo "forge-init: este computador tem o Python $versao, e o Forge precisa do Python $python_minimo ou mais novo. Instale um Python mais novo (no Ubuntu 24.04 ele já vem) ou peça ajuda a quem cuida do computador, e rode de novo. Nada foi mudado." >&2
    exit 2
  fi
}
conferir_python

[ -d "$destino" ] || { echo "forge-init: diretório não existe: $destino" >&2; exit 2; }
destino="$(cd "$destino" && pwd)"
[ -n "$nome" ] || nome="$(basename "$destino")"

[[ "$stack" =~ ^[a-z0-9-]+$ && -f "$raiz_forge/stacks/$stack/pronto.md" ]] || {
  echo "forge-init: stack desconhecida: $stack (disponíveis: $(find "$raiz_forge/stacks" -mindepth 1 -maxdepth 1 -type d -printf '%f ' | sort | tr -s " "))" >&2; exit 2; }
# Comando "pronto" padrão: o sugerido pela stack ("Comando sugerido: `...`" em stacks/<stack>/pronto.md).
if [ -z "$pronto" ]; then
  # shellcheck disable=SC2016  # as crases são literais da expressão
  pronto="$(sed -n 's/^Comando sugerido: `\(.*\)`.*/\1/p' "$raiz_forge/stacks/$stack/pronto.md" | head -n1)"
  [ -n "$pronto" ] || pronto="a definir"
fi

# Pronto rápido da stack ("Pronto rápido: `...`" em stacks/<stack>/pronto.md), gravado no .githooks/pre-push.local, e os
# arquivos de "Detecção:" que dizem se já há código da stack para checar. Stack sem pronto rápido: o pre-push.local não é criado.
# shellcheck disable=SC2016  # as crases são literais da expressão
rapido="$(sed -n 's/^Pronto rápido: `\(.*\)`.*/\1/p' "$raiz_forge/stacks/$stack/pronto.md" | head -n1)"
# shellcheck disable=SC2016
deteccao="$(sed -n 's/^Detecção: //p' "$raiz_forge/stacks/$stack/pronto.md" | head -n1 | grep -o '`[^`]*`' | tr -d '`' | paste -sd' ' -)" || true

escapar() { printf '%s' "$1" | sed -e 's/[\/&|]/\\&/g'; }
n_esc="$(escapar "$nome")"; d_esc="$(escapar "$descricao")"; p_esc="$(escapar "$pronto")"; s_esc="$(escapar "$stack")"
r_esc="$(escapar "$rapido")"; t_esc="$(escapar "$deteccao")"

# .claude/settings.json existente (o próprio `claude plugin install --scope project` cria um): mescla em vez de pular.
# Une as chaves do modelo ao arquivo (dicionário por chave, lista sem repetir, valor do projeto fica); não apaga nada.
# A parte: tudo (padrão), declaracao (só enabledPlugins e extraKnownMarketplaces) ou resto (as outras chaves).
# D1 (0.44.0): o sandbox do modelo só entra com o 4º argumento 1 (projeto novo no Forge com bwrap e credencial).
mesclar_settings() {
  python3 - "$1" "$2" "${3:-tudo}" "${4:-0}" <<'PY'
import copy, json, sys
from pathlib import Path
DECLARACAO = {"extraKnownMarketplaces", "enabledPlugins"}
modelo = json.load(open(sys.argv[1], encoding="utf-8"))
destino, parte = Path(sys.argv[2]), sys.argv[3]
alvo = json.load(open(destino, encoding="utf-8")) if destino.exists() else {}
def unir(base, chave, valor):
    if chave not in base:
        base[chave] = copy.deepcopy(valor)
    elif isinstance(valor, dict) and isinstance(base[chave], dict):
        for k, v in valor.items():
            unir(base[chave], k, v)
    elif isinstance(valor, list) and isinstance(base[chave], list):
        base[chave] += [r for r in valor if r not in base[chave]]
for chave, valor in modelo.items():
    if chave == "sandbox" and sys.argv[4] != "1":
        continue
    if parte == "tudo" or (parte == "declaracao") == (chave in DECLARACAO):
        unir(alvo, chave, valor)
destino.parent.mkdir(parents=True, exist_ok=True)
with open(destino, "w", encoding="utf-8") as f:
    json.dump(alvo, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
}

# Repositório git do destino: o hook e o modo --sem-versionar dependem dele.
em_git=0
if git -C "$destino" rev-parse --is-inside-work-tree >/dev/null 2>&1; then em_git=1; fi
if [ "$sem_versionar" -eq 1 ] && [ "$em_git" -eq 0 ]; then
  echo "forge-init: --sem-versionar pede um repositório git (rode 'git init' antes)" >&2; exit 2
fi

# Projeto que já usa o Forge mas é anterior ao .forge/ (ADR 0005): a versão real é desconhecida.
antigo=0
if [ ! -e "$destino/.forge/versao" ] && { [ -e "$destino/CLAUDE.md" ] || [ -e "$destino/KANBAN.md" ]; }; then antigo=1; fi

novo_no_forge=0
if [ ! -e "$destino/.forge/versao" ] && [ "$antigo" -eq 0 ]; then novo_no_forge=1; fi

# B3 (review da 0.44.1): o sandbox do modelo só liga com o bubblewrap instalado e a credencial do bot configurada (ADR 0009, etapa 2:
# GH_TOKEN no ambiente ou no `env` do ~/.claude/settings.json; GIT_CONFIG_COUNT no ambiente, no `env` dele ou no do
# .claude/settings.local.json do projeto). Sem os dois, o sandbox quebraria o gh, o push e a abertura da sessão: não liga e oferece.
sandbox_pronto() {
  command -v bwrap >/dev/null 2>&1 || return 1
  python3 - "$HOME/.claude/settings.json" "$destino/.claude/settings.local.json" <<'PY'
import json, os, sys
envs = [os.environ]
for p in sys.argv[1:]:
    try:
        e = json.load(open(p, encoding="utf-8")).get("env")
    except (OSError, ValueError, AttributeError):
        continue
    if isinstance(e, dict):
        envs.append(e)
tem = lambda k: any(isinstance(e.get(k), str) and e.get(k).strip() for e in envs)  # noqa: E731
sys.exit(0 if tem("GH_TOKEN") and tem("GIT_CONFIG_COUNT") else 1)
PY
}
sandbox_ok=0; sandbox_novo=0; sandbox_oferta=0
if [ "$sem_sandbox" -eq 0 ] && sandbox_pronto; then sandbox_ok=1; fi
if [ "$novo_no_forge" -eq 1 ]; then
  if [ "$sandbox_ok" -eq 1 ]; then sandbox_novo=1; else sandbox_oferta=1; fi
fi

criados=0; mantidos=0; config_nova=0; fora_do_git=()
while IFS= read -r -d '' arq; do
  rel="${arq#"$modelo"/}"
  alvo="$destino/$rel"
  if [ "$rel" = ".claude/settings.json" ] && [ "$sem_versionar" -eq 1 ]; then
    mesclar_settings "$arq" "$alvo" declaracao 0
    mesclar_settings "$arq" "$destino/.claude/settings.local.json" resto "$sandbox_novo"
    fora_do_git+=(".claude/settings.local.json")
    echo "  mesclado $rel (só a declaração do plugin; o resto em .claude/settings.local.json)"; continue
  fi
  if [ "$rel" = ".claude/settings.json" ] && [ -e "$alvo" ] && [ "$forcar" -eq 0 ]; then
    mesclar_settings "$arq" "$alvo" tudo "$sandbox_novo"
    echo "  mesclado $rel"; continue
  fi
  if [ "$rel" = ".githooks/pre-push.local" ] && [ -z "$rapido" ]; then
    echo "  pulado   $rel (stacks/$stack/pronto.md sem 'Pronto rápido')"; continue
  fi
  if [ -e "$alvo" ] && [ "$forcar" -eq 0 ]; then
    echo "  mantido  $rel"; mantidos=$((mantidos + 1)); continue
  fi
  mkdir -p "$(dirname "$alvo")"
  sed -e "s|{{PROJETO}}|$n_esc|g" -e "s|{{DESCRICAO}}|$d_esc|g" -e "s|{{STACK}}|$s_esc|g" -e "s|{{COMANDO_PRONTO}}|$p_esc|g" \
    -e "s|{{PRONTO_RAPIDO}}|$r_esc|g" -e "s|{{DETECCAO}}|$t_esc|g" "$arq" > "$alvo"
  [ -x "$arq" ] && chmod +x "$alvo"
  if [ "$rel" = ".claude/settings.json" ] && [ "$sandbox_ok" -eq 0 ]; then  # B3: sem bwrap ou credencial, o modelo sai sem sandbox
    sandbox_oferta=1
    python3 - "$alvo" <<'PY'
import json, sys
dados = json.load(open(sys.argv[1], encoding="utf-8"))
dados.pop("sandbox", None)
with open(sys.argv[1], "w", encoding="utf-8") as f:
    json.dump(dados, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
  fi
  echo "  criado   $rel"; criados=$((criados + 1))
  if [ "$rel" = ".forge/config.json" ]; then config_nova=1; else fora_do_git+=("$rel"); fi
done < <(find "$modelo" -type f -print0 | sort -z)

# Tarefas pesadas padrão (hook `pesado`): vêm do pacote da stack (stacks/<stack>/pesados.json, uma lista JSON), não do núcleo.
# Só no .forge/config.json criado agora; a config que o projeto já tinha não é tocada.
if [ "$config_nova" -eq 1 ] && [ -f "$raiz_forge/stacks/$stack/pesados.json" ]; then
  python3 - "$raiz_forge/stacks/$stack/pesados.json" "$destino/.forge/config.json" <<'PY'
import json, sys
lista, alvo = sys.argv[1:3]
config = json.load(open(alvo, encoding="utf-8"))
config["pesados"] = json.load(open(lista, encoding="utf-8"))
with open(alvo, "w", encoding="utf-8") as f:
    json.dump(config, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
  echo "  pesados  .forge/config.json (padrão da stack $stack)"
fi

# Versão do Forge usada (ADR 0005): só grava se ausente, para não esconder migração pendente de projeto antigo;
# no projeto antigo grava 0.0.0, e o forge-upgrade aplica as migrações.
versao_forge="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$raiz_forge/.claude-plugin/plugin.json")"
if [ "$antigo" -eq 1 ] && [ "$forcar" -eq 0 ]; then
  mkdir -p "$destino/.forge"; printf '0.0.0\n' > "$destino/.forge/versao"
  echo "  criado   .forge/versao (0.0.0: projeto anterior ao .forge/)"
  echo "  aviso    rode 'forge-upgrade' neste projeto para aplicar as migrações do Forge"
elif [ ! -e "$destino/.forge/versao" ] || [ "$forcar" -eq 1 ]; then
  mkdir -p "$destino/.forge"; printf '%s\n' "$versao_forge" > "$destino/.forge/versao"
  echo "  criado   .forge/versao ($versao_forge)"
fi
# Estado de execução local e preferências da pessoa (perfil de experiência) não são versionados.
ignorados=('.forge/run/' '.forge/perfil' '.forge/novo-projeto.json' '.forge/onboarding.md')
if [ "$sem_versionar" -eq 1 ]; then
  # FILA-24 (D1 = B): o que o Forge criou fica fora do git pelo .git/info/exclude, que não é versionado; o .gitignore do
  # projeto não muda. Só entram os arquivos criados agora: o que o projeto já tinha continua como estava.
  exclude="$(git -C "$destino" rev-parse --path-format=absolute --git-path info/exclude)"
  prefixo="$(git -C "$destino" rev-parse --show-prefix)"
  mkdir -p "$(dirname "$exclude")"
  for rel in "${ignorados[@]}" "${fora_do_git[@]}"; do
    if ! command grep -qxF "/$prefixo$rel" "$exclude" 2>/dev/null; then echo "/$prefixo$rel" >> "$exclude"; fi
  done
  echo "  exclude  ${#fora_do_git[@]} arquivo(s) do Forge e o estado local fora do git (.git/info/exclude)"
  python3 - "$destino/.forge/config.json" <<'PY'
import json, sys
config = json.load(open(sys.argv[1], encoding="utf-8"))
config["arquivos_do_forge_no_git"] = False
with open(sys.argv[1], "w", encoding="utf-8") as f:
    json.dump(config, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
  echo "  config   .forge/config.json (arquivos_do_forge_no_git: false)"
else
  for ignorado in "${ignorados[@]}"; do
    if ! command grep -qxF "$ignorado" "$destino/.gitignore" 2>/dev/null; then
      echo "$ignorado" >> "$destino/.gitignore"; echo "  gitignore $ignorado"
    fi
  done
fi

# Hook de git: liga o .githooks do Forge, mas nunca troca o core.hooksPath de outra ferramenta nem desliga hooks ativos
# em .git/hooks (o core.hooksPath faria o git ignorá-los). Nesses casos avisa e deixa como está (C-46-3).
if [ "$em_git" -eq 1 ]; then
  atual="$(git -C "$destino" config --get core.hooksPath || true)"
  ativos=""
  if [ -z "$atual" ]; then
    pasta_hooks="$(git -C "$destino" rev-parse --path-format=absolute --git-path hooks)"
    ativos="$(find "$pasta_hooks" -maxdepth 1 -type f -perm -u+x ! -name '*.sample' -printf '%f ' 2>/dev/null | sed 's/ $//' || true)"
  fi
  if [ -n "$atual" ] && [ "$atual" != ".githooks" ] && [ "$atual" != "$destino/.githooks" ]; then
    echo "  aviso    core.hooksPath=$atual é de outra ferramenta e fica como está; o pre-push do Forge (proteção da main)"
    echo "           não foi ligado: chame .githooks/pre-push a partir do pre-push dessa ferramenta"
  elif [ -n "$ativos" ]; then
    echo "  aviso    hooks ativos em .git/hooks ($ativos) ficam como estão; core.hooksPath não foi trocado para não"
    echo "           desligá-los: chame .githooks/pre-push a partir do seu pre-push para ter a proteção da main"
  else
    git -C "$destino" config core.hooksPath .githooks
    echo "  hook     core.hooksPath=.githooks"
  fi
else
  echo "  aviso    $destino não é um repositório git; rode 'git init' e 'git config core.hooksPath .githooks'"
fi
if [ "$sandbox_oferta" -eq 1 ] && [ "$sem_sandbox" -eq 0 ]; then
  echo "  oferta   sandbox do Bash NÃO ligado: falta o bubblewrap (bwrap) ou a credencial do bot (ADR 0009, etapa 2). Para ligá-lo:"
  echo "           1) instale bubblewrap e socat (scripts/preparar-estacao.sh); 2) ponha o GH_TOKEN do bot no env do ~/.claude/settings.json;"
  echo "           3) rode scripts/configurar-ambiente-local.sh (GIT_CONFIG_* no .claude/settings.local.json); 4) forge-upgrade --ligar-sandbox $destino"
fi
echo "forge-init: $criados criado(s), $mantidos mantido(s) em $destino"
