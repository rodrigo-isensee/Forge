#!/usr/bin/env python3
"""Forge: traz um projeto para a versão atual do plugin (ADR 0005). Rode NO projeto, quando quiser.
Uso: forge-upgrade [--simular] [--ate VERSAO] [--apagar-mesclada] [DIRETORIO]
     forge-upgrade --ligar-sandbox [DIRETORIO]
Cria a branch forge/upgrade-<versão>, aplica as migrações pendentes (um commit cada) e sugere o PR. Uma versão pode ter vários
passos: `migrar` (resumo no LEIA.md) e depois `migrar-<passo>` (resumo no LEIA-<passo>.md), em ordem de nome.
Nunca faz push nem merge. D1 (0.44.0): com o sandbox do Bash desligado no .claude/settings.json do projeto, só OFERECE o comando
`--ligar-sandbox`, que grava o bloco `sandbox` do modelo (templates/projeto) sem commitar; nunca o liga sozinho."""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent


def versao(texto):
    return tuple(int(p) for p in texto.strip().split("."))


def git(projeto, *args, check=True):
    r = subprocess.run(["git", "-C", str(projeto), *args], capture_output=True, text=True)
    if check and r.returncode:
        sair(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


def passo(migrar):
    """(rótulo, LEIA) de um passo de migração: `migrar` usa o LEIA.md; `migrar-<passo>`, o LEIA-<passo>.md."""
    nome = migrar.name.removeprefix("migrar").removeprefix("-")
    rotulo = migrar.parent.name + (f" ({nome})" if nome else "")
    return rotulo, migrar.parent / (f"LEIA-{nome}.md" if nome else "LEIA.md")


def migracoes_pendentes(atual, alvo):
    """Os passos das versões acima de `atual` e até `alvo`: por versão, o `migrar` e depois os `migrar-<passo>` em ordem de
    nome (uma versão pode ter vários passos, de entregas diferentes, sem que um edite o arquivo do outro)."""
    passos = (p for p in (RAIZ / "migrations").glob("*/migrar*") if p.name == "migrar" or p.name.startswith("migrar-"))
    return sorted((p for p in passos if versao(atual) < versao(p.parent.name) <= versao(alvo)),
                  key=lambda p: (versao(p.parent.name), p.name))  # "migrar" vem antes de "migrar-<passo>"


def sair(msg, codigo=1):
    print(f"forge-upgrade: {msg}", file=sys.stderr)
    sys.exit(codigo)


def branch_ja_existe(projeto, nova, base, alvo, a):
    """A branch do upgrade já existe: mesclada na base só se apaga com --apagar-mesclada; squash e o resto recusam."""
    sha = git(projeto, "rev-parse", f"refs/heads/{nova}")
    mesclada = subprocess.run(["git", "-C", str(projeto), "merge-base", "--is-ancestor", sha, f"refs/heads/{base}"],
                              capture_output=True).returncode == 0
    if mesclada and not a.apagar_mesclada:
        sair(f"a branch {nova} já foi mesclada na '{base}'; apague-a com `git branch -d {nova}` (estando na '{base}') "
             "ou rode de novo com --apagar-mesclada, e repita", 2)
    if mesclada and a.simular:
        print(f"apagaria a branch {nova} (mesclada na '{base}')")
    elif mesclada:
        git(projeto, "update-ref", "-d", f"refs/heads/{nova}", sha)  # só apaga se o head ainda é o conferido
        print(f"apagada a branch {nova} (mesclada na '{base}')")
    elif git(projeto, "show", f"refs/heads/{base}:.forge/versao", check=False) == alvo:
        sair(f"a branch {nova} parece mesclada por squash (a '{base}' já está na {alvo}); confira com "
             f"`git log {base}..{nova}` e apague com `git branch -D {nova}`; nesta branch, traga a '{base}' "
             "em vez de rodar o upgrade", 2)
    else:
        sair(f"a branch {nova} já existe", 2)


def sandbox_ligado(projeto):
    """O `.claude/settings.json` ou o `.claude/settings.local.json` do projeto liga o sandbox (`sandbox.enabled` true)."""
    for nome in ("settings.json", "settings.local.json"):
        try:
            caixa = json.loads((projeto / ".claude" / nome).read_text(encoding="utf-8")).get("sandbox")
        except (OSError, ValueError, AttributeError):
            continue
        if isinstance(caixa, dict) and caixa.get("enabled") is True:
            return True
    return False


def oferecer_sandbox(projeto):
    """D1: só a oferta, com o comando; o upgrade nunca liga o sandbox sozinho."""
    if not sandbox_ligado(projeto):
        print("\nOferta: o sandbox do Bash está desligado neste projeto. Para ligá-lo no padrão do Forge (sem ler ~/.ssh nem as "
              f"credenciais do gh, rede só na lista e sem as APIs pagas), rode, se quiser:\n  forge-upgrade --ligar-sandbox {projeto}")


IMPOSTOS_DO_SANDBOX = {"enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False}


def mesclar_sandbox(modelo, atual):
    """Mescla profunda (review da 0.44.1): as chaves do projeto ficam, as do modelo que faltam entram, as listas se unem (as do
    projeto primeiro, nada apagado: `denyRead` e `deniedDomains` ganham as do modelo) e as subchaves que o projeto tinha com outro
    tipo voltam ao modelo."""
    saida = dict(atual)
    for chave, valor in modelo.items():
        tinha = atual.get(chave)
        if isinstance(valor, dict):
            saida[chave] = mesclar_sandbox(valor, tinha if isinstance(tinha, dict) else {})
        elif isinstance(valor, list):
            base = tinha if isinstance(tinha, list) else []
            saida[chave] = base + [v for v in valor if v not in base]
        elif chave not in atual:
            saida[chave] = valor
    return saida


def ligar_sandbox(projeto):
    """Grava o bloco `sandbox` do modelo no `.claude/settings.json` do projeto (o resto do arquivo e as chaves do sandbox que o projeto
    já tinha ficam; `enabled` vira true); não commita."""
    alvo = projeto / ".claude" / "settings.json"
    if alvo.parent.is_symlink() or alvo.is_symlink():
        sair(f"{alvo} é um link; ligue o sandbox à mão (`/sandbox` no Claude)", 2)
    try:
        dados = json.loads(alvo.read_text(encoding="utf-8")) if alvo.exists() else {}
    except ValueError:
        sair(f"{alvo} não é JSON válido; corrija-o antes", 2)
    if not isinstance(dados, dict):
        sair(f"{alvo} não é um objeto JSON; corrija-o antes", 2)
    modelo = json.loads((RAIZ / "templates/projeto/.claude/settings.json").read_text(encoding="utf-8"))["sandbox"]
    atual = dados.get("sandbox") if isinstance(dados.get("sandbox"), dict) else {}
    dados["sandbox"] = {**mesclar_sandbox(modelo, atual), **IMPOSTOS_DO_SANDBOX}  # os campos de segurança do modelo valem sempre
    alvo.parent.mkdir(exist_ok=True)
    alvo.write_text(json.dumps(dados, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"forge-upgrade: sandbox ligado em {alvo}; revise o diff e commite (reabra o Claude para valer)")


def main():
    ap = argparse.ArgumentParser(description="Traz um projeto para a versão atual do Forge.")
    ap.add_argument("diretorio", nargs="?", default=".")
    ap.add_argument("--simular", action="store_true", help="mostra o que mudaria, sem gravar")
    ap.add_argument("--ate", help="versão-alvo (padrão: a do plugin)")
    ap.add_argument("--apagar-mesclada", action="store_true",
                    help="apaga a branch forge/upgrade-<versão> que já foi mesclada na base e segue")
    ap.add_argument("--ligar-sandbox", action="store_true",
                    help="só isto: grava o sandbox do modelo no .claude/settings.json do projeto (sem commit)")
    a = ap.parse_args()

    projeto = Path(a.diretorio).resolve()
    if a.ligar_sandbox:
        return ligar_sandbox(projeto)
    if git(projeto, "rev-parse", "--is-inside-work-tree", check=False) != "true":
        sair(f"{projeto} não é um repositório git", 2)
    if git(projeto, "status", "--porcelain"):
        sair("a cópia de trabalho não está limpa; commite ou guarde as mudanças antes", 2)

    # Antes de atualizar: o doutor (rápido, só avisa) mostra o que já está fora do lugar, para não somar problema a problema.
    # (`forge atualizar` já roda o doutor por conta própria e define FORGE_SEM_DOUTOR para o aviso não aparecer no meio dele.)
    if not os.environ.get("FORGE_SEM_DOUTOR"):
        subprocess.run([sys.executable, str(RAIZ / "bin" / "forge-doutor"), "--rapido", str(projeto)], check=False)

    alvo = a.ate or json.loads((RAIZ / ".claude-plugin/plugin.json").read_text(encoding="utf-8"))["version"]
    arq_versao = projeto / ".forge/versao"
    atual = arq_versao.read_text(encoding="utf-8").strip() if arq_versao.exists() else "0.0.0"
    pendentes = migracoes_pendentes(atual, alvo)
    if not pendentes and versao(atual) >= versao(alvo):
        print(f"forge-upgrade: projeto já está na versão {atual}; nada a fazer.")
        oferecer_sandbox(projeto)
        return

    atual_branch = git(projeto, "branch", "--show-current")
    base = "develop" if git(projeto, "rev-parse", "--verify", "-q", "refs/heads/develop", check=False) else atual_branch
    if base in ("main", "master", ""):
        sair(f"branch de integração seria '{base or 'HEAD solto'}'; entre numa branch de trabalho ou crie a develop", 2)
    nova = f"forge/upgrade-{alvo}"
    if git(projeto, "rev-parse", "--verify", "-q", f"refs/heads/{nova}", check=False):
        branch_ja_existe(projeto, nova, base, alvo, a)

    print(f"Projeto {projeto}\n  versão atual {atual} -> {alvo}; branch {nova} a partir de {base}")
    for p in pendentes:
        rotulo, leia = passo(p)
        resumo = leia.read_text(encoding="utf-8").splitlines()[2:3] if leia.is_file() else []
        print(f"  migração {rotulo}: {resumo[0].split('. ')[0] if resumo else ''}")
    if a.simular:
        print("(--simular: nada foi gravado)")
        return

    git(projeto, "switch", "-c", nova, base)
    for p in pendentes:
        rotulo = passo(p)[0]
        r = subprocess.run([sys.executable, str(p), str(projeto)], capture_output=True, text=True)
        if r.returncode:
            sair(f"a migração {rotulo} parou:\n{r.stdout}{r.stderr}\nResolva à mão na branch {nova}.")
        git(projeto, "add", "-A")
        if git(projeto, "status", "--porcelain"):
            git(projeto, "commit", "-q", "-m", f"chore(forge): migração {rotulo}")
            print(f"  commit   migração {rotulo}")
    arq_versao.parent.mkdir(exist_ok=True)
    arq_versao.write_text(alvo + "\n", encoding="utf-8")
    git(projeto, "add", ".forge/versao")
    if git(projeto, "status", "--porcelain"):
        git(projeto, "commit", "-q", "-m", f"chore(forge): registra versão {alvo}")
    print(f"\nPronto na branch {nova}. Revise o diff (git log {base}..{nova}) e abra o PR; o merge é seu:")
    print(f"  gh pr create --base {base} --title 'chore(forge): atualiza para {alvo}'")
    oferecer_sandbox(projeto)


if __name__ == "__main__":
    main()
