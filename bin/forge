#!/usr/bin/env bash
# Forge: despachante de subcomandos. `forge <sub> [args]` executa `bin/forge-<sub>`.
# Uso: forge <subcomando> [argumentos]   (sem argumento, boas-vindas e os subcomandos; -h, só os subcomandos)
#   forge novo-projeto   cria um projeto novo no GitHub e abre o Jarvis nele
#   forge adotar         traz um projeto que já existe para o Forge, sem quebrar nada
#   forge salvar         salva o trabalho (commit e envio) na branch de trabalho
#   forge desfazer       volta ao último ponto bom, sem apagar histórico
#   forge atualizar      atualiza o Forge do projeto, com ponto de retorno
#   forge voltar-versao  volta para a versão de antes da última atualização
#   forge sugerir        sugere uma melhoria ao Forge, sem dados do projeto
#   forge ritmo          mostra ou muda o ritmo do time: econômico, equilibrado ou acelerado
set -euo pipefail

dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

listar() {
  echo "Uso: forge <subcomando> [argumentos]"
  echo "Subcomandos:"
  for f in "$dir"/forge-*; do
    [ -x "$f" ] && echo "  ${f##*/forge-}"
  done
}

# ADR 0015, item 1: quem chega digita `forge` e vê os dois caminhos antes da lista.
boas_vindas() {
  echo "Forge: um time de agentes (o Jarvis e os especialistas) que desenvolve o seu sistema com você."
  echo "Por onde começar:"
  echo "  projeto novo:          forge novo-projeto"
  echo "  projeto que já existe: entre na pasta dele e rode forge adotar"
  echo
}

if [ $# -eq 0 ]; then boas_vindas; listar; exit 0; fi
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then listar; exit 0; fi

sub="$1"; shift
if ! [[ "$sub" =~ ^[a-z][a-z0-9-]*$ ]] || [ ! -x "$dir/forge-$sub" ]; then
  echo "forge: subcomando desconhecido: $sub" >&2
  listar >&2
  exit 2
fi
exec "$dir/forge-$sub" "$@"
