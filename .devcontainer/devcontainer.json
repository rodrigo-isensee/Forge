// Forge: definição mínima do container de desenvolvimento (P9 da 0.43.1; E2.54 da 0.47.2).
// Ao recriar o container, só /workspaces, ~/.claude e ~/.vscode-server sobrevivem. A cada início o postStartCommand
// refaz sozinho, sem o dono, o essencial: gh (apt oficial), o link ~/.forge-contrib para /workspaces/.forge-contrib e o
// core.hooksPath. O login do gh sobrevive em ~/.claude/gh (link ~/.config/gh); sem ele, o Jarvis dá o comando ao abrir.
// O script é idempotente e nunca apaga dados.
// DEVCONTAINER-SEM-GH (v0481 E35.1): o comando roda o script de preparo da cópia já presente em /workspaces/Forge, sem clonar
// a main e sem depender do gh, que o próprio script instala. Decisão do dono, que troca o clone raso da main do B2 da 0.43.1:
// o script roda como root, fora do sandbox, mas só com FORGE_PREPARO_ESSENCIAL=1 (sem a cópia vigente nem o dev-marketplace, que
// ficam no comando manual `bash /workspaces/Forge/scripts/preparar-estacao.sh --container`) e este arquivo é protegido pelo hook.
// O preparo cria ~/.config/gh, instala gh e tmux e refaz o link ~/.forge-contrib; cada passo é idempotente. Faltou algo: o script
// sai com rc 1 e uma linha "erro:", e o comando repete o aviso e sai com 1 (sem "; true" engolindo); o container sobe do mesmo jeito.
// Nenhum segredo aqui, e o GH_TOKEN da máquina do dono NÃO entra no container (remoteEnv o repassaria, com o escopo
// workflow, a todo processo, inclusive a sessão do agente). Login do dono: gh auth login -s repo,workflow --web (escopo
// mínimo repo e workflow, que o push de .github/ pede); o token do bot (ADR 0009) não leva workflow.
// A imagem é a base Ubuntu 24.04 dos dev containers; o volume nomeado guarda ~/.claude.
// shutdownAction none (D2 da BP3): fechar o VS Code não para o container, e o tmux com o Jarvis segue vivo.
{
  "name": "Forge",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "root",
  "shutdownAction": "none",
  "workspaceFolder": "/workspaces/Forge",
  "mounts": [
    "source=forge-claude,target=/root/.claude,type=volume"
  ],
  "postStartCommand": "FORGE_PREPARO_ESSENCIAL=1 bash /workspaces/Forge/scripts/preparar-estacao.sh --container < /dev/null || { echo 'ERRO: o preparo do container falhou (veja as linhas erro: acima); rode bash /workspaces/Forge/scripts/preparar-estacao.sh --container' >&2; exit 1; }"
}
