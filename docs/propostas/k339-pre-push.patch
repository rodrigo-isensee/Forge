diff --git a/tests/test_prepush_k339.py b/tests/test_prepush_k339.py
new file mode 100644
index 0000000..065c368
--- /dev/null
+++ b/tests/test_prepush_k339.py
@@ -0,0 +1,94 @@
+"""K339 (v0478 E72.1 e E72.3): no laço de refs do pre-push do modelo de projeto, a ancestralidade é lida sem enxertos
+(`git replace --graft` e o antigo `.git/info/grafts` não forjam o fast-forward), tag que já existe no remoto não se move
+(nem para um descendente; tag nova pode) e tag com o nome de um remoto (`origin` ou o deste envio, sozinho ou como pasta)
+não é criada nem movida (apagar pode). Entra com o patch de docs/propostas/k339-pre-push.md, que o dono aplica (a pasta
+.githooks/ do modelo é travada para os agentes).
+"""
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import test_prepush_refs as refs  # noqa: E402
+
+ZERO = refs.ZERO
+NAO_FF, TAG_EXISTE, TAG_REMOTO = "envio não fast-forward", "já existe no remoto e não se move", "imita um remoto"
+
+
+class K339Modelo(refs.Base, unittest.TestCase):
+    HOOK = refs.HOOKS["modelo"]
+
+    def setUp(self):
+        super().setUp()
+        self.git("commit", "-q", "--allow-empty", "-m", "b")
+        self.filho = self.git("rev-parse", "HEAD")
+        self.git("checkout", "-q", "--orphan", "outra")
+        self.git("commit", "-q", "--allow-empty", "-m", "x")
+        self.orfao = self.git("rev-parse", "HEAD")
+
+    def roda_no_remoto(self, nome, linhas):
+        """Como `roda`, com outro nome de remoto em $1 (o git passa o nome do remoto do envio)."""
+        r = subprocess.run([str(self.HOOK), nome, str(self.remoto)], cwd=self.repo, env=self.env,
+                           input="".join(f"{ln}\n" for ln in linhas), capture_output=True, text=True, timeout=120,
+                           start_new_session=True)
+        return r.returncode, r.stdout + r.stderr
+
+    def assertPassa(self, resultado):
+        codigo, saida = resultado
+        self.assertEqual([t for t in (NAO_FF, TAG_EXISTE, TAG_REMOTO) if t in saida], [], saida)
+        self.assertEqual(codigo, 0, saida)
+
+    def test_graft_nao_forja_fast_forward(self):
+        self.git("replace", "--graft", self.orfao, self.sha)
+        linha = f"refs/heads/outra {self.orfao} refs/heads/melhoria/a {self.sha}"
+        self.assertRecusa(self.roda([linha]), NAO_FF)
+
+    def test_arquivo_de_grafts_nao_forja_fast_forward(self):
+        (self.repo / ".git" / "info").mkdir(exist_ok=True)
+        (self.repo / ".git" / "info" / "grafts").write_text(f"{self.orfao} {self.sha}\n", encoding="utf-8")
+        linha = f"refs/heads/outra {self.orfao} refs/heads/melhoria/a {self.sha}"
+        self.assertRecusa(self.roda([linha]), NAO_FF)
+
+    def test_fast_forward_real_passa(self):
+        self.assertPassa(self.roda([f"refs/heads/melhoria/a {self.filho} refs/heads/melhoria/a {self.sha}"]))
+
+    def test_tag_existente_movida_para_descendente_recusa(self):
+        self.assertRecusa(self.roda([f"refs/tags/v1 {self.filho} refs/tags/v1 {self.sha}"]), TAG_EXISTE)
+
+    def test_tag_nova_passa(self):
+        self.assertPassa(self.roda([f"refs/tags/v2 {self.filho} refs/tags/v2 {ZERO}"]))
+
+    def test_tag_origin_nova_recusa(self):
+        # $1 é outro remoto: só o padrão fixo `origin/*` pode recusar.
+        for ref in ("refs/tags/origin/develop", "refs/tags/origin/main"):
+            with self.subTest(ref):
+                self.assertRecusa(self.roda_no_remoto("upstream", [f"{ref} {self.filho} {ref} {ZERO}"]), TAG_REMOTO)
+
+    def test_tag_origin_sem_barra_recusa(self):
+        ref = "refs/tags/origin"
+        self.assertRecusa(self.roda_no_remoto("upstream", [f"{ref} {self.filho} {ref} {ZERO}"]), TAG_REMOTO)
+
+    def test_tag_com_o_nome_do_remoto_recusa(self):
+        ref = "refs/tags/fork"
+        self.assertRecusa(self.roda_no_remoto("fork", [f"{ref} {self.filho} {ref} {ZERO}"]), TAG_REMOTO)
+
+    def test_tag_na_pasta_do_remoto_recusa(self):
+        ref = "refs/tags/fork/develop"
+        self.assertRecusa(self.roda_no_remoto("fork", [f"{ref} {self.filho} {ref} {ZERO}"]), TAG_REMOTO)
+
+    def test_tag_com_prefixo_do_remoto_passa(self):
+        # Só o nome exato do remoto, ou ele como pasta, recusa: `forkado` e `originais` seguem livres.
+        for ref in ("refs/tags/forkado", "refs/tags/originais"):
+            with self.subTest(ref):
+                self.assertPassa(self.roda_no_remoto("fork", [f"{ref} {self.filho} {ref} {ZERO}"]))
+
+    def test_apagar_tag_origin_passa(self):
+        self.assertPassa(self.roda([f"(delete) {ZERO} refs/tags/origin/develop {self.sha}"]))
+
+    def test_apagar_tag_do_remoto_passa(self):
+        self.assertPassa(self.roda_no_remoto("fork", [f"(delete) {ZERO} refs/tags/fork {self.sha}"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
