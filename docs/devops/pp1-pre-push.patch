+PULOS_FILTRO_PY='import ast, sys
+sys.path.insert(0, "tests")
+try:
+    import catraca
+    arqs = [a for a in sys.argv[2:] if a.startswith("tests/") and a.endswith(".py") and a != "tests/catraca.py"]
+    def pulos(ref):
+        arvores = []
+        for a in arqs:
+            texto = catraca.ler(".", ref, a)
+            if texto is None:
+                continue
+            try:
+                arvores.append(ast.parse(texto))
+            except SyntaxError:
+                pass
