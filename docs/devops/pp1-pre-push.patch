+    antes, depois = pulos(sys.argv[1]), pulos("HEAD")
+except Exception:
+    sys.exit(2)
+if depois > antes:
+    print(f"skip/skipIf/skipUnless/expectedFailure/skipTest em tests/ subiram de {antes} para {depois}")
+    sys.exit(1)
