#!/usr/bin/env python3
"""Migração 0.5.0 (ADR 0005): cria .forge/versao, .forge/config.json e a linha .forge/run/ no .gitignore.
Uso: migrar DIRETORIO_DO_PROJETO. Idempotente; não sobrescreve nada que exista."""
import shutil
import sys
from pathlib import Path

raiz_forge = Path(__file__).resolve().parents[2]
projeto = Path(sys.argv[1]).resolve()
forge = projeto / ".forge"
forge.mkdir(exist_ok=True)

if not (forge / "versao").exists():
    (forge / "versao").write_text("0.5.0\n", encoding="utf-8")
    print("criado .forge/versao")
if not (forge / "config.json").exists():
    shutil.copy(raiz_forge / "templates/projeto/.forge/config.json", forge / "config.json")
    print("criado .forge/config.json")
gitignore = projeto / ".gitignore"
linhas = gitignore.read_text(encoding="utf-8").splitlines() if gitignore.exists() else []
if ".forge/run/" not in linhas:
    gitignore.write_text("\n".join(linhas + [".forge/run/"]) + "\n", encoding="utf-8")
    print("acrescentado .forge/run/ ao .gitignore")
