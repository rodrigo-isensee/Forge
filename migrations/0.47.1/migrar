#!/usr/bin/env python3
"""Migração 0.47.1 (MP1311, item 9): cria docs/security/_modelo.md no projeto quando falta, porque o papel de segurança
e a skill cyber-security citam esse modelo (o forge-init só o copia em projeto novo). Não sobrescreve o que existe.
Uso: migrar DIRETORIO_DO_PROJETO. Idempotente."""
import shutil
import sys
from pathlib import Path

REL = "docs/security/_modelo.md"
raiz_forge = Path(__file__).resolve().parents[2]
alvo = Path(sys.argv[1]).resolve() / REL
if not alvo.exists():
    alvo.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy(raiz_forge / "templates/projeto" / REL, alvo)
    print(f"criado {REL}")
