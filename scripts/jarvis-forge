#!/usr/bin/env bash
# Forge: abre o Jarvis dentro do repositório ~/Forge (onde se edita), usando como plugin uma CÓPIA VIGENTE do Forge
# (clone da origin/develop em ${XDG_DATA_HOME:-~/.local/share}/forge/vigente), não a cópia de trabalho: editar hooks/
# ou agents/ numa branch não muda a guarda nem as instruções em uso (ADR 0009, seção 4). A cópia é criada se faltar
# e, ao abrir, é atualizada sozinha só por fast-forward para a origin/develop (recusa e avisa se tiver mudança ou
# commit local, ou se estiver sem rede; sessão tmux já aberta não é tocada). Uma vez por dia consulta, com
# `forge-check fontes`, a fonte de harness e mostra uma linha se houver versão nova. Retoma a última conversa, com
# chat remoto e, se instalado, o canal do Telegram. Dentro do tmux (criado/anexado automaticamente) a sessão sobrevive ao fechamento do terminal.
# Uso: jarvis-forge [--sem-tmux] [--dev] | jarvis-forge --atualizar-vigente
#   --sem-tmux           abre direto no terminal, sem criar ou anexar a sessão do tmux
#   --atualizar-vigente  atualiza a cópia vigente para a origin/develop (recusa se tiver mudanças ou commits locais) e sai
#   --dev                teste manual do dono: usa a cópia de trabalho (--plugin-dir .), sem a proteção da cópia vigente
#   -h, --help           mostra esta ajuda
set -euo pipefail
sem_tmux=0
dev=0
atualizar=0
for a in "$@"; do
  case "$a" in
    --sem-tmux) sem_tmux=1 ;;
    --dev) dev=1 ;;
    --atualizar-vigente) atualizar=1 ;;
    -h|--help) sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "jarvis-forge: argumento desconhecido: $a (veja jarvis-forge --help)" >&2; exit 2 ;;
  esac
done
dados="${XDG_DATA_HOME:-$HOME/.local/share}"
case "$dados" in
  /*) ;;
  *) echo "jarvis-forge: XDG_DATA_HOME deve ser um caminho absoluto (recebi '$dados'); nada foi feito." >&2; exit 2 ;;
esac
case "${XDG_STATE_HOME:-/}" in
  /*) ;;
  *) echo "jarvis-forge: XDG_STATE_HOME deve ser um caminho absoluto (recebi '$XDG_STATE_HOME'); nada foi feito." >&2; exit 2 ;;
esac
vigente="$dados/forge/vigente"
if [ "$atualizar" = 1 ] && [ "$dev" = 1 ]; then
  echo "jarvis-forge: --atualizar-vigente e --dev não combinam." >&2; exit 2
fi
criar_vigente() {
  local origem
  origem="$(git -C "$HOME/Forge" remote get-url origin 2>/dev/null)" || {
    echo "jarvis-forge: o $HOME/Forge não tem o remoto 'origin'; não há de onde criar a cópia vigente. Para esta vez, use 'jarvis-forge --dev' (cópia de trabalho, sem a proteção)." >&2
    exit 1
  }
  mkdir -p "$(dirname "$vigente")"
  echo "jarvis-forge: criando a cópia vigente em $vigente (origin/develop)." >&2
  # o git remove sozinho o que o clone começou a criar; este script nunca apaga diretório
  git clone --quiet --branch develop "$origem" "$vigente" || {
    echo "jarvis-forge: não consegui criar a cópia vigente (sem rede ou sem acesso à origin?). Para esta vez, use 'jarvis-forge --dev' (cópia de trabalho, sem a proteção)." >&2
    exit 1
  }
}
# O caminho da cópia vigente só é usado se não existir (será criado) ou se já for um clone do Forge (mesma origin).
# Qualquer outra coisa ali é do usuário: recusa sem tocar em nada.
conferir_vigente() {
  [ -e "$vigente" ] || return 0
  local origem_vigente origem_forge
  origem_vigente="$(git -C "$vigente" remote get-url origin 2>/dev/null || true)"
  origem_forge="$(git -C "$HOME/Forge" remote get-url origin 2>/dev/null || true)"
  if [ ! -d "$vigente/.git" ] || [ -z "$origem_vigente" ] || [ "$origem_vigente" != "$origem_forge" ]; then
    echo "jarvis-forge: $vigente já existe e não é um clone do Forge; não mexi em nada. Mova ou apague esse diretório (ou aponte XDG_DATA_HOME para outro lugar)." >&2
    exit 1
  fi
}
# Busca só a develop, por extenso e sem tags: o nome curto origin/develop é ambíguo (uma tag de mesmo nome na origin
# ganharia da branch e levaria código não revisado para a cópia vigente). Em todo o script, usar refs/remotes/origin/develop.
refspec_develop=+refs/heads/develop:refs/remotes/origin/develop
buscar_develop() {
  git -C "$vigente" fetch --quiet --no-tags origin "$refspec_develop"
}
conferir_vigente
if [ "$atualizar" = 1 ]; then
  if [ ! -e "$vigente" ]; then criar_vigente; exit 0; fi
  if [ -n "$(git -C "$vigente" status --porcelain)" ]; then
    echo "jarvis-forge: a cópia vigente ($vigente) tem mudanças locais; não atualizei. Confira com 'git -C $vigente status'." >&2
    exit 1
  fi
  buscar_develop || {
    echo "jarvis-forge: não consegui buscar a origin (sem rede?); a cópia vigente ficou como estava. Use 'jarvis-forge --dev' para esta vez, se precisar." >&2
    exit 1
  }
  if [ -n "$(git -C "$vigente" rev-list refs/remotes/origin/develop..HEAD)" ]; then
    echo "jarvis-forge: a cópia vigente ($vigente) tem commits locais que não estão na origin/develop; não atualizei, para não descartá-los. Confira com 'git -C $vigente log refs/remotes/origin/develop..HEAD'." >&2
    exit 1
  fi
  antes="$(git -C "$vigente" rev-parse HEAD)"
  git -C "$vigente" reset --quiet --hard refs/remotes/origin/develop
  depois="$(git -C "$vigente" rev-parse HEAD)"
  echo "jarvis-forge: cópia vigente atualizada para origin/develop ($(git -C "$vigente" rev-parse --short HEAD))." >&2
  if [ "$antes" != "$depois" ] && command -v tmux >/dev/null 2>&1 && tmux has-session -t jarvis-Forge 2>/dev/null; then
    echo "jarvis-forge: AVISO: a sessão do tmux 'jarvis-Forge' já está aberta e segue com a cópia anterior; reinicie-a (saia do Jarvis e rode jarvis-forge de novo) para valer a atualização." >&2
  fi
  exit 0
fi
if [ "$dev" = 1 ]; then
  echo "jarvis-forge: AVISO: --dev usa a cópia de trabalho; hooks e agentes em edição passam a valer na hora." >&2
elif [ ! -e "$vigente" ]; then
  criar_vigente
fi
# Só fast-forward: nunca reset nem merge; qualquer dúvida vira um aviso de uma linha e a sessão abre com a cópia atual.
atualizar_ao_abrir() {
  local antes depois
  [ -d "$vigente/.git" ] || return 0
  if [ "$(git -C "$vigente" symbolic-ref --short HEAD 2>/dev/null || true)" != develop ]; then
    echo "jarvis-forge: a cópia vigente não está na develop; não atualizei, sigo com a cópia atual." >&2; return 0
  fi
  if [ -n "$(git -C "$vigente" status --porcelain)" ]; then
    echo "jarvis-forge: a cópia vigente tem mudanças locais; não atualizei, sigo com a cópia atual." >&2; return 0
  fi
  if ! timeout 30 git -C "$vigente" fetch --quiet --no-tags origin "$refspec_develop"; then
    echo "jarvis-forge: sem rede (ou sem acesso à origin); sigo com a cópia vigente atual." >&2; return 0
  fi
  if [ -n "$(git -C "$vigente" rev-list refs/remotes/origin/develop..HEAD)" ]; then
    echo "jarvis-forge: a cópia vigente tem commits locais fora da origin/develop; não atualizei, sigo com a cópia atual." >&2; return 0
  fi
  antes="$(git -C "$vigente" rev-parse HEAD)"
  if ! git -C "$vigente" merge --quiet --ff-only refs/remotes/origin/develop; then
    echo "jarvis-forge: a cópia vigente não avança por fast-forward; não atualizei, sigo com a cópia atual." >&2; return 0
  fi
  depois="$(git -C "$vigente" rev-parse HEAD)"
  [ "$antes" = "$depois" ] || echo "jarvis-forge: cópia vigente atualizada para a origin/develop ($(git -C "$vigente" rev-parse --short HEAD))." >&2
}
# No máximo uma consulta por dia (cache da data); sem registro local das fontes, `forge-check fontes` fica em silêncio.
consultar_fontes() {
  local estado cache fc saida codigo
  estado="${XDG_STATE_HOME:-$HOME/.local/state}/forge"
  cache="$estado/fontes-$(date +%F)"
  [ -e "$cache" ] && return 0
  fc="$vigente/bin/forge-check"; [ "$dev" = 1 ] && fc="$HOME/Forge/bin/forge-check"
  [ -x "$fc" ] || return 0
  codigo=0; saida="$("$fc" fontes 2>/dev/null)" || codigo=$?
  [ -n "$saida" ] && echo "jarvis-forge: $saida" >&2
  if [ "$codigo" != 3 ]; then mkdir -p "$estado" && : > "$cache"; fi  # 3 = sem rede: tenta de novo na próxima abertura
  return 0
}
# O que ocorre uma vez por abertura: dentro do tmux a sessão reentra neste script (FORGE_ABERTURA_FEITA) e não repete.
if [ -z "${FORGE_ABERTURA_FEITA:-}" ]; then
  # sessão tmux já aberta só é reanexada: não troca o plugin sob ela (a atualização espera o reinício)
  if [ "$dev" = 0 ] && ! { [ "$sem_tmux" = 0 ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1 \
      && tmux has-session -t jarvis-Forge 2>/dev/null; }; then
    atualizar_ao_abrir
  fi
  consultar_fontes
fi
cd "$HOME/Forge"
if [ "$sem_tmux" = 0 ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
  repasse=(); [ "$dev" = 1 ] && repasse=(--dev)
  sessao=jarvis-Forge; [ "$dev" = 1 ] && sessao=jarvis-Forge-dev  # um nome por modo: -A não reaproveita a sessão do outro modo
  eu="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  exec tmux new-session -A -s "$sessao" -c "$PWD" "$(printf '%q ' env FORGE_ABERTURA_FEITA=1 "$eu" ${repasse[@]+"${repasse[@]}"})"
fi
plugin_dir="$vigente"; [ "$dev" = 1 ] && plugin_dir=.
nome_remoto="Jarvis - Forge"; [ "$dev" = 1 ] && nome_remoto="Jarvis - Forge (dev)"
args=(--plugin-dir "$plugin_dir" --agent forge:jarvis --remote-control "$nome_remoto")
# retoma a conversa do Forge se já existir uma (o diretório do projeto é o caminho com "/" trocado por "-")
if [ -d "$HOME/.claude/projects/${PWD//\//-}" ]; then args=(--continue "${args[@]}"); fi
if claude plugin list 2>/dev/null | grep -q 'telegram@claude-plugins-official'; then
  if pgrep -f "bun server.ts" >/dev/null; then
    echo "jarvis-forge: outra sessão já usa o bot do Telegram; abrindo sem o canal." >&2
  else
    args+=(--channels plugin:telegram@claude-plugins-official)
  fi
fi
exec claude "${args[@]}"
