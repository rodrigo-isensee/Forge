#!/usr/bin/env bash
# Forge: abre o Jarvis dentro do repositório ~/Forge, usando a cópia de trabalho como plugin (--plugin-dir),
# retomando a última conversa do Forge, com chat remoto e, se instalado, o canal do Telegram.
# Dentro do tmux (criado/anexado automaticamente) a sessão sobrevive ao fechamento do terminal.
# Uso: jarvis-forge [--sem-tmux]
set -euo pipefail
cd "$HOME/Forge"
if [ "${1:-}" != "--sem-tmux" ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
  eu="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  exec tmux new-session -A -s jarvis-Forge -c "$PWD" "$(printf '%q' "$eu")"
fi
args=(--plugin-dir . --agent forge:jarvis --remote-control "Jarvis - Forge")
# retoma a conversa do Forge se já existir uma (o diretório do projeto é o caminho com "/" trocado por "-")
if [ -d "$HOME/.claude/projects/${PWD//\//-}" ]; then args=(--continue "${args[@]}"); fi
if claude plugin list 2>/dev/null | grep -q 'telegram@claude-plugins-official'; then
  if pgrep -f "bun server.ts" >/dev/null; then
    echo "jarvis-forge: outra sessão já usa o bot do Telegram; abrindo sem o canal." >&2
  else
    args+=(--channels plugin:telegram@claude-plugins-official)
  fi
fi
exec claude "${args[@]}"
