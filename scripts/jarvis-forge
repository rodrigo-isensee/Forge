#!/usr/bin/env bash
# Forge: abre o Jarvis dentro do repositório ~/Forge (onde se edita), usando como plugin uma CÓPIA VIGENTE do Forge
# (clone da origin/develop em ${XDG_DATA_HOME:-~/.local/share}/forge/vigente), não a cópia de trabalho: editar hooks/
# ou agents/ numa branch não muda a guarda nem as instruções em uso (ADR 0009, seção 4). A cópia é criada se faltar
# e só é atualizada por --atualizar-vigente, depois de um merge. Retoma a última conversa, com chat remoto e, se instalado,
# o canal do Telegram. Dentro do tmux (criado/anexado automaticamente) a sessão sobrevive ao fechamento do terminal.
# Uso: jarvis-forge [--sem-tmux] [--dev] | jarvis-forge --atualizar-vigente
#   --sem-tmux           abre direto no terminal, sem criar ou anexar a sessão do tmux
#   --atualizar-vigente  atualiza a cópia vigente para a origin/develop (recusa se tiver mudanças locais) e sai
#   --dev                teste manual do dono: usa a cópia de trabalho (--plugin-dir .), sem a proteção da cópia vigente
#   -h, --help           mostra esta ajuda
set -euo pipefail
sem_tmux=0
dev=0
atualizar=0
for a in "$@"; do
  case "$a" in
    --sem-tmux) sem_tmux=1 ;;
    --dev) dev=1 ;;
    --atualizar-vigente) atualizar=1 ;;
    -h|--help) sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "jarvis-forge: argumento desconhecido: $a (veja jarvis-forge --help)" >&2; exit 2 ;;
  esac
done
vigente="${XDG_DATA_HOME:-$HOME/.local/share}/forge/vigente"
if [ "$atualizar" = 1 ] && [ "$dev" = 1 ]; then
  echo "jarvis-forge: --atualizar-vigente e --dev não combinam." >&2; exit 2
fi
criar_vigente() {
  local origem
  origem="$(git -C "$HOME/Forge" remote get-url origin)"
  mkdir -p "$(dirname "$vigente")"
  echo "jarvis-forge: criando a cópia vigente em $vigente (origin/develop)." >&2
  if ! git clone --quiet --branch develop "$origem" "$vigente"; then
    rm -rf "$vigente"
    echo "jarvis-forge: não consegui criar a cópia vigente." >&2; exit 1
  fi
}
if [ "$atualizar" = 1 ]; then
  if [ ! -d "$vigente/.git" ]; then criar_vigente; exit 0; fi
  if [ -n "$(git -C "$vigente" status --porcelain)" ]; then
    echo "jarvis-forge: a cópia vigente ($vigente) tem mudanças locais; não atualizei. Confira com 'git -C $vigente status'." >&2
    exit 1
  fi
  git -C "$vigente" fetch --quiet origin
  git -C "$vigente" reset --quiet --hard origin/develop
  echo "jarvis-forge: cópia vigente atualizada para origin/develop ($(git -C "$vigente" rev-parse --short HEAD))." >&2
  exit 0
fi
if [ "$dev" = 1 ]; then
  echo "jarvis-forge: AVISO: --dev usa a cópia de trabalho; hooks e agentes em edição passam a valer na hora." >&2
elif [ ! -d "$vigente/.git" ]; then
  criar_vigente
fi
cd "$HOME/Forge"
if [ "$sem_tmux" = 0 ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
  repasse=(); [ "$dev" = 1 ] && repasse=(--dev)
  eu="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  exec tmux new-session -A -s jarvis-Forge -c "$PWD" "$(printf '%q ' "$eu" "${repasse[@]}")"
fi
plugin_dir="$vigente"; [ "$dev" = 1 ] && plugin_dir=.
args=(--plugin-dir "$plugin_dir" --agent forge:jarvis --remote-control "Jarvis - Forge")
# retoma a conversa do Forge se já existir uma (o diretório do projeto é o caminho com "/" trocado por "-")
if [ -d "$HOME/.claude/projects/${PWD//\//-}" ]; then args=(--continue "${args[@]}"); fi
if claude plugin list 2>/dev/null | grep -q 'telegram@claude-plugins-official'; then
  if pgrep -f "bun server.ts" >/dev/null; then
    echo "jarvis-forge: outra sessão já usa o bot do Telegram; abrindo sem o canal." >&2
  else
    args+=(--channels plugin:telegram@claude-plugins-official)
  fi
fi
exec claude "${args[@]}"
