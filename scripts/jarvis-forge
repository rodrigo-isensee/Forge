#!/usr/bin/env bash
# Forge: abre o Jarvis dentro do repositório ~/Forge (onde se edita), usando como plugin uma CÓPIA VIGENTE do Forge
# (clone da origin/develop em ${XDG_DATA_HOME:-~/.local/share}/forge/vigente), não a cópia de trabalho: editar hooks/
# ou agents/ numa branch não muda a guarda nem as instruções em uso (ADR 0009, seção 4). A cópia é criada se faltar
# e, ao abrir, é atualizada sozinha só por fast-forward para a origin/develop (recusa e avisa se tiver mudança ou
# commit local, ou se estiver sem rede; sessão tmux já aberta não é tocada). Uma vez por dia consulta, com
# `forge-check fontes`, a fonte de harness e mostra uma linha se houver versão nova. Retoma a última conversa, com
# chat remoto e, se instalado, o canal do Telegram. Carrega também o plugin de desenvolvimento `forge-dev` (a pasta
# `dev/` da mesma cópia, com o agente AQ), só nesta sessão. Dentro do tmux (criado/anexado automaticamente) a sessão sobrevive ao fechamento do terminal
# e, se o claude cair (saída anormal), o Jarvis reabre sozinho (--continue), no máximo 3 vezes em 30 min, sempre com o Claude Code mais novo
# instalado; cada queda vai para ${XDG_STATE_HOME:-~/.local/state}/forge/quedas.log. Fora do tmux só avisa que a sessão não é durável.
# Uso: jarvis-forge [--sem-tmux] [--dev] | jarvis-forge --atualizar-vigente
#   --sem-tmux           abre direto no terminal, sem criar ou anexar a sessão do tmux (avisa que a sessão não é durável)
#   --atualizar-vigente  atualiza a cópia vigente para a origin/develop (recusa se tiver mudanças ou commits locais) e sai
#   --dev                teste manual do dono: usa a cópia de trabalho (--plugin-dir . e ./dev), sem a proteção da cópia vigente
#   -h, --help           mostra esta ajuda
set -euo pipefail
sem_tmux=0
dev=0
atualizar=0
for a in "$@"; do
  case "$a" in
    --sem-tmux) sem_tmux=1 ;;
    --dev) dev=1 ;;
    --atualizar-vigente) atualizar=1 ;;
    -h|--help) sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "jarvis-forge: argumento desconhecido: $a (veja jarvis-forge --help)" >&2; exit 2 ;;
  esac
done
dados="${XDG_DATA_HOME:-$HOME/.local/share}"
case "$dados" in
  /*) ;;
  *) echo "jarvis-forge: XDG_DATA_HOME deve ser um caminho absoluto (recebi '$dados'); nada foi feito." >&2; exit 2 ;;
esac
case "${XDG_STATE_HOME:-/}" in
  /*) ;;
  *) echo "jarvis-forge: XDG_STATE_HOME deve ser um caminho absoluto (recebi '$XDG_STATE_HOME'); nada foi feito." >&2; exit 2 ;;
esac
vigente="$dados/forge/vigente"
if [ "$atualizar" = 1 ] && [ "$dev" = 1 ]; then
  echo "jarvis-forge: --atualizar-vigente e --dev não combinam." >&2; exit 2
fi
criar_vigente() {
  local origem
  origem="$(git -C "$HOME/Forge" remote get-url origin 2>/dev/null)" || {
    echo "jarvis-forge: o $HOME/Forge não tem o remoto 'origin'; não há de onde criar a cópia vigente. Para esta vez, use 'jarvis-forge --dev' (cópia de trabalho, sem a proteção)." >&2
    exit 1
  }
  mkdir -p "$(dirname "$vigente")"
  echo "jarvis-forge: criando a cópia vigente em $vigente (origin/develop)." >&2
  # o git remove sozinho o que o clone começou a criar; este script nunca apaga diretório
  git clone --quiet --branch develop "$origem" "$vigente" || {
    echo "jarvis-forge: não consegui criar a cópia vigente (sem rede ou sem acesso à origin?). Para esta vez, use 'jarvis-forge --dev' (cópia de trabalho, sem a proteção)." >&2
    exit 1
  }
}
# O caminho da cópia vigente só é usado se não existir (será criado) ou se já for um clone do Forge (mesma origin).
# Qualquer outra coisa ali é do usuário: recusa sem tocar em nada.
conferir_vigente() {
  [ -e "$vigente" ] || return 0
  local origem_vigente origem_forge
  origem_vigente="$(git -C "$vigente" remote get-url origin 2>/dev/null || true)"
  origem_forge="$(git -C "$HOME/Forge" remote get-url origin 2>/dev/null || true)"
  if [ ! -d "$vigente/.git" ] || [ -z "$origem_vigente" ] || [ "$origem_vigente" != "$origem_forge" ]; then
    echo "jarvis-forge: $vigente já existe e não é um clone do Forge; não mexi em nada. Mova ou apague esse diretório (ou aponte XDG_DATA_HOME para outro lugar)." >&2
    exit 1
  fi
}
# Busca só a develop, por extenso e sem tags: o nome curto origin/develop é ambíguo (uma tag de mesmo nome na origin
# ganharia da branch e levaria código não revisado para a cópia vigente). Em todo o script, usar refs/remotes/origin/develop.
refspec_develop=+refs/heads/develop:refs/remotes/origin/develop
buscar_develop() {
  git -C "$vigente" fetch --quiet --no-tags origin "$refspec_develop"
}
# VIGENTE-REINICIO-OCIOSO: diz se é seguro reiniciar a sessão aberta, sem mudar nada. Lê a suíte e o push pelo
# `--status` da cópia vigente (nunca da de trabalho: ADR 0009, seção 4) e conta os agentes ativos com as funções do hook
# `agentes` dela; do estado só sai um inteiro. Qualquer dúvida vira "não conferido" e o fecho manda esperar.
ocupacao() {
  local saida rc=0 fila suite agentes n
  saida="$(timeout 10 "$vigente/.githooks/pre-push" --status 2>/dev/null)" || rc=$?
  fila="$(printf '%s\n' "$saida" | tail -n 1 | grep -oE '[0-9]+ na fila$' | grep -oE '^[0-9]+' || true)"
  case "$rc" in
    0) suite="rodando, ${fila:-?} na fila" ;;
    1) suite=livre ;;
    *) suite="não conferida" ;;
  esac
  n="$(timeout 10 python3 -I -c 'import json, sys, time
from pathlib import Path
sys.path.insert(0, sys.argv[1] + "/hooks")
import agentes
raiz = Path(sys.argv[2])
hook = agentes.Hook("agentes")
hook.raiz = raiz
estado = json.loads(Path(agentes.arquivo_de_estado(raiz)).read_text(encoding="utf-8"))
print(len(agentes.vigentes(estado["agentes"], time.time(), hook.expira_s())))' "$vigente" "$HOME/Forge" 2>/dev/null || true)"
  if ! [[ "$n" =~ ^[0-9]+$ ]]; then agentes="não conferido"
  elif [ "$n" = 0 ]; then agentes=nenhum
  else agentes="$n ativos"; fi
  printf 'agora: suíte do Forge %s; agentes %s; ' "$suite" "$agentes"
  # testes de módulo fora da trava (até a 0.44 I9): sem essa fonte o aviso nunca diz "seguro"; só pede para esperar
  echo "espere: testes de módulo: não conferidos; reinicie quando a suíte terminar, nenhum agente estiver ativo e nenhum teste de módulo ou mutante rodar (confira com .githooks/pre-push --status)"
}
conferir_vigente
if [ "$atualizar" = 1 ]; then
  if [ ! -e "$vigente" ]; then criar_vigente; exit 0; fi
  if [ -n "$(git -C "$vigente" status --porcelain)" ]; then
    echo "jarvis-forge: a cópia vigente ($vigente) tem mudanças locais; não atualizei. Confira com 'git -C $vigente status'." >&2
    exit 1
  fi
  buscar_develop || {
    echo "jarvis-forge: não consegui buscar a origin (sem rede?); a cópia vigente ficou como estava. Use 'jarvis-forge --dev' para esta vez, se precisar." >&2
    exit 1
  }
  if [ -n "$(git -C "$vigente" rev-list refs/remotes/origin/develop..HEAD)" ]; then
    echo "jarvis-forge: a cópia vigente ($vigente) tem commits locais que não estão na origin/develop; não atualizei, para não descartá-los. Confira com 'git -C $vigente log refs/remotes/origin/develop..HEAD'." >&2
    exit 1
  fi
  antes="$(git -C "$vigente" rev-parse HEAD)"
  git -C "$vigente" reset --quiet --hard refs/remotes/origin/develop
  depois="$(git -C "$vigente" rev-parse HEAD)"
  echo "jarvis-forge: cópia vigente atualizada para origin/develop ($(git -C "$vigente" rev-parse --short HEAD))." >&2
  if [ "$antes" != "$depois" ] && command -v tmux >/dev/null 2>&1 && tmux has-session -t jarvis-Forge 2>/dev/null; then
    echo "jarvis-forge: AVISO: a sessão do tmux 'jarvis-Forge' já está aberta e segue com a cópia anterior; reinicie-a (saia do Jarvis e rode jarvis-forge de novo) para valer a atualização; $(ocupacao)" >&2
  fi
  exit 0
fi
if [ "$dev" = 1 ]; then
  echo "jarvis-forge: AVISO: --dev usa a cópia de trabalho; hooks e agentes em edição passam a valer na hora." >&2
elif [ ! -e "$vigente" ]; then
  criar_vigente
fi
# Defasagem nunca é muda (versao-defasada, VD-1): a data do commit da cópia vigente diz desde quando ela está parada.
avisou_defasagem=0
data_da_copia() { git -C "$vigente" log -1 --format=%cs HEAD 2>/dev/null || true; }
atrasado() {
  avisou_defasagem=1
  echo "jarvis-forge: ATRASADO desde $(data_da_copia): a cópia vigente não foi atualizada e pode estar atrás da origin/develop. Para atualizar, saia do Jarvis, rode 'jarvis-forge --atualizar-vigente' e reabra a sessão." >&2
}
sessao_aberta() {
  [ "$sem_tmux" = 0 ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1 && tmux has-session -t jarvis-Forge 2>/dev/null
}
# Com a sessão tmux aberta o plugin não é trocado (a atualização espera o reinício), mas a pessoa fica sabendo se está atrás.
avisar_na_sessao_aberta() {
  local data novidades
  [ -d "$vigente/.git" ] || return 0
  data="$(data_da_copia)"
  if ! timeout 30 git -C "$vigente" fetch --quiet --no-tags origin "$refspec_develop"; then
    avisou_defasagem=1
    echo "jarvis-forge: ATRASADO desde $data: não consegui consultar a origin; a sessão aberta usa a cópia de $data e pode estar atrás da develop. Para atualizar, saia do Jarvis, rode 'jarvis-forge --atualizar-vigente' e reabra a sessão." >&2
    return 0
  fi
  if ! novidades="$(git -C "$vigente" rev-list HEAD..refs/remotes/origin/develop 2>/dev/null)"; then
    atrasado  # a comparação falhou depois do fetch: sem prova de que está em dia, nunca fica mudo
  elif [ -n "$novidades" ]; then
    avisou_defasagem=1
    echo "jarvis-forge: AVISO: a sessão aberta usa a cópia de $data e a origin/develop já tem novidades. Para valer, saia do Jarvis, rode 'jarvis-forge --atualizar-vigente' e reabra a sessão." >&2
  fi
}
# Só fast-forward: nunca reset nem merge; qualquer dúvida vira um aviso de uma linha e a sessão abre com a cópia atual.
atualizar_ao_abrir() {
  local antes depois
  [ -d "$vigente/.git" ] || return 0
  if [ "$(git -C "$vigente" symbolic-ref --short HEAD 2>/dev/null || true)" != develop ]; then
    echo "jarvis-forge: a cópia vigente não está na develop; não atualizei, sigo com a cópia atual." >&2; atrasado; return 0
  fi
  if [ -n "$(git -C "$vigente" status --porcelain)" ]; then
    echo "jarvis-forge: a cópia vigente tem mudanças locais; não atualizei, sigo com a cópia atual." >&2; atrasado; return 0
  fi
  if ! timeout 30 git -C "$vigente" fetch --quiet --no-tags origin "$refspec_develop"; then
    echo "jarvis-forge: sem rede (ou sem acesso à origin); sigo com a cópia vigente atual." >&2; atrasado; return 0
  fi
  if [ -n "$(git -C "$vigente" rev-list refs/remotes/origin/develop..HEAD)" ]; then
    echo "jarvis-forge: a cópia vigente tem commits locais fora da origin/develop; não atualizei, sigo com a cópia atual." >&2; atrasado; return 0
  fi
  antes="$(git -C "$vigente" rev-parse HEAD)"
  if ! git -C "$vigente" merge --quiet --ff-only refs/remotes/origin/develop; then
    echo "jarvis-forge: a cópia vigente não avança por fast-forward; não atualizei, sigo com a cópia atual." >&2; atrasado; return 0
  fi
  depois="$(git -C "$vigente" rev-parse HEAD)"
  [ "$antes" = "$depois" ] || echo "jarvis-forge: cópia vigente atualizada para a origin/develop ($(git -C "$vigente" rev-parse --short HEAD))." >&2
}
# FORGE-SEMPRE-ATUAL (ADR 0017): atualiza o plugin instalado (não a cópia vigente, que tem o caminho próprio acima). O código vem
# só da pasta deste script, que o trampolim de ~/.local/bin leva ao installPath ativo; pasta com .git (work tree) não roda.
# Sem pergunta, sem barrar: o resultado fica no registro da ferramenta, que nunca roda com a sessão do tmux aberta.
atualizar_plugin() {
  local raiz ferramenta
  raiz="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  ferramenta="$raiz/bin/forge-sempre-atual"
  if [ ! -x "$ferramenta" ] || [ -e "$raiz/.git" ]; then return 0; fi
  if command -v timeout >/dev/null 2>&1; then
    timeout 90 "$ferramenta" --gatilho atalho --projeto "$PWD" </dev/null || true
  else
    "$ferramenta" --gatilho atalho --projeto "$PWD" </dev/null || true
  fi
}
# No máximo uma consulta por dia (cache da data); sem registro local das fontes, `forge-check fontes` fica em silêncio.
consultar_fontes() {
  local estado cache fc saida codigo
  estado="${XDG_STATE_HOME:-$HOME/.local/state}/forge"
  cache="$estado/fontes-$(date +%F)"
  [ -e "$cache" ] && return 0
  fc="$vigente/bin/forge-check"; [ "$dev" = 1 ] && fc="$HOME/Forge/bin/forge-check"
  [ -x "$fc" ] || return 0
  codigo=0; saida="$("$fc" fontes 2>/dev/null)" || codigo=$?
  [ -n "$saida" ] && echo "jarvis-forge: $saida" >&2
  if [ "$codigo" != 3 ]; then mkdir -p "$estado" && : > "$cache"; fi  # 3 = sem rede: tenta de novo na próxima abertura
  return 0
}
# O que ocorre uma vez por abertura: dentro do tmux a sessão reentra neste script (FORGE_ABERTURA_FEITA) e não repete.
if [ -z "${FORGE_ABERTURA_FEITA:-}" ]; then
  # sessão tmux já aberta só é reanexada: não troca o plugin sob ela (a atualização espera o reinício), mas avisa se está atrás
  if [ "$dev" = 0 ]; then
    if sessao_aberta; then avisar_na_sessao_aberta; else atualizar_ao_abrir; fi
  fi
  consultar_fontes
  if ! sessao_aberta; then (cd "$HOME/Forge" && atualizar_plugin); fi
  # o tmux toma a tela logo em seguida: com terminal, dá tempo de ler o aviso de defasagem
  if [ "$avisou_defasagem" = 1 ] && [ -t 2 ]; then sleep 3; fi
fi
cd "$HOME/Forge"
prefixo=jarvis-forge; rotulo=Forge; [ "$dev" = 1 ] && rotulo=Forge-dev
# CLAUDE-ATUAL-INICIO (BP3 S1, D1 do dono): o atalho abre sempre o Claude Code mais novo entre o do instalador oficial
# ($HOME/.local/bin/claude, que a atualização automática mantém) e o primeiro do PATH, nunca o do PATH só por ser o primeiro:
# um binário velho num diretório do sistema (por exemplo /usr/local/bin) vem antes e abriria uma versão atrasada.
# Só caminho absoluto de arquivo executável (nunca o diretório atual); iguais pelo caminho real contam uma vez; com um só
# candidato não roda nada; com dois, `--version` de cada um (10 s) e vence o maior número, o empate fica com o do instalador.
# Sem versão legível em nenhum, ou se o primeiro do PATH não responde `--version`, fica o `command -v claude` de sempre (nada
# que não se possa comparar o troca). Roda a cada abertura e a cada reabertura.
# Resultado em claude_bin (e claude_versao, quando conhecida); sem nenhum claude, claude_bin fica vazio.
resolver_claude() {
  local c real dir v vistos="
" maior="" primeiro primeiro_real v_primeiro=""
  local -a candidatos=() unicos=()
  claude_bin=""; claude_versao=""
  primeiro="$(command -v claude 2>/dev/null || true)"
  primeiro_real="$(readlink -f "$primeiro" 2>/dev/null || true)"
  [ -x "$HOME/.local/bin/claude" ] && [ -f "$HOME/.local/bin/claude" ] && candidatos+=("$HOME/.local/bin/claude")
  case "$primeiro" in /*) [ -x "$primeiro" ] && [ -f "$primeiro" ] && candidatos+=("$primeiro") ;; esac
  for c in ${candidatos[@]+"${candidatos[@]}"}; do
    real="$(readlink -f "$c" 2>/dev/null || printf '%s' "$c")"
    case "$vistos" in *"
$real
"*) continue ;; esac
    vistos="$vistos$real
"
    unicos+=("$c")
  done
  if [ "${#unicos[@]}" -eq 1 ]; then claude_bin="${unicos[0]}"; return 0; fi
  for c in ${unicos[@]+"${unicos[@]}"}; do
    if command -v timeout >/dev/null 2>&1; then
      v="$(timeout 10 "$c" --version </dev/null 2>/dev/null | grep -oE '^[0-9]+(\.[0-9]+)+' | head -n 1 || true)"
    else
      v="$("$c" --version </dev/null 2>/dev/null | grep -oE '^[0-9]+(\.[0-9]+)+' | head -n 1 || true)"
    fi
    [ -n "$v" ] || continue
    if [ -n "$primeiro_real" ] && [ "$(readlink -f "$c" 2>/dev/null || true)" = "$primeiro_real" ]; then v_primeiro="$v"; fi
    if [ -z "$maior" ] || [ "$(printf '%s\n%s\n' "$maior" "$v" | sort -V | tail -n 1)" != "$maior" ]; then
      maior="$v"; claude_bin="$c"; claude_versao="$v"
    fi
  done
  if [ -z "$claude_bin" ] || [ -z "$v_primeiro" ]; then claude_bin="$primeiro"; claude_versao=""; fi
  if [ -n "$claude_versao" ] && [ "$claude_bin" != "$primeiro" ]; then
    echo "$prefixo: usando o Claude Code $claude_versao ($claude_bin); o primeiro do PATH é outro e mais antigo." >&2
  fi
  return 0
}
# CLAUDE-ATUAL-FIM
# SUPERVISOR-INICIO (BP3 S1, D1 do dono): dentro do tmux o atalho não entrega o processo ao claude: roda-o e olha como saiu.
# Reabre (`--continue`, sempre com o Claude Code atual, resolvido de novo) só em saída anormal: código 128 ou mais, fora 129
# (terminal fechado) e 130 (Ctrl+C); 0 (/exit) e qualquer código abaixo de 128 (erro de uso) encerram como antes. Espera
# FORGE_QUEDA_ESPERA s (padrão 10) e conta as reaberturas na janela de FORGE_QUEDA_JANELA s (padrão 1800, 30 min): a 4.ª queda
# na janela, depois de 3 reaberturas, não reabre mais, avisa e deixa a janela esperando um Enter. O modo de permissão não muda
# (`--permission-mode auto`): a ação destrutiva segue perguntando. Cada queda vira uma linha em quedas.log, só com data,
# projeto, código de saída e número da tentativa (nunca texto do claude).
quedas_teto=3
registrar_queda() {
  local base dir
  case "${XDG_STATE_HOME:-}" in /*) base="$XDG_STATE_HOME" ;; *) base="$HOME/.local/state" ;; esac
  dir="$base/forge"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf '%s projeto=%s saida=%s tentativa=%s acao=%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$rotulo" "$1" "$2" "$3" >> "$dir/quedas.log" 2>/dev/null || true
}
supervisionar() {
  local rc espera janela agora t
  local -a recentes=() mantidas=()
  espera="${FORGE_QUEDA_ESPERA:-10}"; janela="${FORGE_QUEDA_JANELA:-1800}"
  case "$espera" in ''|*[!0-9]*) espera=10 ;; esac
  case "$janela" in ''|*[!0-9]*) janela=1800 ;; esac
  while :; do
    resolver_claude
    if [ -z "$claude_bin" ]; then echo "$prefixo: claude não encontrado no PATH." >&2; return 127; fi
    rc=0
    "$claude_bin" "$@" || rc=$?
    if [ "$rc" -lt 128 ] || [ "$rc" = 129 ] || [ "$rc" = 130 ]; then return "$rc"; fi
    agora="$(date +%s)"
    mantidas=()
    for t in ${recentes[@]+"${recentes[@]}"}; do
      if [ $((agora - t)) -lt "$janela" ]; then mantidas+=("$t"); fi
    done
    recentes=(${mantidas[@]+"${mantidas[@]}"})
    if [ "${#recentes[@]}" -ge "$quedas_teto" ]; then
      registrar_queda "$rc" "$quedas_teto" desiste
      echo "$prefixo: o Jarvis caiu de novo (saída $rc) depois de $quedas_teto reaberturas em $((janela / 60)) min; não reabro mais. Veja o registro em ${XDG_STATE_HOME:-~/.local/state}/forge/quedas.log." >&2
      if [ -t 0 ]; then read -r -p "Enter para fechar esta janela " _ || true; fi
      return "$rc"
    fi
    recentes+=("$agora")
    registrar_queda "$rc" "${#recentes[@]}" reabre
    echo "$prefixo: o Jarvis caiu (saída $rc); reabrindo em ${espera}s (reabertura ${#recentes[@]} de $quedas_teto em $((janela / 60)) min)." >&2
    sleep "$espera"
    if [ "${1:-}" != --continue ]; then set -- --continue "$@"; fi
  done
}
# SUPERVISOR-FIM
# SESSAO-DURAVEL-AVISO (BP3 S1, D4 do dono): fora do tmux só avisa, numa linha, e abre assim mesmo; nunca bloqueia.
if [ -z "${TMUX:-}" ] && { [ "$sem_tmux" = 1 ] || ! command -v tmux >/dev/null 2>&1; }; then
  if [ "$sem_tmux" = 1 ]; then
    echo "jarvis-forge: sessão não durável (--sem-tmux): uma queda do terminal derruba os agentes." >&2
  else
    echo "jarvis-forge: tmux não instalado: sessão não durável, uma queda do terminal derruba os agentes; instale com 'sudo apt-get install tmux' (ou o gerenciador do seu sistema). Abrindo assim mesmo." >&2
  fi
fi
if [ "$sem_tmux" = 0 ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
  repasse=(); [ "$dev" = 1 ] && repasse=(--dev)
  sessao=jarvis-Forge; [ "$dev" = 1 ] && sessao=jarvis-Forge-dev  # um nome por modo: -A não reaproveita a sessão do outro modo
  eu="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  exec tmux new-session -A -s "$sessao" -c "$PWD" "$(printf '%q ' env FORGE_ABERTURA_FEITA=1 "$eu" ${repasse[@]+"${repasse[@]}"})"
fi
plugin_dir="$vigente"; [ "$dev" = 1 ] && plugin_dir=.
nome_remoto="Jarvis - Forge"; [ "$dev" = 1 ] && nome_remoto="Jarvis - Forge (dev)"
args=(--plugin-dir "$plugin_dir")
# forge-dev (agente AQ): plugin de desenvolvimento do Forge, só desta sessão; nunca instalado nos projetos.
# A cópia vigente anterior a ele não tem a pasta: nesse caso abre só com o forge.
[ -f "$plugin_dir/dev/.claude-plugin/plugin.json" ] && args+=(--plugin-dir "$plugin_dir/dev")
# SESSAO-AUTOMATICA (diretriz 28): a sessão abre sempre em --permission-mode auto; o Jarvis confere o sandbox no primeiro comando.
args+=(--agent forge:jarvis --permission-mode auto --remote-control "$nome_remoto")
# retoma a conversa do Forge se já existir uma (o diretório do projeto é o caminho com "/" trocado por "-")
if [ -d "$HOME/.claude/projects/${PWD//\//-}" ]; then args=(--continue "${args[@]}"); fi
resolver_claude
if [ -z "$claude_bin" ]; then echo "jarvis-forge: claude não encontrado no PATH." >&2; exit 127; fi
if "$claude_bin" plugin list 2>/dev/null | grep -q 'telegram@claude-plugins-official'; then
  if pgrep -f "bun server.ts" >/dev/null; then
    echo "jarvis-forge: outra sessão já usa o bot do Telegram; abrindo sem o canal." >&2
  else
    args+=(--channels plugin:telegram@claude-plugins-official)
  fi
fi
if [ -n "${TMUX:-}" ] && [ "$sem_tmux" = 0 ]; then
  rc=0; supervisionar "${args[@]}" || rc=$?; exit "$rc"
fi
exec "$claude_bin" "${args[@]}"
