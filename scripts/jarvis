#!/usr/bin/env bash
# Forge: abre o Jarvis num projeto, retomando a última conversa, com o chat remoto (claude.ai/code)
# e, se o plugin estiver instalado, o canal do Telegram.
# Dentro do tmux (criado/anexado automaticamente) a sessão sobrevive ao fechamento do terminal.
# Dentro do tmux, reabre o Jarvis sozinho (--continue) se o claude cair (saída anormal), no máximo 3 vezes em 30 min, sempre com
# o Claude Code mais novo instalado; cada queda vai para ${XDG_STATE_HOME:-~/.local/state}/forge/quedas.log.
# Uso: jarvis [--sem-tmux] [projeto]   (diretório em $HOME; padrão: diretório atual)
#   --sem-tmux   abre direto no terminal, sem criar ou anexar a sessão do tmux (avisa que a sessão não é durável)
#   -h, --help   mostra esta ajuda
# Antes de abrir o Claude, uma vez por abertura, atualiza o plugin do Forge (bin/forge-sempre-atual, ADR 0017): não
# pergunta, não barra e nunca roda com a sessão do tmux do projeto já aberta (aí só reanexa). Instale com: scripts/instalar-atalho.sh
set -euo pipefail
sem_tmux=0
posicionais=()
for a in "$@"; do
  case "$a" in
    --sem-tmux) sem_tmux=1 ;;
    -h|--help) sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "jarvis: opção desconhecida: $a (veja jarvis --help)" >&2; exit 2 ;;
    *) posicionais+=("$a") ;;
  esac
done
if [ ${#posicionais[@]} -gt 0 ]; then cd "$HOME/${posicionais[0]}"; fi
projeto="$(basename "$PWD")"
sessao="jarvis-${projeto//[.:]/_}"
usa_tmux=0
if [ "$sem_tmux" = 0 ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then usa_tmux=1; fi
prefixo=jarvis; rotulo="$projeto"
# SESSAO-DURAVEL-AVISO (BP3 S1, D4 do dono): fora do tmux só avisa, numa linha, e abre assim mesmo; nunca bloqueia.
if [ "$usa_tmux" = 0 ] && [ -z "${TMUX:-}" ]; then
  if [ "$sem_tmux" = 1 ]; then
    echo "jarvis: sessão não durável (--sem-tmux): uma queda do terminal derruba os agentes." >&2
  else
    echo "jarvis: tmux não instalado: sessão não durável, uma queda do terminal derruba os agentes; instale com 'sudo apt-get install tmux' (ou o gerenciador do seu sistema). Abrindo assim mesmo." >&2
  fi
fi
# FORGE-SEMPRE-ATUAL: o código vem só da pasta deste script, que o trampolim de ~/.local/bin leva ao installPath ativo
# (nunca de um work tree: pasta com .git não roda). O resultado fica no registro da ferramenta; o código de saída dela
# não decide nada, e a sessão tmux já aberta só é reanexada (a ferramenta nunca roda sob ela).
atualizar_plugin() {
  local raiz ferramenta
  raiz="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  ferramenta="$raiz/bin/forge-sempre-atual"
  if [ ! -x "$ferramenta" ] || [ -e "$raiz/.git" ]; then return 0; fi
  if command -v timeout >/dev/null 2>&1; then
    timeout 90 "$ferramenta" --gatilho atalho --projeto "$PWD" </dev/null || true
  else
    "$ferramenta" --gatilho atalho --projeto "$PWD" </dev/null || true
  fi
}
if [ -z "${FORGE_ABERTURA_FEITA:-}" ]; then
  if [ "$usa_tmux" = 1 ] && tmux has-session -t "$sessao" 2>/dev/null; then :; else atualizar_plugin; fi
fi
if [ "$usa_tmux" = 1 ]; then
  eu="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  exec tmux new-session -A -s "$sessao" -c "$PWD" "$(printf '%q ' env FORGE_ABERTURA_FEITA=1 "$eu" ${posicionais[@]+"${posicionais[@]}"})"
fi
# CLAUDE-ATUAL-INICIO (BP3 S1, D1 do dono): o atalho abre sempre o Claude Code mais novo entre o do instalador oficial
# ($HOME/.local/bin/claude, que a atualização automática mantém) e o primeiro do PATH, nunca o do PATH só por ser o primeiro:
# um binário velho num diretório do sistema (por exemplo /usr/local/bin) vem antes e abriria uma versão atrasada.
# Só caminho absoluto de arquivo executável (nunca o diretório atual); iguais pelo caminho real contam uma vez; com um só
# candidato não roda nada; com dois, `--version` de cada um (10 s) e vence o maior número, o empate fica com o do instalador.
# Sem versão legível em nenhum, ou se o primeiro do PATH não responde `--version`, fica o `command -v claude` de sempre (nada
# que não se possa comparar o troca). Roda a cada abertura e a cada reabertura.
# Resultado em claude_bin (e claude_versao, quando conhecida); sem nenhum claude, claude_bin fica vazio.
resolver_claude() {
  local c real dir v vistos="
" maior="" primeiro primeiro_real v_primeiro=""
  local -a candidatos=() unicos=()
  claude_bin=""; claude_versao=""
  primeiro="$(command -v claude 2>/dev/null || true)"
  primeiro_real="$(readlink -f "$primeiro" 2>/dev/null || true)"
  [ -x "$HOME/.local/bin/claude" ] && [ -f "$HOME/.local/bin/claude" ] && candidatos+=("$HOME/.local/bin/claude")
  case "$primeiro" in /*) [ -x "$primeiro" ] && [ -f "$primeiro" ] && candidatos+=("$primeiro") ;; esac
  for c in ${candidatos[@]+"${candidatos[@]}"}; do
    real="$(readlink -f "$c" 2>/dev/null || printf '%s' "$c")"
    case "$vistos" in *"
$real
"*) continue ;; esac
    vistos="$vistos$real
"
    unicos+=("$c")
  done
  if [ "${#unicos[@]}" -eq 1 ]; then claude_bin="${unicos[0]}"; return 0; fi
  for c in ${unicos[@]+"${unicos[@]}"}; do
    if command -v timeout >/dev/null 2>&1; then
      v="$(timeout 10 "$c" --version </dev/null 2>/dev/null | grep -oE '^[0-9]+(\.[0-9]+)+' | head -n 1 || true)"
    else
      v="$("$c" --version </dev/null 2>/dev/null | grep -oE '^[0-9]+(\.[0-9]+)+' | head -n 1 || true)"
    fi
    [ -n "$v" ] || continue
    if [ -n "$primeiro_real" ] && [ "$(readlink -f "$c" 2>/dev/null || true)" = "$primeiro_real" ]; then v_primeiro="$v"; fi
    if [ -z "$maior" ] || [ "$(printf '%s\n%s\n' "$maior" "$v" | sort -V | tail -n 1)" != "$maior" ]; then
      maior="$v"; claude_bin="$c"; claude_versao="$v"
    fi
  done
  if [ -z "$claude_bin" ] || [ -z "$v_primeiro" ]; then claude_bin="$primeiro"; claude_versao=""; fi
  if [ -n "$claude_versao" ] && [ "$claude_bin" != "$primeiro" ]; then
    echo "$prefixo: usando o Claude Code $claude_versao ($claude_bin); o primeiro do PATH é outro e mais antigo." >&2
  fi
  return 0
}
# CLAUDE-ATUAL-FIM
# SUPERVISOR-INICIO (BP3 S1, D1 do dono): dentro do tmux o atalho não entrega o processo ao claude: roda-o e olha como saiu.
# Reabre (`--continue`, sempre com o Claude Code atual, resolvido de novo) só em saída anormal: código 128 ou mais, fora 129
# (terminal fechado) e 130 (Ctrl+C); 0 (/exit) e qualquer código abaixo de 128 (erro de uso) encerram como antes. Espera
# FORGE_QUEDA_ESPERA s (padrão 10) e conta as reaberturas na janela de FORGE_QUEDA_JANELA s (padrão 1800, 30 min): a 4.ª queda
# na janela, depois de 3 reaberturas, não reabre mais, avisa e deixa a janela esperando um Enter. O modo de permissão não muda
# (`--permission-mode auto`): a ação destrutiva segue perguntando. Cada queda vira uma linha em quedas.log, só com data,
# projeto, código de saída e número da tentativa (nunca texto do claude).
quedas_teto=3
registrar_queda() {
  local base dir
  case "${XDG_STATE_HOME:-}" in /*) base="$XDG_STATE_HOME" ;; *) base="$HOME/.local/state" ;; esac
  dir="$base/forge"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf '%s projeto=%s saida=%s tentativa=%s acao=%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$rotulo" "$1" "$2" "$3" >> "$dir/quedas.log" 2>/dev/null || true
}
supervisionar() {
  local rc espera janela agora t
  local -a recentes=() mantidas=()
  espera="${FORGE_QUEDA_ESPERA:-10}"; janela="${FORGE_QUEDA_JANELA:-1800}"
  case "$espera" in ''|*[!0-9]*) espera=10 ;; esac
  case "$janela" in ''|*[!0-9]*) janela=1800 ;; esac
  while :; do
    resolver_claude
    if [ -z "$claude_bin" ]; then echo "$prefixo: claude não encontrado no PATH." >&2; return 127; fi
    rc=0
    "$claude_bin" "$@" || rc=$?
    if [ "$rc" -lt 128 ] || [ "$rc" = 129 ] || [ "$rc" = 130 ]; then return "$rc"; fi
    agora="$(date +%s)"
    mantidas=()
    for t in ${recentes[@]+"${recentes[@]}"}; do
      if [ $((agora - t)) -lt "$janela" ]; then mantidas+=("$t"); fi
    done
    recentes=(${mantidas[@]+"${mantidas[@]}"})
    if [ "${#recentes[@]}" -ge "$quedas_teto" ]; then
      registrar_queda "$rc" "$quedas_teto" desiste
      echo "$prefixo: o Jarvis caiu de novo (saída $rc) depois de $quedas_teto reaberturas em $((janela / 60)) min; não reabro mais. Veja o registro em ${XDG_STATE_HOME:-~/.local/state}/forge/quedas.log." >&2
      if [ -t 0 ]; then read -r -p "Enter para fechar esta janela " _ || true; fi
      return "$rc"
    fi
    recentes+=("$agora")
    registrar_queda "$rc" "${#recentes[@]}" reabre
    echo "$prefixo: o Jarvis caiu (saída $rc); reabrindo em ${espera}s (reabertura ${#recentes[@]} de $quedas_teto em $((janela / 60)) min)." >&2
    sleep "$espera"
    if [ "${1:-}" != --continue ]; then set -- --continue "$@"; fi
  done
}
# SUPERVISOR-FIM
# SESSAO-AUTOMATICA (diretriz 28): a sessão abre sempre em --permission-mode auto; o Jarvis confere o sandbox no primeiro comando.
args=(--continue --permission-mode auto --remote-control "Jarvis - $projeto")
# SANDBOX-AVISO (v047 E1.222): o modo automático segue, mas sem sandbox ligado no projeto o classificador é a única barreira; avisa numa linha.
sandbox_ligado() {
  python3 -I - "$PWD/.claude/settings.json" "$PWD/.claude/settings.local.json" <<'PY' 2>/dev/null
import json, sys
for caminho in sys.argv[1:]:
    try:
        with open(caminho, encoding="utf-8") as f:
            dado = json.load(f)
        if dado["sandbox"]["enabled"] is True:
            sys.exit(0)
    except Exception:
        pass
sys.exit(1)
PY
}
if ! sandbox_ligado; then
  echo "jarvis: sandbox desligado neste projeto: a sessão automática roda sem sandbox; rode 'forge adotar' para ligá-lo." >&2
fi
resolver_claude
if [ -z "$claude_bin" ]; then echo "jarvis: claude não encontrado no PATH." >&2; exit 127; fi
if "$claude_bin" plugin list 2>/dev/null | grep -q 'telegram@claude-plugins-official'; then
  if pgrep -f "bun server.ts" >/dev/null; then
    echo "jarvis: outra sessão já usa o bot do Telegram; abrindo sem o canal." >&2
  else
    args+=(--channels plugin:telegram@claude-plugins-official)
  fi
fi
# Antes de abrir o Jarvis: o doutor rápido (local, sem rede, custo zero de tokens). Silencioso se está tudo bem; se
# listou algo, espera um Enter para a pessoa ler antes de o Claude ocupar a tela. Sem o plugin instalado, pula.
doutor="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bin/forge-doutor"
[ -x "$doutor" ] || doutor="$(command -v forge-doutor || true)"
if [ -n "$doutor" ] && ! "$doutor" --rapido && [ -t 0 ]; then
  read -r -p "Enter para abrir o Jarvis assim mesmo (ou Ctrl+C para consertar antes com: forge doutor) " _
fi
if [ -n "${TMUX:-}" ] && [ "$sem_tmux" = 0 ]; then
  rc=0; supervisionar "${args[@]}" || rc=$?; exit "$rc"
fi
exec "$claude_bin" "${args[@]}"
