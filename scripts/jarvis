#!/usr/bin/env bash
# Forge: abre o Jarvis num projeto, retomando a última conversa, com o chat remoto (claude.ai/code)
# e, se o plugin estiver instalado, o canal do Telegram.
# Dentro do tmux (criado/anexado automaticamente) a sessão sobrevive ao fechamento do terminal.
# Uso: jarvis [--sem-tmux] [projeto]   (diretório em $HOME; padrão: diretório atual)
#   --sem-tmux   abre direto no terminal, sem criar ou anexar a sessão do tmux
#   -h, --help   mostra esta ajuda
# Antes de abrir o Claude, uma vez por abertura, atualiza o plugin do Forge (bin/forge-sempre-atual, ADR 0017): não
# pergunta, não barra e nunca roda com a sessão do tmux do projeto já aberta (aí só reanexa). Instale com: scripts/instalar-atalho.sh
# Abre na visão de foco (Focus view) se nenhum settings.json a decide; para desligar: "viewMode": "default" no ~/.claude/settings.json.
set -euo pipefail
sem_tmux=0
posicionais=()
for a in "$@"; do
  case "$a" in
    --sem-tmux) sem_tmux=1 ;;
    -h|--help) sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "jarvis: opção desconhecida: $a (veja jarvis --help)" >&2; exit 2 ;;
    *) posicionais+=("$a") ;;
  esac
done
if [ ${#posicionais[@]} -gt 0 ]; then cd "$HOME/${posicionais[0]}"; fi
projeto="$(basename "$PWD")"
sessao="jarvis-${projeto//[.:]/_}"
usa_tmux=0
if [ "$sem_tmux" = 0 ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then usa_tmux=1; fi
# FORGE-SEMPRE-ATUAL: o código vem só da pasta deste script, que o trampolim de ~/.local/bin leva ao installPath ativo
# (nunca de um work tree: pasta com .git não roda). O resultado fica no registro da ferramenta; o código de saída dela
# não decide nada, e a sessão tmux já aberta só é reanexada (a ferramenta nunca roda sob ela).
atualizar_plugin() {
  local raiz ferramenta
  raiz="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  ferramenta="$raiz/bin/forge-sempre-atual"
  if [ ! -x "$ferramenta" ] || [ -e "$raiz/.git" ]; then return 0; fi
  if command -v timeout >/dev/null 2>&1; then
    timeout 90 "$ferramenta" --gatilho atalho --projeto "$PWD" </dev/null || true
  else
    "$ferramenta" --gatilho atalho --projeto "$PWD" </dev/null || true
  fi
}
if [ -z "${FORGE_ABERTURA_FEITA:-}" ]; then
  if [ "$usa_tmux" = 1 ] && tmux has-session -t "$sessao" 2>/dev/null; then :; else atualizar_plugin; fi
fi
if [ "$usa_tmux" = 1 ]; then
  eu="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  exec tmux new-session -A -s "$sessao" -c "$PWD" "$(printf '%q ' env FORGE_ABERTURA_FEITA=1 "$eu" ${posicionais[@]+"${posicionais[@]}"})"
fi
# SESSAO-AUTOMATICA (diretriz 28): a sessão abre sempre em --permission-mode auto; o Jarvis confere o sandbox no primeiro comando.
args=(--continue --permission-mode auto --remote-control "Jarvis - $projeto")
# SANDBOX-AVISO (v047 E1.222): o modo automático segue, mas sem sandbox ligado no projeto o classificador é a única barreira; avisa numa linha.
sandbox_ligado() {
  python3 -I - "$PWD/.claude/settings.json" "$PWD/.claude/settings.local.json" <<'PY' 2>/dev/null
import json, sys
for caminho in sys.argv[1:]:
    try:
        with open(caminho, encoding="utf-8") as f:
            dado = json.load(f)
        if dado["sandbox"]["enabled"] is True:
            sys.exit(0)
    except Exception:
        pass
sys.exit(1)
PY
}
if ! sandbox_ligado; then
  echo "jarvis: sandbox desligado neste projeto: a sessão automática roda sem sandbox; rode 'forge adotar' para ligá-lo." >&2
fi
# VISAO-DE-FOCO (diretriz 31): "viewMode": "focus" só nesta sessão, por --settings, quando nenhum arquivo (local > projeto >
# usuário) define viewMode; com a visão valendo e sem tui decidido (arquivo ou variável), também a tela cheia, que ela exige.
# Arquivo ilegível: não decide pelo dono. Lê só duas chaves; nada do arquivo é impresso.
visao_de_foco() {
  python3 -I - "$PWD/.claude/settings.local.json" "$PWD/.claude/settings.json" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" <<'PY'
import json, os, sys
dados = []
for caminho in sys.argv[1:]:
    if os.path.exists(caminho):
        try:
            with open(caminho, encoding="utf-8") as f:
                dado = json.load(f)
        except Exception:
            sys.exit(0)
        dados.append(dado if isinstance(dado, dict) else {})
modo = next((d["viewMode"] for d in dados if "viewMode" in d), None)
extra = {} if modo is not None else {"viewMode": "focus"}
sem_tui = not any("tui" in d for d in dados) and not os.environ.get("CLAUDE_CODE_NO_FLICKER") \
    and not os.environ.get("CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN")
if modo in (None, "focus") and sem_tui:
    extra["tui"] = "fullscreen"
if extra:
    print(json.dumps(extra, separators=(",", ":")))
PY
}
foco="$(visao_de_foco 2>/dev/null)" || foco=""
if [ -n "$foco" ]; then args+=(--settings "$foco"); fi
if claude plugin list 2>/dev/null | grep -q 'telegram@claude-plugins-official'; then
  if pgrep -f "bun server.ts" >/dev/null; then
    echo "jarvis: outra sessão já usa o bot do Telegram; abrindo sem o canal." >&2
  else
    args+=(--channels plugin:telegram@claude-plugins-official)
  fi
fi
# Antes de abrir o Jarvis: o doutor rápido (local, sem rede, custo zero de tokens). Silencioso se está tudo bem; se
# listou algo, espera um Enter para a pessoa ler antes de o Claude ocupar a tela. Sem o plugin instalado, pula.
doutor="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bin/forge-doutor"
[ -x "$doutor" ] || doutor="$(command -v forge-doutor || true)"
if [ -n "$doutor" ] && ! "$doutor" --rapido && [ -t 0 ]; then
  read -r -p "Enter para abrir o Jarvis assim mesmo (ou Ctrl+C para consertar antes com: forge doutor) " _
fi
exec claude "${args[@]}"
