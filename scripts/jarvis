#!/usr/bin/env bash
# Forge: abre o Jarvis num projeto, retomando a última conversa, com o chat remoto (claude.ai/code)
# e, se o plugin estiver instalado, o canal do Telegram.
# Dentro do tmux (criado/anexado automaticamente) a sessão sobrevive ao fechamento do terminal.
# Uso: jarvis [--sem-tmux] [projeto]   (diretório em $HOME; padrão: diretório atual)
#   --sem-tmux   abre direto no terminal, sem criar ou anexar a sessão do tmux
#   -h, --help   mostra esta ajuda
# Instale com: scripts/instalar-atalho.sh
set -euo pipefail
sem_tmux=0
posicionais=()
for a in "$@"; do
  case "$a" in
    --sem-tmux) sem_tmux=1 ;;
    -h|--help) sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "jarvis: opção desconhecida: $a (veja jarvis --help)" >&2; exit 2 ;;
    *) posicionais+=("$a") ;;
  esac
done
if [ ${#posicionais[@]} -gt 0 ]; then cd "$HOME/${posicionais[0]}"; fi
projeto="$(basename "$PWD")"
if [ "$sem_tmux" = 0 ] && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
  sessao="jarvis-${projeto//[.:]/_}"
  eu="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  exec tmux new-session -A -s "$sessao" -c "$PWD" "$(printf '%q ' "$eu" "${posicionais[@]}")"
fi
# SESSAO-AUTOMATICA (diretriz 28): a sessão abre sempre em --permission-mode auto; o Jarvis confere o sandbox no primeiro comando.
args=(--continue --permission-mode auto --remote-control "Jarvis - $projeto")
# SANDBOX-AVISO (v047 E1.222): o modo automático segue, mas sem sandbox ligado no projeto o classificador é a única barreira; avisa numa linha.
sandbox_ligado() {
  python3 -I - "$PWD/.claude/settings.json" "$PWD/.claude/settings.local.json" <<'PY' 2>/dev/null
import json, sys
for caminho in sys.argv[1:]:
    try:
        with open(caminho, encoding="utf-8") as f:
            dado = json.load(f)
        if dado["sandbox"]["enabled"] is True:
            sys.exit(0)
    except Exception:
        pass
sys.exit(1)
PY
}
if ! sandbox_ligado; then
  echo "jarvis: sandbox desligado neste projeto: a sessão automática roda sem sandbox; rode 'forge adotar' para ligá-lo." >&2
fi
if claude plugin list 2>/dev/null | grep -q 'telegram@claude-plugins-official'; then
  if pgrep -f "bun server.ts" >/dev/null; then
    echo "jarvis: outra sessão já usa o bot do Telegram; abrindo sem o canal." >&2
  else
    args+=(--channels plugin:telegram@claude-plugins-official)
  fi
fi
# Antes de abrir o Jarvis: o doutor rápido (local, sem rede, custo zero de tokens). Silencioso se está tudo bem; se
# listou algo, espera um Enter para a pessoa ler antes de o Claude ocupar a tela. Sem o plugin instalado, pula.
doutor="$(find "$HOME"/.claude/plugins/cache/*/forge/*/bin/forge-doutor 2>/dev/null | sort -V | tail -n 1 || true)"
[ -n "$doutor" ] || doutor="$(command -v forge-doutor || true)"
if [ -n "$doutor" ] && ! "$doutor" --rapido && [ -t 0 ]; then
  read -r -p "Enter para abrir o Jarvis assim mesmo (ou Ctrl+C para consertar antes com: forge doutor) " _
fi
exec claude "${args[@]}"
